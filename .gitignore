# Krafted — NEVER commit these to public repo
*.kpak
*.krafted
node_modules/
.DS_Store

# But keep docs/ and .github/ for deploy
!docs/
!.github/

# Generated on every test run. tests/fixtures/ is rebuilt from .version_state,
# so committing it would only commit a copy that goes stale on the next bump.
tests/fixtures/
tests/__pycache__/
tests/*.pyc

# Mutation/patch scripts leave these next to the file they edit so they can
# always restore it. They are scratch, not source.
*.orig
*.mutbak
*.pyc

# Timestamped scratch backups of files this repo ALREADY tracks (e.g.
# tests/run_all.sh.bak-20260831-100359). Git history is the backup for a
# tracked file; committing a second full copy of it just plants a stale
# duplicate next to the real one, and a stale copy of version_scan.py is a
# copy that still contains the bug you just fixed. Backups of tracked files
# belong in ../backups/, which this repo does not track at all.
*.bak-*
