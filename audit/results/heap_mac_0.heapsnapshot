ddImage(src, natW, natH, x, y, true);\n}\n\n// ============================================================\n//  LINK CARDS \u2014 paste a URL, get a preview cover, click to open\n// ============================================================\nfunction openLinkModal() {\n  hideWelcome();\n  const modal = document.getElementById('link-modal');\n  const input = document.getElementById('link-url-input');\n  modal.classList.add('active');\n  input.value = '';\n  setTimeout(() => input.focus(), 50);\n}\nfunction closeLinkModal() {\n  document.getElementById('link-modal').classList.remove('active');\n  document.getElementById('link-loading-msg').style.display = 'none';\n}\nfunction confirmLinkModal() {\n  const input = document.getElementById('link-url-input');\n  let url = input.value.trim();\n  if (!url) return;\n  // Auto-add https:// if missing\n  if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;\n  closeLinkModal();\n  addLinkCard(url);\n}\n\nfunction extractYouTubeId(url) {\n  const patterns = [\n    /(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/|youtube\\.com\\/embed\\/|youtube\\.com\\/shorts\\/)([a-zA-Z0-9_-]{11})/,\n  ];\n  for (const p of patterns) {\n    const m = url.match(p);\n    if (m) return m[1];\n  }\n  return null;\n}\n\nfunction extractBilibiliId(url) {\n  // BV ID: bilibili.com/video/BV1xx411c7mD\n  const bvMatch = url.match(/bilibili\\.com\\/video\\/(BV[a-zA-Z0-9]+)/);\n  if (bvMatch) return { type: 'bvid', id: bvMatch[1] };\n  // AV ID: bilibili.com/video/av12345678\n  const avMatch = url.match(/bilibili\\.com\\/video\\/av(\\d+)/i);\n  if (avMatch) return { type: 'aid', id: avMatch[1] };\n  // Short URL: b23.tv/xxxxxxx\n  const shortMatch = url.match(/b23\\.tv\\/([a-zA-Z0-9]+)/);\n  if (shortMatch) return { type: 'short', id: shortMatch[1] };\n  return null;\n}\n\nfunction getHostname(url) {\n  try { return new URL(url).hostname.replace(/^www\\./, ''); } catch(e) { return url; }\n}\n\nfunction addLinkCard(url, opts) {\n  pushUndo();\n  const linkUrl = url;\n  const hostname = getHostname(url);\n  const placeX = (opts && opts.x !== undefined) ? opts.x : (window.innerWidth/2 - 200 - state.pan.x) / state.zoom;\n  const placeY = (opts && opts.y !== undefined) ? opts.y : (window.innerHeight/2 - 150 - state.pan.y) / state.zoom;\n  const w = 400, h = 300;\n\n  const el = document.createElement('div');\n  el.className = 'item link-card';\n  canvasContent.appendChild(el);\n\n  // Placeholder shown while fetching\n  const placeholder = document.createElement('div');\n  placeholder.className = 'link-placeholder';\n  placeholder.innerHTML = '<div class=\"link-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 9.5l3-3M6 10l-1 1a2 2 0 01-3-3l2-2a2 2 0 013 0M10 6l1-1a2 2 0 013 3l-2 2a2 2 0 01-3 0\"/></svg></div><div class=\"link-text\">' + hostname + '</div>';\n  el.appendChild(placeholder);\n\n  const item = {\n    id: G.nextId++, el, img: null, video: null,\n    x: placeX, y: placeY, w, h, rot: 0, opacity: 1, flipH: false, flipV: false, locked: false,\n    z: G.nextZ++,\n    src: '', natW: 400, natH: 300, isVideo: false,\n    isLink: true, linkUrl, linkTitle: hostname, linkDesc: '',\n    cropX: 0, cropY: 0, cropW: 400, cropH: 300,\n    brightness: 100, contrast: 100, saturate: 100, hueRotate: 0, blur: 0, sepia: 0, grayscale: 0,\n    temp: 0, vignette: 0, shadow: 100, highlight: 100, grain: 0,\n    trimStart: 0, trimEnd: 0, playbackRate: 1,\n  };\n  state.items.push(item);\n  updateItemStyle(item);\n  selectOnly(item.id);\n\n  // Double-click opens the link\n  el.addEventListener('dblclick', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n\n  // Try to fetch cover image\n  fetchLinkCover(url, el, item, placeholder);\n  scheduleAutoSave();\n  updateAutoFitPaper();\n  return item;\n}\n\nfunction fetchLinkCover(url, el, item, placeholder) {\n  const ytId = extractYouTubeId(url);\n  if (ytId) {\n    // YouTube \u2014 use thumbnail directly (no API needed)\n    const coverUrl = 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg';\n    const title = 'YouTube Video';\n    applyLinkCover(el, item, placeholder, coverUrl, title, 480, 360, url);\n    return;\n  }\n  const biliId = extractBilibiliId(url);\n  if (biliId) {\n    // Bilibili \u2014 fetch video info via CORS proxy\n    if (biliId.type === 'short') {\n      // b23.tv short URL \u2014 need to resolve redirect first to get BV ID\n      fetchBilibiliShort(url, el, item, placeholder);\n      return;\n    }\n    fetchBilibiliVideoInfo(biliId, url, el, item, placeholder);\n    return;\n  }\n  // Other URLs \u2014 try microlink.io API\n  fetchMicrolink(url, el, item, placeholder);\n}\n\nfunction fetchBilibiliShort(url, el, item, placeholder) {\n  // Resolve b23.tv short URL to get the full URL (which contains BV ID)\n  // Try multiple CORS proxies in parallel, fastest wins\n  var proxyUrls = [\n    'https://corsproxy.io/?' + encodeURIComponent(url),\n    'https://api.allorigins.win/get?url=' + encodeURIComponent(url),\n    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(url),\n    'https://cors-anywhere.herokuapp.com/' + url\n  ];\n\n  var fetchWithTimeout = function(u) {\n    return new Promise(function(resolve, reject) {\n      var controller = new AbortController();\n      var timer = setTimeout(function() { controller.abort(); reject(new Error('timeout')); }, 8000);\n      fetch(u, { signal: controller.signal })\n        .then(function(r) {\n          clearTimeout(timer);\n          resolve(r);\n        })\n        .catch(function(e) { clearTimeout(timer); reject(e); });\n    });\n  };\n\n  Promise.any(proxyUrls.map(fetchWithTimeout))\n    .then(function(r) {\n      // Try to determine the resolved URL\n      if (r.redirected) {\n        onShortResolved(r.url);\n      } else {\n        // Might be allorigins /get JSON response \u2014 try parsing\n        r.json().then(function(data) {\n          onShortResolved((data.status && data.status.url) || url);\n        }).catch(function() {\n          onShortResolved(url);\n        });\n      }\n    })\n    .catch(function() {\n      onShortResolved(url);\n    });\n\n  function onShortResolved(resolvedUrl) {\n    var biliId = extractBilibiliId(resolvedUrl);\n    if (biliId && biliId.type !== 'short') {\n      fetchBilibiliVideoInfo(biliId, url, el, item, placeholder);\n    } else {\n      fetchMicrolink(url, el, item, placeholder);\n    }\n  }\n}\n\nfunction fetchBilibiliVideoInfo(biliId, originalUrl, el, item, placeholder) {\n  let apiUrl;\n  if (biliId.type === 'bvid') apiUrl = 'https://api.bilibili.com/x/web-interface/view?bvid=' + biliId.id;\n  else if (biliId.type === 'aid') apiUrl = 'https://api.bilibili.com/x/web-interface/view?aid=' + biliId.id;\n  else { fetchMicrolink(originalUrl, el, item, placeholder); return; }\n\n  // Multiple CORS proxies \u2014 tried in parallel, fastest wins\n  var proxyUrls = [\n    'https://corsproxy.io/?' + encodeURIComponent(apiUrl),\n    'https://api.allorigins.win/raw?url=' + encodeURIComponent(apiUrl),\n    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(apiUrl),\n    'https://cors-anywhere.herokuapp.com/' + apiUrl,\n    'https://thingproxy.freeboard.io/fetch/' + apiUrl\n  ];\n\n  var fetchWithTimeout = function(url) {\n    return new Promise(function(resolve, reject) {\n      var controller = new AbortController();\n      var timer = setTimeout(function() { controller.abort(); reject(new Error('timeout')); }, 8000);\n      fetch(url, { signal: controller.signal })\n        .then(function(r) {\n          clearTimeout(timer);\n          if (!r.ok) { reject(new Error('status ' + r.status)); return; }\n          r.json().then(resolve).catch(reject);\n        })\n        .catch(function(e) { clearTimeout(timer); reject(e); });\n    });\n  };\n\n  Promise.any(proxyUrls.map(fetchWithTimeout))\n    .then(function(data) {\n      if (data && data.code === 0 && data.data) {\n        var coverUrl = data.data.pic || '';\n        var title = data.data.title || 'Bilibili Video';\n        var desc = data.data.desc || '';\n        if (coverUrl) {\n          // Bilibili CDN blocks hotlinking via Referer \u2014 use no-referrer\n          applyLinkCover(el, item, placeholder, coverUrl, title, 400, 300, originalUrl, desc, true);\n        } else {\n          applyLinkPlaceholder(el, item, placeholder, title, originalUrl);\n        }\n      } else {\n        fetchMicrolink(originalUrl, el, item, placeholder);\n      }\n    })\n    .catch(function() {\n      // All proxies failed \u2014 fallback to microlink\n      fetchMicrolink(originalUrl, el, item, placeholder);\n    });\n}\n\n// FIX-v6.0.1: use safeFetch and add json parse error handling\nfunction fetchMicrolink(url, el, item, placeholder) {\n  safeFetch('https://api.microlink.io/?url=' + encodeURIComponent(url))\n    .then(function(r) {\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n      return r.json();\n    })\n    .then(function(data) {\n      if (data.status === 'success' && data.data) {\n        const coverUrl = (data.data.image && data.data.image.url) ||\n                         (data.data.screenshot && data.data.screenshot.url) || '';\n        const title = data.data.title || getHostname(url);\n        const desc = data.data.description || '';\n        const imgW = (data.data.image && data.data.image.width) || 400;\n        const imgH = (data.data.image && data.data.image.height) || 300;\n        if (coverUrl) {\n          applyLinkCover(el, item, placeholder, coverUrl, title, imgW, imgH, url, desc);\n        } else {\n          applyLinkPlaceholder(el, item, placeholder, title, url);\n        }\n      } else {\n        applyLinkPlaceholder(el, item, placeholder, getHostname(url), url);\n      }\n    })\n    .catch(function(err) {\n      console.warn('[fetchMicrolink] Failed:', err.message);\n      applyLinkPlaceholder(el, item, placeholder, getHostname(url), url);\n    });\n}\n\nfunction applyLinkCover(el, item, placeholder, coverUrl, title, imgW, imgH, url, desc, noCors) {\n  const img = new Image();\n  if (!noCors) img.crossOrigin = 'anonymous';\n  // Set no-referrer to bypass hotlink protection (e.g. Bilibili CDN blocks foreign Referer)\n  img.referrerPolicy = 'no-referrer';\n  img.onload = () => {\n    // Remove placeholder\n    if (placeholder && placeholder.parentNode) placeholder.remove();\n    // Create img element\n    const mediaEl = document.createElement('img');\n    mediaEl.src = coverUrl;\n    mediaEl.referrerPolicy = 'no-referrer';\n    mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n    mediaEl.draggable = false;\n    el.insertBefore(mediaEl, el.firstChild);\n    item.img = mediaEl;\n    item.src = coverUrl;\n    item.natW = img.naturalWidth || imgW;\n    item.natH = img.naturalHeight || imgH;\n    item.linkTitle = title;\n    item.linkDesc = desc || '';\n    // Adjust aspect ratio\n    const aspect = item.natW / item.natH;\n    item.w = 720;\n    item.h = Math.round(720 / aspect);\n    updateItemStyle(item);\n    // Add overlay elements\n    addLinkOverlay(el, item);\n    refreshSelection();\n    scheduleAutoSave();\n    updateAutoFitPaper();\n    toast('Link card added: ' + title);\n  };\n  img.onerror = () => {\n    // If direct load fails, try loading through an image proxy as last resort\n    const proxiedCoverUrl = 'https://images.weserv.nl/?url=' + encodeURIComponent(coverUrl.replace(/^https?:\\/\\//, ''));\n    const img2 = new Image();\n    img2.referrerPolicy = 'no-referrer';\n    img2.onload = () => {\n      if (placeholder && placeholder.parentNode) placeholder.remove();\n      const mediaEl = document.createElement('img');\n      mediaEl.src = proxiedCoverUrl;\n      mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n      mediaEl.draggable = false;\n      el.insertBefore(mediaEl, el.firstChild);\n      item.img = mediaEl;\n      item.src = proxiedCoverUrl;\n      item.natW = img2.naturalWidth || imgW;\n      item.natH = img2.naturalHeight || imgH;\n      item.linkTitle = title;\n      item.linkDesc = desc || '';\n      const aspect = item.natW / item.natH;\n      item.w = 720;\n      item.h = Math.round(720 / aspect);\n      updateItemStyle(item);\n      addLinkOverlay(el, item);\n      refreshSelection();\n      scheduleAutoSave();\n      updateAutoFitPaper();\n      toast('Link card added: ' + title);\n    };\n    img2.onerror = () => {\n      applyLinkPlaceholder(el, item, placeholder, title, url);\n    };\n    img2.src = proxiedCoverUrl;\n  };\n  img.src = coverUrl;\n}\n\nfunction applyLinkPlaceholder(el, item, placeholder, title, url) {\n  if (placeholder) {\n    placeholder.querySelector('.link-text').textContent = title || getHostname(url);\n  }\n  item.linkTitle = title || getHostname(url);\n  item.src = '';\n  addLinkOverlay(el, item);\n  refreshSelection();\n  scheduleAutoSave();\n  toast('Link added (no preview available)');\n}\n\nfunction addLinkOverlay(el, item) {\n  // Remove existing overlay if any\n  const existing = el.querySelectorAll('.link-overlay, .link-badge, .link-open-btn');\n  existing.forEach(e => e.remove());\n  // Info overlay at bottom\n  // FIX-v6.0.1: use textContent for user-controlled linkTitle to prevent XSS\n  const overlay = document.createElement('div');\n  overlay.className = 'link-overlay';\n  var titleDiv = document.createElement('div');\n  titleDiv.className = 'link-title';\n  titleDiv.textContent = item.linkTitle || '';\n  overlay.appendChild(titleDiv);\n  var urlDiv = document.createElement('div');\n  urlDiv.className = 'link-url';\n  urlDiv.textContent = getHostname(item.linkUrl);\n  overlay.appendChild(urlDiv);\n  el.appendChild(overlay);\n  // Badge\n  const badge = document.createElement('div');\n  badge.className = 'link-badge';\n  badge.textContent = 'LINK';\n  el.appendChild(badge);\n  // Hover open button\n  const openBtn = document.createElement('div');\n  openBtn.className = 'link-open-btn';\n  openBtn.innerHTML = 'Open Link';\n  openBtn.addEventListener('click', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n  el.appendChild(openBtn);\n}\n\nfunction openSelectedLink() {\n  const sel = getSelectedItems();\n  if (sel.length > 0 && sel[0].isLink && sel[0].linkUrl) {\n    window.open(sel[0].linkUrl, '_blank', 'noopener,noreferrer');\n  }\n}\n\n// Rebuild link overlay when restoring from saved state\nfunction rebuildLinkCard(item) {\n  const el = item.el;\n  el.className = 'item link-card';\n  if (item.src) {\n    // Has cover image \u2014 recreate it\n    const mediaEl = document.createElement('img');\n    mediaEl.src = item.src;\n    mediaEl.referrerPolicy = 'no-referrer';\n    mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n    mediaEl.draggable = false;\n    el.appendChild(mediaEl);\n    item.img = mediaEl;\n  } else {\n    // No cover \u2014 show placeholder\n    // FIX-v6.0.1: use textContent for linkTitle, keep SVG as innerHTML\n    const placeholder = document.createElement('div');\n    placeholder.className = 'link-placeholder';\n    placeholder.innerHTML = '<div class=\"link-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 9.5l3-3M6 10l-1 1a2 2 0 01-3-3l2-2a2 2 0 013 0M10 6l1-1a2 2 0 013 3l-2 2a2 2 0 01-3 0\"/></svg></div>';\n    var textDiv = document.createElement('div');\n    textDiv.className = 'link-text';\n    textDiv.textContent = item.linkTitle || getHostname(item.linkUrl);\n    placeholder.appendChild(textDiv);\n    el.appendChild(placeholder);\n  }\n  addLinkOverlay(el, item);\n  // Double-click opens the link\n  el.addEventListener('dblclick', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n}\n// v6.8.2: single source of truth for text-item event wiring.\n// Previously addText() and the undo-restore path each hand-rolled their own\n// copy of these three listeners, and the two copies had drifted:\n// restore was missing updateTextColorPalette() (stale colour swatches after\n// an undo) and updateAutoFitPaper() (paper bounds not recomputed on blur).\n// Both paths now call this, so they can never diverge again.\nfunction serializeBoardText(t) {\n  const out = normalizeBoardTextMeta({\n    id: t.id, x: t.x, y: t.y, w: t.w, h: t.h, z: t.z,\n    rot: t.rot, opacity: t.opacity, locked: t.locked,\n    font: t.font, size: t.size, bold: t.bold, italic: t.italic,\n    underline: t.underline, strike: t.strike, highlight: t.highlight,\n    shadow: t.shadow, bg: t.bg, outline: t.outline, uppercase: t.uppercase,\n    color: t.color, highlightColor: t.highlightColor, align: t.align,\n    // \u5B9E\u65F6 DOM \u4F18\u5148\uFF1B\u65E0 DOM \u65F6\u4FDD\u7559\u5DF2\u6709 HTML \u6216\u7EAF\u6B63\u6587\uFF0C\u6B63\u6587\u4E0D\u4F5C\u4E3A HTML \u63D2\u5165\u3002\n    html: t.el ? t.el.innerHTML : (typeof t.html === 'string' ? t.html : ''),\n    content: t.el ? t.el.textContent : (typeof t.content === 'string' ? t.content : ''),\n    userResized: t.userResized || false,\n    _autoGrowLocked: t._autoGrowLocked || false,\n    _textZoom: 1,\n  }, t);\n  // v7.18.0: doc-card identity plus the original markdown, set AFTER\n  // normalizeBoardTextMeta. That helper reads its defaults from the live\n  // item (its second argument), so anything written into the literal\n  // above is a second copy of the same coercion that it then overwrites.\n  // The tell was mutation: breaking those literal fields changed nothing.\n  out.docCard = !!t.docCard;\n  out.mdMode = (t.mdMode === 'rendered' || t.mdMode === 'source') ? t.mdMode : '';\n  out.mdSrc = typeof t.mdSrc === 'string' ? t.mdSrc : '';\n  return out;\n}\n\nfunction normalizeBoardTextMeta(tx, data) {\n  data = data || {};\n  tx.name = typeof data.name === 'string' ? data.name : '';\n  tx.note = typeof data.note === 'string' ? data.note : '';\n  var tags = Array.isArray(data.tags) ? data.tags\n    : (typeof data.tags === 'string' ? splitTags(data.tags) : []);\n  // \u6BCF\u6B21\u751F\u6210\u72EC\u7ACB\u6570\u7EC4\uFF1B\u53EA\u89C4\u8303\u5316 metadata\uFF0C\u4E0D\u5E94\u7528\u9884\u8BBE\u6216\u6539\u53D8\u51E0\u4F55\u3001\u6837\u5F0F\u3002\n  tx.tags = tags.filter(function (tag) { return typeof tag === 'string'; })\n    .map(function (tag) { return tag.trim(); })\n    .filter(function (tag) { return tag.length > 0; });\n  tx.textPreset = typeof data.textPreset === 'string' ? data.textPreset : '';\n  // v7.18.0: doc-card flags. Restored from whatever the file carried, so a\n  // reloaded or undone card comes back as the same kind of card it was.\n  tx.docCard = !!data.docCard;\n  tx.mdMode = (data.mdMode === 'rendered' || data.mdMode === 'source') ? data.mdMode : '';\n  tx.mdSrc = typeof data.mdSrc === 'string' ? data.mdSrc : '';\n  return tx;\n}\n\n// Board Text: one edit lifecycle; controls remain outside the editable DOM.\nfunction boardTextIsComposing(e, el) {\n  return !!(e.isComposing || e.keyCode === 229 || (el && el._btComposing));\n}\nfunction beginBoardTextUndo(tx) {\n  if (tx.locked || tx.el._btUndo) return;\n  pushUndo();\n  tx.el._btUndo = true;\n}\nfunction finishBoardTextEditing() {\n  var tx = getEditingText();\n  if (tx && tx.el._btComposing) return;\n  if (tx) tx.el.blur();\n  if (state.tool === 'text') setTool('select');\n  clearSelection();\n  syncBoardTextUI();\n}\nwindow.addEventListener('board-text-done', finishBoardTextEditing);\nwindow.addEventListener('resize', function () { positionBoardTextUI(); });\nif (window.visualViewport) {\n  window.visualViewport.addEventListener('resize', positionBoardTextUI);\n  window.visualViewport.addEventListener('scroll', positionBoardTextUI);\n}\n\nfunction routeBoardTextMouse(e) {\n  if (e.button !== 0 || (state.tool !== 'select' && state.tool !== 'text')) return false;\n  const grip = e.target.closest('.bt-move');\n  const edge = e.target.closest('.bt-select-edge');\n  const resize = e.target.closest('.item-handle[data-text-handle]');\n  if (grip || resize) {\n    const editing = getEditingText();\n    if (editing) editing.el.blur();\n    if (state.tool !== 'select') setTool('select');\n    return false; // existing move/resize lifecycle owns the gesture\n  }\n  const textEl = e.target.closest('.text-item');\n  const tx = edge ? state.texts.find(t => t.id === Number(edge.dataset.id)) : state.texts.find(t => t.el === textEl);\n  if (!tx) return false;\n  if (tx.locked || edge || e.shiftKey || e.metaKey || e.ctrlKey) {\n    e.preventDefault();\n    if (textEl && document.activeElement === textEl) textEl.blur();\n    if (e.shiftKey || e.metaKey || e.ctrlKey) toggleSelect(tx.id);\n    else selectOnly(tx.id);\n    return true;\n  }\n  // v7.19.0: two-stage text interaction (Figma-style). Click 1 selects the\n  // card only. With the card ALREADY selected the router hands the gesture\n  // back (return false) so the canvas mousedown arms a move drag \u2014 dragging\n  // the body now MOVES the card, and a micro-click (cancelled by the 3px\n  // threshold in the move-mouseup handler) enters edit. A card that is\n  // already editing, or any body click with the text TOOL active, keeps\n  // one-click caret behaviour.\n  // Decide the branch BEFORE blurring the other editor: its blur handler can\n  // flip the tool back to 'select' (finishBoardTextEditing path), which would\n  // silently turn this one-click edit into a plain select.\n  const oneClickEdit = state.tool === 'text' || tx.el.classList.contains('editing');\n  const editingOther = getEditingText();\n  if (editingOther && editingOther !== tx) editingOther.el.blur();\n  if (oneClickEdit) {\n    // Do not preventDefault: native caret placement and drag-to-select remain intact.\n    tx.el.focus({preventScroll:true});\n    return true;\n  }\n  // v7.20.0: a text card that is NOT being edited behaves exactly like an\n  // image card \u2014 the press hands straight back to the canvas mousedown,\n  // which selects the card AND arms a move drag in the SAME gesture. There\n  // is no \"click 1 selects, click 2 acts\" stage any more; editing is\n  // double-click only (see the viewport dblclick handler).\n  //\n  // preventDefault is REQUIRED here, and it is the whole reason the old\n  // one-press drag could never work: the body is contentEditable even when\n  // it is not being edited, so a plain press FOCUSES the card (the focus\n  // listener then adds .editing) and a drag paints a native TEXT SELECTION\n  // instead of moving the card. Machine-verified in Chrome: preventDefault\n  // on mousedown suppresses focus and text selection, while dblclick still\n  // fires \u2014 which is exactly the split we want.\n  e.preventDefault();\n  return false;\n}\nfunction attachTextListeners(tx) {\n  const el = tx.el;\n  if (!el || el._textListenersAttached) return;\n  el._textListenersAttached = true;\n  el.setAttribute('role', 'textbox');\n  el.setAttribute('aria-multiline', 'true');\n  el.setAttribute('aria-label', boardTextLabel('Board text', '\u753B\u677F\u6587\u5B57'));\n  el.addEventListener('compositionstart', () => { el._btComposing = true; });\n  el.addEventListener('compositionend', () => { el._btComposing = false; autoGrowTextItem(tx); });\n  el.addEventListener('beforeinput', e => {\n    if (tx.locked) { e.preventDefault(); return; }\n    beginBoardTextUndo(tx);\n  });\n  el.addEventListener('input', () => {\n    // v7.18.0: in SOURCE mode the text you type IS the markdown, so keep\n    // the source in step with the card. In RENDERED mode the source no\n    // longer describes what you see, so we drop it (and with it the\n    // source/rendered toggle) rather than offer a re-render that would\n    // silently throw the edit away.\n    if (el.classList.contains('md-source')) tx.mdSrc = el.textContent;\n    else if (tx.mdSrc) tx.mdSrc = '';\n    if (tx.mdSrc === '') tx.mdMode = '';\n    autoGrowTextItem(tx);\n    scheduleAutoSave();\n    syncBoardTextUI();\n  });\n  el.addEventListener('keydown', ke => {\n    if (boardTextIsComposing(ke, el)) return;\n    if (ke.key === 'Escape' || (ke.key === 'Enter' && (ke.metaKey || ke.ctrlKey))) {\n      ke.preventDefault();\n      ke.stopPropagation();\n      // Esc now commits; undo, not Esc, is the explicit way to revert edits.\n      finishBoardTextEditing();\n    }\n  });\n  el.addEventListener('focus', () => {\n    if (tx.locked) { el.blur(); return; }\n    el.classList.add('editing');\n    el._focusSnapshot = el.innerHTML;\n    el._btUndo = false;\n    if (!state.selected.has(tx.id) || state.selected.size !== 1) selectOnly(tx.id);\n    syncBoardTextUI();\n  });\n  el.addEventListener('blur', () => {\n    el.classList.remove('editing');\n    if (!el.textContent.trim()) {\n      // Creation already has a pre-create snapshot; clearing existing content has beforeinput undo.\n      el.remove();\n      const handles = canvas.querySelector('.text-handles[data-owner=\"' + tx.id + '\"]');\n      if (handles) handles.remove();\n      state.texts = state.texts.filter(t => t.id !== tx.id);\n      clearSelection();\n    } else if (el._focusSnapshot !== undefined && el._focusSnapshot !== el.innerHTML) {\n      autoGrowTextItem(tx);\n    }\n    el._focusSnapshot = undefined;\n    el._btUndo = false;\n    if (state.tool === 'text') setTool('select');\n    scheduleAutoSave();\n    updateAutoFitPaper();\n    syncBoardTextUI();\n  });\n}\n// \u2500\u2500 v7.17.0: text documents on the board (.md / .txt) \u2500\u2500\n// One file becomes one editable text card. Markdown markers are stripped to\n// plain text \u2014 per-line font sizes would need real HTML and a second editing\n// mode, which is a much bigger change \u2014 and long documents are capped and\n// scroll inside the card instead of growing two screens tall.\nvar DOC_TEXT_MAX_H = 600;          // world px, same unit as every other item box\nvar DOC_TEXT_W = 560;              // world px\nvar DOC_TEXT_MAX_BYTES = 512 * 1024;\n\nfunction isDocTextFile(f) {\n  return !!f && /\\.(md|markdown|txt)$/i.test(String((f && f.name) || ''));\n}\n\nfunction stripMarkdownToPlain(raw) {\n  var lines = String(raw == null ? '' : raw).replace(/\\r\\n?/g, '\\n').split('\\n');\n  var parts = [];\n  for (var i = 0; i < lines.length; i++) {\n    var line = lines[i];\n    var indent = (line.match(/^\\s*/) || [''])[0];\n    var body = line.slice(indent.length);\n    if (/^#{1,6}\\s+/.test(body)) {\n      if (i > 0) parts.push('');\n      parts.push(indent + '\u258E' + body.replace(/^#{1,6}\\s+/, ''));\n      continue;\n    }\n    if (/^(-{3,}|\\*{3,}|_{3,})\\s*$/.test(body)) { parts.push('\u2014\u2014\u2014\u2014'); continue; }\n    if (/^>\\s?/.test(body)) { parts.push(indent + '  ' + body.replace(/^>\\s?/, '')); continue; }\n    if (/^([-*+])\\s+/.test(body)) { parts.push(indent + '\u2022 ' + body.replace(/^([-*+])\\s+/, '')); continue; }\n    var plain = body\n      .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')\n      .replace(/__([^_]+)__/g, '$1')\n      .replace(/(^|[^\\*\\w])\\*([^*\\s][^*]*)\\*(?!\\*)/g, '$1$2')\n      .replace(/(^|[^_\\w])_([^_\\s][^_]*)_(?!_)/g, '$1$2');\n    parts.push(indent + plain);\n  }\n  return parts.join('\\n').replace(/\\n{3,}/g, '\\n\\n').replace(/^\\n+/, '').replace(/\\s+$/, '');\n}\n\nfunction readTextFile(file) {\n  if (file && typeof file.text === 'function') return file.text();\n  return new Promise(function (resolve, reject) {\n    var fr = new FileReader();\n    fr.onload = function () { resolve(String(fr.result || '')); };\n    fr.onerror = function () { reject(fr.error || new Error('read failed')); };\n    try { fr.readAsText(file); } catch (e) { reject(e); }\n  });\n}\n\nfunction importDocTextFiles(files, posAt) {\n  (files || []).forEach(function (file, i) {\n    if (!file) return;\n    if (file.size && file.size > DOC_TEXT_MAX_BYTES) {\n      var ok = false;\n      try {\n        ok = window.confirm(boardTextLabel(\n          '\"' + (file.name || '') + '\" is ' + Math.round(file.size / 1024) + ' KB. Import it anyway?',\n          '\u300C' + (file.name || '') + '\u300D\u6709 ' + Math.round(file.size / 1024) + ' KB\uFF0C\u4ECD\u7136\u6C47\u5165\uFF1F'));\n      } catch (e) { ok = true; }\n      if (!ok) return;\n    }\n    readTextFile(file).then(function (raw) {\n      // v7.18.0: .md renders (tables, heading sizes, real bold); .txt stays\n      // plain, because a .txt is usually not markdown and rendering it\n      // would surprise more than it helps.\n      var isMd = isMarkdownFile(file);\n      var body = isMd ? renderMarkdownToHtml(raw) : stripMarkdownToPlain(raw);\n      if (!String(raw == null ? '' : raw).trim() || !body) {\n        try { toast(boardTextLabel('Empty file: ', '\u7A7A\u6863\u6848\uFF1A') + (file.name || '')); } catch (e) {}\n        return;\n      }\n      var at = (typeof posAt === 'function' ? posAt(i) : null) || { x: 0, y: 0 };\n      var tx = addText(at.x, at.y, isMd ? '' : body, { noFocus: true, initW: DOC_TEXT_W });\n      if (!tx) return;\n      tx.name = String(file.name || '').replace(/\\.[^.]+$/, '');\n      // v7.18.0: these flags are what survive save / undo / load; the CSS\n      // classes are re-derived from them by syncDocCardClasses().\n      tx.docCard = true;\n      tx.mdMode = isMd ? 'rendered' : '';\n      tx.mdSrc = isMd ? String(raw) : '';\n      if (isMd) tx.el.innerHTML = sanitizeTextHtml(body);\n      syncDocCardClasses(tx);\n      requestAnimationFrame(function () { autoGrowTextItem(tx); });\n      try { toast(boardTextLabel('Imported ', '\u5DF2\u6C47\u5165 ') + (file.name || '')); } catch (e) {}\n    }).catch(function () {\n      try { toast(boardTextLabel('Could not read ', '\u8BFB\u5514\u5230 ') + (file.name || '')); } catch (e) {}\n    });\n  });\n}\n\nfunction handleTextUpload(ev) {\n  var input = ev && ev.target;\n  var list = [];\n  try { list = Array.prototype.slice.call((input && input.files) || []); } catch (e) {}\n  try { if (input) input.value = ''; } catch (e) {}\n  if (!list.length) return;\n  var cx = (window.innerWidth / 2 - DOC_TEXT_W / 2 - state.pan.x) / state.zoom;\n  var cy = (window.innerHeight / 2 - state.pan.y) / state.zoom;\n  importDocTextFiles(list, function (i) { return { x: cx + i * 28, y: cy + i * 28 }; });\n}\n\n// v7.17.0: a doc card consumes the wheel only while it can still scroll, and\n// never for pinch / Cmd zoom. Deciding first and swallowing second is the same\n// contract the board's own nested handlers follow \u2014 and because we return\n// WITHOUT calling preventDefault, the browser performs the scroll itself.\nfunction wheelDocCardTarget(e) {\n  var t = e && e.target;\n  if (!t || typeof t.closest !== 'function') return null;\n  return t.closest('.text-item.doc-card');\n}\nfunction docCardCanScroll(el, e) {\n  if (!el || !e) return false;\n  if (e.ctrlKey || e.metaKey) return false;\n  if (state.dragging) return false;\n  var dy = e.deltaY;\n  if (!dy) return false;\n  if (el.scrollHeight <= el.clientHeight + 1) return false;\n  if (dy < 0) return el.scrollTop > 0;\n  return el.scrollTop + el.clientHeight < el.scrollHeight - 1;\n}\n\n// \u2500\u2500 v7.18.0: render markdown into the card's own HTML \u2500\u2500\n// An imported .md is no longer flattened to plain text: headings get real\n// sizes, bold is real bold, and GFM tables become real tables. Everything is\n// escaped FIRST and only a closed set of tags is ever emitted, and the result\n// still goes through sanitizeTextHtml() on every save / undo / load, so a\n// hostile .md cannot smuggle script onto the board.\nfunction escMd(s) {\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;').replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n}\nfunction safeMdUrl(u) {\n  var t = String(u == null ? '' : u).trim();\n  if (/^(https?:|mailto:)/i.test(t)) return t;\n  if (/^[#/]/.test(t) || /^\\.{1,2}\\//.test(t)) return t;\n  return '#';\n}\nfunction inlineMd(s) {\n  var t = escMd(s);\n  t = t.replace(/`([^`]+)`/g, '<code>$1</code>');\n  t = t.replace(/!\\[([^\\]]*)\\]\\(([^)\\s]*)\\)/g, function (m, a) {\n    return '<span>[' + (a || 'image') + ']</span>';\n  });\n  t = t.replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, function (m, a, b) {\n    return '<a href=\"' + safeMdUrl(b) + '\">' + a + '</a>';\n  });\n  t = t.replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>');\n  t = t.replace(/__([^_]+)__/g, '<strong>$1</strong>');\n  t = t.replace(/(^|[^\\w*])\\*([^*\\s][^*]*)\\*(?!\\*)/g, '$1<em>$2</em>');\n  t = t.replace(/(^|[^_\\w])_([^_\\s][^_]*)_(?!_)/g, '$1<em>$2</em>');\n  t = t.replace(/~~([^~]+)~~/g, '<del>$1</del>');\n  return t;\n}\nfunction splitMdRow(line) {\n  var s = String(line == null ? '' : line).trim();\n  if (s.charAt(0) === '|') s = s.slice(1);\n  if (s.charAt(s.length - 1) === '|') s = s.slice(0, -1);\n  return s.split('|').map(function (c) { return c.trim(); });\n}\nfunction mdAlignCell(c) {\n  var s = String(c == null ? '' : c).trim();\n  if (!/^:?-{1,}:?$/.test(s)) return '';\n  var l = s.charAt(0) === ':', r = s.charAt(s.length - 1) === ':';\n  if (l && r) return 'center';\n  if (r) return 'right';\n  if (l) return 'left';\n  return '';\n}\nvar MD_LIST_RE = /^(\\s*)([-*+]|\\d+[.)])\\s+(.*)$/;\nfunction mdListTree(flat, pos, indent) {\n  var items = [];\n  while (pos < flat.length) {\n    if (flat[pos].indent < indent) break;\n    if (flat[pos].indent > indent) {\n      if (!items.length) { items.push(flat[pos]); pos++; continue; }\n      var sub = mdListTree(flat, pos, flat[pos].indent);\n      items[items.length - 1].children = sub.items;\n      pos = sub.pos;\n      continue;\n    }\n    items.push(flat[pos]);\n    pos++;\n  }\n  return { items: items, pos: pos };\n}\nfunction mdRenderList(items, ordered) {\n  var tag = ordered ? 'ol' : 'ul';\n  var s = '<' + tag + '>';\n  for (var k = 0; k < items.length; k++) {\n    s += '<li>' + inlineMd(items[k].text);\n    var kids = items[k].children || [];\n    if (kids.length) s += mdRenderList(kids, !!kids[0].ordered);\n    s += '</li>';\n  }\n  return s + '</' + tag + '>';\n}\nfunction renderMarkdownToHtml(raw) {\n  var src = String(raw == null ? '' : raw).replace(/\\r\\n?/g, '\\n').replace(/\\t/g, '    ');\n  var lines = src.split('\\n');\n  var out = [];\n  var i = 0;\n  while (i < lines.length) {\n    var line = lines[i];\n    if (/^\\s*$/.test(line)) { i++; continue; }\n    var fence = line.match(/^\\s*(`{3,}|~{3,})\\s*[A-Za-z0-9_+-]*\\s*$/);\n    if (fence) {\n      var mark = fence[1].charAt(0), flen = fence[1].length, buf = [];\n      i++;\n      while (i < lines.length) {\n        var cm = lines[i].match(/^\\s*(`{3,}|~{3,})\\s*$/);\n        if (cm && cm[1].charAt(0) === mark && cm[1].length >= flen) { i++; break; }\n        buf.push(lines[i]); i++;\n      }\n      out.push('<pre><code>' + escMd(buf.join('\\n')) + '</code></pre>');\n      continue;\n    }\n    if (/^\\s*(-{3,}|\\*{3,}|_{3,})\\s*$/.test(line)) { out.push('<hr>'); i++; continue; }\n    var h = line.match(/^\\s*(#{1,6})\\s+(.*)$/);\n    if (h) {\n      var lv = Math.min(h[1].length, 6);\n      out.push('<h' + lv + '>' + inlineMd(h[2].replace(/\\s+#+\\s*$/, '')) + '</h' + lv + '>');\n      i++; continue;\n    }\n    if (line.indexOf('|') >= 0 && i + 1 < lines.length &&\n        /^\\s*\\|?\\s*:?-{1,}:?\\s*(\\|\\s*:?-{1,}:?\\s*)*\\|?\\s*$/.test(lines[i + 1])) {\n      var head = splitMdRow(line);\n      var align = splitMdRow(lines[i + 1]).map(mdAlignCell);\n      i += 2;\n      var rows = [];\n      while (i < lines.length && lines[i].indexOf('|') >= 0 && lines[i].trim() !== '') {\n        rows.push(splitMdRow(lines[i])); i++;\n      }\n      var th = '', r0, c1;\n      for (c1 = 0; c1 < head.length; c1++) {\n        th += '<th' + (align[c1] ? ' style=\"text-align:' + align[c1] + '\"' : '') + '>' + inlineMd(head[c1]) + '</th>';\n      }\n      var tb = '';\n      for (r0 = 0; r0 < rows.length; r0++) {\n        tb += '<tr>';\n        for (c1 = 0; c1 < head.length; c1++) {\n          tb += '<td' + (align[c1] ? ' style=\"text-align:' + align[c1] + '\"' : '') + '>' +\n                inlineMd(rows[r0][c1] == null ? '' : rows[r0][c1]) + '</td>';\n        }\n        tb += '</tr>';\n      }\n      out.push('<table><thead><tr>' + th + '</tr></thead><tbody>' + tb + '</tbody></table>');\n      continue;\n    }\n    if (/^\\s*>/.test(line)) {\n      var qb = [];\n      while (i < lines.length && /^\\s*>/.test(lines[i])) {\n        qb.push(lines[i].replace(/^\\s*>\\s?/, '')); i++;\n      }\n      out.push('<blockquote>' + renderMarkdownToHtml(qb.join('\\n')) + '</blockquote>');\n      continue;\n    }\n    if (MD_LIST_RE.test(line)) {\n      var flat = [];\n      while (i < lines.length) {\n        var lm = lines[i].match(MD_LIST_RE);\n        if (lm) {\n          flat.push({ indent: lm[1].length, ordered: /\\d/.test(lm[2]), text: lm[3], children: [] });\n          i++; continue;\n        }\n        if (flat.length && /^\\s{2,}\\S/.test(lines[i])) {\n          flat[flat.length - 1].text += ' ' + lines[i].trim(); i++; continue;\n        }\n        if (/^\\s*$/.test(lines[i])) {\n          var nx = i + 1;\n          if (nx < lines.length && MD_LIST_RE.test(lines[nx])) { i++; continue; }\n          break;\n        }\n        break;\n      }\n      var tree = mdListTree(flat, 0, flat.length ? flat[0].indent : 0);\n      out.push(mdRenderList(tree.items, tree.items.length ? !!tree.items[0].ordered : false));\n      continue;\n    }\n    var para = [];\n    while (i < lines.length && !/^\\s*$/.test(lines[i]) &&\n           !/^\\s*(#{1,6})\\s+/.test(lines[i]) && !/^\\s*>/.test(lines[i]) &&\n           !MD_LIST_RE.test(lines[i]) && lines[i].indexOf('|') < 0) {\n      para.push(lines[i]); i++;\n    }\n    if (!para.length) { para.push(lines[i]); i++; }\n    out.push('<p>' + inlineMd(para.join('\\n')) + '</p>');\n  }\n  return out.join('');\n}\nfunction isMarkdownFile(f) {\n  return !!f && /\\.(md|markdown)$/i.test(String((f && f.name) || ''));\n}\n// v7.18.0: the classes are DERIVED from the persisted flags on every style\n// pass, not stamped on once at import time. Stamping is what let a reload or\n// an undo restore the words while silently dropping the height cap and the\n// scrolling that make a long script usable.\nfunction syncDocCardClasses(tx) {\n  var el = tx && tx.el;\n  if (!el || !el.classList) return;\n  var wantDoc = !!tx.docCard;\n  var wantRen = wantDoc && tx.mdMode === 'rendered';\n  var wantSrc = wantDoc && tx.mdMode === 'source';\n  if (el.classList.contains('doc-card') !== wantDoc) el.classList.toggle('doc-card', wantDoc);\n  if (el.classList.contains('md-rendered') !== wantRen) el.classList.toggle('md-rendered', wantRen);\n  if (el.classList.contains('md-source') !== wantSrc) el.classList.toggle('md-source', wantSrc);\n}\nfunction docCardSetMode(tx, mode) {\n  if (!tx || !tx.el || typeof tx.mdSrc !== 'string' || !tx.mdSrc) return false;\n  tx.mdMode = (mode === 'source') ? 'source' : 'rendered';\n  if (tx.mdMode === 'source') tx.el.textContent = tx.mdSrc;\n  else tx.el.innerHTML = sanitizeTextHtml(renderMarkdownToHtml(tx.mdSrc));\n  syncDocCardClasses(tx);\n  autoGrowTextItem(tx);\n  scheduleAutoSave();\n  return true;\n}\nfunction toggleDocCardSource(id) {\n  var list = state.texts || [];\n  for (var i = 0; i < list.length; i++) {\n    if (list[i] && list[i].id === id) {\n      docCardSetMode(list[i], list[i].mdMode === 'source' ? 'rendered' : 'source');\n      return;\n    }\n  }\n}\n\nfunction addText(x, y, initialText, opts) {\n  pushUndo();\n  const el = document.createElement('div');\n  el.className = 'text-item';\n  el.contentEditable = true;\n  el.spellcheck = false;\n  el.setAttribute('data-placeholder', (typeof I18N !== 'undefined' && I18N.getLang && I18N.getLang() === 'zh') ? '\u8F93\u5165\u6587\u5B57\u2026' : 'Type here...');\n  // Do NOT set textContent if empty \u2014 keeps the element truly empty so :empty::before placeholder works\n  if (initialText) el.textContent = initialText;\n  canvasContent.appendChild(el);\n  const tx = {\n    id: G.nextId++, el,\n    x: x !== undefined ? x : (window.innerWidth/2 - 100 - state.pan.x) / state.zoom,\n    y: y !== undefined ? y : (window.innerHeight/2 - 24 - state.pan.y) / state.zoom,\n    // v6.8.26: text box W/H and font size are WORLD coords, same as\n    // every other item type. The canvas transform scales them on screen \u2014\n    // zooming out shrinks text (Figma/Miro behavior). Old on-screen-px\n    // files are converted at load time in restoreBoard (_textWorld marker).\n    // opts.initW still wins (used by paste/undo paths).\n    w: (opts && opts.initW) ? opts.initW : 320, h: 36, z: G.nextZ++,\n    _autoGrowLocked: true, name: '', note: '', tags: [], textPreset: 'body',\n    font: textTool.font, size: textTool.size || 24,\n    bold: textTool.bold, italic: textTool.italic, underline: textTool.underline, strike: textTool.strike,\n    highlight: textTool.highlight, shadow: textTool.shadow, bg: textTool.bg, outline: textTool.outline,\n    uppercase: textTool.uppercase,\n    color: textTool.color, highlightColor: textTool.highlightColor,\n    align: textTool.align,\n  };\n  state.texts.push(tx);\n  applyTextProps(tx);\n  updateItemStyle(tx);\n  // Auto-grow on input + focus/blur handling (shared with the undo-restore path)\n  attachTextListeners(tx);\n  // Defer focus + selection so DOM is fully settled and handles don't interfere\n  requestAnimationFrame(() => {\n    selectOnly(tx.id);\n    if (!opts || !opts.noFocus) el.focus();\n  });\n  scheduleAutoSave();\n  updateAutoFitPaper();\n  return tx;\n}\nfunction autoGrowTextItem(tx) {\n  // Width is authoritative, regardless of old auto-width flags. Opening alone never measures.\n  growTextHeightToFit(tx);\n}\n// v7.0.26: grow-only height refit for text items. Used after box resizes\n// and font-size changes, where the wrapped content may need MORE vertical\n// room than the box currently has. Never shrinks \u2014 a height the user\n// deliberately dragged taller stays taller.\nfunction growTextHeightToFit(tx) {\n  const el = tx.el;\n  if (!el || !el.isConnected || !tx.w) return;\n  const oldMin = el.style.minWidth;\n  el.style.minWidth = '0';\n  el.style.width = tx.w + 'px';\n  el.style.height = 'auto';\n  // v7.17.0: an imported .md is one card, not two screens of text. The cap\n  // lives here (not only in CSS) so tx.h and the drawn box agree, and so\n  // editing cannot grow the card past it either.\n  const _naturalH = Math.max(32, Math.ceil(el.scrollHeight) + 2);\n  const _capH = el.classList.contains('doc-card') ? DOC_TEXT_MAX_H : Infinity;\n  const nextH = Math.min(_naturalH, _capH);\n  el.style.minWidth = oldMin;\n  tx.h = nextH;\n  updateItemStyle(tx);\n  updateAutoFitPaper();\n  positionBoardTextUI();\n}\n// v7.19.0: ONE sync for the .text-handles sibling (the Move-grip box). This\n// used to be hand-written only in the full style path, so the lightweight\n// move-drag pass early-returned ABOVE it and the grip stayed at the drag-start\n// spot for the whole gesture. The two resize fast paths each carried their own\n// copy of the same writes \u2014 one definition, every path, ends that.\nfunction syncTextHandleBox(item) {\n  const el = item.el;\n  if (!el || !el.classList.contains('text-item')) return;\n  const hCont = el.parentElement ? el.parentElement.querySelector('.text-handles[data-owner=\"' + item.id + '\"]') : null;\n  if (hCont) {\n    hCont.style.left = item.x + 'px';\n    hCont.style.top = item.y + 'px';\n    hCont.style.width = item.w + 'px';\n    hCont.style.height = item.h + 'px';\n    hCont.style.zIndex = item.z || 1;\n  }\n}\nfunction updateItemStyle(item, lightweight) {\n  const el = item.el;\n  // Skip style updates on the container during reframe \u2014 img is manually controlled\n  if (el.classList.contains('reframing')) return;\n  // v6.3.2: during lightweight drag, only update transform/opacity/zIndex.\n  // Width/height don't change during move \u2014 skipping them avoids expensive\n  // reflow cascades (especially on complex video DOM trees).\n  if (lightweight) {\n    const flipS = `${item.flipH ? -1 : 1}, ${item.flipV ? -1 : 1}`;\n    el.style.transform = `translate3d(${item.x}px, ${item.y}px, 0) rotate(${item.rot || 0}deg) scale(${flipS})`;\n    el.style.opacity = item.opacity !== undefined ? item.opacity : 1;\n    el.style.zIndex = item.z || 1;\n    if (item.locked) el.classList.add('locked'); else el.classList.remove('locked');\n    // Keep audio card internals in sync even on lightweight passes used by drag/resize fast paths.\n    if (item.isAudio) _applyAudioItemUiScale(item);\n    // v7.19.0: the Move grip must follow during a MOVE drag too \u2014 this early\n    // return sits above the full path's handle sync, which is exactly why the\n    // grip used to stay at the drag-start spot until mouseup.\n    if (el.classList.contains('text-item')) syncTextHandleBox(item);\n    return;\n  }\n  // v6.8.26: text items now use WORLD coordinates like every other item\n  // type (tx.w/tx.h/tx.size are world px; the canvas transform scales them\n  // on screen). Previously they were stored as on-screen px and divided by\n  // zoom at render time \u2014 but updateCanvas() never re-rendered them on zoom\n  // change, so the stored convention and the rendered result disagreed,\n  // causing handle/textbox mismatch after zooming. World coords make zoom\n  // \"just work\" via the canvas scale, same as images/videos.\n  const isTextItem = el.classList.contains('text-item');\n  // v7.18.0: keep a doc card's classes in step with its persisted flags,\n  // so a reload or an undo cannot quietly turn a scrolling script card\n  // back into an unbounded wall of text.\n  if (isTextItem) syncDocCardClasses(item);\n  const _tz = 1;\n  if (item.w !== undefined) el.style.width = (item.w / _tz) + 'px';\n  // Video/GIF items (.has-media): total height = video height + 54px\n  // (24px info bar + 30px controls bar). Round 68: added info bar height.\n  const isMediaItem = el.classList.contains('has-media');\n  if (item.h !== undefined && !(el.classList.contains('todo-item'))) {\n    el.style.height = ((isMediaItem ? item.h + 54 : item.h) / _tz) + 'px';\n  }\n  // Set .media-wrap height for video/GIF items\n  if (isMediaItem) {\n    const wrap = el.querySelector('.media-wrap');\n    if (wrap) wrap.style.height = (item.h / _tz) + 'px';\n  }\n  // But allow explicit height for todos when resized (h !== initial auto height)\n  if (item.h !== undefined && el.classList.contains('todo-item') && item._resized) el.style.height = item.h + 'px';\n  // Scale todo internal content proportionally with window width\n  if (el.classList.contains('todo-item') && item._resized) {\n    el.style.setProperty('--todo-zoom', Math.max(0.3, Math.min(4, item.w / 220)));\n  }\n  // Audio cards use a custom internal UI; scale controls and typography with item size.\n  if (item.isAudio) _applyAudioItemUiScale(item);\n  // translate3d forces GPU compositing \u2014 critical for smooth drag of many items\n  const flipS = `${item.flipH ? -1 : 1}, ${item.flipV ? -1 : 1}`;\n  el.style.transform = `translate3d(${item.x}px, ${item.y}px, 0) rotate(${item.rot || 0}deg) scale(${flipS})`;\n  el.style.opacity = item.opacity !== undefined ? item.opacity : 1;\n  el.style.zIndex = item.z || 1;\n  if (item.locked) el.classList.add('locked'); else el.classList.remove('locked');\n  // v7.0.49: framing (zoom / pan / rotate) depends on the frame size, so it has\n  // to be re-applied whenever that changes or the crop window drifts out of\n  // step with the frame. This call is also what makes a reframe survive a\n  // reload \u2014 before it, the transform was only ever written by exitReframe, so\n  // every reframe silently vanished the moment you reopened the board.\n  if (!item.isVideo && item.img) applyImageFraming(item);\n  // v7.19.0: text-handles sync is shared with the lightweight drag path via\n  // syncTextHandleBox() above \u2014 one definition, both paths.\n  if (isTextItem) syncTextHandleBox(item);\n  // LIGHTWEIGHT PATH (drag): skip all GPU-expensive work that doesn't depend on position.\n  // Filter strings, CGI overlays, mask layer updates all re-trigger GPU filter/canvas work.\n  // transform/width/height/opacity/zIndex above are all we need for smooth dragging.\n  // (lightweight early-return is now at the top of the function for max perf.)\n  // Sync mind map connectors when item moves\n  if (el.classList.contains('mindmap-item') && item.nodes && item.nodes.length > 0) {\n    requestAnimationFrame(() => mmUpdateConnectors(item));\n  }\n  // CSS filter for images/videos\n  const mediaEl = item.img || item.video;\n  if (mediaEl) {\n    // v7.0.35: one filter table for the screen, the mask compositor, the\n    // screenshot and the export. Shadow lifts/lowers (brightness) and\n    // highlight boosts/suppresses (contrast) \u2014 see shadowFilterString /\n    // highlightFilterString for the shared curves.\n    mediaEl.style.filter = mediaFilterString(item);\n    // Shadow/Highlight overlay\n    updateCgiOverlays(item);\n    // Mask layer overlays \u2014 filter-only update (mask shape unchanged)\n    renderMasks(item, true);\n  }\n}\nfunction applyTextProps(tx) {\n  const el = tx.el;\n  el.style.fontFamily = tx.font;\n  // v6.8.26: tx.size is WORLD px. The canvas transform scales it on\n  // screen, same as images \u2014 zooming out shrinks text, zooming in\n  // enlarges it. No zoom division needed.\n  el.style.fontSize = tx.size + 'px';\n  el.style.fontWeight = tx.bold ? 'bold' : 'normal';\n  el.style.fontStyle = tx.italic ? 'italic' : 'normal';\n  el.style.textDecoration = [tx.underline ? 'underline' : '', tx.strike ? 'line-through' : ''].filter(Boolean).join(' ') || 'none';\n  el.style.color = tx.color;\n  el.style.textAlign = tx.align;\n  el.style.textTransform = tx.uppercase ? 'uppercase' : 'none';\n  let bg = 'transparent';\n  if (tx.highlight) bg = tx.highlightColor;\n  else if (tx.bg) bg = tx.highlightColor + '88';\n  el.style.backgroundColor = bg;\n  let shadow = 'none';\n  if (tx.shadow) shadow = '2px 2px 4px rgba(0,0,0,0.7)';\n  el.style.textShadow = tx.outline ? `-1px -1px 0 #000, 1px -1px 0 #000, -1px 1px 0 #000, 1px 1px 0 #000${tx.shadow ? ', 2px 2px 4px rgba(0,0,0,0.7)' : ''}` : (tx.shadow ? shadow : 'none');\n}\n\n// v7.20.0: ONE definition for \"scale a text card's font along with its box\".\n// baseSize is the font size captured when the corner drag STARTED and scale\n// is w / origW \u2014 deriving from the ORIGINAL every frame means the size can\n// never compound, so dragging out and back lands on the exact start size.\nfunction scaleBoardTextFontSize(tx, baseSize, scale) {\n  if (!tx || typeof baseSize !== 'number' || !isFinite(baseSize)) return;\n  if (!scale || !isFinite(scale) || scale <= 0) return;\n  const next = Math.max(4, Math.min(800, Math.round(baseSize * scale * 10) / 10));\n  if (next === tx.size) return;\n  tx.size = next;\n  if (tx.el) applyTextProps(tx);\n}\n\n// ==== media-player.js ====\n\n// \u2500\u2500 v7.0.34: frame-rate helpers \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// The old detection did Math.round(totalVideoFrames / duration), which\n// cannot represent 23.976 / 29.97 / 59.94 at all \u2014 it maps them onto\n// 24 / 30 / 60. Those are not exotic rates: they are what a film scan, an\n// NTSC broadcast master and most online screeners actually run at. Being\n// 0.1% off sounds harmless, but a frame comment anchored with the wrong\n// rate drifts a full frame every ~10 seconds of a 23.976 clip, so notes\n// written against \"frame 1436\" land somewhere else on replay.\nvar _FPS_STANDARDS = [23.976, 24, 25, 29.97, 30, 47.952, 48, 50, 59.94, 60, 100, 120];\nfunction snapFpsToStandard(raw, frames) {\n  if (!isFinite(raw) || raw <= 0) return 24;\n  var best = raw, bestD = Infinity;\n  for (var i = 0; i < _FPS_STANDARDS.length; i++) {\n    var d = Math.abs(_FPS_STANDARDS[i] - raw) / raw;\n    if (d < bestD) { bestD = d; best = _FPS_STANDARDS[i]; }\n  }\n  // totalVideoFrames / duration is a noisy estimate: the browser counts\n  // dropped and repeated frames, and a 10-second clip is quantised to\n  // ~0.1 fps of resolution. So only trust the snap when the sample can\n  // actually resolve it:\n  //   * within 0.4%              \u2192 unambiguous, always snap\n  //   * within 2% and >= 1000\n  //     frames counted           \u2192 long enough that 23.976 vs 24 (0.1%\n  //                                apart) is a real measurement, not noise\n  // Otherwise hand back the raw estimate; the user can set it on the chip.\n  if (bestD <= 0.004) return best;\n  if (frames && frames >= 1000 && bestD <= 0.02) return best;\n  return Math.round(raw * 1000) / 1000;\n}\n// Chip label: 24 \u2192 \"24\", 23.976 \u2192 \"23.976\", 29.97 \u2192 \"29.97\".\nfunction formatFpsLabel(f) {\n  if (!isFinite(f)) return '\u2014';\n  var r = Math.round(f);\n  if (Math.abs(f - r) < 1e-6) return String(r);\n  return String(Math.round(f * 1000) / 1000);\n}\n// ONE detection implementation. There were FIVE copies of this heuristic\n// scattered through the file \u2014 the fps chip, the loadedmetadata handler,\n// the right-panel label, the frame-step buttons and the arrow-key\n// stepping \u2014 and they had drifted apart: three of them still guessed the\n// rate from the pixel height (h >= 2160 \u2192 60fps), and all five rounded.\n// Fixing only the chip would have left the others reporting 24 for a\n// 23.976 clip, so a comment anchored by the chip would still be stepped\n// somewhere else by the arrow keys. Every path now lands here.\n// Returns a rate clamped to [12,120]; falls back to 24 (film / animation\n// review) when the browser cannot tell us anything.\nfunction detectVideoFps(videoEl) {\n  var detected = 0;\n  try {\n    if (videoEl && typeof videoEl.getVideoPlaybackQuality === 'function') {\n      var q = videoEl.getVideoPlaybackQuality();\n      if (q && q.totalVideoFrames > 0 && videoEl.duration > 0) {\n        detected = snapFpsToStandard(q.totalVideoFrames / videoEl.duration,\n                                     q.totalVideoFrames);\n      }\n    }\n  } catch (e) {}\n  if (!detected || detected <= 0 || detected > 120) detected = 24;\n  return Math.max(12, Math.min(120, detected));\n}\n\n// ============================================================\n//  VIDEO ANNOTATION STROKES   (v7.0.35: one painter)\n// ============================================================\n// This loop used to exist SIX times: the live annotation canvas, the comment\n// thumbnail, the comment snapshot, the .webm bake, the frame-comment zip\n// export and the lightbox. They disagreed on line width (size / size*unit /\n// size*unit*1.3), on arrow-head length (2.5x / 3.2x, floors 2/4/6/8/10) and\n// on text size (3x / 4x / 4.5x / 5x), so the same annotation was a different\n// shape in every surface. Six copies also meant a fix had to be applied six\n// times \u2014 which is exactly why they drifted.\n//\n// Every surface now calls paintAnnoStroke() and only picks its own scale:\n//   opts.box    [cw, ch]  the rect normalised [0,1] points map onto\n//   opts.unit   pixels per 1 unit of stk.size (the surface's legibility scale)\n//   opts.zoom   extra multiplier for the live video zoom (default 1)\n//   opts.weight boldness multiplier (default 1)\n//   opts.minW   line-width floor      (default 1)\n//   opts.minHead arrow-head floor     (default 2)\n//   opts.minFont text-size floor      (default 5)\nfunction paintAnnoStroke(ctx, stk, opts) {\n  if (!stk || !stk.points || stk.points.length === 0) return;\n  const o = opts || {};\n  const cw = (o.box && o.box[0]) || 0;\n  const ch = (o.box && o.box[1]) || 0;\n  if (!(cw > 0) || !(ch > 0)) return;\n  const zoom = o.zoom === undefined ? 1 : o.zoom;\n  const k = (o.unit === undefined ? 1 : o.unit) * zoom * (o.weight === undefined ? 1 : o.weight);\n\n  const color = stk.color || '#ff4444';\n  ctx.strokeStyle = color;\n  ctx.fillStyle = color;\n  ctx.lineWidth = Math.max(o.minW === undefined ? 1 : o.minW, (stk.size || 4) * k);\n  ctx.lineCap = 'round';\n  ctx.lineJoin = 'round';\n  const pts = stk.points.map(p => [p[0] * cw, p[1] * ch]);\n\n  if (stk.type === 'pen') {\n    if (pts.length < 2) return;\n    ctx.beginPath();\n    pts.forEach((p, i) => i === 0 ? ctx.moveTo(p[0], p[1]) : ctx.lineTo(p[0], p[1]));\n    ctx.stroke();\n  } else if (stk.type === 'arrow') {\n    if (pts.length < 2) return;\n    const [x0, y0] = pts[0];\n    const [x1, y1] = pts[pts.length - 1];\n    ctx.beginPath();\n    ctx.moveTo(x0, y0);\n    ctx.lineTo(x1, y1);\n    ctx.stroke();\n    const angle = Math.atan2(y1 - y0, x1 - x0);\n    // v7.0.15: the head follows the video zoom too, otherwise zoomed-out\n    // arrows look bloated (huge head, thin shaft) and zoomed-in ones\n    // pin-headed. z=1 behaviour is unchanged.\n    const headLen = Math.max(o.minHead === undefined ? 2 : o.minHead,\n                             Math.max(10, (stk.size || 4) * 3.2) * k);\n    ctx.beginPath();\n    ctx.moveTo(x1, y1);\n    ctx.lineTo(x1 - headLen * Math.cos(angle - Math.PI / 6), y1 - headLen * Math.sin(angle - Math.PI / 6));\n    ctx.lineTo(x1 - headLen * Math.cos(angle + Math.PI / 6), y1 - headLen * Math.sin(angle + Math.PI / 6));\n    ctx.closePath();\n    ctx.fill();\n  } else if (stk.type === 'box') {\n    // Rectangle from start -> end, the same way the global drawing tool does.\n    if (pts.length < 2) return;\n    const [x0, y0] = pts[0];\n    const [x1, y1] = pts[pts.length - 1];\n    ctx.beginPath();\n    ctx.strokeRect(Math.min(x0, x1), Math.min(y0, y1), Math.abs(x1 - x0), Math.abs(y1 - y0));\n  } else if (stk.type === 'circle') {\n    // Ellipse fitted to the bounding box of the two pointer positions. Both\n    // radii are floored at 0.5 so a single click can't produce a zero radius.\n    if (pts.length < 2) return;\n    const [x0, y0] = pts[0];\n    const [x1, y1] = pts[pts.length - 1];\n    ctx.beginPath();\n    ctx.ellipse((x0 + x1) / 2, (y0 + y1) / 2,\n                Math.max(0.5, Math.abs(x1 - x0) / 2), Math.max(0.5, Math.abs(y1 - y0) / 2),\n                0, 0, Math.PI * 2);\n    ctx.stroke();\n  } else if (stk.type === 'text') {\n    // The stroke stores one normalised [x, y] point plus a `text` string.\n    // Rendered with a translucent black pill so it stays readable on light\n    // AND dark frames. Font size, padding and corner radius all follow the\n    // same scale as the line width, so a note keeps its proportions on any\n    // surface and at any video zoom (v7.0.15).\n    const [x, y] = pts[0];\n    const text = (stk.text || '').trim();\n    if (!text) return;\n    const fontSize = Math.max(o.minFont === undefined ? 5 : o.minFont,\n                              Math.max(14, (stk.size || 4) * 5) * k);\n    ctx.font = '600 ' + fontSize + 'px -apple-system, \"SF Pro Display\", system-ui, sans-serif';\n    ctx.textBaseline = 'top';\n    const metrics = ctx.measureText(text);\n    const padX = 6 * k, padY = 4 * k;\n    const bgW = metrics.width + padX * 2;\n    const bgH = fontSize * 1.15 + padY * 2;\n    const radius = Math.min(5 * k, Math.min(bgW, bgH) / 2);\n    ctx.save();\n    ctx.fillStyle = 'rgba(0, 0, 0, 0.55)';\n    ctx.beginPath();\n    ctx.moveTo(x + radius, y);\n    ctx.lineTo(x + bgW - radius, y);\n    ctx.quadraticCurveTo(x + bgW, y, x + bgW, y + radius);\n    ctx.lineTo(x + bgW, y + bgH - radius);\n    ctx.quadraticCurveTo(x + bgW, y + bgH, x + bgW - radius, y + bgH);\n    ctx.lineTo(x + radius, y + bgH);\n    ctx.quadraticCurveTo(x, y + bgH, x, y + bgH - radius);\n    ctx.lineTo(x, y + radius);\n    ctx.quadraticCurveTo(x, y, x + radius, y);\n    ctx.closePath();\n    ctx.fill();\n    ctx.restore();\n    ctx.fillStyle = stk.color || '#fff';\n    ctx.fillText(text, x + padX, y + padY);\n  }\n}\n\n// v7.0.37 \u2014 P2. One builder for every board <video>. Three call sites used to\n// hand-roll the element (addImage, undo/redo restore, kpak restore) and they\n// had drifted three ways: preload 'auto' vs 'metadata' vs 'none', and only\n// addImage attached the codec error listener. The visible consequence: a\n// ProRes / DNxHR clip restored from a .kpak failed to decode and sat there as\n// a BLACK FRAME with no explanation, while the very same file dropped onto\n// the board said \"Unsupported codec \u2014 use H.264 MP4\". Same file, two\n// behaviours, and the silent one is the one that wastes the user's time.\n// opts: { preload: 'auto' | 'metadata' | 'none' (default 'metadata'),\n//         onError: false to skip the codec listener }\n// v7.23.0: map a screen point back into an element's OWN local coordinate\n// space. getBoundingClientRect() hands back the AXIS-ALIGNED bounding box of\n// the transformed element, so for a card that is rotated or flipped its\n// left/top are not the element's origin and its width/height are not the\n// element's size. Anybody doing `(clientX - rect.left) / rect.width` on such a\n// card gets a skewed, scaled \u2014 and, for a flip, mirrored \u2014 answer. That is\n// exactly how a stroke drawn on a rotated video card landed somewhere other\n// than under the pen.\n//\n// Instead of re-deriving the CSS transform chain (and then having to keep that\n// derivation in step with every transform added later), let the browser do the\n// maths: three zero-size probes pinned at known local offsets give the exact\n// local->screen affine basis, and inverting that basis is a 2x2 solve. Correct\n// under rotation, mirroring, board zoom and any nesting, with no knowledge of\n// what the transforms actually are.\n//\n// `el` must be the probes' containing block (i.e. position: relative or\n// absolute) \u2014 .media-wrap is, see the stylesheet. One definition; the\n// annotation canvas is the only caller so far.\nvar KRAFTED_PROBE_BASIS = 16;\nfunction kraftedLocalBasis(el) {\n  if (!el) return null;\n  var m = el._kraftedProbes;\n  if (!m) {\n    m = [];\n    var offs = [[0, 0], [KRAFTED_PROBE_BASIS, 0], [0, KRAFTED_PROBE_BASIS]];\n    for (var i = 0; i < 3; i++) {\n      var d = document.createElement('div');\n      d.className = 'krafted-local-probe';\n      d.setAttribute('aria-hidden', 'true');\n      d.style.cssText = 'position:absolute;width:0;height:0;pointer-events:none;left:' +\n                        offs[i][0] + 'px;top:' + offs[i][1] + 'px;';\n      el.appendChild(d);\n      m.push(d);\n    }\n    el._kraftedProbes = m;\n  }\n  var o = m[0].getBoundingClientRect();\n  var px = m[1].getBoundingClientRect();\n  var py = m[2].getBoundingClientRect();\n  return {\n    ox: o.left, oy: o.top,\n    ax: (px.left - o.left) / KRAFTED_PROBE_BASIS,\n    ay: (px.top - o.top) / KRAFTED_PROBE_BASIS,\n    bx: (py.left - o.left) / KRAFTED_PROBE_BASIS,\n    by: (py.top - o.top) / KRAFTED_PROBE_BASIS\n  };\n}\n// [localX, localY] in el's padding-box CSS px, or null when el has no layout\n// (display:none gives every probe a zero rect, so the basis is not invertible).\nfunction kraftedClientToLocal(el, clientX, clientY, basis) {\n  var b = basis || kraftedLocalBasis(el);\n  if (!b) return null;\n  var det = b.ax * b.by - b.bx * b.ay;\n  if (!det || !isFinite(det)) return null;\n  var dx = clientX - b.ox, dy = clientY - b.oy;\n  return [(dx * b.by - b.bx * dy) / det, (b.ax * dy - dx * b.ay) / det];\n}\nfunction makeVideoElement(src, opts) {\n  const o = opts || {};\n  const v = document.createElement('video');\n  v.src = src || '';\n  v.playsInline = true;\n  v.loop = true;\n  v.muted = true;\n  v.preload = o.preload || 'metadata';\n  if (o.onError !== false) {\n    v.addEventListener('error', function () {\n      // A lazy video