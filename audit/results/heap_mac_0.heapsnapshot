m trackpad *magnitude* alone. Signal #5 below (exact repeat)\n    //    is what actually separates them, so this branch only fires when\n    //    there's an accompanying finger tell (sideways drift or a\n    //    fractional value).\n    // v7.10.0: the +2 used to fire on magnitude alone. A fast two-finger\n    // flick ramps past NOTCH_FLOOR too, and because its events also arrive\n    // back to back it was scoring mouse-positive in the middle of a pan \u2014\n    // exactly the regression v6.8.21 was written to prevent. A mechanical\n    // detent cannot repeat inside 30ms; a flick always does. Gating the\n    // credit on the gap keeps the flick negative without touching real\n    // notches, and a genuine wheel that does stream that fast still gets\n    // there on signal 5 (exact repeat) below.\n    if (ady >= NOTCH_FLOOR && gap > 30) score += 2;\n    else if (ady > 0 && ady <= FINGER_CEIL && (adx > 0.5 || !Number.isInteger(e.deltaY))) score -= 2;\n\n    // 2. Horizontal component. Real wheels don't drift sideways.\n    //    (A tilt-wheel gives a pure horizontal event with deltaY === 0,\n    //    which we deliberately do NOT penalise.)\n    if (adx > 0.5 && ady > 0.5) score -= 2;\n\n    // 3. Quantisation. Wheel deltas are whole numbers; trackpad\n    //    momentum produces fractions.\n    //    v6.8.5: dropped the >= NOTCH_FLOOR gate on the positive branch \u2014\n    //    small-delta mice report exact integers too and deserve credit.\n    if (ady > 0 && Number.isInteger(e.deltaY)) score += 1;\n    if (ady > 0 && !Number.isInteger(e.deltaY)) score -= 1;\n\n    // 4. Cadence. Streaming at frame rate = fingers; sparse = notches.\n    if (gap < 30) score -= 1;\n    else if (gap > 120) score += 1;\n\n    // 5. Consistency. A mouse repeats the EXACT same magnitude every\n    //    notch \u2014 no matter how small that magnitude is \u2014 because it's\n    //    a fixed mechanical detent. Trackpad momentum is a continuous\n    //    decay curve that essentially never produces the same value\n    //    twice in a row.\n    //    v6.8.5: dropped the >= NOTCH_FLOOR requirement here too \u2014 this\n    //    was the main reason low-delta mice never reached a 'mouse'\n    //    verdict. An exact repeat is an exact repeat regardless of size;\n    //    signals #1-3 above already reject genuine finger noise.\n    // v7.10.0: was `recent.length >= 3`, which delayed the lock by a whole\n    // notch. Two is enough: a flick never repeats a magnitude, so the +3\n    // still cannot carry it, and a real wheel locks one notch sooner.\n    if (recent.length >= 2) {\n      const uniq = new Set(recent.map(v => Math.round(v)));\n      if (uniq.size === 1 && recent[0] > 0) score += 3;\n      else if (uniq.size >= recent.length - 1) score -= 1;\n    }\n\n    // Fold the score into the running verdict rather than replacing it,\n    // so oneambiguous event can't flip an established decision.\n    if (score > 0) {\n      if (verdict === 'mouse') confidence = Math.min(1, confidence + 0.34);\n      else { verdict = 'mouse'; confidence = 0.34; }\n    } else if (score < 0) {\n      if (verdict === 'trackpad') confidence = Math.min(1, confidence + 0.34);\n      else { verdict = 'trackpad'; confidence = 0.34; }\n    }\n    return verdict;\n  }\n\n  return {\n    classify: classify,\n    // True only when we actively believe a physical wheel is in use.\n    // 'unknown' deliberately returns false so the historical trackpad\n    // behaviour remains the default until proven otherwise.\n    // state.wheelMode ('auto' | 'mouse' | 'trackpad') overrides the\n    // heuristic entirely when the user has pinned it.\n    get isMouse() {\n      const m = (window.state && window.state.wheelMode) || 'auto';\n      if (m === 'mouse') return true;\n      if (m === 'trackpad') return false;\n      // v7.10.0: a pinned mode is authoritative. The heuristic has to\n      // reach MOUSE_LOCK first, so one ambiguous event cannot turn a\n      // two-finger pan into a