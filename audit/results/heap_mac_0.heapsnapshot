|| null, img: n.img || null, imgW: n.imgW || 0, imgH: n.imgH || 0, audio: n.audio || null, audioName: n.audioName || null })), connections: (m.connections||[]).map(c => ({ id: c.id, from: c.from, to: c.to, color: c.color })), nextNodeId: m.nextNodeId || 1, nextConnId: m.nextConnId || 1 })),\n    drawStrokes: G.drawStrokes,\n    groups: state.groups.map(serializeGroup),\n    // v7.0.40: named views persist in .kpak, so the running order survives\n    // the meeting \u2014 whoever opens the board later sees the same tape.\n    views: (state.views || []).map(serializeView),\n    nextViewId: G.nextViewId,\n    nextGroupId: G.nextGroupId,\n    nextId: G.nextId, nextZ: G.nextZ, nextStrokeId: G.nextStrokeId,\n    pan: state.pan, zoom: state.zoom,\n    relations: (state.relations || []).map(function(r) { return { id: r.id, fromId: r.fromId, toId: r.toId, fromAnchor: r.fromAnchor, toAnchor: r.toAnchor, label: r.label || '', style: r.style || 'orthogonal', color: r.color || '#00e5ff', lineWidth: r.lineWidth || 6, labelSize: r.labelSize || 16 }; }),\n    paper: { enabled: paperState.enabled, autoFit: paperState.autoFit, width: paperState.width, height: paperState.height, color: paperState.color },\n    canvasBg: getComputedStyle(document.documentElement).getPropertyValue('--canvas-bg').trim(),\n  };\n}\n\n// Figure out the filename extension from a blob's MIME type\nfunction mimeToExt(mime, fallback) {\n  if (!mime) return fallback || 'bin';\n  if (mime.includes('video/mp4')) return 'mp4';\n  if (mime.includes('video/webm')) return 'webm';\n  if (mime.includes('video/ogg')) return 'ogv';\n  if (mime.includes('video/quicktime')) return 'mov';\n  if (mime.includes('video/')) return 'mp4';\n  if (mime.includes('image/png')) return 'png';\n  if (mime.includes('image/gif')) return 'gif';\n  if (mime.includes('image/webp')) return 'webp';\n  if (mime.includes('image/jpeg')) return 'jpg';\n  if (mime.includes('image/svg')) return 'svg';\n  if (mime.includes('image/')) return 'png';\n  if (mime.includes('audio/wav')) return 'wav';\n  if (mime.includes('audio/mpeg')) return 'mp3';\n  if (mime.includes('audio/ogg')) return 'ogg';\n  if (mime.includes('audio/')) return 'mp3';\n  return fallback || 'bin';\n}\n\n// v7.0.27: UI-language helper for save/load progress strings\nfunction _isZhUI() { return (typeof I18N !== 'undefined' && I18N.getLang && I18N.getLang() === 'zh'); }\n// v7.0.27: human ETA / duration strings, language-aware\nfunction _fmtEtaSec(sec) {\n  if (!isFinite(sec) || sec < 0) return '';\n  const zh = _isZhUI();\n  if (sec < 60) return zh ? ('\u5269\u7EA6 ' + Math.ceil(sec) + ' \u79D2') : ('~' + Math.ceil(sec) + 's left');\n  const m = Math.floor(sec / 60), s = Math.round(sec % 60);\n  return zh ? ('\u5269\u7EA6 ' + m + ' \u5206 ' + s + ' \u79D2') : ('~' + m + 'm ' + s + 's left');\n}\nfunction _fmtDurSec(sec) {\n  const zh = _isZhUI();\n  if (sec < 60) return zh ? (Math.max(1, Math.round(sec)) + ' \u79D2') : (Math.max(1, Math.round(sec)) + 's');\n  const m = Math.floor(sec / 60), s = Math.round(sec % 60);\n  return zh ? (m + ' \u5206 ' + s + ' \u79D2') : (m + 'm ' + s + 's');\n}\n// v7.0.27: determinate progress UI \u2014 bar + % + bytes written + rolling-rate ETA.\n// Replaces the text-only .save-progress div. update(text, {doneBytes,\n// totalBytes, doneItems, totalItems, extra}); pass text=null to keep the label.\nfunction makeProgressUI(opts) {\n  opts = opts || {};\n  const el = document.createElement('div');\n  el.className = 'save-progress';\n  el.innerHTML = '<div class=\"pct\"></div><div class=\"bar\"><i></i></div><div class=\"sub\"></div>'\n    + (opts.onCancel\n        ? '<div class=\"pg-cancel\"><button type=\"button\">'\n          + (opts.cancelLabel || 'Cancel') + '</button></div>'\n        : '');\n  document.body.appendChild(el);\n  const pctEl = el.querySelector('.pct');\n  const barEl = el.querySelector('.bar > i');\n  const subEl = el.querySelector('.sub');\n  const t0 = performance.now();\n  // v7.9.0: opt-in, so every existing caller keeps the card it had. Cancelling\n  // only SETS THE FLAG \u2014 the loop owns stopping, because a half-written file\n  // is worse than a finished one.\n  let _cancelled = false;\n  if (opts.onCancel) {\n    const cBtn = el.querySelector('.pg-cancel > button');\n    if (cBtn) cBtn.addEventListener('click', function () {\n      _cancelled = true;\n      cBtn.disabled = true;\n      cBtn.textContent = opts.cancellingLabel || 'Cancelling\u2026';\n      try { opts.onCancel(); } catch (e) { console.error(e); }\n    });\n  }\n  const samples = [];\n  let lastBarT = 0;\n  return {\n    el: el,\n    update: function(text, o) {\n      o = o || {};\n      if (text != null) pctEl.textContent = text;\n      let pct = -1;\n      if (o.totalBytes > 0 && o.doneBytes != null) pct = Math.min(99, o.doneBytes / o.totalBytes * 100);\n      else if (o.totalItems > 0 && o.doneItems != null) pct = Math.min(99, o.doneItems / o.totalItems * 100);\n      const nowT = performance.now();\n      if (pct >= 0 && (nowT - lastBarT > 100)) { barEl.style.width = pct.toFixed(1) + '%'; lastBarT = nowT; }\n      let sub = '';\n      if (o.doneBytes != null) {\n        sub = formatBytes(o.doneBytes) + (o.totalBytes > 0 ? ' / ~' + formatBytes(o.totalBytes) : '');\n        samples.push({ t: nowT, b: o.doneBytes });\n        while (samples.length > 2 && nowT - samples[0].t > 4000) samples.shift();\n        if (o.totalBytes > 0 && o.doneBytes < o.totalBytes) {\n          if (samples.length >= 2) {\n            const dt = (nowT - samples[0].t) / 1000;\n            const rate = dt > 0.2 ? (o.doneBytes - samples[0].b) / dt : 0;\n            if (rate > 1024) { const eta = _fmtEtaSec((o.totalBytes - o.doneBytes) / rate); if (eta) sub += ' \u00B7 ' + eta; }\n            else sub += ' \u00B7 ' + (_isZhUI() ? '\u4F30\u7B97\u4E2D\u2026' : 'estimating\u2026');\n          } else if (o.doneBytes > 0) {\n            sub += ' \u00B7 ' + (_isZhUI() ? '\u4F30\u7B97\u4E2D\u2026' : 'estimating\u2026');\n          }\n        }\n      }\n      if (o.extra) sub = sub ? sub + ' \u00B7 ' + o.extra : o.extra;\n      subEl.textContent = sub;\n    },\n    elapsedSec: function() { return (performance.now() - t0) / 1000; },\n    cancelled: function() { return _cancelled; },\n    done: function() { try { el.remove(); } catch (e) {} }\n  };\n}\n\n// Build the .kpak zip file (manifest.json + all media blobs as raw files)\n// v6.3.0: Streaming kpak builder \u2014 writes directly to a WritableStream.\n// Replaces buildKpakBlob which held the entire zip in memory via JSZip.\nasync function buildKpakStream(writableStream, progressCallback, lockPassword) {\n  console.log('[KPACK] buildKpakStream starting...');\n\n  const zip = new StreamingZipWriter(writableStream);\n\n  // 1. Build manifest (embed lock metadata if password provided)\n  const manifest = buildManifest();\n  // v6.5.0: Lock support removed\n  await zip.addText('manifest.json', JSON.stringify(manifest));\n\n  // 2. Walk items and stream media blobs one at a time\n  let packed = 0, skipped = 0, idx = 0;\n  const blobItems = state.items.filter(it => it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')));\n  console.log('[KPACK] found', blobItems.length, 'blob items to stream');\n\n  for (const it of blobItems) {\n    idx++;\n    const label = it.isVideo ? 'Video' : it.isAudio ? 'Audio' : 'Image';\n    if (progressCallback) progressCallback('Packing ' + label + ' ' + idx + '/' + blobItems.length + '...');\n    try {\n      const resp = await fetch(it.src);\n      if (!resp.ok) { console.warn('[KPACK] fetch failed for', it.id, 'status:', resp.status); skipped++; continue; }\n      const blob = await resp.blob();\n      const ext = mimeToExt(blob.type, it.isVideo ? 'mp4' : it.isAudio ? 'mp3' : 'png');\n      const zipPath = 'media/' + it.id + '.' + ext;\n      await zip.addBlob(zipPath, blob);\n      packed++;\n      if (idx % 3 === 0) await new Promise(r => setTimeout(r, 0));\n    } catch (e) {\n      console.warn('[KPACK] failed to pack media for item', it.id, e.message);\n      skipped++;\n    }\n  }\n\n  if (progressCallback) progressCallback('Finalizing zip...');\n  console.log('[KPACK] finalizing streaming zip with', packed, 'files...');\n  await zip.finalize();\n  console.log('[KPACK] streaming zip finalized:', packed, 'packed,', skipped, 'skipped');\n  return { manifest, packed, skipped };\n}\n\n// Legacy fallback: build kpak as a blob via JSZip (used when File System Access API is unavailable).\n// Kept for non-Chrome browsers. For large projects, streaming via buildKpakStream is preferred.\nasync function buildKpakBlob(progressCallback) {\n  console.log('[KPACK] buildKpakBlob starting (JSZip fallback)...');\n  if (typeof JSZip === 'undefined') throw new Error('JSZip not loaded - refresh the page');\n  \n  const zip = new JSZip();\n  const manifest = buildManifest();\n  zip.file('manifest.json', JSON.stringify(manifest));\n\n  let packed = 0, skipped = 0, idx = 0;\n  const blobItems = state.items.filter(it => it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')));\n  console.log('[KPACK] found', blobItems.length, 'blob items to pack');\n  \n  for (const it of blobItems) {\n    idx++;\n    const label = it.isVideo ? 'Video' : it.isAudio ? 'Audio' : 'Image';\n    if (progressCallback) progressCallback('Packing ' + label + ' ' + idx + '/' + blobItems.length + '...');\n    try {\n      const resp = await fetch(it.src);\n      if (!resp.ok) { console.warn('[KPACK] fetch failed for', it.id, 'status:', resp.status); skipped++; continue; }\n      const blob = await resp.blob();\n      const ext = mimeToExt(blob.type, it.isVideo ? 'mp4' : it.isAudio ? 'mp3' : 'png');\n      const zipPath = 'media/' + it.id + '.' + ext;\n      zip.file(zipPath, blob, { binary: true });\n      packed++;\n      if (idx % 3 === 0) await new Promise(r => setTimeout(r, 0));\n    } catch (e) {\n      console.warn('[KPACK] failed to pack media for item', it.id, e.message);\n      skipped++;\n    }\n  }\n\n  if (progressCallback) progressCallback('Generating zip...');\n  console.log('[KPACK] generating zip with', packed, 'files...');\n  const zipBlob = await zip.generateAsync({ type: 'blob', compression: 'STORE' }, function(meta) {\n    if (progressCallback && meta.percent) {\n      progressCallback('Zipping ' + meta.percent.toFixed(0) + '%');\n    }\n  });\n  console.log('[KPACK] zip generated, size:', zipBlob.size);\n  return { zipBlob, manifest, packed, skipped };\n}\n\n// Fallback download helper \u2014 used when File System Access API is unavailable\nfunction downloadBlob(blob, suggestedName) {\n  return new Promise((resolve, reject) => {\n    try {\n      const url = URL.createObjectURL(blob);\n      const link = document.createElement('a');\n      link.download = suggestedName;\n      link.href = url;\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      // v7.0.45: same race as the main save path. Revoking the URL on a fixed\n      // 5 s timer cuts the legs out from under any download the browser has\n      // not finished draining, which truncates the file. Hold it until the\n      // next save instead of guessing at a timeout.\n      _releaseLastSaveObjectUrl();\n      _lastSaveObjectUrl = url;\n      resolve(true);\n    } catch (e) { reject(e); }\n  });\n}\n\n// Save with native \"Save As\" dialog (File System Access API) \u2014 fallback to regular download\nasync function saveBlobWithPicker(blob, suggestedName, mimeType, extension) {\n  console.log('[SAVE-PICKER] blob size:', blob.size, 'type:', blob.type, 'name:', suggestedName);\n  console.log('[SAVE-PICKER] showSaveFilePicker available:', !!window.showSaveFilePicker);\n  \n  if (window.showSaveFilePicker) {\n    console.log('[SAVE-PICKER] attempting showSaveFilePicker...');\n    try {\n      const handle = await window.showSaveFilePicker({\n        suggestedName,\n        types: [{\n          description: extension === '.kpak' ? 'Krafted Package' : 'JSON File',\n          accept: { [mimeType]: [extension] }\n        }]\n      });\n      console.log('[SAVE-PICKER] handle obtained:', handle.name);\n      const writable = await handle.createWritable();\n      await writable.write(blob);\n      await writable.close();\n      console.log('[SAVE-PICKER] write complete');\n      return { ok: true, path: handle.name };\n    } catch (e) {\n      console.error('[SAVE-PICKER] showSaveFilePicker error:', e.name, e.message);\n      if (e.name === 'AbortError') { return { ok: false, cancelled: true }; }\n      // Other errors (e.g. permission denied, transient activation expired) \u2014 fall through to link download\n      console.warn('[SAVE-PICKER] falling back to link download');\n    }\n  }\n  // Fallback: regular download to default Downloads folder\n  console.log('[SAVE-PICKER] using fallback link download');\n  try {\n    await downloadBlob(blob, suggestedName);\n    console.log('[SAVE-PICKER] fallback download triggered');\n    return { ok: true, path: null, fallback: true };\n  } catch (e2) {\n    console.error('[SAVE-PICKER] fallback also failed:', e2);\n    return { ok: false, cancelled: false, error: e2.message };\n  }\n}\n\n// --- REQUEST file handle BEFORE building kpak (must happen while transient user activation is fresh) ---\nasync function requestSaveHandle(suggestedName, mimeType, extension) {\n  if (!window.showSaveFilePicker) return { handle: null, name: null };\n  try {\n    const handle = await window.showSaveFilePicker({\n      suggestedName,\n      types: [{\n        description: extension === '.kpak' ? 'Krafted Package' : 'JSON File',\n        accept: { [mimeType]: [extension] }\n      }]\n    });\n    return { handle, name: handle.name };\n  } catch (e) {\n    if (e.name === 'AbortError') return { handle: null, name: null, cancelled: true };\n    console.warn('[SAVE] showSaveFilePicker failed (' + e.name + '), will use download fallback');\n    return { handle: null, name: null };\n  }\n}\n\n// ============================================================\n// v6.5.0: Custom KPAK container format\n// ============================================================\n// Single-file, internally chunked. Save is streaming (append-only).\n// Load uses Blob.slice() for random access \u2014 NO JSZip, NO OOM.\n//\n// Format:\n//   [Data Blocks...] [Index] [Footer: \"KPAK\" + 8B index_offset]\n//\n// Each data block: [4B LE size][N bytes raw data]\n// Index: [4B entry_count][for each: 2B name_len + name + 8B offset + 8B size + 1B type]\n// Footer: \"KPAK\" (4B magic) + 8B LE index_offset\n// ============================================================\n\n// Write helpers for streaming\nfunction _kpakWriteU32(w, v) {\n  const b = new Uint8Array(4);\n  new DataView(b.buffer).setUint32(0, v, true); // LE\n  return w.write(b);\n}\nfunction _kpakWriteU64(w, v) {\n  const b = new Uint8Array(8);\n  new DataView(b.buffer).setBigUint64(0, BigInt(v), true); // LE\n  return w.write(b);\n}\nfunction _kpakWriteStr(w, s) {\n  const enc = new TextEncoder().encode(s);\n  const lenB = new Uint8Array(2);\n  new DataView(lenB.buffer).setUint16(0, enc.length, true); // LE\n  return w.write(lenB).then(() => w.write(enc));\n}\n\n// v6.5.0: Build kpak blob \u2014 writes manifest + all media as raw entries\n// Uses the custom container format. Two modes:\n//   1) With FileSystemWritableFileStream (Chrome/Edge): stream each entry directly to disk\n//   2) Fallback: build Blob from array of ArrayBuffers (1 entry in memory at a time)\nasync function buildKpakV6(progressCallback, writableStream, estTotalBytes) {\n  console.log('[KPAKv6] buildKpakV6 starting...', writableStream ? 'STREAMING' : 'BLOB');\n  const useStreaming = !!writableStream;\n\n  const manifest = buildManifest();\n  const manifestJson = JSON.stringify(manifest);\n  const manifestBytes = new TextEncoder().encode(manifestJson);\n\n  const blobItems = state.items.filter(it =>\n    (it._sourceBlob instanceof Blob && it._sourceBlob.size > 0) ||\n    (it._lazyZip && it._lazyEntry) ||\n    // v7.0.2: never-activated v6 KPAK lazy videos (_kpakEntry/_kpakBlob set,\n    // src still '') were previously excluded here entirely \u2014 they vanished\n    // from the save with ZERO warning because they never even entered the\n    // failedItems/expectedMediaCount accounting. Must be included so they\n    // get resolved into a real Blob below instead of silently dropped.\n    (it._kpakEntry && it._kpakBlob) ||\n    (it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')))\n  );\n  console.log('[KPAKv6] items to pack:', blobItems.length);\n\n  // v6.8.28: remember original media item count so we can warn if any vanish.\n  const expectedMediaCount = blobItems.length;\n\n  // Build entries list with metadata only \u2014 bytes are fetched on demand\n  const entryMetas = [];\n  entryMetas.push({ name: 'manifest.json', size: manifestBytes.length, type: 0, bytes: manifestBytes, isManifest: true });\n  for (const it of blobItems) {\n    entryMetas.push({\n      name: 'media/' + it.id + (it.isVideo ? '.mp4' : it.isAudio ? '.mp3' : '.png'),\n      size: it._fileSize || (it.isVideo ? 80 * 1024 * 1024 : 5 * 1024 * 1024),\n      type: it.isVideo ? 1 : it.isAudio ? 2 : 3,\n      src: it.src,\n      // v6.8.29/30: media items may retain a stable source Blob. Prefer it\n      // over fetch(src), which can throw Chrome ERR_UPLOAD_FILE_CHANGED for\n      // screenshot clipboard URLs and URLs recreated from a loaded KPAK.\n      sourceBlob: (it._sourceBlob instanceof Blob) ? it._sourceBlob : null,\n      // Legacy JSZip loads keep large videos lazy. Resolve that entry only\n      // when saving, then retain the Blob so the next save is direct too.\n      lazyZip: it._lazyZip || null,\n      lazyEntry: it._lazyEntry || null,\n      // v7.0.2: v6 KPAK never-activated lazy videos. Resolve on save from\n      // the ORIGINAL loaded File + entry offset/size (still valid at this\n      // point, before any save/overwrite has touched the destination path).\n      kpakEntry: it._kpakEntry || null,\n      kpakBlob: it._kpakBlob || null,\n      item: it,\n      itemId: it.id\n    });\n  }\n\n  if (progressCallback) progressCallback('Writing ' + entryMetas.length + ' entries...');\n\n  const entries = [];\n  const failedItems = [];\n  let currentOffset = 0;\n  const blobParts = [];\n  // v7.0.27: byte-accurate progress. estTotalBytes comes from saveBoardV6's\n  // upfront estimate; as each entry resolves its REAL size we fold it in, so\n  // the bar self-corrects instead of jumping when the estimate was off.\n  let doneBytes = 0;\n  let knownTotal = Math.max(0, estTotalBytes || 0);\n\n  for (let i = 0; i < entryMetas.length; i++) {\n    const m = entryMetas[i];\n    if (progressCallback) progressCallback('Pack ' + (i + 1) + '/' + entryMetas.length + ' (' + formatBytes(m.size) + ')...', { doneBytes: doneBytes, totalBytes: Math.max(knownTotal, doneBytes), doneItems: i, totalItems: entryMetas.length });\n\n    try {\n      // v6.8.29/30: stable source Blobs bypass fetch entirely. Chrome can\n      // report ERR_UPLOAD_FILE_CHANGED when fetch() re-opens a clipboard or\n      // previously-loaded blob URL, even though the media still renders.\n      // Legacy JSZip video entries are resolved once here and then retained.\n      if (!m.isManifest && !m.sourceBlob && m.lazyZip && m.lazyEntry) {\n        const lazyFile = m.lazyZip.file(m.lazyEntry);\n        if (!lazyFile) throw new Error('legacy KPAK entry not found: ' + m.lazyEntry);\n        m.sourceBlob = await lazyFile.async('blob');\n        if (m.item) m.item._sourceBlob = m.sourceBlob;\n        if (!m.sourceBlob || !m.sourceBlob.size) throw new Error('legacy KPAK media is empty');\n      }\n      // v7.0.2: v6 KPAK never-activated lazy videos. These were previously\n      // excluded from the save entirely (see blobItems filter above) \u2014 now\n      // resolve them from the ORIGINAL loaded File + entry offset/size.\n      // saveBoardV6()'s pre-save materialize pass already does this eagerly\n      // BEFORE the destination file handle is created (streaming path), so\n      // this is a defensive fallback for direct buildKpakV6() callers and\n      // the blob-download path.\n      if (!m.isManifest && !m.sourceBlob && m.kpakEntry && m.kpakBlob) {\n        m.sourceBlob = await extractKpakV6EntryBlob(m.kpakBlob, m.kpakEntry);\n        if (m.item) m.item._sourceBlob = m.sourceBlob;\n        if (!m.sourceBlob || !m.sourceBlob.size) throw new Error('v6 KPAK lazy media is empty');\n      }\n      if (!m.isManifest && m.sourceBlob) {\n        if (!m.sourceBlob.size) throw new Error('source Blob is empty');\n        m.size = m.sourceBlob.size;\n      } else if (!m.isManifest) {\n        // v6.8.28: preflight the blob URL with a lightweight fetch that only reads\n        // headers. This catches revoked / stale blob URLs early instead of silently\n        // writing a missing media entry.\n        try {\n          const probe = await fetch(m.src);\n          if (!probe.ok) throw new Error('preflight status ' + probe.status);\n          const cl = parseInt(probe.headers.get('content-length') || '0', 10);\n          if (cl === 0 && probe.body && probe.body.cancel) probe.body.cancel();\n          if (cl > 0) m.size = cl;\n        } catch (pe) {\n          console.error('[KPAKv6] preflight failed for', m.name, m.src, pe.message);\n          failedItems.push({ name: m.name, itemId: m.itemId, reason: 'preflight: ' + pe.message });\n          continue;\n        }\n      }\n\n      // Stream entry bytes via Blob/Response + getReader, writing chunks as we read\n      // This keeps memory usage at ~chunk-size (typically 64KB) instead of full entry\n      const resp = (m.isManifest || m.sourceBlob) ? null : await fetch(m.src);\n      if (!m.isManifest && !m.sourceBlob && !resp.ok) { console.warn('[KPAKv6] fetch failed', m.name); failedItems.push({ name: m.name, itemId: m.itemId, reason: 'fetch ' + resp.status }); continue; }\n\n      // Write 4-byte size placeholder (we know size at end, fix it via finalization)\n      // For true streaming without seek, we write SIZE = 0xFFFFFFFF (4GB marker) as sentinel.\n      // The index stores the real offset/size, so the in-band size header is redundant.\n      // Wait, our readKpakV6Index DOES need this for media entry size to do blob.slice().\n      // We need real size. So we MUST use Content-Length or pre-count.\n      const contentLength = m.isManifest ? m.bytes.length : m.sourceBlob ? m.sourceBlob.size : parseInt(resp.headers.get('content-length') || '0', 10);\n\n      let sizeBuf;\n      if (contentLength > 0) {\n        // Use Content-Length (reliable for blob: URLs since they wrap a Blob with known size)\n        sizeBuf = new Uint8Array(4);\n        new DataView(sizeBuf.buffer).setUint32(0, contentLength, true);\n      } else {\n        // Fallback: use 0 as placeholder, will fix later\n        sizeBuf = new Uint8Array(4);\n      }\n\n      if (useStreaming) {\n        await writableStream.write(sizeBuf);\n      } else {\n        blobParts.push(sizeBuf);\n      }\n      currentOffset += 4;\n\n      const dataOffset = currentOffset;\n      let actualSize = 0;\n\n      if (m.isManifest) {\n        if (useStreaming) {\n          await writableStream.write(m.bytes);\n        } else {\n          blobParts.push(m.bytes);\n        }\n        actualSize = m.bytes.length;\n      } else if ((m.sourceBlob && m.sourceBlob.stream) || (resp.body && resp.body.getReader)) {\n        // True streaming \u2014 read chunks and write immediately\n        const reader = m.sourceBlob ? m.sourceBlob.stream().getReader() : resp.body.getReader();\n        let _lastChunkReport = 0;\n        while (true) {\n          const { done, value } = await reader.read();\n          if (done) break;\n          // v6.8.15: always copy reader chunks before writing/queuing.\n          // Some engines may recycle fetch-reader backing buffers, and\n          // relying on shared views can corrupt packed media bytes.\n          const chunk = new Uint8Array(value);\n          if (useStreaming) {\n            await writableStream.write(chunk);\n          } else {\n            // v6.8.1 FIX (macOS/Safari): never push `.buffer` from pooled\n            // reader chunks. Keep exact chunk boundaries as Uint8Array views.\n            if (blobParts.length > 50) {\n              const combined = new Blob(blobParts);\n              blobParts.length = 0;\n              blobParts.push(combined);\n            }\n            blobParts.push(chunk);\n          }\n          actualSize += chunk.length;\n          // v7.0.27: intra-entry progress for very large single media (e.g.\n          // a 500 MB video) \u2014 report every ~16 MB so the bar keeps moving\n          // instead of sitting on one entry for minutes.\n          if (progressCallback && actualSize - _lastChunkReport >= 16 * 1024 * 1024) {\n            _lastChunkReport = actualSize;\n            progressCallback(null, { doneBytes: doneBytes + actualSize, totalBytes: Math.max(knownTotal, doneBytes + actualSize), doneItems: i, totalItems: entryMetas.length });\n          }\n        }\n        // Update size header if Content-Length was wrong/missing\n        if (contentLength === 0 || contentLength !== actualSize) {\n          const fixBuf = new Uint8Array(4);\n          new DataView(fixBuf.buffer).setUint32(0, actualSize, true);\n          // v6.8.28: blob-fallback path can still seek in memory to fix the\n          // size header. For streaming we cannot; rely on the index instead.\n          if (!useStreaming) {\n            const headerPos = dataOffset - 4;\n            blobParts.forEach(function(part, idx) {\n              // Only ArrayBuffer-backed parts matter; Blobs from the combine step\n              // are too late to patch. In practice size mismatches for blob URLs\n              // are rare, and the index remains authoritative.\n              if (part instanceof Uint8Array && headerPos >= currentOffset && headerPos < currentOffset + part.length) {\n                part.set(fixBuf, headerPos - currentOffset);\n              }\n            });\n          } else {\n            console.warn('[KPAKv6] size mismatch for', m.name, 'contentLength:', contentLength, 'actual:', actualSize);\n          }\n        }\n      } else {\n        // No getReader \u2014 fallback to arrayBuffer\n        const ab = m.sourceBlob ? await m.sourceBlob.arrayBuffer() : await resp.arrayBuffer();\n        if (useStreaming) {\n          await writableStream.write(new Uint8Array(ab));\n        } else {\n          blobParts.push(new Uint8Array(ab));\n        }\n        actualSize = ab.byteLength;\n      }\n\n      entries.push({ name: m.name, offset: dataOffset, size: actualSize, type: m.type });\n      currentOffset += actualSize;\n      // v7.0.27: fold this entry's REAL size into the running total so the\n      // percentage self-corrects (upfront estimate used 80MB/5MB guesses for\n      // unknown blob sizes).\n      if (!m.isManifest && estTotalBytes) knownTotal = Math.max(0, knownTotal - (m.size || 0) + actualSize);\n      doneBytes += actualSize;\n      if (i % 2 === 0) await new Promise(r => setTimeout(r, 0));\n    } catch (e) {\n      console.warn('[KPAKv6] failed to pack', m.name, e.message);\n      failedItems.push({ name: m.name, itemId: m.itemId, reason: e.message });\n      // A writable-stream error is fatal to the selected file. Do not keep\n      // writing subsequent entries into a broken stream and then close it as\n      // if the package were valid; abort and let saveBoardV6 use the verified\n      // Blob fallback instead.\n      if (useStreaming) throw e;\n    }\n  }\n\n  // v6.8.28: surface missing media at save time. A silent mismatch here is\n  // exactly what produces \"saved ok but images missing on load\".\n  if (failedItems.length > 0 || entries.filter(e => e.name.startsWith('media/')).length !== expectedMediaCount) {\n    console.error('[KPAKv6] MEDIA LOSS DETECTED during save:', failedItems);\n  }\n\n  // Pass 2: build index\n  if (progressCallback) progressCallback(_isZhUI() ? '\u5199\u5165\u7D22\u5F15\u2026' : 'Writing index...', { doneBytes: doneBytes, totalBytes: Math.max(knownTotal, doneBytes) || 1 });\n  // v6.8.1: index parts are pushed as Uint8Array VIEWS (not .buffer) so\n  // byte lengths stay exact \u2014 same class of bug as the media chunks above.\n  const indexParts = [];\n  const countBuf = new Uint8Array(4);\n  new DataView(countBuf.buffer).setUint32(0, entries.length, true);\n  indexParts.push(countBuf);\n\n  for (const e of entries) {\n    const nameEnc = new TextEncoder().encode(e.name);\n    const nameLenBuf = new Uint8Array(2);\n    new DataView(nameLenBuf.buffer).setUint16(0, nameEnc.length, true);\n    indexParts.push(nameLenBuf);\n    indexParts.push(nameEnc);\n\n    const offsetBuf = new Uint8Array(8);\n    new DataView(offsetBuf.buffer).setBigUint64(0, BigInt(e.offset), true);\n    indexParts.push(offsetBuf);\n\n    const sizeBuf2 = new Uint8Array(8);\n    new DataView(sizeBuf2.buffer).setBigUint64(0, BigInt(e.size), true);\n    indexParts.push(sizeBuf2);\n\n    const typeBuf = new Uint8Array(1);\n    typeBuf[0] = e.type;\n    indexParts.push(typeBuf);\n  }\n\n  if (useStreaming) {\n    for (const p of indexParts) {\n      await writableStream.write(p);\n    }\n  } else {\n    blobParts.push(...indexParts);\n  }\n\n  // Pass 3: write footer\n  const indexOffset = currentOffset;\n  const footerBuf = new Uint8Array(12);\n  footerBuf.set(new TextEncoder().encode('KPAK'), 0);\n  new DataView(footerBuf.buffer).setBigUint64(4, BigInt(indexOffset), true);\n\n  if (useStreaming) {\n    await writableStream.write(footerBuf);\n    // Don't close stream \u2014 caller manages lifetime\n    return { entries, size: currentOffset + indexParts.reduce((s, p) => s + p.byteLength, 0) + 12, streamed: true, manifestJson, failedItems };\n  } else {\n    blobParts.push(footerBuf);\n    // v6.8.1: build the Blob FIRST, then read its real .size. The old code\n    // summed `p.byteLength` across blobParts, but some parts are Blobs\n    // (from the periodic combine step) which have `.size`, not\n    // `.byteLength` \u2014 so totalSize came out NaN / wrong on the very paths\n    // that hit the combine branch (large boards on macOS).\n    const outBlob = new Blob(blobParts, { type: 'application/octet-stream' });\n    const totalSize = outBlob.size;\n    if (progressCallback) progressCallback('Finalized ' + formatBytes(totalSize));\n    console.log('[KPAKv6] blob built:', entries.length, 'entries,', formatBytes(totalSize));\n    return { blob: outBlob, size: totalSize, entries, manifestJson, failedItems };\n  }\n}\n\n// v6.5.0: Read kpak index from a Blob (uses .slice() for random access)\n// Returns {entries: [{name, offset, size, type}], manifestJson}\nasync function readKpakV6Index(blob) {\n  // Read footer (last 12 bytes)\n  const footerBuf = await blob.slice(-12).arrayBuffer();\n  const footerView = new DataView(footerBuf);\n  const magic = new TextDecoder().decode(new Uint8Array(footerBuf, 0, 4));\n  if (magic !== 'KPAK') throw new Error('Not a valid KPAK v6 file (bad magic: ' + magic + ')');\n  const indexOffset = Number(footerView.getBigUint64(4, true));\n\n  // Read index\n  // First read enough to get entry count (4 bytes), then read rest\n  const indexHeadBuf = await blob.slice(indexOffset, indexOffset + 4).arrayBuffer();\n  const entryCount = new DataView(indexHeadBuf).getUint32(0, true);\n\n  // v6.8.28: read the entire index region up to the footer. The old estimate\n  // (entryCount * 60) could truncate long file names or future index fields,\n  // silently cutting off the last entries and making their media vanish on load.\n  const indexEnd = Math.max(indexOffset + 4, blob.size - 12);\n  const indexBuf = await blob.slice(indexOffset, indexEnd).arrayBuffer();\n  const indexView = new DataView(indexBuf);\n  let pos = 4; // skip entry_count\n  const entries = [];\n\n  for (let i = 0; i < entryCount; i++) {\n    if (pos + 2 > indexBuf.byteLength) throw new Error('KPAK index truncated at nameLen (entry ' + i + ')');\n    const nameLen = indexView.getUint16(pos, true); pos += 2;\n    if (pos + nameLen + 8 + 8 + 1 > indexBuf.byteLength) throw new Error('KPAK index truncated at entry ' + i + ' (nameLen=' + nameLen + ')');\n    const name = new TextDecoder().decode(new Uint8Array(indexBuf, pos, nameLen)); pos += nameLen;\n    const offset = Number(indexView.getBigUint64(pos, true)); pos += 8;\n    const size = Number(indexView.getBigUint64(pos, true)); pos += 8;\n    const type = indexView.getUint8(pos); pos += 1;\n    entries.push({ name, offset, size, type });\n  }\n\n  // Extract manifest\n  const manifestEntry = entries.find(e => e.name === 'manifest.json');\n  if (!manifestEntry) throw new Error('No manifest.json in kpak');\n  const manifestBuf = await blob.slice(manifestEntry.offset, manifestEntry.offset + manifestEntry.size).arrayBuffer();\n  const manifestJson = new TextDecoder().decode(manifestBuf);\n  const manifest = JSON.parse(manifestJson);\n\n  return { entries, manifest };\n}\n\n\n// \u2500\u2500 v7.0.45: the ONE answer to \"is this file a board?\" \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// There used to be two hand-rolled copies of this check \u2014 one in the\n// stream-to-handle path, one in the blob-download fallback \u2014 and they did not\n// agree. The blob copy toasted when verification threw. The stream copy logged\n// the throw to the console and carried on, so a 0-byte file still ended with a\n// cheerful \"Saved \u2714\". That is the reported bug exactly: the file is destroyed\n// and the user is told it is fine.\n//\n// Why \"0 bytes\" never even reached the old out-of-bounds counter, which was\n// the only thing that could raise an alarm: readKpakV6Index() reads the\n// 12-byte footer first, and an empty file has no footer, so it throws\n// 'bad magic' \u2014 which the stream path then swallowed. So emptiness has to be\n// checked BEFORE the index is opened, not inferred from it.\n//\n// A kpak is never legitimately empty and never legitimately tiny: the smallest\n// possible one still carries a manifest, an index, and the 12-byte footer.\nconst KPAK_MIN_BYTES = 64;\n\nasync function verifyKpakOutput(container) {\n  const v = { ok: false, reason: 'nothing was written', size: 0, entries: 0, bad: 0, manifest: null };\n  if (!container) return v;\n  const size = (typeof container.size === 'number') ? container.size : 0;\n  v.size = size;\n  if (size === 0) { v.reason = 'the file was written with 0 bytes \u2014 nothing was saved'; return v; }\n  if (size < KPAK_MIN_BYTES) { v.reason = 'only ' + size + ' bytes were written \u2014 the file is truncated'; return v; }\n  let parsed = null;\n  try {\n    parsed = await readKpakV6Index(container);\n  } catch (e) {\n    v.reason = (e && e.message) ? e.message : 'the file could not be read back after writing';\n    return v;\n  }\n  const entries = (parsed && parsed.entries) || [];\n  v.entries = entries.length;\n  v.manifest = parsed ? parsed.manifest : null;\n  if (entries.length === 0) { v.reason = 'the file contains nothing \u2014 not even the board itself'; return v; }\n  let bad = 0;\n  for (const e of entries) {\n    if (!(e.size > 0) || e.offset < 0 || (e.offset + e.size) > size) bad++;\n  }\n  v.bad = bad;\n  if (bad > 0) { v.reason = bad + ' of ' + entries.length + ' files point outside the file'; return v; }\n  v.ok = true;\n  v.reason = '';\n  return v;\n}\n\n// A package can be structurally perfect and still be missing half its videos,\n// and the container check above cannot see that \u2014 only the builder knows how\n// many bytes it meant to produce. So the expected count is handed in\n// separately and a materially short write is flagged here.\n//\n// The tolerance matters. buildKpakV6's streaming branch reports a COMPUTED\n// length (see its `return`), which can legitimately drift by a few bytes from\n// what actually lands on disk, so only a shortfall that is both large in\n// absolute terms and more than 1% counts. A half-written 2 GB board shows up;\n// accounting drift does not.\nfunction applyShortWriteCheck(v, expectedBytes) {\n  if (!v || !v.ok || !(expectedBytes > 0)) return v;\n  const shortBy = expectedBytes - v.size;\n  if (shortBy > 65536 && shortBy > expectedBytes * 0.01) {\n    v.ok = false;\n    v.reason = 'the write was cut short \u2014 ' + formatBytes(v.size) + ' of ' + formatBytes(expectedBytes);\n  }\n  return v;\n}\n\n// v6.8.15: Detect media mime from magic bytes to improve cross-browser\n// decode reliability for blob slices loaded from kpak.\nasync function _detectKpakEntryMime(blob, entry) {\n  try {\n    const head = new Uint8Array(await blob.slice(0, 32).arrayBuffer());\n    if (head.length >= 12) {\n      if (head[0] === 0x89 && head[1] === 0x50 && head[2] === 0x4E && head[3] === 0x47) return 'image/png';\n      if (head[0] === 0xFF && head[1] === 0xD8 && head[2] === 0xFF) return 'image/jpeg';\n      if (head[0] === 0x47 && head[1] === 0x49 && head[2] === 0x46 && head[3] === 0x38) return 'image/gif';\n      if (head[0] === 0x42 && head[1] === 0x4D) return 'image/bmp';\n      if (head[0] === 0x52 && head[1] === 0x49 && head[2] === 0x46 && head[3] === 0x46 && head[8] === 0x57 && head[9] === 0x45 && head[10] === 0x42 && head[11] === 0x50) return 'image/webp';\n      if (head[4] === 0x66 && head[5] === 0x74 && head[6] === 0x79 && head[7] === 0x70) return 'video/mp4';\n      if (head[0] === 0x1A && head[1] === 0x45 && head[2] === 0xDF && head[3] === 0xA3) return 'video/webm';\n      if (head[0] === 0x4F && head[1] === 0x67 && head[2] === 0x67 && head[3] === 0x53) return (entry && entry.type === 2) ? 'audio/ogg' : 'video/ogg';\n      if (head[0] === 0x52 && head[1] === 0x49 && head[2] === 0x46 && head[3] === 0x46 && head[8] === 0x57 && head[9] === 0x41 && head[10] === 0x56 && head[11] === 0x45) return 'audio/wav';\n      if (head[0] === 0x49 && head[1] === 0x44 && head[2] === 0x33) return 'audio/mpeg';\n      if (head[0] === 0xFF && (head[1] & 0xE0) === 0xE0) return 'audio/mpeg';\n    }\n  } catch (_) {}\n  return '';\n}\n\n// v6.8.30: Extract a KPAK entry as a stable Blob. Keeping the Blob on the\n// item is required for repeated saves: refetching a blob URL created from a\n// previously-loaded KPAK file can fail in Chrome with ERR_UPLOAD_FILE_CHANGED.\n// v7.0.2: MUST fully materialize the bytes into memory (arrayBuffer \u2192 new\n// Blob), not just take a lazy Blob.slice() view. When `kpakBlob` is the\n// on-disk File the user picked to load, .slice() is a lazy reference into\n// that file \u2014 if the user then Saves and OVERWRITES that same file path\n// (createWritable() truncates it immediately), every not-yet-actually-read\n// slice becomes invalid mid-save and every read throws a generic\n// \"network error\". Reading eagerly here guarantees the bytes live in RAM\n// and are completely decoupled from the source file on disk.\n// v7.0.5: concurrency limiter + retry for KPAK media extraction.\n// Reading many large `Blob.slice().arrayBuffer()` ranges from the SAME\n// on-disk File concurrently \u2014 e.g. the mouse sweeping/selecting across\n// many never-activated lazy videos right after opening a large (multi-GB,\n// many-entry) .kpak \u2014 can make Chrome throw a transient\n// `NotReadableError: The requested file could not be read...` for SOME\n// of the concurrent reads, even though the file is completely healthy\n// and unrelated reads succeed at the same time. This is resource\n// contention, not corruption: it consistently hits whichever items\n// happen to be read while several others are mid-read. Serializing\n// large reads (max N concurrent) and retrying on this specific\n// transient error class fixes it without touching byte-correctness.\nlet _kpakExtractActive = 0;\nconst _kpakExtractQueue = [];\nconst KPAK_EXTRACT_CONCURRENCY = 2;\nfunction _kpakExtractAcquire() {\n  return new Promise(resolve => {\n    if (_kpakExtractActive < KPAK_EXTRACT_CONCURRENCY) {\n      _kpakExtractActive++;\n      resolve();\n    } else {\n      _kpakExtractQueue.push(resolve);\n    }\n  });\n}\nfunction _kpakExtractRelease() {\n  _kpakExtractActive--;\n  const next = _kpakExtractQueue.shift();\n  if (next) { _kpakExtractActive++; next(); }\n}\n\n// v7.0.6: per-item re-entrancy guard + failure cooldown for lazy-video\n// activation. `_activateLazyVideoV6`/`_activateLazyVideo` are called on\n// EVERY mousemove-hover tick and on every select for the same item. A\n// large video's `arrayBuffer()` read can take multiple seconds \u2014 during\n// that window the mouse keeps moving over the same item and fires MANY\n// more calls for the SAME item.id. Without a guard those calls all pile\n// into the small concurrency semaphore fighting each other, and once one\n// fails, the very next mousemove tick immediately retries \u2014 producing an\n// endless \"retry 1/3 \u2192 2/3 \u2192 fail \u2192 retry 1/3...\" storm that never\n// settles, even though the underlying byte range may be completely fine.\n// Fix: (1) if activation for this item.id is already in flight, skip \u2014\n// the in-flight call will finish on its own; (2) after a failure,\n// remember the item.id with a short cooldown so rapid re-triggering\n// (mousemove) doesn't hammer the same read again immediately. Both maps\n// are read/written directly by each activation function's own try/catch\n// so failures never produce an unhandled promise rejection at the\n// (un-awaited) call sites in refreshSelection()/hover.\nconst _lazyActivationInFlight = new Set(); // item.id currently being activated\nconst _lazyActivationCooldownUntil = new Map(); // item.id -> timestamp (ms)\nconst LAZY_ACTIVATION_COOLDOWN_MS = 4000;\nfunction _lazyActivationShouldSkip(id) {\n  if (_lazyActivationInFlight.has(id)) return true;\n  const until = _lazyActivationCooldownUntil.get(id);\n  return until !== undefined && Date.now() < until;\n}\n\n// v7.0.8: read a Blob/File range in fixed-size chunks instead of one giant\n// `.slice(offset, offset+size).arrayBuffer()` call. A single-shot read of a\n// multi-hundred-MB / multi-GB range is itself a fragile operation in Chrome\n// \u2014 independent of concurrency contention or post-write settling delays\n// (both already handled by the caller's retry loop), one huge read can\n// throw `NotReadableError` even against a file that `readKpakV6Index()` and\n// a save-time verify pass both just confirmed is completely intact. Chunking\n// keeps each individual read small (64MB) so any transient hiccup only\n// costs one chunk-retry instead of restarting the whole multi-GB read from\n// byte zero, and in practice chunked reads of this size are dramatically\n// less likely to hit the error at all.\n// v7.0.9: return an ARRAY of chunk Uint8Arrays instead of concatenating them\n// into one giant pre-allocated buffer. The very first version of this\n// function did `new Uint8Array(size)` up front for a near-GB `size` \u2014 that\n// single large contiguous allocation is exactly the kind of operation this\n// function exists to avoid, and it can throw `RangeError: Array buffer\n// allocation failed` under memory pressure (undo stack, emergency backup\n// JSON, browser overhead, etc. all compete for the same heap). `new\n// Blob(arrayOfChunks)` accepts a list of parts and does NOT require any of\n// them to be copied into one pre-sized buffer, so returning the chunks\n// as-is and handing them straight to `new Blob(...)` avoids the large\n// allocation entirely while still producing a single logical byte range.\nconst KPAK_CHUNK_READ_SIZE = 64 * 1024 * 1024; // 64MB\nasync function _readBlobRangeChunked(blob, offset, size) {\n  if (size <= KPAK_CHUNK_READ_SIZE) {\n    // Small entry \u2014 a single read is already safe and avoids chunking overhead.\n    return [new Uint8Array(await blob.slice(offset, offset + size).arrayBuffer())];\n  }\n  const chunks = [];\n  let pos = 0;\n  while (pos < size) {\n    const thisSize = Math.min(KPAK_CHUNK_READ_SIZE, size - pos);\n    const chunkSlice = blob.slice(offset + pos, offset + pos + thisSize);\n    const MAX_CHUNK_ATTEMPTS = 5;\n    let lastErr;\n    let ab = null;\n    for (let attempt = 1; attempt <= MAX_CHUNK_ATTEMPTS; attempt++) {\n      try {\n        ab = await chunkSlice.arrayBuffer();\n        break;\n      } catch (e) {\n        lastErr = e;\n        if (e.name !== 'NotReadableError' || attempt === MAX_CHUNK_ATTEMPTS) throw e;\n        console.warn('[KPAKv6] chunk retry ' + attempt + '/' + MAX_CHUNK_ATTEMPTS + ' at offset ' + (offset + pos) + ' after ' + e.name);\n        await new Promise(r => setTimeout(r, 500 * attempt));\n      }\n    }\n    if (!ab) throw lastErr || new Error('chunk read failed');\n    chunks.push(new Uint8Array(ab));\n    pos += thisSize;\n  }\n  return chunks;\n}\n\nasync function extractKpakV6EntryBlob(kpakBlob, entry) {\n  if (!kpakBlob || !entry || entry.offset < 0 || entry.size <= 0 || entry.offset + entry.size > kpakBlob.size) {\n    throw new Error('KPAK media range is invalid for ' + ((entry && entry.name) || 'unknown entry'));\n  }\n  await _kpakExtractAcquire();\n  try {\n    // v7.0.7: widen the retry window. `NotReadableError` can also happen\n    // when the file was JUST written (Save streamed it, then the user\n    // immediately re-opened it to Load) and the OS / antivirus / cloud\n    // sync (OneDrive, iCloud Drive, etc.) is still settling the freshest\n    // bytes at the END of the file \u2014 typically the most-recently-added,\n    // largest video, since entries are appended in order. The old 3\n    // attempts / ~1.8s total backoff was tuned for pure read-contention\n    // (mouse hover spam) and was too short for this OS-level settling\n    // delay. 5 attempts with a longer ramp (500ms..2500ms per whole-entry\n    // attempt) covers both cases without materially slowing down the\n    // common case (first attempt almost always succeeds).\n    // v7.0.8: the actual byte read now goes through _readBlobRangeChunked,\n    // which reads in 64MB pieces (see above) instead of one giant read \u2014\n    // this is the fix for large (near-GB) single-entry files where even a\n    // fully-verified, non-contended file can throw NotReadableError on one\n    // huge slice().arrayBuffer() call. This outer loop remains as a final\n    // safety net for whole-entry-level transient failures.\n    // v7.0.9: _readBlobRangeChunked returns an ARRAY of chunk Uint8Arrays\n    // (not one concatenated buffer) \u2014 pass it directly as `new Blob(chunks)`\n    // parts. Never spread it as `new Blob([chunks])`, which would wrap the\n    // whole array as a single part instead of many, and never manually\n    // concatenate into one big Uint8Array first \u2014 that reintroduces the\n    // exact large-allocation problem this fix is meant to avoid.\n    const MAX_ATTEMPTS = 5;\n    let lastErr;\n    for (let attempt = 1; attempt <= MAX_ATTEMPTS; attempt++) {\n      try {\n        const chunks = await _readBlobRangeChunked(kpakBlob, entry.offset, entry.size);\n        const mime = await _detectKpakEntryMime(new Blob(chunks), entry);\n        return new Blob(chunks, { type: mime || 'application/octet-stream' });\n      } catch (e) {\n        lastErr = e;\n        // Only retry the transient contention/settling error class. Anything\n        // else (e.g. a genuinely invalid byte range) should fail immediately.\n        if (e.name !== 'NotReadableError' || attempt === MAX_ATTEMPTS) throw e;\n        console.warn('[KPAKv6] extract retry ' + attempt + '/' + MAX_ATTEMPTS + ' for ' + (entry.name || 'entry') + ' after ' + e.name);\n        await new Promise(r => setTimeout(r, 500 * attempt));\n      }\n    }\n    throw lastErr;\n  } finally {\n    _kpakExtractRelease();\n  }\n}\n\n// v6.5.0: Extract a single entry from kpak Blob as a Blob URL\nasync function extractKpakV6Entry(kpakBlob, entry) {\n  const typed = await extractKpakV6EntryBlob(kpakBlob, entry);\n  return URL.createObjectURL(typed);\n}\n// v6.8.27: save mutex helpers. Show a full-screen overlay and block pointer\n// events while saving so the user cannot drag, resize, delete, or drop items\n// in the middle of a write. This prevents partial/corrupted saves and reduces\n// the chance of OOM crashes caused by concurrent mutations + serialization.\nfunction _setSaving(isSaving) {\n  state._saving = isSaving;\n  // v7.0.30: replay any undo step that was deferred while the save ran.\n  if (!isSaving) { try { _flushDeferredUndo(); } catch (e) {} }\n  let overlay = document.getElementById('krafted-save-overlay');\n  if (isSaving) {\n    if (!overlay) {\n      overlay = document.createElement('div');\n      overlay.id = 'krafted-save-overlay';\n      overlay.className = 'krafted-save-overlay';\n      overlay.innerHTML = '<div class=\"krafted-save-spinner\"></div><div class=\"krafted-save-text\">Saving\u2026 please wait</div>';\n      document.body.appendChild(overlay);\n    }\n    overlay.style.display = 'flex';\n  } else if (overlay) {\n    overlay.style.display = 'none';\n  }\n}\n\n// v6.8.27: Emergency backup helpers. After every successful save we stash the\n// serialized board in IndexedDB. If the tab crashes during a later save and the\n// downloaded .kpak is corrupted, the user can recover from this backup via the\n// browser console: window.__kraftedRestoreEmergencyBackup()\nconst KRAFTED_DB_NAME = 'KraftedEmergencyDB';\nconst KRAFTED_DB_VERSION = 1;\nconst KRAFTED_BACKUP_KEY = 'lastSuccessfulBoard';\nfunction _openKraftedDB() {\n  return new Promise((resolve, reject) => {\n    const req = indexedDB.open(KRAFTED_DB_NAME, KRAFTED_DB_VERSION);\n    req.onerror = () => reject(req.error);\n    req.onupgradeneeded = (e) => {\n      const db = e.target.result;\n      if (!db.objectStoreNames.contains('backups')) db.createObjectStore('backups');\n    };\n    req.onsuccess = () => resolve(req.result);\n  });\n}\nasync function _writeEmergencyBackup(jsonStr) {\n  try {\n    if (!jsonStr || jsonStr.length > 100 * 1024 * 1024) return; // don't back up huge boards (>100MB JSON)\n    const db = await _openKraftedDB();\n    const tx = db.transaction('backups', 'readwrite');\n    const store = tx.objectStore('backups');\n    await new Promise((resolve, reject) => {\n      const req = store.put({ json: jsonStr, savedAt: new Date().toISOString() }, KRAFTED_BACKUP_KEY);\n      req.onsuccess = () => resolve();\n      req.onerror = () => reject(req.error);\n    });\n    db.close();\n    console.log('[EMERGENCY BACKUP] written:', formatBytes(jsonStr.length));\n  } catch (e) {\n    console.warn('[EMERGENCY BACKUP] failed:', e.message);\n  }\n}\nwindow.__kraftedRestoreEmergencyBackup = async function() {\n  try {\n    const db = await _openKraftedDB();\n    const tx = db.transaction('backups', 'readonly');\n    const store = tx.objectStore('backups');\n    const rec = await new Promise((resolve, reject) => {\n      const req = store.get(KRAFTED_BACKUP_KEY);\n      req.onsuccess = () => resolve(req.result);\n      req.onerror = () => reject(req.error);\n    });\n    db.close();\n    if (!rec || !rec.json) { toast('No emergency backup found'); return; }\n    const proceed = confirm(\n      'Found emergency backup from ' + (rec.savedAt || 'unknown time') + '\\nSize: ' + formatBytes(rec.json.length) + '\\n\\n' +\n      'This will REPLACE the current board. Continue?'\n    );\n    if (!proceed) return;\n    const data = safeJSONParse(rec.json, null);\n    if (!data) { toast('Backup is corrupted'); return; }\n    cleanupAllItems();\n    state.items = []; state.texts = []; state.todos = []; state.mindmaps = [];\n    state.selected.clear(); state.groups.forEach(disposeGroupEl); state.groups = [];\n    restoreBoard(data, false);\n    toast('Emergency backup restored');\n    console.log('[EMERGENCY BACKUP] restored');\n  } catch (e) {\n    console.error('[EMERGENCY BACKUP] restore failed:', e.message);\n    toast('Restore failed: ' + e.message);\n  }\n};\n\n\n// \u2500\u2500 v7.0.45: a failed save you cannot miss \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// A 2-second toast is the wrong instrument for \"the file you are relying on\n// is now 0 bytes\". By the time it fades the user has moved on, believing the\n// board is safe. So a save now reports on surfaces that outlive the moment:\n//\n//   FATAL     the file is not a board. Blocking modal, because this is the\n//             one case where the user must not carry on assuming otherwise.\n//   DEGRADED  the file opens but media is missing. No modal \u2014 the board is\n//             still in memory and the file still loads \u2014 but the banner\n//             stays, because \"Saved, but 3 items missing\" in a toast is\n//             forgotten before it finishes animating.\n//\n// Either way the banner persists until the user dismisses it. That is the fix\n// for \u300C\u6211\u90FD\u5514\u77E5\u539F\u4F86\u6587\u4EF6\u5DF2\u7D93\u640D\u6BC1\u300D: the state of \"your last save is not\n// trustworthy\" is on screen until someone deals with it.\n\n// The last save whose bytes came back verified, kept so a later alarm can hand\n// the user something real instead of only bad news. One blob, replaced on each\n// successful save \u2014 the previous one is then garbage.\nlet _lastGoodSaveBlob = null;\n\n// The blob: URL behind the last download. Held open deliberately; see the\n// comment at the download site for why it is not revoked on a timer.\nlet _lastSaveObjectUrl = null;\nfunction _releaseLastSaveObjectUrl() {\n  if (_lastSaveObjectUrl) { try { URL.revokeObjectURL(_lastSaveObjectUrl); } catch (e) {} }\n  _lastSaveObjectUrl = null;\n}\n\nlet _saveBannerEl = null;\nfunction _clearSaveBanner() {\n  if (_saveBannerEl) { try { _saveBannerEl.remove(); } catch (e) {} }\n  _saveBannerEl = null;\n}\n\nfunction _showSaveBanner(level, html) {\n  _clearSaveBanner();\n  const el = document.createElement('div');\n  el.className = 'krafted-save-banner ' + (level === 'fatal' ? 'is-fatal' : 'is-warn');\n  el.innerHTML =\n    '<span class=\"krafted-save-banner-icon\">' + (level === 'fatal' ? '\\u26d4' : '\\u26a0') + '</span>' +\n    '<span class=\"krafted-save-banner-msg\">' + html + '</span>' +\n    '<button class=\"krafted-save-banner-x\" type=\"button\">\\u2715</button>';\n  el.querySelector('.krafted-save-banner-x').addEventListener('click', function () { _clearSaveBanner(); });\n  document.body.appendChild(el);\n  _saveBannerEl = el;\n}\n\n// A blocking modal for the case where the bytes on disk are not a board.\n// It names the file, how many bytes actually landed, how big the file used to\n// be, and why \u2014 because \"save failed\" without numbers is not actionable, and\n// the user cannot check a file they have not been told is broken.\nfunction _showSaveAlarm(o) {\n  const zh = _isZhUI();\n  const wrote = formatBytes(o.bytes || 0);\n  let facts = '';\n  facts += '<div class=\"krafted-save-alarm-row\"><span>' + (zh ? '\\u6a94\\u6848' : 'File') + '</span><b>' + escapeHtml(o.fname || '(unknown)') + '</b></div>';\n  facts += '<div class=\"krafted-save-alarm-row\"><span>' + (zh ? '\\u5be6\\u969b\\u5beb\\u4e86' : 'Bytes written') + '</span><b>' + wrote + '</b></div>';\n  if (o.prevBytes > 0) {\n    facts += '<div class=\"krafted-save-alarm-row\"><span>' + (zh ? '\\u8986\\u84cb\\u4e4b\\u524d\\u4fc2' : 'It used to be') + '</span><b>' + formatBytes(o.prevBytes) + '</b></div>';\n  }\n  facts += '<div class=\"krafted-save-alarm-row\"><span>' + (zh ? '\\u539f\\u56e0' : 'Reason') + '</span><b>' + escapeHtml(o.reason || 'unknown') + '</b></div>';\n\n  const overlay = document.createElement('div');\n  overlay.className = 'krafted-save-alarm';\n  overlay.innerHTML =\n    '<div class=\"krafted-save-alarm-card\" role=\"alertdialog\" aria-modal=\"true\">' +\n      '<div class=\"krafted-save-alarm-head\">\\u26d4 ' + (zh ? '\\u4fdd\\u5b58\\u5931\\u6557 \\u2014\\u2014 \\u5440\\u597d\\u4fe1\\u5462\\u500b\\u6a94\\u6848' : 'SAVE FAILED \\u2014 DO NOT TRUST THIS FILE') + '</div>' +\n      '<p class=\"krafted-save-alarm-lead\">' + (zh\n        ? '\\u4f60\\u55bb board \\u4ef2\\u55ae\\u8a18\\u61b6\\u9ad4\\u5165\\u9762\\uff0c\\u672a\\u51b7\\u3002\\u4f46\\u4fc2<b>\\u786c\\u789f\\u4e0a\\u55bb\\u6a94\\u6848\\u5df2\\u7d93\\u5beb\\u58de</b>\\uff0c\\u5440\\u597d\\u7576\\u4f75\\u4fc2\\u5099\\u4efd\\u3002'\n        : 'Your board is still open in memory \\u2014 nothing is lost yet. But <b>the file on disk is damaged</b>. Do not treat it as a backup.') + '</p>' +\n      '<div class=\"krafted-save-alarm-facts\">' + facts + '</div>' +\n      (o.detail ? '<div class=\"krafted-save-alarm-detail\">' + escapeHtml(o.detail) + '</div>' : '') +\n      '<div class=\"krafted-save-alarm-actions\"></div>' +\n    '</div>';\n\n  const actions = overlay.querySelector('.krafted-save-alarm-actions');\n\n  // Recovery, best option first. \"Save a copy\" re-runs the save through the\n  // picker, which is the only path that can still produce a real file: the\n  // board is in memory, so a transient write failure is recoverable.\n  const btnCopy = document.createElement('button');\n  btnCopy.type = 'button';\n  btnCopy.className = 'primary';\n  btnCopy.textContent = zh ? '\\u53e6\\u5b58\\u65b0\\u6a94\\u2026' : 'Save a copy\\u2026';\n  btnCopy.addEventListener('click', function () {\n    try { overlay.remove(); } catch (e) {}\n    try { saveBoardV6({ forceNew: true }); } catch (e) {}\n  });\n  actions.appendChild(btnCopy);\n\n  // Only offered while holding bytes that were themselves verified \u2014 handing\n  // over an unverified blob would just relocate the problem.\n  if (_lastGoodSaveBlob && _lastGoodSaveBlob.blob && _lastGoodSaveBlob.blob.size > 0) {\n    const btnDl = document.createElement('button');\n    btnDl.type = 'button';\n    btnDl.textContent = zh ? '\\u4e0b\\u8f09\\u4e0a\\u4e00\\u6b21\\u6b63\\u5e38\\u55bb\\u526f\\u672c' : 'Download the last good copy';\n    btnDl.addEventListener('click', function () {\n      try {\n        const url = URL.createObjectURL(_lastGoodSaveBlob.blob);\n        _releaseLastSaveObjectUrl();\n        _lastSaveObjectUrl = url;\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = _lastGoodSaveBlob.name || 'krafted.kpak';\n        document.body.appendChild(a);\n        a.click();\n        setTimeout(function () { try { a.remove(); } catch (e) {} }, 10000);\n        toast(zh ? '\\u526f\\u672c\\u5df2\\u4e0b\\u8f09' : 'Copy downloaded');\n      } catch (e) { toast(zh ? '\\u4e0b\\u8f09\\u5931\\u6557' : 'Download failed'); }\n    });\n    actions.appendChild(btnDl);\n  }\n\n  const btnOk = document.createElement('button');\n  btnOk.type = 'button';\n  btnOk.textContent = zh ? '\\u6211\\u77e5\\u9053\\u4e86' : 'I understand';\n  btnOk.addEventListener('click', function () { try { overlay.remove(); } catch (e) {} });\n  actions.appendChild(btnOk);\n\n  document.body.appendChild(overlay);\n\n  _showSaveBanner('fatal',\n    (zh ? '<b>\\u4fdd\\u5b58\\u5931\\u6557</b> \\u2014\\u2014 ' : '<b>SAVE FAILED</b> \\u2014 ') +\n    escapeHtml(o.fname || '') + ' ' + (zh ? '\\u5beb\\u4e86 ' : 'wrote ') + wrote +\n    (zh ? '\\uff0c\\u6a94\\u6848\\u5df2\\u7d93\\u640d\\u6bc0\\u3002' : ', and the file is damaged.') +\n    ' ' + escapeHtml(o.reason || ''));\n  return overlay;\n}\n\n// v7.0.45: the single place a save is declared good or bad. Both write paths\n// end here, so they cannot disagree about what success means \u2014 and, the point\n// of the whole change, a file that did not verify can no longer produce a\n// success toast. It produces an alarm.\n//\n// o: {fname, verdict, expectedBytes, prevBytes, missingItems, manifestJson,\n//     elapsed, destWarning}\nasync function _finishSave(o) {\n  const zh = _isZhUI();\n  const fname = o.fname || '(unknown)';\n  const v = applyShortWriteCheck(o.verdict, o.expectedBytes);\n  const missing = o.missingItems || [];\n\n  // The manifest backup runs on failure too, not only on success: a board with\n  // no media is still far more recoverable than no board at all, and the\n  // failure case is precisely when it is needed.\n  if (o.manifestJson) { try { await _writeEmergencyBackup(o.manifestJson); } catch (e) {} }\n\n  if (!v || !v.ok) {\n    console.error('[SAVE V6] VERIFY FAILED \u2014', fname, (v && v.reason) || 'no verdict');\n    _showSaveAlarm({\n      fname: fname,\n      bytes: (v && v.size) || 0,\n      prevBytes: o.prevBytes || 0,\n      reason: (v && v.reason) || 'the file could not be read back after writing'\n    });\n    return false;\n  }\n\n  const okMsg = (zh ? '\\u5df2\\u4fdd\\u5b58 \\u2714 ' : 'Saved \\u2714 ') + fname + ' (' + formatBytes(v.size) +\n                (o.elapsed != null ? ' \\u00b7 ' + _fmtDurSec(o.elapsed) : '') + ')';\n\n  // Valid container, missing media. The file opens, which is why this is not a\n  // modal \u2014 but it is not the board the user thinks they saved, so it must not\n  // be a 2-second toast either.\n  const problems = [];\n  if (missing.length > 0) {\n    problems.push(zh\n      ? ('<b>' + missing.length + '</b> \\u500b\\u5a92\\u9ad4\\u6a94\\u6848\\u5beb\\u5514\\u5230\\uff0c\\u958b\\u8fd4\\u5462\\u500b\\u6a94\\u6703\\u5c11\\u4e86\\u4f75\\u5730\\u3002')\n      : ('<b>' + missing.length + '</b> media file(s) could not be written \\u2014 they will be missing when you reopen this file.'));\n  }\n  if (o.destWarning) problems.push(escapeHtml(o.destWarning));\n\n  if (problems.length > 0) {\n    _showSaveBanner('warn', (zh ? '\\u5df2\\u4fdd\\u5b58\\uff0c\\u4f46\\u4fc2\\uff1a' : 'Saved, but: ') + problems.join(' '));\n  } else {\n    _clearSaveBanner();\n    toast(okMsg);\n  }\n  return true;\n}\n\n// v6.5.0: Save using custom kpak container \u2014 single file, no OOM on load\nasync function saveBoardV6(opts) {\n  opts = opts || {};\n  const forceNew = !!opts.forceNew; // Ctrl+Shift+S = Save As (pick a new file)\n  // v6.8.27: save mutex \u2014 one save at a time.\n  if (state._saving) { toast('Save already in progress'); return; }\n  _setSaving(true);\n  console.log('[SAVE V6] saveBoardV6() called', forceNew ? '(force new location)' : '');\n\n  // v7.0.4: CRITICAL \u2014 request the save file handle FIRST, before any other\n  // async work. showSaveFilePicker() requires a recent, unconsumed user\n  // activation (the click/keypress that triggered this function). Every\n  // `await` that runs before this call burns down that activation window.\n  // On a board that is \"a bit bigger\" the pre-save lazy-media materialize\n  // pass below can take long enough (reading video/image bytes into RAM)\n  // that by the time the OLD code finally called showSaveFilePicker() at\n  // the very end, Chrome had already expired the activation and threw\n  // SecurityError \u2014 silently downgrading to the anonymous download\n  // fallback instead of letting the user pick/replace a file (that's the\n  // \"[SAVE] showSaveFilePicker failed (SecurityError)\" warning users saw).\n  // Grabbing the handle up front, while the activation is still fresh,\n  // fixes this regardless of how long the rest of the save takes.\n  const dateStr = new Date().toISOString().slice(0, 10);\n  let fname = 'krafted_' + dateStr + '.kpak';\n  let saveHandle = null;\n  // v7.0.27: quick-save \u2014 reuse the handle from the last successful pick so\n  // Ctrl+S overwrites the same file WITHOUT re-opening the picker every time.\n  // Permission is re-checked (still inside the fresh user-activation window,\n  // same as the picker path below). If the file was moved/renamed or the\n  // permission expired, we transparently fall back to the picker.\n  if (!forceNew && state._saveHandle && window.showSaveFilePicker) {\n    try {\n      const _q = await state._saveHandle.queryPermission({ mode: 'readwrite' });\n      if (_q === 'granted') {\n        saveHandle = state._saveHandle;\n      } else {\n        const _r = await state._saveHandle.requestPermission({ mode: 'readwrite' });\n        if (_r === 'granted') saveHandle = state._saveHandle;\n      }\n    } catch (e) {\n      console.warn('[SAVE V6] saved handle unusable, falling back to picker:', e.message);\n      saveHandle = null;\n    }\n    if (!saveHandle) state._saveHandle = null;\n  }\n  if (!saveHandle && window.showSaveFilePicker) {\n    const _h = await requestSaveHandle(fname, 'application/zip', '.kpak');\n    if (_h.cancelled) { toast('Save cancelled'); _setSaving(false); return; }\n    saveHandle = _h.handle; // null if the API failed/was denied even though it exists\n    if (saveHandle) state._saveHandle = saveHandle;\n  }\n  if (saveHandle && saveHandle.name) fname = saveHandle.name;\n\n  const counts = countMediaItems();\n  console.log('[SAVE V6] media counts:', counts);\n\n  let estTotalBytes = 0;\n  for (const it of state.items) {\n    if (it._fileSize) { estTotalBytes += it._fileSize; }\n    // v7.2.1: a board loaded from a .kpak carries a stable Blob but had no\n    // _fileSize, so every item fell through to the 5 MB guess below -- a\n    // 151 image board reported ~755 MB while actually writing 3.8 MB. The\n    // Blob we are about to write IS the answer; prefer it over guessing.\n    else if (it._sourceBlob && it._sourceBlob.size) { estTotalBytes += it._sourceBlob.size; }\n    else if (it.src && it.src.startsWith('data:')) {\n      const b64Len = it.src.indexOf(';base64,') >= 0 ? it.src.split(',')[1]?.length || 0 : 0;\n      estTotalBytes += Math.round(b64Len * 0.75);\n    } else if (it.src && it.src.startsWith('blob:')) {\n      estTotalBytes += it.isVideo ? 80 * 1024 * 1024 : 5 * 1024 * 1024;\n    }\n  }\n  const estMB = Math.round(estTotalBytes / (1024 * 1024));\n  const estStr = estMB >= 1024 ? (estMB / 1024).toFixed(1) + ' GB' : estMB + ' MB';\n  console.log('[SAVE V6] estimated total:', estStr);\n\n  // v6.8.27: warn before attempting very large saves. Browsers can OOM when\n  // building a huge Blob in memory (fallback path) or when the OS runs low on\n  // swap. Give the user a chance to cancel and split the board.\n  if (estTotalBytes > 1.5 * 1024 * 1024 * 1024) {\n    const proceed = confirm(\n      '\u26A0 This board is very large: ~' + estStr + '\\n\\n' +\n      'Saving may run out of memory and crash the tab.\\n' +\n      'Tip: delete unused items, split into smaller boards, or use streaming save (Chrome/Edge).\\n\\n' +\n      'Continue saving?'\n    );\n    if (!proceed) { _setSaving(false); return; }\n  }\n\n  // Pause videos during save\n  const _pausedVideos = [];\n  state.items.forEach(function(it) {\n    if (it.video && !it.video.paused) { _pausedVideos.push(it.video); it.video.pause(); }\n  });\n\n  // v7.0.2: CRITICAL \u2014 materialize every still-lazy media reference into an\n  // independent in-memory Blob BEFORE we ever open a writable handle on the\n  // destination file. `createWritable()` truncates the target file the\n  // instant it is called. If the user is overwriting (Replace) the SAME\n  // .kpak file they just loaded, any item still holding a lazy reference\n  // into that file (never-activated v6 KPAK video via _kpakEntry/_kpakBlob,\n  // or legacy JSZip lazy video via _lazyZip/_lazyEntry) would have its only\n  // byte source destroyed mid-save, producing a generic \"network error\" for\n  // every one of those items and a cascading MEDIA LOSS DETECTED. Resolving\n  // them here, while the source file is still fully intact, decouples the\n  // save entirely from whatever happens to the destination path.\n  const _lazyItemsToMaterialize = state.items.filter(it =>\n    !(it._sourceBlob instanceof Blob && it._sourceBlob.size > 0) &&\n    ((it._kpakEntry && it._kpakBlob) || (it._lazyZip && it._lazyEntry))\n  );\n  const _lazyMaterializeFailed = [];\n  if (_lazyItemsToMaterialize.length > 0) {\n    const _prepUI = makeProgressUI();\n    let _lazyDone = 0;\n    for (const it of _lazyItemsToMaterialize) {\n      _lazyDone++;\n      _prepUI.update(\n        (_isZhUI() ? '\u51C6\u5907\u5A92\u4F53 ' : 'Preparing media ') + _lazyDone + '/' + _lazyItemsToMaterialize.length + '...',\n        { doneItems: _lazyDone - 1, totalItems: _lazyItemsToMaterialize.length }\n      );\n      try {\n        if (it._kpakEntry && it._kpakBlob) {\n          it._sourceBlob = await extractKpakV6EntryBlob(it._kpakBlob, it._kpakEntry);\n        } else if (it._lazyZip && it._lazyEntry) {\n          const lazyFile = it._lazyZip.file(it._lazyEntry);\n          if (!lazyFile) throw new Error('legacy KPAK entry not found: ' + it._lazyEntry);\n          it._sourceBlob = await lazyFile.async('blob');\n        }\n      } catch (e) {\n        console.error('[SAVE V6] pre-save materialize failed for item', it.id, e.message);\n        _lazyMaterializeFailed.push(it.id);\n      }\n    }\n    _prepUI.done();\n  }\n  if (_lazyMaterializeFailed.length > 0) {\n    console.error('[SAVE V6] could not materialize lazy media for items:', _lazyMaterializeFailed);\n  }\n\n  const progUI = makeProgressUI();\n  progUI.update(_isZhUI() ? '\u6784\u5EFA v6 kpak\u2026' : 'Building v6 kpak...');\n  const updateProg = (t, o) => progUI.update(t, o);\n\n  try {\n    // Try streaming first (Chrome/Edge with File System Access API) \u2014 only one entry in memory at a time\n    let saved = false;\n    // v7.0.45: set when the streamed write went wrong. The destination is\n    // already committed by the time we find out, so even if the blob fallback\n    // below later succeeds, the file the user actually picked may have been\n    // damaged \u2014 and that has to be said, not hidden behind the fallback's\n    // success toast.\n    let streamDestWarning = null;\n    // v7.0.4: use the handle acquired at the very top of this function\n    // (while the user activation was still fresh) instead of re-requesting\n    // showSaveFilePicker() here, which could be well past the activation\n    // window on a board with a lot of lazy media to materialize.\n    if (saveHandle) {\n      let writable = null;\n      try {\n        // v7.0.45: remember how big the destination was BEFORE writing. If\n        // this save goes wrong the old copy is gone, and the alarm is only\n        // honest if it can name what was lost, not just what replaced it.\n        let prevBytes = 0;\n        try { prevBytes = (await saveHandle.getFile()).size || 0; } catch (e) {}\n        writable = await saveHandle.createWritable();\n        const result = await buildKpakV6(updateProg, writable, estTotalBytes);\n        await writable.close();\n        saved = true;\n        console.log('[SAVE V6] streamed to file');\n        updateProg(_isZhUI() ? '\u6821\u9A8C\u6587\u4EF6\u2026' : 'Verifying...', { doneItems: 1, totalItems: 1 });\n        const writtenFile = await saveHandle.getFile();\n        // v7.0.45: verification decides what the user is told. The old code ran\n        // its own bounds check here and, when readKpakV6Index() threw \u2014 which\n        // it ALWAYS does on a 0-byte file, because an empty file has no KPAK\n        // footer to find \u2014 caught the throw, logged it to the console, and let\n        // the success toast fire anyway. That is the reported bug exactly: the\n        // file is destroyed and the app says \"Saved \u2714\".\n        const verdict = await verifyKpakOutput(writtenFile);\n        const _allFailed = [...(result.failedItems || []).map(f => f.itemId), ..._lazyMaterializeFailed];\n        if (_allFailed.length > 0) {\n          console.error('[SAVE V6] failed media items:', result.failedItems, 'materialize failed:', _lazyMaterializeFailed);\n        }\n        const streamGood = await _finishSave({\n          fname: fname,\n          verdict: verdict,\n          expectedBytes: result.size || 0,\n          prevBytes: prevBytes,\n          missingItems: _allFailed,\n          manifestJson: result.manifestJson,\n          elapsed: progUI.elapsedSec()\n        });\n        if (!streamGood) {\n          // The destination is committed and broken. Drop the quick-save handle\n          // so the next Ctrl+S asks where to go instead of silently aiming at\n          // the file we just damaged.\n          state._saveHandle = null;\n        }\n      } catch (e) {\n        // A failed writable stream may have truncated the selected file. Abort\n        // it and do not mark the partial file as a successful save. The caller\n        // falls back to a verified download built from stable source Blobs.\n        try { if (writable && writable.abort) await writable.abort(e); } catch (abortErr) {\n          console.warn('[SAVE V6] could not abort failed stream:', abortErr.name, abortErr.message);\n        }\n        console.warn('[SAVE V6] stream failed, falling back to blob:', e.name, e.message);\n        state._saveHandle = null;\n        streamDestWarning = (_isZhUI() ? '\u5BEB\u5165 ' : 'Writing to ') + fname +\n          (_isZhUI() ? ' \u5931\u6557\uFF0C\u4F60\u539F\u672C\u55F0\u500B\u6A94\u6848\u53EF\u80FD\u5DF2\u7D93\u88AB\u6E05\u7A7A \u2014\u2014 \u8ACB\u6AA2\u67E5\u3002\u4E0B\u9762\u53E6\u5B58\u5605\u526F\u672C\u4FC2\u597D\u5605\u3002'\n                     : ' failed \u2014 your existing file may have been emptied. Please check it. The copy saved below is good.');\n      }\n    }\n\n    if (!saved) {\n      // Fallback: build blob (one entry in memory at a time, GC'd between)\n      const result = await buildKpakV6(updateProg, null, estTotalBytes);\n      const blob = result.blob;\n\n      // v7.0.45: one verifier, and its answer decides everything downstream.\n      // The old inline copy reported \"bad entry ranges\" but still downloaded\n      // the file afterwards, on the theory that a damaged board beats no\n      // board. It does not: a file that will not open is worse than an honest\n      // failure, because the user finds out weeks later.\n      updateProg(_isZhUI() ? '\u6821\u9A8C\u6587\u4EF6\u2026' : 'Verifying...', { doneItems: 1, totalItems: 1 });\n      const verdict = await verifyKpakOutput(blob);\n      const _allFailed = [...(result.failedItems || []).map(f => f.itemId), ..._lazyMaterializeFailed];\n      if (_allFailed.length > 0) {\n        console.error('[SAVE V6] failed media items:', result.failedItems, 'materialize failed:', _lazyMaterializeFailed);\n      }\n\n      const good = await _finishSave({\n        fname: fname,\n        verdict: verdict,\n        expectedBytes: blob.size,\n        prevBytes: 0,\n        missingItems: _allFailed,\n        manifestJson: result.manifestJson,\n        elapsed: progUI.elapsedSec(),\n        destWarning: streamDestWarning\n      });\n\n      if (good) {\n        // Keep the verified bytes so a later alarm can offer a real recovery\n        // instead of only bad news.\n        _lastGoodSaveBlob = { blob: blob, name: fname, at: Date.now() };\n        // v7.0.45: do NOT revoke this URL on a short timer. Chrome reads the\n        // blob lazily while it streams the download to disk; revoking the URL\n        // out from under a multi-hundred-megabyte download truncates it, and a\n        // truncated download is exactly how a 0 KB \".kpak\" appears in the\n        // Downloads folder while the app is already showing \"Saved \u2714\". The\n        // old 2000 ms timeout raced every save too big for the disk to absorb\n        // in two seconds \u2014 which is to say, most real ones. The URL is now\n        // held until the next save replaces it.\n        const url = URL.createObjectURL(blob);\n        _releaseLastSaveObjectUrl();\n        _lastSaveObjectUrl = url;\n        const a = document.createElement('a');\n        a.href = url;\n        a.download = fname;\n        document.body.appendChild(a);\n        a.click();\n        // Only the anchor is cleaned up here. The URL outlives it on purpose.\n        setTimeout(() => { try { a.remove(); } catch (e) {} }, 10000);\n        console.log('[SAVE V6] blob downloaded, size:', formatBytes(blob.size));\n      } else {\n        console.error('[SAVE V6] refusing to download a package that did not verify:', formatBytes(blob.size));\n      }\n    }\n\n  } catch (err) {\n    console.error('[SAVE V6] FAILED:', err.name, err.message);\n    updateProg('Error: ' + (err.message || 'unknown'));\n    // v7.0.45: a thrown save is a save that did not happen, and a two-second\n    // \"Save failed\" toast leaves the board looking saved once it fades. This\n    // now goes through the same alarm as a file that failed verification \u2014\n    // the user asked to be asked, not to be told in passing.\n    _showSaveAlarm({\n      fname: fname,\n      bytes: 0,\n      prevBytes: 0,\n      reason: (err && (err.name || err.message))\n        ? (String(err.name || '') + (err.message ? ': ' + err.message : ''))\n        : 'unknown error'\n    });\n    await new Promise(r => setTimeout(r, 3000));\n  } finally {\n    // Resume paused videos\n    _pausedVideos.forEach(function(v) { resumeMediaEl(v); });   // v7.0.33\n    try { progUI.done(); } catch (e) {}\n    _setSaving(false);\n  }\n}\n\n// v7.0.27: open a .kpak/.zip dropped onto the board (drag-to-open).\n// Shims an event-like object so the existing loader body runs unchanged \u2014\n// its event.target.value assignments just set a harmless property on our\n// plain object. Guards against concurrent loads / loads mid-save.\nasync function loadBoardFromFile(file) {\n  if (!file) return;\n  if (state._saving) { toast(_isZhUI() ? '\u4FDD\u5B58\u8FDB\u884C\u4E2D\uFF0C\u8BF7\u7A0D\u5019' : 'Please wait for save to finish'); return; }\n  if (state._loading) { toast(_isZhUI() ? '\u6B63\u5728\u8BFB\u53D6\uFF0C\u8BF7\u7A0D\u5019' : 'Load already in progress'); return; }\n  state._loading = true;\n  try { await loadBoardFile({ target: { files: [file], value: '' } }); }\n  finally { state._loading = false; }\n}\n\n// Load board from file \u2014 detects .kpak (zip) vs .json format\nasync function loadBoardFile(event) {\n  const file = event.target.files[0];\n  if (!file) return;\n  if (!file.size) {\n    toast('Error loading: selected file is empty (0 bytes)');\n    event.target.value = '';\n    return;\n  }\n\n  const isLarge = file.size > 5 * 1024 * 1024;\n  const fname = (file.name || '').toLowerCase();\n  const isKpak = fname.endsWith('.kpak') || fname.endsWith('.zip');\n\n  // Progress toast for large files\n  let prog = null;\n  if (isLarge) {\n    prog = makeProgressUI();\n    prog.update((_isZhUI() ? '\u8BFB\u53D6\u4E2D ' : 'Loading ') + formatBytes(file.size) + '...');\n  }\n\n  // v6.3.4: warn for very large files \u2014 JSZip async('blob') holds all media\n  // in memory as blob URLs. Files >1.5GB risk OOM on load.\n  // v6.5.0: detect KPAK v6 format FIRST \u2014 it doesn't need the JSZip warning\n  // because readKpakV6Index only reads the index, not the full file\n  let isV6Kpak = false;\n  try {\n    // Use explicit start/end bounds (not negative slice) for wider compatibility.\n    const tailStart = Math.max(0, file.size - 12);\n    const tailBuf = await file.slice(tailStart, file.size).arrayBuffer();\n    if (tailBuf && tailBuf.byteLength >= 4) {\n      const tailMagic = new TextDecoder().decode(new Uint8Array(tailBuf, 0, 4));\n      isV6Kpak = (tailMagic === 'KPAK');\n    }\n  } catch (e) {}\n\n  // Defensive fallback: if footer peek misses, probe parser once before JSZip.\n  // This avoids misrouting a valid v6 container into legacy zip load path.\n  if (isKpak && !isV6Kpak) {\n    try {\n      const probe = await readKpakV6Index(file);\n      if (probe && probe.entries && probe.entries.length > 0) {\n        isV6Kpak = true;\n        console.warn('[V6 LOAD] footer probe miss; parser probe matched v6 container');\n      }\n    } catch (_) {}\n  }\n\n  if (isV6Kpak) {\n    // v6 kpak uses Blob.slice() \u2014 no JSZip, no OOM. Skip the 1.5GB warning entirely.\n  } else if (file.size > 1.5 * 1024 * 1024 * 1024) {\n    // Only show warning for legacy zip format\n    const proceed = confirm(\n      '\u26A0 Very large kpak: ' + formatBytes(file.size) + '\\n\\n' +\n      'Loading may run out of memory (browser limit ~2GB).\\n' +\n      'Tip: close other tabs, or split the project into multiple smaller kpaks.\\n\\n' +\n      'Continue loading?'\n    );\n    if (!proceed) { event.target.value = ''; return; }\n  }\n\n  try {\n    if (isV6Kpak) {\n      // === KPAK v6 format \u2014 streaming load, no OOM ===\n      try {\n      if (prog) prog.update(_isZhUI() ? '\u8BFB\u53D6\u7D22\u5F15\u2026' : 'Reading index...');\n      console.log('[V6 LOAD] reading index from', formatBytes(file.size), 'file');\n      const { entries, manifest } = await readKpakV6Index(file);\n      console.log('[V6 LOAD] index read:', entries.length, 'entries');\n      const data = manifest;\n      console.log('[V6 LOAD] manifest:', data.items ? data.items.length : 0, 'items');\n\n      // v6.5.0: Lock support removed \u2014 always load directly\n      // Map entries to items \u2014 set _kpakEntry + _kpakBlob for on-demand extraction\n      const mediaEntries = entries.filter(e => e.name.startsWith('media/'));\n      let remappedCount = 0;\n      let loadedBytes = 0; // v7.0.27: real bytes restored, for the progress bar\n      const missingMediaIds = [];\n      const failedExtractIds = [];\n      for (const dataItem of data.items || []) {\n        const mediPrefix = 'media/' + dataItem.id + '.';\n        const entry = mediaEntries.find(e => e.name.startsWith(mediPrefix));\n        if (!entry) {\n          // v6.8.28: an item expects media but no entry was written for it.\n          // Usually means the blob URL was dead at save time.\n          if (dataItem.src && (dataItem.src.startsWith('blob:') || dataItem.src.startsWith('data:'))) {\n            missingMediaIds.push(dataItem.id);\n          }\n          continue;\n        }\n        dataItem._kpakEntry = entry;\n        dataItem._kpakBlob = file;\n        // v7.0.2: videos stay LAZY at load time \u2014 do NOT eagerly materialize\n        // their bytes here. extractKpakV6EntryBlob now reads the full entry\n        // into memory (needed to survive a same-file overwrite on save), so\n        // calling it unconditionally for every item would force-read every\n        // video into RAM during LOAD, defeating the whole \"no OOM on load\"\n        // design for large boards. Videos are safely materialized later,\n        // either on first playback activation or by saveBoardV6's pre-save\n        // materialize pass (both already handle _kpakEntry/_kpakBlob).\n        if (dataItem.isVideo) {\n          dataItem.src = '';\n          remappedCount++;\n          if (prog) prog.update((_isZhUI() ? '\u8FD8\u539F\u5A92\u4F53 ' : 'Restoring media ') + remappedCount + '/' + mediaEntries.length + '...', { doneBytes: loadedBytes, totalBytes: file.size, doneItems: remappedCount, totalItems: mediaEntries.length });\n          continue;\n        }\n        try {\n          // v6.8.30: retain the extracted Blob on the manifest item. On the\n          // next save, buildKpakV6 can stream this stable Blob directly\n          // instead of refetching a blob URL backed by the previously-loaded\n          // file.\n          const stableMediaBlob = await extractKpakV6EntryBlob(file, entry);\n          dataItem._sourceBlob = stableMediaBlob;\n          dataItem._fileSize = stableMediaBlob.size;\n          dataItem.src = URL.createObjectURL(stableMediaBlob);\n          remappedCount++;\n          loadedBytes += entry.size || 0;\n          if (prog) prog.update((_isZhUI() ? '\u8FD8\u539F\u5A92\u4F53 ' : 'Restoring media ') + remappedCount + '/' + mediaEntries.length + '...', { doneBytes: loadedBytes, totalBytes: file.size, doneItems: remappedCount, totalItems: mediaEntries.length });\n          if (remappedCount % 10 === 0) await new Promise(r => setTimeout(r, 0));\n        } catch(e) {\n          console.warn('Failed to extract', dataItem.id, e);\n          failedExtractIds.push(dataItem.id);\n        }\n      }\n\n      // v6.8.28: surface media problems immediately so the user knows what happened.\n      if (missingMediaIds.length > 0) {\n        console.error('[V6 LOAD] media entries missing for items:', missingMediaIds);\n      }\n      if (failedExtractIds.length > 0) {\n        console.error('[V6 LOAD] media extraction failed for items:', failedExtractIds);\n      }\n\n      let doAppend = false;\n      if (state.items.length > 0 || state.texts.length > 0) {\n        doAppend = confirm(\n          'Board already has ' + (state.items.length + state.texts.length) + ' items.\\n\\n' +\n          'OK = Append (add to existing board)\\nCancel = Replace (clear board first)'\n        );\n      }\n      restoreBoard(data, doAppend);\n\n      window._activateLazyVideoV6 = async function(item) {\n        if (!item.video) return;\n        if (!(item._sourceBlob instanceof Blob) && (!item._kpakEntry || !item._kpakBlob)) return;\n        // v7.0.6: skip if this exact item is already being activated, or\n        // just failed and is in its cooldown window. Without this, rapid\n        // mousemove-hover re-triggers for the SAME item pile up and retry\n        // forever the instant one attempt fails.\n        if (_lazyActivationShouldSkip(item.id)) return;\n        _lazyActivationInFlight.add(item.id);\n        try {\n          // v7.0.3: PREFER an already-materialized _sourceBlob. saveBoardV6's\n          // pre-save pass (and repeated saves) can populate _sourceBlob while\n          // leaving _kpakEntry/_kpakBlob set for bookkeeping \u2014 if this function\n          // ignores that and re-reads from _kpakBlob (the ORIGINAL loaded File\n          // handle), it can throw \"NotReadableError: The requested file could\n          // not be read\" the moment that file has since been overwritten by a\n          // save (e.g. Replace-save the same path). Only fall back to\n          // extracting from _kpakBlob when no materialized Blob exists yet.\n          const stableBlob = (item._sourceBlob instanceof Blob)\n            ? item._sourceBlob\n            : await extractKpakV6EntryBlob(item._kpakBlob, item._kpakEntry);\n          item._sourceBlob = stableBlob;\n          item._fileSize = stableBlob.size;\n          const blobUrl = URL.createObjectURL(stableBlob);\n          item.video.src = blobUrl;\n          item.src = blobUrl;\n          item.video.preload = 'auto';\n          item.video.load();\n          const _activatedSize = stableBlob.size;\n          delete item._kpakEntry;\n          delete item._kpakBlob;\n          console.log('[V6 Lazy] Activated video:', item.id, formatBytes(_activatedSize));\n        } catch(e) {\n          console.warn('[V6 Lazy] Failed:', item.id, e.message);\n          _lazyActivationCooldownUntil.set(item.id, Date.now() + LAZY_ACTIVATION_COOLDOWN_MS);\n        } finally {\n          _lazyActivationInFlight.delete(item.id);\n        }\n      };\n\n      if (prog) { try { prog.done(); } catch(e) {} }\n      const problems = missingMediaIds.length + failedExtractIds.length;\n      let msg = 'Loaded ' + formatBytes(file.size) + ' (v6 format, ' + data.items.length + ' items, ' + remappedCount + ' media \u00B7 ' + _fmtDurSec(prog ? prog.elapsedSec() : 0) + ')';\n      if (problems > 0) {\n        msg = 'Loaded ' + formatBytes(file.size) + ' \u26A0 ' + problems + ' media missing/failed (see Console). Check DevTools for item IDs.';\n        console.error('[V6 LOAD] summary \u2014 missing:', missingMediaIds.length, 'failed:', failedExtractIds.length);\n      }\n      toast(msg);\n      event.target.value = '';\n      return;\n      } catch (err) {\n        console.error('[V6 LOAD] FAILED:', err.name, err.message, err.stack);\n        if (prog) { try { prog.done(); } catch(e) {} }\n        toast('V6 load failed: ' + (err.message || 'unknown error') + ' \u2014 check console');\n        event.target.value = '';\n        return;\n      }\n    }\n\n    if (isKpak) {\n      // Detect: locked kpak = JSON wrapper (starts with '{'), binary kpak = zip (starts with 'PK')\n      // v6.3.7: use arrayBuffer for first-byte peek \u2014 file.text() consumes the stream\n      // and breaks subsequent JSZip.loadAsync(file) (caused \"permission\" error).\n      const firstBuf = await file.slice(0, 1).arrayBuffer();\n      const firstByte = String.fromCharCode(new Uint8Array(firstBuf)[0]);\n      if (firstByte === '{') {\n        // v6.5.0: Locked kpak (JSON wrapper) no longer supported\n        toast('Locked kpak files are no longer supported in v6.6.0. Please re-save from an older version.');\n        event.target.value = '';\n        return;\n      } else {\n      // === REGULAR KPAK (binary zip) ===\n      // === REGULAR KPAK (binary zip) ===\n      if (prog) prog.update((_isZhUI() ? '\u89E3\u5305 ' : 'Unpacking ') + formatBytes(file.size) + '...');\n      const zipBytes = await file.arrayBuffer();\n      if (!zipBytes || zipBytes.byteLength === 0) throw new Error('Selected file is empty (0 bytes)');\n      const zip = await JSZip.loadAsync(zipBytes);\n\n      // Read manifest\n      const manifestFile = zip.file('manifest.json');\n      if (!manifestFile) { toast('Invalid .kpak: no manifest.json found'); event.target.value = ''; return; }\n      const manifestJson = await manifestFile.async('string');\n      const data = JSON.parse(manifestJson);\n\n\n      // Remap media/ entries to blob URLs.\n      if (prog) prog.update(_isZhUI() ? '\u8FD8\u539F\u5A92\u4F53\u2026' : 'Restoring media...');\n      const mediaEntries = Object.keys(zip.files).filter(p => p.startsWith('media/') && !p.endsWith('/'));\n      let restoredCount = 0;\n      const remappedIds = new Set();\n      for (const dataItem of data.items || []) {\n        // v6.1: try to remap whenever a matching media/ entry exists,\n        // regardless of d.src's current value. The old prefix check\n        // (blob:/data:) was too strict \u2014 items with dead/empty src\n        // were skipped, then restoreBoard tried the stale src and\n        // produced ERR_FILE_NOT_FOUND.\n        const mediPrefix = 'media/' + dataItem.id + '.';\n        const entryPath = mediaEntries.find(p => p.startsWith(mediPrefix));\n        if (!entryPath) continue;\n\n        // v6.3.6: lazy video \u2014 defer blob extraction for video items.\n        // Videos can be hundreds of MB each; extracting them all at once\n        // during load OOMs the tab. Instead, store the zip entry reference\n        // and extract on first user interaction (select/click/hover).\n        if (dataItem.isVideo) {\n          dataItem._lazyEntry = entryPath;\n          dataItem._lazyZip = zip;\n          dataItem.src = ''; // placeholder \u2014 _activateLazyVideo sets real src\n          remappedIds.add(dataItem.id);\n          restoredCount++;\n          continue;\n        }\n\n        try {\n          const blob = await zip.file(entryPath).async('blob');\n          if (blob && blob.size > 0) {\n            // v7.0.1: retain the decoded legacy-KPAK Blob. Re-fetching the\n            // recreated object URL on a later save can produce network error /\n            // ERR_UPLOAD_FILE_CHANGED in Chrome.\n            dataItem._sourceBlob = blob;\n            dataItem._fileSize = blob.size;\n            dataItem.src = URL.createObjectURL(blob);\n            remappedIds.add(dataItem.id);\n            restoredCount++;\n            if (prog) prog.update((_isZhUI() ? '\u8FD8\u539F\u5A92\u4F53 ' : 'Restoring media ') + restoredCount + '/' + mediaEntries.length + '...', { doneItems: restoredCount, totalItems: mediaEntries.length });\n          }\n          // v6.3.4: yield to GC every 10 items to avoid peak memory buildup\n          if (restoredCount % 10 === 0) await new Promise(r => setTimeout(r, 0));\n        } catch (e) {\n          console.warn('Failed to restore media for item', dataItem.id, e);\n        }\n      }\n      // After remap: if any item still has a stale blob: URL that was NOT\n      // remapped (no media/ entry existed), strip it. Only touch items\n      // that didn't get a fresh remappedId \u2014 freshly-remapped blob: URLs\n      // are alive and must be preserved.\n      let deadBlobsStripped = 0;\n      for (const dataItem of data.items || []) {\n        if (typeof dataItem.src === 'string' && dataItem.src.startsWith('blob:') && !remappedIds.has(dataItem.id)) {\n          console.warn('[Load] Stripping dead blob URL for item', dataItem.id);\n          dataItem.src = '';\n          deadBlobsStripped++;\n        }\n      }\n      if (deadBlobsStripped > 0) console.log('[Load] Stripped ' + deadBlobsStripped + ' unrecoverable blob URL(s)');\n      console.log('[Krafted Load] kpak format, v' + (data._kraftedVersion || '?') + ', ' + (data.items || []).length + ' items, ' + restoredCount + ' media restored, ' + formatBytes(file.size));\n\n      // v6.4.0: if board already has items, ask whether to replace or append\n      var doAppend = false;\n      if (state.items.length > 0 || state.texts.length > 0) {\n        var appendChoice = confirm(\n          'Board already has ' + (state.items.length + state.texts.length) + ' items.\\n\\n' +\n          'OK = Append (add to existing board)\\n' +\n          'Cancel = Replace (clear board first)'\n        );\n        doAppend = appendChoice;\n      }\n      restoreBoard(data, doAppend);\n\n      // v6.3.6: after restoreBoard, attach lazy video activator to items that have _lazyEntry.\n      // The zip reference is kept alive on each item so _activateLazyVideo can extract blobs on demand.\n      window._activateLazyVideo = async function(item) {\n        if (!item.video) return;\n        if (!(item._sourceBlob instanceof Blob) && (!item._lazyEntry || !item._lazyZip)) return;\n        // v7.0.6: same re-entrancy guard as _activateLazyVideoV6.\n        if (_lazyActivationShouldSkip(item.id)) return;\n        _lazyActivationInFlight.add(item.id);\n        var entryPath = item._lazyEntry;\n        var zip = item._lazyZip;\n        try {\n          // v7.0.3: prefer an already-materialized _sourceBlob (e.g. from\n          // saveBoardV6's pre-save pass) over re-reading the JSZip entry \u2014\n          // same fix as _activateLazyVideoV6 above.\n          // v7.0.5: reuse the same concurrency limiter as the v6 KPAK path \u2014\n          // reading many large JSZip entries concurrently from the same\n          // in-memory zip can hit the same transient contention as slicing\n          // a giant File, especially right after loading a large legacy kpak.\n          var blob = item._sourceBlob instanceof Blob ? item._sourceBlob : await (async function() {\n            await _kpakExtractAcquire();\n            try { return await zip.file(entryPath).async('blob'); }\n            finally { _kpakExtractRelease(); }\n          })();\n          if (blob && blob.size > 0) {\n            var blobUrl = URL.createObjectURL(blob);\n            item._sourceBlob = blob;\n            item._fileSize = blob.size;\n            item.video.src = blobUrl;\n            item.src = blobUrl;\n            item.video.preload = 'auto';\n            item.video.load();\n            delete item._lazyEntry;\n            delete item._lazyZip;\n            console.log('[LazyVideo] Activated:', item.id, formatBytes(blob.size));\n          }\n        } catch(e) {\n          console.warn('[LazyVideo] Failed to activate:', item.id, e.message);\n          _lazyActivationCooldownUntil.set(item.id, Date.now() + LAZY_ACTIVATION_COOLDOWN_MS);\n        } finally {\n          _lazyActivationInFlight.delete(item.id);\n        }\n      };\n      toast('Loaded ' + formatBytes(file.size) + ' (' + restoredCount + ' media restored)');\n      } // end regular kpak\n    } else {\n      // === JSON LOAD (legacy .json / .krafted) ===\n      const text = await new Promise((resolve, reject) => {\n        const reader = new FileReader();\n        reader.onload = () => resolve(reader.result);\n        reader.onerror = () => reject(reader.error);\n        reader.readAsText(file);\n      });\n\n      // Defensive: empty file?\n      if (!text || text.trim().length === 0) {\n        toast('Error loading: file is empty');\n        event.target.value = '';\n        return;\n      }\n      console.log('[Load] file size:', file.size, 'text length:', text.length, 'first 200 chars:', text.substring(0, 200));\n\n      let data;\n      try { data = JSON.parse(text); }\n      catch(err) {\n        console.error('[Load] JSON parse error:', err);\n        console.error('[Load] file size:', file.size, 'text length:', text.length);\n        console.error('[Load] last 500 chars:', text.substring(text.length - 500));\n        toast('Error loading: Invalid JSON: ' + err.message);\n        event.target.value = '';\n        return;\n      }\n\n      // v6.5.0: Locked kpak/JSON no longer supported \u2014 skip to plain JSON load\n      if (data._kraftedLock) {\n        toast('Locked files are no longer supported in v6.5.0. Please re-save from an older version.');\n        event.target.value = '';\n        return;\n      }\n\n      // Log what we got\n      const embedded = (data.items || []).filter(d => d.mediaData).length;\n      console.log('[Krafted Load] v' + (data._kraftedVersion || 'legacy') + ', ' + (data.items || []).length + ' items, ' + embedded + ' embedded, ' + formatBytes(file.size));\n\n      restoreBoard(data);\n      // Re-apply DPI scale after board restore \u2014 the DOM rebuild\n      // from restoreBoard() creates fresh player controls that need\n      // the --dpi-scale CSS variable on body.\n      if (typeof window._applyDpiScale === 'function') window._applyDpiScale();\n      toast('Board loaded!');\n    }\n  } catch (err) {\n    console.error('loadBoardFile failed:', err);\n    toast('Error loading: ' + (err.message || 'unknown error'));\n  } finally {\n    try { prog && prog.done(); } catch (e) {}\n    event.target.value = '';\n  }\n}\n\n// v7.0.43: sentinel written in place of a blob: URL. The bytes themselves\n// are mirrored into IndexedDB by persistAutosaveMedia().\nconst AUTOSAVE_MEDIA_PREFIX = 'autosave-media:';\n\n// Backwards-compatible sync serialize (used by autosave)\n// v5.5 stripped ALL media src (blob: and data:) to dodge the localStorage\n// QuotaExceededError, on the assumption that \"media is reloaded from\n// original files/kpak\". Nothing on the autosave path ever did that reload,\n// so every restored item came back as an empty shell \u2014 the bug fixed here.\n// The JSON still carries layout only; the bytes now go to IndexedDB and\n// come back through the sentinel above.\nfunction serializeBoard() {\n  return JSON.stringify({\n    // v6.8.26: marker \u2014 texts store w/h/size in WORLD coords. Old files\n    // without this marker stored them as on-screen px and are converted\n    // on load (divided by the file's saved zoom) in restoreBoard().\n    _textWorld: true,\n    items: state.items.map(i => {\n      const d = {\n        id: i.id,\n        x: i.x, y: i.y, w: i.w, h: i.h, rot: i.rot, opacity: i.opacity,\n        flipH: i.flipH, flipV: i.flipV, locked: i.locked, z: i.z,\n        // v7.0.43: a blob: URL is a pointer into the document that minted\n        // it, so it is already dead by the time Restore is clicked. Write a\n        // sentinel; persistAutosaveMedia() puts the real bytes in IndexedDB\n        // and rehydrateAutosaveMedia() swaps it back for a fresh object URL.\n        // A data: URL is already inline in this JSON \u2014 leave it alone.\n        src: (i.src && i.src.indexOf('blob:') === 0) ? (AUTOSAVE_MEDIA_PREFIX + i.id) : (i.src || ''),\n        natW: i.natW, natH: i.natH, isVideo: i.isVideo || false, isGif: i.isGif || false, isAudio: i.isAudio || false, isProxy: i.isProxy || false, originalName: i.originalName || '', audioName: i.audioName || '',\n        filename: i.filename || '',\n        cropX: i.cropX, cropY: i.cropY, cropW: i.cropW, cropH: i.cropH, frameOn: i.frameOn || false, frameZ: i.frameZ || 1, frameRot: i.frameRot || 0, frameX: i.frameX || 0, frameY: i.frameY || 0, name: i.name || '', note: i.note || '', tags: i.tags ? i.tags.slice() : [],\n        brightness: i.brightness, contrast: i.contrast, saturate: i.saturate,\n        hueRotate: i.hueRotate, blur: i.blur, sepia: i.sepia, grayscale: i.grayscale,\n        temp: i.temp, vignette: i.vignette, shadow: i.shadow, highlight: i.highlight, grain: i.grain,\n        trimStart: i.trimStart || 0, trimEnd: i.trimEnd || 0, playbackRate: i.playbackRate || 1,\n        isLink: i.isLink || false, linkUrl: i.linkUrl || '', linkTitle: i.linkTitle || '', linkDesc: i.linkDesc || '',\n        masks: (i.masks || []).map(m => ({ id: m.id, name: m.name, enabled: m.enabled, type: m.type, color: m.color, tolerance: m.tolerance, feather: m.feather, brushData: m.brushData, brushSize: m.brushSize, brightness: m.brightness, contrast: m.contrast, saturate: m.saturate, temp: m.temp, shadow: m.shadow, highlight: m.highlight, hueRotate: m.hueRotate, sepia: m.sepia, tintColor: m.tintColor, tintStrength: m.tintStrength })),\n      };\n      if (i.type === 'draw') {\n        d.type = 'draw'; d.strokeId = i.strokeId;\n        d.drawMode = i.drawMode; d.drawColor = i.drawColor;\n        d.drawSize = i.drawSize; d.drawOpacity = i.drawOpacity;\n        d.drawArrowHead = i.drawArrowHead;\n        // v7.0.29: keep packed strokes so autosave / export round-trips them\n        var _pds2 = i.drawStrokes || (i.el && i.el._strokeData) || null;\n        if (_pds2 && _pds2.length) {\n          d.drawStrokes = _pds2;\n          d.drawPad = i.drawPad; d.drawMinX = i.drawMinX; d.drawMinY = i.drawMinY;\n          d.drawW = i.drawW; d.drawH = i.drawH;\n        }\n      }\n      // v7.0.43: v5.5 used to clear d.src here and set videoLost/imageLost,\n      // which is precisely why Restore came back as empty shells. The\n      // sentinel