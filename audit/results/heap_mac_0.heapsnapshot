d yet'); } catch (e) {} return; }\n  const it = _csItem();\n  if (!it) return;\n  const url = _cs.dataUrl;\n  const n = _cs.count;\n  const img = new Image();\n  img.onload = function () {\n    // item.h is the media box only \u2014 the player's controls bar hangs\n    // below it, so measuring the element is the only way to place the\n    // strip clear of the player instead of on top of it.\n    let belowY = it.y + (it.h || 0) + 24;\n    try {\n      if (it.el && it.el.getBoundingClientRect) {\n        const bcr = it.el.getBoundingClientRect();\n        if (bcr.height > 0) belowY = it.y + (bcr.height / (state.zoom || 1)) + 24;\n      }\n    } catch (e) {}\n    const w = Math.max(120, it.w || 640);\n    const h = Math.round(w * (img.height / img.width));\n    const newItem = addImage(url, img.width, img.height, it.x, belowY);\n    if (newItem) {\n      newItem.w = w;\n      newItem.h = h;\n      try { updateItemStyle(newItem); } catch (e) {}\n      try { updateCanvas(); } catch (e) {}\n    }\n    try { scheduleAutoSave(); } catch (e) {}\n    try { toast('Contact sheet added \u00B7 ' + n + ' frames'); } catch (e) {}\n    closeContactSheet();\n  };\n  img.onerror = function () { try { toast('Could not decode the sheet'); } catch (e) {} };\n  img.src = url;\n}\n\nfunction downloadContactSheet() {\n  if (!_cs.dataUrl) return;\n  const it = _csItem();\n  const base = (it && it.filename ? it.filename.replace(/\\.[^.]+$/, '') : 'clip') || 'clip';\n  try {\n    const a = document.createElement('a');\n    a.href = _cs.dataUrl;\n    a.download = base + '-contact-sheet-' + _cs.count + '.jpg';\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n  } catch (e) {\n    try { toast('Download failed'); } catch (e2) {}\n  }\n}\n\nfunction closeContactSheet() {\n  _cs.token++;   // cancels any in-flight frame read\n  const modal = document.getElementById('contact-sheet-modal');\n  if (modal) modal.classList.remove('active');\n  const cv = document.ge