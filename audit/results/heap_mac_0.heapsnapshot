45\u8272',\n    'Warm paper': '\u6696\u7EB8\u8272',\n    'Paper / Artboard': '\u7EB8\u5F20 / \u753B\u677F',\n    'Show Paper': '\u663E\u793A\u7EB8\u5F20',\n    'Hide Paper': '\u9690\u85CF\u7EB8\u5F20',\n    'Auto-fit: ON': '\u81EA\u52A8\u9002\u5E94\uFF1A\u5F00',\n    'Auto-fit: OFF': '\u81EA\u52A8\u9002\u5E94\uFF1A\u5173',\n    'Paper Color': '\u7EB8\u5F20\u989C\u8272',\n    'W': '\u5BBD',\n    'H': '\u9AD8',\n    '4K': '4K',\n\n    // \u2500\u2500 GIF Editor \u2500\u2500\n    'GIF Trim Editor': 'GIF \u88C1\u526A\u7F16\u8F91\u5668',\n    'Preview': '\u9884\u89C8',\n    'Total Frames:': '\u603B\u5E27\u6570\uFF1A',\n    'Duration:': '\u65F6\u957F\uFF1A',\n    'Trim:': '\u88C1\u526A\uFF1A',\n    'Speed:': '\u901F\u5EA6\uFF1A',\n    'Apply Trim': '\u5957\u7528\u88C1\u526A',\n    'Export GIF': '\u5BFC\u51FA GIF',\n    'Frame Strip (click to set In point)': '\u5E27\u6761 (\u70B9\u51FB\u8BBE\u5B9A\u8D77\u59CB\u70B9)',\n\n    // \u2500\u2500 Context menu \u2500\u2500\n    'Duplicate Ctrl+Shift+D': '\u590D\u5236 Ctrl+Shift+D',\n    'Copy Ctrl+C': '\u590D\u5236 Ctrl+C',\n    'Paste Ctrl+V': '\u8D34\u4E0A Ctrl+V',\n    '\u2713 Alt+Left Pan (Mac trackpad)': '\u2713 Alt+\u5DE6\u952E\u5E73\u79FB (Mac \u89E6\u63A7\u677F)',\n    '\u25CB Alt+Left Pan (Mac trackpad)': '\u25CB Alt+\u5DE6\u952E\u5E73\u79FB (Mac \u89E6\u63A7\u677F)',\n    '\u2699 Wheel: Mouse (zoom)': '\u2699 \u6EDA\u8F6E\uFF1A\u9F20\u6807\uFF08\u7F29\u653E\uFF09',\n    '\u2699 Wheel: Trackpad (pan)': '\u2699 \u6EDA\u8F6E\uFF1A\u89E6\u63A7\u677F\uFF08\u5E73\u79FB\uFF09',\n    'Same Size Ctrl+Alt+\u2191': '\u76F8\u540C\u5927\u5C0F Ctrl+Alt+\u2191',\n    'Distribute H': '\u6C34\u5E73\u5206\u5E03',\n    'Distribute V': '\u5782\u76F4\u5206\u5E03',\n    '\uF9F9 Tidy Selected': '\uF9F9 \u6574\u7406\u9009\u53D6',\n    'Trim GIF': '\u88C1\u526A GIF',\n    'Save media files\u2026': '\u50A8\u5B58\u5A92\u4F53\u6863\u2026',\n    '\uF4DD Export notes as HTML\u2026': '\uF4DD \u532F\u51FA\u5716\u6587\u5099\u8A3B HTML\u2026',\n    'Crop Image C': '\u88C1\u526A\u56FE\u7247 C',\n    'Reframe Image Enter': '\u91CD\u6784\u56FE\u7247 Enter',\n    'Lock/Unlock': '\u9501\u5B9A/\u89E3\u9501',\n    'Translate EN->\u4E2D': '\u7FFB\u8BD1 EN\u2192\u4E2D',\n    'Group Ctrl+G': '\u7FA4\u7EC4 Ctrl+G',\n    'Ungroup Ctrl+Shift+G': '\u53D6\u6D88\u5206\u7EC4 Ctrl+Shift+G',\n    'Bring to Front': '\u79FB\u81F3\u6700\u524D',\n    'Send to Back': '\u79FB\u81F3\u6700\u540E',\n    'Delete Del': '\u5220\u9664 Del',\n    'Import Audio': '\u6C47\u5165\u97F3\u8BAF',\n    'Save images as PNG\u2026': '\u50A8\u5B58\u4E3A PNG \u56FE\u7247\u2026',\n    'Save original files\u2026': '\u50A8\u5B58\u539F\u59CB\u6863\u6848\u2026',\n    '\uF9F9 Tidy All': '\uF9F9 \u5168\u90E8\u6574\u7406',\n    'Help & Shortcuts H': '\u5E2E\u52A9\u4E0E\u5FEB\u6377\u952E H',\n    '\uF517 Toggle Relations': '\uF517 \u5207\u6362\u5173\u7CFB\u7EBF',\n\n    // \u2500\u2500 Player controls \u2500\u2500\n    'Player Fullscreen': '\u64AD\u653E\u5668\u5168\u5C4F\u5E55',\n    'Exit Player Fullscreen (Esc)': '\u9000\u51FA\u5168\u5C4F\u5E55 (Esc)',\n    'Open frame comments  (shortcut: M)': '\u5F00\u542F\u5E27\u7559\u8A00 (\u5FEB\u6377\u952E: M)',\n    'Draw on the frame (D) \u2014 arrows / freehand annotations saved with the next comment': '\u5728\u5E27\u4E0A\u7ED8\u56FE (D) \u2014 \u7BAD\u5934/\u624B\u7ED8\u6CE8\u89E3\u968F\u4E0B\u6B21\u7559\u8A00\u4FDD\u5B58',\n    'Clean mode (H) \u2014 hide all controls for distraction-free viewing': '\u7B80\u6D01\u6A21\u5F0F (H) \u2014 \u9690\u85CF\u6240\u6709\u63A7\u5236\u9879',\n    'Snap all annotated frames \u2014 batch-capture every frame that has draw/text strokes as a frame comment': '\u64B7\u53D6\u6240\u6709\u6CE8\u89E3\u5E27',\n    'Snap': '\u64B7\u53D6',\n    'Press H or click to exit clean mode': '\u6309 H \u6216\u70B9\u51FB\u9000\u51FA\u7B80\u6D01\u6A21\u5F0F',\n\n    // \u2500\u2500 Video annotation toolbar \u2500\u2500\n    'Arrow mode \u2014 click and drag to draw an arrow': '\u7BAD\u5934\u6A21\u5F0F \u2014 \u62D6\u52A8\u7ED8\u5236\u7BAD\u5934',\n    'Freehand pen mode \u2014 click and drag to draw': '\u624B\u7ED8\u7B14\u6A21\u5F0F \u2014 \u62D6\u52A8\u7ED8\u5236',\n    'Box / rectangle mode \u2014 click and drag to draw a box': '\u65B9\u6846\u6A21\u5F0F \u2014 \u62D6\u52A8\u7ED8\u5236\u65B9\u6846',\n    'Circle / ellipse mode \u2014 click and drag to draw a circle': '\u5706\u5F62\u6A21\u5F0F \u2014 \u62D6\u52A8\u7ED8\u5236\u5706\u5F62',\n    'Text mode \u2014 click on the video to place a text annotation': '\u6587\u5B57\u6A21\u5F0F \u2014 \u70B9\u51FB\u89C6\u9891\u653E\u7F6E\u6587\u5B57\u6CE8\u89E3',\n    'Click to pick saturation & brightness': '\u70B9\u51FB\u9009\u62E9\u9971\u548C\u5EA6\u4E0E\u4EAE\u5EA6',\n    'Drag to pick hue': '\u62D6\u52A8\u9009\u62E9\u8272\u76F8',\n    'Lock to player \u2014 stay in draw mode between strokes (off -> keep current tool, on -> continuous draw)': '\u9501\u5B9A\u64AD\u653E\u5668 \u2014 \u4FDD\u6301\u7ED8\u56FE\u6A21\u5F0F',\n    'Clear all strokes on this frame': '\u6E05\u9664\u6B64\u5E27\u6240\u6709\u7B14\u5212',\n    'Done drawing (Esc)': '\u5B8C\u6210\u7ED8\u56FE (Esc)',\n    'Exit draw mode (press the draw button again to come back)': '\u9000\u51FA\u7ED8\u56FE\u6A21\u5F0F',\n    'Snap the draw panel back to the video (re-enable follow)': '\u5C06\u7ED8\u56FE\u9762\u677F\u5BF9\u9F50\u89C6\u9891',\n    'Drag to move the toolbar': '\u62D6\u52A8\u79FB\u52A8\u5DE5\u5177\u5217',\n\n    // \u2500\u2500 Frame comments popover \u2500\u2500\n    'Translate the typed text \u2014 auto-detects source language (uses MyMemory/Google translate API; offline / network failure shows a hint)': '\u7FFB\u8BD1\u6587\u5B57 \u2014 \u81EA\u52A8\u4FA6\u6D4B\u8BED\u8A00',\n    '\uF310 \u2192 \u4E2D': '\uF310 \u2192 \u4E2D',\n    '\u23F3': '\u23F3',\n    'no change': '\u65E0\u53D8\u66F4',\n    '\u2717 offline': '\u2717 \u79BB\u7EBF',\n    'Add': '\u65B0\u589E',\n    '\uF4DD (overall comment)': '\uF4DD (\u6574\u4F53\u7559\u8A00)',\n    'Drag to resize': '\u62D6\u52A8\u8C03\u6574\u5927\u5C0F',\n    'Click to view full-size snapshot with annotations': '\u70B9\u51FB\u67E5\u770B\u5B8C\u6574\u622A\u56FE\u4E0E\u6CE8\u89E3',\n    'Click to jump to this frame': '\u70B9\u51FB\u8DF3\u5230\u6B64\u5E27',\n    'Jump to this frame (...)': '\u8DF3\u5230\u6B64\u5E27 (...)',\n    'Translate': '\u7FFB\u8BD1',\n    'Delete': '\u5220\u9664',\n    'Click to type...': '\u70B9\u51FB\u8F93\u5165...',\n    'Export frame comments + snapshots + over comment to HTML (uses original file name)': '\u5BFC\u51FA\u5E27\u7559\u8A00+\u622A\u56FE\u4E3A HTML',\n    '\u2913 Export': '\u2913 \u5BFC\u51FA',\n    'Send every snap+text comment to the canvas as a 2-column storyboard...': '\u5C06\u6240\u6709\u622A\u56FE+\u7559\u8A00\u53D1\u9001\u5230\u753B\u5E03',\n    '\uF4CB Board': '\uF4CB \u9762\u677F',\n    'Export the video with per-frame drawings baked in (.mp4)': '\u5BFC\u51FA\u542B\u5E27\u7ED8\u56FE\u7684\u89C6\u9891 (.mp4)',\n    '\uF3AC Video': '\uF3AC \u89C6\u9891',\n    'Close  (Esc)': '\u5173\u95ED (Esc)',\n    'Delete ALL comments for this video (cannot be undone \u2014 confirmation asked)': '\u5220\u9664\u6B64\u89C6\u9891\u6240\u6709\u7559\u8A00 (\u65E0\u6CD5\u64A4\u9500)',\n    '\uF5D1 Clear': '\uF5D1 \u6E05\u9664',\n    'Hide / show snapshot thumbnails on every comment card': '\u9690\u85CF/\u663E\u793A\u7559\u8A00\u5361\u7F29\u56FE',\n    '\uF4CC Follow': '\uF4CC \u8DDF\u968F',\n    'Snap the popover back to the video (re-enable follow)': '\u5C06\u5F39\u7A97\u5BF9\u9F50\u89C6\u9891',\n    'Show the draw toolbar and start drawing (or press Ctrl+D / the draw button)': '\u663E\u793A\u7ED8\u56FE\u5DE5\u5177\u5217',\n    'Translate every comment to the other language at once (sequential, ~1s per comment)': '\u4E00\u6B21\u7FFB\u8BD1\u6240\u6709\u7559\u8A00',\n    '\uF310->\u4E2D All': '\uF310\u2192\u4E2D \u5168\u90E8',\n\n    // \u2500\u2500 Toast messages (frequent ones) \u2500\u2500\n    'Board cleared!': '\u9762\u677F\u5DF2\u6E05\u9664\uFF01',\n   