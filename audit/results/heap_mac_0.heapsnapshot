const tagM = html.match(/<img[^>]*>/i);\n      if (tagM) {\n        const tag = tagM[0];\n        // srcset: pick the best candidate AT OR BELOW ~1600w (e.g.\n        // Pinterest drags carry \"\u2026236x.jpg 236w, \u2026736x.jpg 736w,\n        // \u2026originals\u2026.jpg 1200w\"). v7.0.19: previously we took the\n        // LARGEST variant \u2014 'originals' can be several MB, and ~3 such\n        // drags created enough memory pressure for Chrome's OOM killer\n        // to crash the heavy SOURCE tab (Pinterest). If every variant is\n        // above 1600w, take the closest one above; if there are no width\n        // descriptors, keep the last (largest) entry.\n        const ssM = tag.match(/srcset\\s*=\\s*[\"']([^\"']+)[\"']/i);\n        if (ssM) {\n          let bestLe = null, bestLeW = -1;\n          let bestGt = null, bestGtW = Infinity;\n          let largest = null, largestW = -1;\n          ssM[1].split(',').forEach(function(part) {\n            const bits = part.trim().split(/\\s+/);\n            if (!bits[0]) return;\n            const w = (bits[1] && /w$/i.test(bits[1])) ? parseInt(bits[1], 10) : 0;\n            if (w > largestW) { largestW = w; largest = bits[0]; }\n            if (w > 0 && w <= 1600 && w > bestLeW) { bestLeW = w; bestLe = bits[0]; }\n            if (w > 1600 && w < bestGtW) { bestGtW = w; bestGt = bits[0]; }\n          });\n          const pick = bestLe || bestGt || largest;\n          if (pick) _pushCandidate(pick);\n        }\n        const srcM = tag.match(/\\ssrc\\s*=\\s*[\"']([^\"']+)[\"']/i);\n        if (srcM) _pushCandidate(srcM[1]);\n      }\n      // v7.0.21: dragging from a Pinterest CLOSEUP (the opened big-image\n      // view) can carry a DIV with background-image instead of an <img>\n      // tag \u2014 scan the whole html payload for url(...) references too.\n      const urlRe = /url\\(\\s*[\"']?([^\"')]+)[\"']?\\s*\\)/g;\n      let um;\n      while ((um = urlRe.exec(html)) !== null) {\n        if (/^https?:\\/\\//i.te