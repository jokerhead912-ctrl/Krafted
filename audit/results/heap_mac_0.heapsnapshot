he snapshot has been validated, and\n// the live state is captured first as a safety net that gets replayed if the\n// rebuild throws or produces fewer items than the snapshot promised.\n// safetyStr: the state to replay if the rebuild fails. undo()/redo() already\n// snapshot the live board before they restore (that is what feeds the opposite\n// stack), so they hand it in here and we avoid a second full serialisation.\nfunction restoreSnapshot(snapStr, safetyStr) {\n  let snap = null;\n  try { snap = safeJSONParse(snapStr, null); } catch (e) { snap = null; }\n  if (!snap || typeof snap !== 'object' || !Array.isArray(snap.items)) {\n    console.error('[undo] refusing to restore an unreadable snapshot');\n    try {\n      toast((typeof _isZhUI === 'function' && _isZhUI())\n        ? '\u64A4\u9500\u5931\u8D25\uFF1A\u65E0\u6CD5\u8BFB\u53D6\u5386\u53F2\u8BB0\u5F55\uFF0C\u753B\u677F\u4FDD\u6301\u539F\u6837'\n        : 'Undo failed \u2014 unreadable history, board left untouched');\n    } catch (e) {}\n    return false;\n  }\n  let safety = (typeof safetyStr === 'string' && safetyStr) ? safetyStr : null;\n  if (!safety) { try { safety = _captureSnapshotSafe(); } catch (e) {} }\n  let ok = true;\n  try {\n    applySnapshot(snap);\n  } catch (err) {\n    console.error('[undo] restore threw:', err);\n    ok = false;\n  }\n  if (!ok || (snap.items.length > 0 && state.items.length === 0)) {\n    console.error('[undo] restore produced an empty board \u2014 replaying the safety snapshot');\n    if (safety) {\n      try { applySnapshot(safeJSONParse(safety, null)); } catch (e) {}\n    }\n    try {\n      toast((typeof _isZhUI === 'function' && _isZhUI())\n        ? '\u64A4\u9500\u65F6\u51FA\u9519\uFF0C\u5DF2\u8FD8\u539F\u753B\u677F'\n        : 'Undo hit an error \u2014 board restored');\n    } catch (e) {}\n    return false;\n  }\n  return true;\n}\n\nfunction applySnapshot(snap) {\n  // Remove all current items\n  cleanupAllItems();\n  state.items = [];\n  state.texts = [];\n  