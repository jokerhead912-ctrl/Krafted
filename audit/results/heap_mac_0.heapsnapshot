screen text coords \u00F7 savedZoom ' + _textMigZ);\n  if (!append) {\n    G.nextZ = 1;\n  }\n  let maxId = append ? state.items.reduce((m, it) => Math.max(m, it.id || 0), 0) : 0;\n  if (append) {\n    G.nextZ = state.items.reduce((m, it) => Math.max(m, (it.z || 0) + 1), G.nextZ);\n  }\n\n  // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // v6.8.3: ID COLLISION GUARD\n  //\n  // Every restore path used to do `d.id !== undefined ? d.id : (maxId+1)`,\n  // i.e. it blindly trusted the id stored in the file. In APPEND mode\n  // (loading a second board onto an existing one) that id can already\n  // belong to an item on the canvas \u2014 and it very often does, because\n  // ids are small sequential integers, so two boards saved from separate\n  // sessions both contain id 1, 2, 3...\n  //\n  // Selection is id-based:\n  //   getSelectedItems() -> [...].filter(i => state.selected.has(i.id))\n  // so two items sharing an id BOTH match a single selection. Clicking\n  // one selected/moved/scaled both \u2014 the \"stuck together\" duplicates\n  // the user reported.\n  //\n  // Fix: track every id already in use (existing canvas items in append\n  // mode, plus everything assigned during this restore) and hand out a\n  // fresh id whenever the file's id is missing OR already taken.\n  //\n  // Non-append (normal full load) keeps the file's ids verbatim, so\n  // nothing changes there \u2014 groups/relations/strokes that reference ids\n  // by value stay valid. Collisions are impossible in that path anyway\n  // because the board is cleared first.\n  // \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  const _usedIds = new Set();\n  if (append) {\n    [].concat(\n      state.items || [], state.texts || [],\n      state.todos || [], state.mindmaps || []\n    ).forEach(function(it) { if (it && it.id !== undefined) _usedIds.add(it.id); });\n  }\n  // Maps an id from the file to the id actually used, so downstream\n  // references (groups, relations) can be remapped after the fact.\n  const _idRemap = new Map();\n  function _claimId(rawId) {\n    let id = rawId;\n    if (id === undefined || (append && _usedIds.has(id))) {\n      // Take the next free integer above everything seen so far.\n      do { maxId += 1; } while (_usedIds.has(maxId));\n      id = maxId;\n      if (rawId !== undefined) _idRemap.set(rawId, id);\n    }\n    _usedIds.add(id);\n    if (typeof id === 'number' && id > maxId) maxId = id;\n    return id;\n  }\n  data.items.forEach(d => {\n    try {\n    // Skip video items whose blob: URL was lost on reload\n    // v6.5.0: also check _kpakEntry \u2014 v6 lazy videos have empty src but valid _kpakEntry\n    if (d.videoLost || (d.isVideo && !d.src && !d.mediaData && !d._kpakEntry && !d._lazyEntry)) {\n      console.log('[RESTORE] skip item id=' + d.id + ' isVideo=' + d.isVideo + ' src=' + (d.src ? 'set' : 'EMPTY') + ' _kpakEntry=' + !!d._kpakEntry);\n      return;\n    }\n    // v5.5: Skip image items whose blob URL was lost (auto-save stripped src).\n    // They'll show as a grey placeholder with dimensions preserved.\n    if (d.imageLost && !d.mediaData) {\n      // Still create the item so layout is preserved \u2014 just without the image\n      d.src = '';\n    }\n    // Round 78: if we have embedded media, restore it as a blob URL\n    // BE