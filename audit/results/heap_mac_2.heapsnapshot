.nextGroupId || (Math.max(...data.groups.map(g => g.id), 0) + 1);\n    }\n    data.groups.forEach(gd => {\n      // v6.8.3: memberIds must go through _idRemap too (see relations above).\n      // Without this, appending a board whose ids collided would leave the\n      // group pointing at the pre-existing items instead of its own.\n      // Group ids are renumbered when appending so two boards' groups can't\n      // share an id (ungroup / border updates look groups up by id).\n      const _gid = append ? (G.nextGroupId++) : gd.id;\n      state.groups.push(makeGroupEl({ id: _gid, color: gd.color, name: gd.name, memberIds: (gd.memberIds || []).map(_remapId) }));\n    });\n    setTimeout(() => updateAllGroupBorders(), 200);\n  }\n  // v7.0.40: restore named views. Their `ids` go through _idRemap exactly like\n  // group memberIds do \u2014 appending a board renumbers every incoming item, so a\n  // view carrying the pre-remap ids would frame nothing at all (or, worse,\n  // frame the OTHER board's items). On a full load the list is replaced; when\n  // appending, the incoming views are added to the ones already on the board.\n  if (!append) state.views = [];\n  if (data.views && data.views.length) {\n    data.views.forEach(function (vd) {\n      state.views.push(deserializeView(vd, _remapId));\n    });\n    // Full load: trust the saved counter. Append: the two boards' counters\n    // may collide, so drop it and let nextViewId() re-derive from the merged\n    // list (it falls back to max(id)+1 when G.nextViewId is not a number).\n    G.nextViewId = (!append && Number.isFinite(data.nextViewId)) ? data.nextViewId : undefined;\n  }\n  if (!append) state._activeViewIndex = -1;\n  try { renderViewsPanel(); } catch (e) {}\n  // Restore paper / artboard\n  if (data.paper) {\n    paperState.enabled = data.paper.enabled || false;\n    paperState.autoFit = data.paper.autoFit || false;\n    paperState.width = data.paper.width || 1920;\n    paperState.height = data.paper.height || 1080;\n    paperState.color = data.paper.color || '#ffffff';\n    document.getElementById('paper-controls').style.display = paperState.enabled ? 'block' : 'none';\n    document.getElementById('paper-w').value = paperState.width;\n    document.getElementById('paper-h').value = paperState.height;\n    // Update auto-fit button state\n    const afBtn = document.getElementById('btn-autofit-toggle');\n    if (afBtn) { afBtn.textContent = paperState.autoFit ? 'Auto-fit: ON' : 'Auto-fit: OFF'; afBtn.style.color = paperState.autoFit ? 'var(--accent)' : ''; }\n    const wInput = document.getElementById('paper-w');\n    const hInput = document.getElementById('paper-h');\n    if (wInput) wInput.disabled = paperState.autoFit;\n    if (hInput) hInput.disabled = paperState.autoFit;\n    document.getElementById('btn-paper-toggle').textContent = paperState.enabled ? 'Hide Paper' : 'Show Paper';\n    updatePaper();\n  }\n  if (data.canvasBg) setCanvasBg(data.canvasBg);\n  updateCanvas();\n  redrawDrawLayer();\n  _frozenGifs.clear();\n  // v6.0: fit-to-content after load. If the user was previously zoomed\n  // in on a different board, the loaded items would render at the wrong\n  // scale / off-screen. Compute the bounding box of all loaded items\n  // and frame the viewport so the user sees them on first paint.\n  // v6.4.1: skip in append mode \u2014 preserve user's existing zoom/pan.\n  if (!append) {\n  // v6.7.24: skip the auto fit-to-content zoom/pan. The user's save-time\n  // viewport (data.zoom / data.pan) was already restored above. Running\n  // fit-to-content here overwrote the saved zoom (e.g. a small text box\n  // at w=160,h=56 made the viewport zoom out to 10x because the bbox\n  // was tiny relative to the screen), which is exactly what the user\n  // does NOT want \u2014 save/load should preserve the camera position.\n  // If we ever want fit-to-content on load, do it as a separate user\n  // action (\"Reset view\" button) so it doesn't surprise anyone.\n  }\n  updateMediaBar();\n  // Render mask overlays for restored items\n  state.items.forEach(item => {\n    if (item.masks && item.masks.length > 0 && item.img && item.src) {\n      // Pre-load image pixel cache for color masks\n      if (!maskImageCache[item.src]) {\n        getCachedImagePixels(item.src, () => { invalidateMaskCache(item.src); renderMasks(item); });\n      }\n      renderMasks(item);\n    }\n  });\n  // R73: re-render the frame-comment list so restored snapshot data\n  // is reflected in the popover thumbnails. Without this, the list\n  // would still show whatever was rendered before load/auto-save.\n  try {\n    state.items.forEach(it => {\n      if (it && it.isVideo && it.anno && it.el) {\n        if (typeof videoAnnoRefreshCommentList === 'function') {\n          videoAnnoRefreshCommentList(it);\n        }\n        if (it.el._refreshListBody) it.el._refreshListBody();\n        if (it.el._refreshAnnoBadges) it.el._refreshAnnoBadges();\n        if (it.el._refreshSeekMarkers) it.el._refreshSeekMarkers();\n      }\n    });\n  } catch (e) { /* non-fatal */ }\n  scheduleAutoSave();\n  setTimeout(() => updateAutoFitPaper(), 200);\n  // Render relation lines after all items are restored\n  setTimeout(function() {\n    try {\n      if (state.relations && state.relations.length) renderRelations();\n    } catch(e) { console.warn('renderRelations after restore failed:', e); }\n  }, 300);\n}\n\n// ============================================================\n//  AUTO SAVE\n// ============================================================\nfunction scheduleAutoSave() {\n  clearTimeout(state.autoSaveTimer);\n  // v7.0.52: every data mutation funnels through here, so this is the one place\n  // that can notice 'the board changed' without hunting down the import,\n  // delete, paste, undo and load paths one by one. v7.0.51 only refreshed on\n  // search / toggle / row click, so the list silently went stale - deleted\n  // items stayed in it and clicking one flew the camera at a dead object.\n  try { requestLibraryRefresh(); } catch (e) {}\n  try { requestMinimapRefresh(); } catch (e) {}\n  // v6.8.27: longer debounce (5s) for large boards \u2014 serializing a board with\n  // many base64/blob URLs every 2s creates GC pressure and can OOM.\n  state.autoSaveTimer = setTimeout(() => {\n    try {\n      var val = serializeBoard();\n      // v6.8.27: localStorage is capped (~5-10MB). Large boards can exceed it\n      // and throw, or silently corrupt. Skip the write if the payload is huge,\n      // and warn the user once per session to rely on manual Save instead.\n      if (val.length > 4 * 1024 * 1024) {\n        if (!state._autosaveOversizeWarned) {\n          state._autosaveOversizeWarned = true;\n          toast('\u26A0 Board too large for autosave. Please use File \u2192 Save manually.');\n        }\n        console.warn('[AUTOSAVE] skipped \u2014 payload', formatBytes(val.length), 'exceeds safe localStorage limit');\n        return;\n      }\n      localStorage.setItem('krafted_autosave', val);\n      if (window.KraftedStorage) window.KraftedStorage.setItem('krafted_autosave', val).catch(function(){});\n      // v7.0.43: the payload above is layout plus `autosave-media:<id>`\n      // sentinels. Mirror the actual bytes so Restore has something to\n      // point them at. Fire-and-forget \u2014 a failed mirror must never block\n      // or roll back the layout save that already succeeded.\n      persistAutosaveMedia();\n    } catch(e) {\n      console.warn('[AUTOSAVE] failed:', e.name, e.message);\n      if (e.name === 'QuotaExceededError' && !state._autosaveQuotaWarned) {\n        state._autosaveQuotaWarned = true;\n        toast('\u26A0 Autosave storage full. Please use File \u2192 Save manually.');\n      }\n    }\n  }, 5000);\n}\n// \u2500\u2500 Autosave media persistence (v7.0.43) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// A blob: URL is a handle into the document that created it. The moment the\n// tab is reloaded that handle is dangling, so an autosave that stores the\n// URL restores nothing \u2014 the item keeps its frame and loses its content.\n// IndexedDB stores Blobs natively and is not bound by the ~5MB localStorage\n// cap that forced v5.5 to clear src in the first place, so that is where\n// the bytes go. The JSON keeps a sentinel pointing at them.\nconst AUTOSAVE_MAX_BLOB_BYTES = 512 * 1024 * 1024;\n\n// Items whose media has to be mirrored: only blob: URLs die on reload.\nfunction autosaveMediaItems() {\n  return (state.items || []).filter(function(it) {\n    return it && it.src && typeof it.src === 'string' && it.src.indexOf('blob:') === 0;\n  });\n}\n\n// Bytes gone \u2014 private-mode flush, storage evicted, or an autosave written\n// before v7.0.43 that never had them. restoreBoard() draws its usual grey\n// placeholder for these rather than a broken <img>/<video>.\nfunction markAutosaveMediaLost(d) {\n  if (!d || typeof d.src !== 'string') return;\n  if (d.src.indexOf(AUTOSAVE_MEDIA_PREFIX) !== 0) return;\n  d.src = '';\n  if (d.isVideo || d.isAudio) { d.videoLost = true; } else { d.imageLost = true; }\n}\n\n// Copy every blob: item's bytes into IndexedDB, then drop blobs whose item\n// no longer exists. Called (fire-and-forget) from scheduleAutoSave().\nfunction persistAutosaveMedia() {\n  var KS = window.KraftedStorage;\n  if (!KS || !KS.saveMediaBlob || !KS.isReady()) return Promise.resolve();\n\n  var live = {};\n  var work = autosaveMediaItems().map(function(it) {\n    live[String(it.id)] = true;\n    // A blob: URL is minted once per import and never changes, so a\n    // successful save for this exact URL means the bytes are already on\n    // disk. Re-reading a 2GB clip on every autosave would stall the tab.\n    if (it._asMediaSavedFor === it.src) return Promise.resolve();\n    // Pre-flight on the size we already know: fetch().blob() would buffer\n    // the whole file in RAM before we could refuse it.\n    if (it._fileSize && it._fileSize > AUTOSAVE_MAX_BLOB_BYTES) {\n      console.warn('[AUTOSAVE] media id=' + it.id + ' too large to mirror (' + formatBytes(it._fileSize) + ')');\n      return Promise.resolve();\n    }\n    return fetch(it.src)\n      .then(function(r) { return r.blob(); })\n      .then(function(b) {\n        if (b.size > AUTOSAVE_MAX_BLOB_BYTES) {\n          console.warn('[AUTOSAVE] media id=' + it.id + ' too large to mirror (' + formatBytes(b.size) + ')');\n          return;\n        }\n        return KS.saveMediaBlob(it.id, b).then(function() {\n          it._asMediaSavedFor = it.src;\n        });\n      })\n      .catch(function(e) {\n        console.warn('[AUTOSAVE] media mirror failed for id=' + it.id + ':', e && e.message);\n      });\n  });\n\n  return Promise.all(work).then(function() {\n    if (!KS.listMediaKeys) return;\n    // Diff the store against live ids. Deleting an item leaves its blob\n    // orphaned forever if nothing prunes it.\n    return KS.listMediaKeys().then(function(keys) {\n      return Promise.all((keys || []).filter(function(k) {\n        return !live[String(k)];\n      }).map(function(k) {\n        return KS.removeMediaBlob(k);\n      }));\n    });\n  }).catch(function(e) {\n    console.warn('[AUTOSAVE] media mirror pass failed:', e && e.message);\n  });\n}\n\n// Swap every sentinel back for a live object URL. restoreBoard() is\n// synchronous and reads d.src in a dozen places, so the async IndexedDB\n// reads have to happen out here in the loader, not inside the restore.\nfunction rehydrateAutosaveMedia(data) {\n  var KS = window.KraftedStorage;\n  var items = (data && data.items) || [];\n  var total = 0;\n  items.forEach(function(d) {\n    if (d && typeof d.src === 'string' && d.src.indexOf(AUTOSAVE_MEDIA_PREFIX) === 0) total++;\n  });\n  if (!KS || !KS.getMediaBlob) {\n    items.forEach(markAutosaveMediaLost);\n    return Promise.resolve({ lost: total });\n  }\n  return KS.ready().then(function() {\n    return Promise.all(items.map(function(d) {\n      if (!d || typeof d.src !== 'string' || d.src.indexOf(AUTOSAVE_MEDIA_PREFIX) !== 0) {\n        return Promise.resolve(false);\n      }\n      return KS.getMediaBlob(d.src.slice(AUTOSAVE_MEDIA_PREFIX.length))\n        .then(function(blob) {\n          if (blob) { d.src = URL.createObjectURL(blob); return true; }\n          markAutosaveMediaLost(d);\n          return false;\n        })\n        .catch(function() { markAutosaveMediaLost(d); return false; });\n    }));\n  }).then(function(hits) {\n    return { lost: total - hits.filter(Boolean).length };\n  }).catch(function(e) {\n    console.warn('[AUTOSAVE] media rehydrate failed:', e && e.message);\n    items.forEach(markAutosaveMediaLost);\n    return { lost: total };\n  });\n}\n\n// How much of this autosave can actually come back. Drives both the welcome\n// screen's offer and the restore toast, so the number under the button is\n// the number the user will really get.\nfunction probeAutosaveMedia(data) {\n  var KS = window.KraftedStorage;\n  var ids = [];\n  ((data && data.items) || []).forEach(function(d) {\n    if (d && typeof d.src === 'string' && d.src.indexOf(AUTOSAVE_MEDIA_PREFIX) === 0) {\n      ids.push(d.src.slice(AUTOSAVE_MEDIA_PREFIX.length));\n    }\n  });\n  if (!KS || !KS.getMediaBlob) {\n    return Promise.resolve({ sentinels: ids.length, found: 0, lost: ids.length });\n  }\n  return KS.ready().then(function() {\n    return Promise.all(ids.map(function(id) {\n      return KS.getMediaBlob(id)\n        .then(function(b) { return !!b; })\n        .catch(function() { return false; });\n    }));\n  }).then(function(hits) {\n    var found = hits.filter(Boolean).length;\n    return { sentinels: ids.length, found: found, lost: ids.length - found };\n  }).catch(function() {\n    return { sentinels: ids.length, found: 0, lost: ids.length };\n  });\n}\n\n// v7.0.37 \u2014 P2. scheduleAutoSave() has been WRITING 'krafted_autosave' all\n// along; this function was the only reader and v6.5.0 turned it into `return`.\n// The result was a silent lie: the app keeps autosaving, so a crash looks\n// recoverable, but a reload comes up empty and the board is gone.\n// AUTO-restoring is what v6.5.0 deliberately removed (it left broken\n// placeholder state behind), so instead we surface the autosave and let the\n// user decide \u2014 recoverable when they need it, out of the way when they don't.\nconst AUTOSAVE_KEY = 'krafted_autosave';\nfunction readAutoSave() {\n  try {\n    const raw = (window.KraftedStorage && window.KraftedStorage.getItemSync(AUTOSAVE_KEY)) || localStorage.getItem(AUTOSAVE_KEY);\n    if (!raw) return null;\n    const data = JSON.parse(raw);\n    if (!data || !Array.isArray(data.items)) return null;\n    return data;\n  } catch (e) { return null; }\n}\nfunction discardAutoSave() {\n  try {\n    localStorage.removeItem(AUTOSAVE_KEY);\n    if (window.KraftedStorage) window.KraftedStorage.removeItem(AUTOSAVE_KEY).catch(function(){});\n  } catch (e) {}\n}\n// v7.0.43: async \u2014 the media bytes live in IndexedDB and have to be\n// re-attached before the synchronous restoreBoard() runs.\nfunction loadAutoSave() {\n  const data = readAutoSave();\n  if (!data) return;\n  const n = (data.items || []).length;\n  if (n === 0) { discardAutoSave(); return; }\n  const btn = document.querySelector('#welcome-autosave button');\n  if (btn) { btn.disabled = true; btn.textContent = 'Restoring\u2026'; }\n  rehydrateAutosaveMedia(data).then(function(res) {\n    restoreBoard(data, false);\n    hideWelcome();\n    // v7.0.37 deliberately left the autosave in place so a failed .kpak\n    // save could be retried \u2014 but it also meant the welcome screen\n    // re-offered the same board on every single reload, forever. Now that\n    // the bytes really do come back, consuming it is the honest behaviour:\n    // the board is on the canvas, not pending in storage.\n    discardAutoSave();\n    toast('Restored autosave \u00B7 ' + n + ' item' + (n === 1 ? '' : 's')\n      + (res.lost ? ' \u00B7 ' + res.lost + ' file' + (res.lost === 1 ? '' : 's') + ' could not be recovered' : '')\n      + ' \u2014 save it to a .kpak now');\n  }).catch(function(e) {\n    console.warn('[AUTOSAVE] restore failed:', e);\n    if (btn) { btn.disabled = false; btn.textContent = 'Restore'; }\n    toast('Autosave could not be restored: ' + (e.message || 'unknown'));\n  });\n}\n// Called once at startup: if an autosave exists, put a Restore / Discard\n// choice on the welcome screen instead of silently throwing the work away.\n// v7.0.43: async. An autosave written before this version has no persisted\n// blobs, so every media item in it is an empty shell \u2014 offering a Restore\n// button for that is the exact complaint this version fixes. Probe the\n// media store first and only show the button when something can come back.\nfunction offerAutoSave() {\n  const data = readAutoSave();\n  if (!data) return;\n  const n = (data.items || []).length;\n  // v7.0.43: the old count looked at items only, so a board of nothing but\n  // text/todos/mindmaps reported 0 and got silently discarded.\n  const extra = (data.texts || []).length + (data.todos || []).length +\n                (data.mindmaps || []).length;\n  if (n === 0 && extra === 0) { discardAutoSave(); return; }\n  const bar = document.getElementById('welcome-autosave');\n  const label = document.getElementById('welcome-autosave-label');\n  if (!bar || !label) return;\n\n  probeAutosaveMedia(data).then(function(p) {\n    // Nothing recoverable: media sentinels whose bytes are all gone, and no\n    // text content either. That board is a page of empty rectangles \u2014\n    // retire it rather than dangling a button that cannot deliver.\n    if (p.sentinels > 0 && p.found === 0 && extra === 0) {\n      discardAutoSave();\n      return;\n    }\n    const parts = [];\n    if (n) parts.push(n + ' item' + (n === 1 ? '' : 's'));\n    if (extra) parts.push(extra + ' text/note' + (extra === 1 ? '' : 's'));\n    if (p.found) parts.push(p.found + ' file' + (p.found === 1 ? '' : 's') + ' recovered');\n    if (p.lost) parts.push(p.lost + ' unrecoverable');\n    label.textContent = (parts.join(' \u00B7 ') || 'unsaved work') + ' from your last session';\n    bar.style.display = 'flex';\n  });\n}\n\n\n// v6.5.0: Quick Save removed entirely \u2014 all QS functions and shortcuts deleted.\n\n// ==== init.js ====\n\n//  HELP PANEL \u2014 now in help.js (R79)\n// ============================================================\n// showHelp / hideHelp are defined in help.js with the full\n// tabbed UI (Guide + Shortcuts editor). The stubs below are\n// kept as no-ops so nothing breaks if help.js fails to load.\n\ninitTextToolbar();\nupdateCanvas();\ninitVideoLazyLoad();\n// ALWAYS show welcome page on load \u2014 user must click GET STARTED every time\nshowWelcome();\n// v6.5.0: Skip autosave restore on startup \u2014 always start with a clean board.\n// Clear cache / reopen = fresh board. No more broken placeholder cleanup needed.\nwindow.addEventListener('load', async () => {\n  // Autosave restore DISABLED \u2014 user loads kpak via Load button when ready\n  // Show alt-pan status badge if enabled (MacBook trackpad mode)\n  updateAltPanBadge();\n  // v7.0.29: fill in the board-pen pack/exit hint on first paint\n  if (typeof refreshDrawPackHint === 'function') refreshDrawPackHint();\n\n  // v7.0.37 \u2014 P2: the autosave IS being written; stop hiding that fact.\n  // Offer it back instead of silently starting empty.\n  offerAutoSave();\n\n  // v6.8.28: warn before closing/reloading while saving or if board is dirty.\n  // This reduces the chance of losing the .kpak file if the tab closes during\n  // a large save, or if the user accidentally refreshes before saving.\n  window.addEventListener('beforeunload', function(e) {\n    if (state._saving) {\n      e.preventDefault();\n      e.returnValue = 'A save is still in progress. Closing now may corrupt the file.';\n      return e.returnValue;\n    }\n    // Heuristic: if there are items and the last autosave was recent, consider dirty.\n    // We don't track a global dirty flag, so use item count as a coarse guard.\n    if ((state.items.length > 0 || state.texts.length > 0) && !state._kraftedClosingConfirmed) {\n      // Modern browsers only show a generic message, but setting returnValue still triggers it.\n      e.preventDefault();\n      e.returnValue = 'You have an unsaved board. Close without saving?';\n      return e.returnValue;\n    }\n  });\n});\nwindow.addEventListener('resize', () => { updateCanvas(); if (cutState) updateCutTargetHighlight(); });\n\n// \u2500\u2500 v5.5.1: Tab visibility \u2192 pause all videos \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Saves CPU and memory when the user switches tabs/apps.\ndocument.addEventListener('visibilitychange', function() {\n  if (document.hidden) {\n    document.querySelectorAll('.item.has-media video').forEach(function(vid) {\n      if (!vid.paused) {\n        vid._wasPlayingBeforeHidden = true;\n        vid.pause();\n      }\n    });\n  } else {\n    document.querySelectorAll('.item.has-media video').forEach(function(vid) {\n      if (vid._wasPlayingBeforeHidden) {\n        vid._wasPlayingBeforeHidden = false;\n        resumeMediaEl(vid);   // v7.0.33\n      }\n    });\n  }\n});\n\n// New Board \u2014 clear everything and show fresh welcome\nfunction newBoard() {\n  // v7.0.31: Clear used to be a one-click, unrecoverable wipe of everything \u2014\n  // the board AND both history stacks AND the autosave \u2014 behind a prominent\n  // toolbar button with no confirmation. A misclick destroyed hours of work\n  // with no way back: Ctrl+Z was empty, the autosave was already deleted.\n  //\n  // Two changes:\n  //   1. Ask first \u2014 but only when there is actually something to lose, so\n  //      clearing an already-empty board stays a single no-nag click.\n  //   2. Record an undo step instead of nuking history, so Ctrl+Z brings the\n  //      whole board back even after confirming.\n  const _n = state.items.length + state.texts.length +\n             (state.todos ? state.todos.length : 0) +\n             (state.mindmaps ? state.mindmaps.length : 0) +\n             (G.drawStrokes ? G.drawStrokes.length : 0);\n  if (_n > 0) {\n    const _zh = (typeof _isZhUI === 'function') ? _isZhUI() : false;\n    const _msg = _zh\n      ? '\u6E05\u7A7A\u753B\u677F\uFF1F\\n\\n\u5C06\u79FB\u9664 ' + _n + ' \u4E2A\u9879\u76EE\u3002\\n\u53EF\u4EE5\u7528 Ctrl+Z \u64A4\u9500\u3002'\n      : 'Clear the board?\\n\\nThis removes ' + _n + ' item' + (_n === 1 ? '' : 's') +\n        '.\\nYou can undo with Ctrl+Z.';\n    if (!window.confirm(_msg)) return;\n  }\n  // Snapshot BEFORE wiping so the step above is recoverable. pushUndo()\n  // handles the save-in-flight case itself (it defers), so don't touch\n  // state._deferredUndo here or the pending step would be dropped.\n  try { pushUndo(); } catch (e) {}\n  cleanupAllItems();\n  state.items = [];\n  state.texts = [];\n  state.todos = [];\n  state.mindmaps = [];\n  state.selected.clear();\n  state.groups.forEach(disposeGroupEl);\n  state.groups = [];\n  G.nextGroupId = 1;\n  // v7.0.40: views name items, so they die with them. Leaving them behind\n  // would fill the rail with rows that fly the camera to nowhere.\n  state.views = [];\n  state._activeViewIndex = -1;\n  G.nextViewId = 1;\n  if (state._present) stopPresent();\n  try { renderViewsPanel(); } catch (e) {}\n  // v7.0.31: the undo/redo stacks are deliberately NOT cleared \u2014 the snapshot\n  // pushed above is the way back, and it is bounded by the same 100-step /\n  // 300MB cap as every other undo entry. pushUndo() already emptied redoStack.\n  // v7.0.10: the annotation-stroke stack is still dropped \u2014 its entries hold\n  // direct DOM references to elements we are about to destroy.\n  G._annoUndoStack = [];\n  G._annoRedoStack = [];\n  G.nextZ = 1; G.nextId = 1;\n  G.drawStrokes.length = 0;\n  state.pan = { x: 0, y: 0 };\n  state.zoom = 1;\n  try { localStorage.removeItem('krafted_autosave'); if (window.KraftedStorage) window.KraftedStorage.removeItem('krafted_autosave').catch(function(){}); } catch(e) {}\n  updateCanvas();\n  redrawDrawLayer();\n  refreshSelection();\n  _frozenGifs.clear();\n  updateMediaBar();\n  showWelcome();\n  toast(((typeof _isZhUI === 'function') ? _isZhUI() : false)\n    ? '\u753B\u677F\u5DF2\u6E05\u7A7A\uFF08Ctrl+Z \u53EF\u64A4\u9500\uFF09'\n    : 'Board cleared! (Ctrl+Z to undo)');\n}\n\n// ============================================================\n//  SAVE TO FOLDER \u2014 File System Access API\n//  Lets the user pick a local folder and write files directly to it.\n//  Works in Chrome / Edge / Brave / Arc on Windows + Mac.\n//  Falls back to standard download on Safari / Firefox.\n// ============================================================\n\nfunction hasFileSystemAccess() {\n  return typeof window.showDirectoryPicker === 'function';\n}\n\nasync function pickSaveFolder() {\n  if (!hasFileSystemAccess()) return null;\n  try {\n    return await window.showDirectoryPicker({ mode: 'readwrite' });\n  } catch (e) {\n    // User cancelled the picker \u2014 silent return\n    if (e && (e.name === 'AbortError' || e.code === 20 || e.code === 'ABORT_ERR')) return null;\n    throw e;\n  }\n}\n\nfunction dataUrlToBlob(dataUrl) {\n  if (!dataUrl) return Promise.resolve(null);\n  if (dataUrl.startsWith('blob:')) {\n    return fetch(dataUrl).then(r => r.ok ? r.blob() : null).catch(() => null);\n  }\n  const idx = dataUrl.indexOf(',');\n  if (idx < 0) return Promise.resolve(null);\n  const meta = dataUrl.slice(0, idx);\n  const b64 = dataUrl.slice(idx + 1);\n  const mime = (meta.match(/data:([^;]+)/) || [, 'image/png'])[1];\n  try {\n    const bin = atob(b64);\n    const arr = new Uint8Array(bin.length);\n    for (let i = 0; i < bin.length; i++) arr[i] = bin.charCodeAt(i);\n    return Promise.resolve(new Blob([arr], { type: mime }));\n  } catch (e) {\n    return Promise.resolve(null);\n  }\n}\n\nfunction canvasToBlobAsync(canvas, type, quality) {\n  type = type || 'image/png';\n  return new Promise((resolve, reject) => {\n    try {\n      canvas.toBlob(b => b ? resolve(b) : reject(new Error('toBlob returned null')), type, quality);\n    } catch (e) { reject(e); }\n  });\n}\n\nfunction sanitizeFilename(name, fallback) {\n  let s = (name == null ? '' : String(name));\n  // Strip path separators and characters forbidden on Win/Mac\n  s = s.replace(/[<>:\"/\\\\|?*\\x00-\\x1F]/g, '_');\n  // Strip leading dots (hidden files on Mac, invalid on Win)\n  s = s.replace(/^\\.+/, '');\n  // Collapse whitespace and underscores\n  s = s.replace(/[\\s_]+/g, ' ').trim();\n  if (s.length > 120) s = s.slice(0, 120);\n  return s || (fallback || 'file');\n}\n\nasync function uniqueFilename(dirHandle, base, ext) {\n  // Returns a filename that doesn't already exist in the folder\n  const tryName = async (n) => {\n    try {\n      await dirHandle.getFileHandle(n, { create: false });\n      return false; // exists\n    } catch (e) { return true; } // doesn't exist (good)\n  };\n  let candidate = base + '.' + ext;\n  if (await tryName(candidate)) return candidate;\n  for (let i = 2; i < 1000; i++) {\n    candidate = base + '_' + i + '.' + ext;\n    if (await tryName(candidate)) return candidate;\n  }\n  return base + '_' + Date.now() + '.' + ext;\n}\n\nasync function writeBlobToFolder(dirHandle, filename, blob) {\n  const fh = await dirHandle.getFileHandle(filename, { create: true });\n  const w = await fh.createWritable();\n  try { await w.write(blob); } finally { await w.close(); }\n  return filename;\n}\n\nfunction triggerDownload(blob, filename) {\n  const url = URL.createObjectURL(blob);\n  const a = document.createElement('a');\n  a.href = url;\n  a.download = filename;\n  document.body.appendChild(a);\n  a.click();\n  // v7.0.45: 1000 ms was a race, not a cleanup. The browser drains the blob\n  // lazily while it writes the file, so revoking the URL a second after the\n  // click truncates anything bigger than the disk absorbed in that second \u2014\n  // the same failure class that was producing 0 KB files on the save path.\n  // Exports are usually small enough to have looked fine, which is why this\n  // survived; the HTML export and large captures are not.\n  setTimeout(() => { URL.revokeObjectURL(url); a.remove(); }, 60000);\n}\n\n// Round 28.7: kraftedSaveFile \u2014 unified \"Save As\" helper that gives the\n// user a NATIVE save-location dialog on Chrome/Edge (Mac + Windows + Linux)\n// via window.showSaveFilePicker, and falls back to the same-old\n// <a download> for Safari / Firefox / any browser that doesn't ship the\n// File System Access API. The user was getting frustrated with the\n// \"the file just lands in Downloads and I have to dig it out\" flow \u2014\n// the native picker is what they want.\n//\n// Usage:\n//   await kraftedSaveFile({ filename: 'foo.html', blob: myBlob, mime: 'text/html' })\n//   await kraftedSaveFile({ filename: 'foo.mp4', blob: myBlob })  // mime auto-from .mp4\n//\n// Returns 'saved' / 'cancelled' / 'fallback' so the caller can update\n// the toast. 'fallback' means \"saved via the old <a download> path,\n// because this browser doesn't support the native picker\".\nfunction hasShowSaveFilePicker() {\n  return typeof window.showSaveFilePicker === 'function';\n}\nasync function kraftedSaveFile(opts) {\n  opts = opts || {};\n  const filename = sanitizeFilename(opts.filename || 'krafted-export', 'krafted-export');\n  const blob = opts.blob;\n  if (!blob) return 'cancelled';\n  // Preferred path: native save dialog (Chrome/Edge 86+, works on Mac + Win)\n  if (hasShowSaveFilePicker()) {\n    try {\n      const handle = await window.showSaveFilePicker({\n        suggestedName: filename,\n        types: [{\n          description: (opts.description || 'File'),\n          accept: { [opts.mime || (blob.type || 'application/octet-stream')]: ['.' + (filename.split('.').pop() || 'bin')] },\n        }],\n      });\n      const w = await handle.createWritable();\n      try { await w.write(blob); } finally { try { await w.close(); } catch (e) {} }\n      return 'saved';\n    } catch (e) {\n      // User cancelled the picker \u2014 silent return\n      if (e && (e.name === 'AbortError' || e.code === 20 || e.code === 'ABORT_ERR')) return 'cancelled';\n      // Any other error: log + fall through to the <a download> fallback\n      console.warn('showSaveFilePicker failed, falling back:', e);\n    }\n  }\n  // Fallback: classic <a download> \u2014 works everywhere but the user has\n  // to find the file in their browser's default download location.\n  try {\n    triggerDownload(blob, filename);\n    return 'fallback';\n  } catch (e) {\n    console.error('Save failed:', e);\n    return 'cancelled';\n  }\n}\n\n// Save a single canvas (capture or export) to a chosen local folder\nasync function saveCaptureToFolder(canvas, suggestedName, onComplete) {\n  if (!canvas) return;\n  if (!hasFileSystemAccess()) {\n    // Fallback: download\n    try {\n      const blob = await canvasToBlobAsync(canvas, 'image/png');\n      const name = sanitizeFilename(suggestedName, 'krafted') + '.png';\n      triggerDownload(blob, name);\n      toast('Folder picker not supported \u2014 downloaded instead');\n    } catch (e) {\n      console.error(e);\n      toast('Save failed: ' + (e.message || e));\n    }\n    if (onComplete) onComplete();\n    return;\n  }\n  const dirHandle = await pickSaveFolder();\n  if (!dirHandle) return; // user cancelled\n  try {\n    const blob = await canvasToBlobAsync(canvas, 'image/png');\n    const baseName = sanitizeFilename(suggestedName, 'krafted');\n    const filename = await uniqueFilename(dirHandle, baseName, 'png');\n    await writeBlobToFolder(dirHandle, filename, blob);\n    toast('Saved to ' + dirHandle.name + '/' + filename);\n    if (onComplete) onComplete();\n  } catch (e) {\n    console.error('Save capture failed', e);\n    if (e && e.name === 'SecurityError') {\n      toast('Cannot save: image is cross-origin');\n    } else if (e && e.name === 'NotAllowedError') {\n      toast('Permission denied');\n    } else {\n      toast('Save failed: ' + (e.message || e));\n    }\n  }\n}\n\nfunction saveExportModalToFolder() {\n  saveCaptureToFolder(\n    document.getElementById('export-canvas'),\n    'krafted_export_' + Date.now()\n  );\n}\n\nfunction saveCapturePanelToFolder() {\n  saveCaptureToFolder(\n    G.captureResultCanvas,\n    'krafted_capture_' + Date.now(),\n    () => {\n      captureResultPanel.classList.remove('show');\n      G.captureResultCanvas = null;\n      captureResultImg.style.display = '';\n    }\n  );\n}\n\n// ============================================================\n//  V7.9.0 \u2014 EXPORT: one naming rule, one bake rule\n// ============================================================\n// Three export paths used to invent their own file extension\n// (blob.type.split('/')[1] in one place, src.split('.').pop() in another) and\n// their own name ('krafted_image_' + i, 'image_' + Date.now()). On a board\n// full of blob: URLs that produced \"IMG_2301.blob:http://localhost:8000/\n// 550e8400-e29b-\u2026\" \u2014 a name no OS can open \u2014 and 300 files all called\n// image_1..image_300 even though item.filename has carried the real name\n// since import. The rules live here once; every sink calls them.\nvar EXPORT_MIME_EXT = {\n  'image/png': 'png', 'image/jpeg': 'jpg', 'image/jpg': 'jpg',\n  'image/webp': 'webp', 'image/gif': 'gif', 'image/bmp': 'bmp',\n  'image/avif': 'avif', 'image/tiff': 'tiff', 'image/svg+xml': 'svg',\n  'image/x-icon': 'ico', 'image/heic': 'heic', 'image/heif': 'heif'\n};\nfunction extFromMime(mime, fallback) {\n  var m = String(mime || '').split(';')[0].trim().toLowerCase();\n  if (EXPORT_MIME_EXT[m]) return EXPORT_MIME_EXT[m];\n  // Anything else: take the subtype, but only if it is short enough to BE an\n  // extension. (No jpeg->jpg fixup here: 'image/jpeg' is in the table above,\n  // so a subtype of 'jpeg' cannot reach this line \u2014 a mapping that could never\n  // run is worse than none, because it looks like coverage.)\n  var sub = m.split('/')[1];\n  if (sub && /^[a-z0-9]{2,5}$/.test(sub)) return sub;\n  return fallback || 'png';\n}\n// The dropped file's own name is the most truthful source of its extension:\n// no fetch, no guess, and it survives the blob: URL that replaced the path.\nfunction extFromName(name, fallback) {\n  var parts = String(name == null ? '' : name).split('.');\n  if (parts.length < 2) return fallback || '';\n  var e = parts[parts.length - 1].toLowerCase();\n  return /^[a-z0-9]{2,5}$/.test(e) ? e : (fallback || '');\n}\nfunction stripExt(name) {\n  return String(name == null ? '' : name).replace(/\\.[^.\\/\\\\]+$/, '');\n}\n// Original file name if we have one, else the name given to the item, else a\n// positional fallback. Never invents an extension \u2014 the caller adds that.\nfunction exportBaseName(item, i) {\n  var n = stripExt((item && (item.filename || item.name)) || '').trim();\n  return n || ('image_' + (i + 1));\n}\n// Two folders can both hold IMG_2301.jpg. The first keeps the bare name and\n// the rest get _2, _3\u2026 \u2014 a silent overwrite would lose a picture for good.\nfunction dedupeExportNames(names) {\n  var seen = Object.create(null), out = [];\n  for (var i = 0; i < names.length; i++) {\n    var base = names[i], nm = base, k = 2;\n    while (seen[nm.toLowerCase()]) { nm = base + '_' + k; k++; }\n    seen[nm.toLowerCase()] = true;\n    out.push(nm);\n  }\n  return out;\n}\n// The four corners of the item's own box, in screen px. The probes are\n// children of item.el, so the browser folds the item's rotate/flip in itself \u2014\n// the same reason itemPixelGeometry exists. getBoundingClientRect() would hand\n// back the axis-aligned box AROUND a rotated item, which IS the v7.8.0 bug.\nfunction itemScreenQuad(item) {\n  if (!item || !item.el) return null;\n  var W = item.el.offsetWidth, H = item.el.offsetHeight;\n  if (!W || !H) return null;\n  return [\n    _geoProbe(item.el, 'left:0;top:0;'),\n    _geoProbe(item.el, 'left:' + W + 'px;top:0;'),\n    _geoProbe(item.el, 'left:' + W + 'px;top:' + H + 'px;'),\n    _geoProbe(item.el, 'left:0;top:' + H + 'px;')\n  ];\n}\n// Bake one item into the pixels you actually see: crop, reframe, rotation,\n// flip and the colour grade all end up in the output. Crop/rot/flip are kept\n// as non-destructive transforms and the grade is a CSS filter, so before\n// v7.9.0 an exported board handed back PRE-EDIT originals \u2014 only lasso/cut/\n// knock-out, which rewrite pixels, ever showed up in what came out.\nasync function bakeItemToBlob(item) {\n  if (!item || !item.el) return null;\n  var imgEl = item.img || item.el.querySelector('img');\n  if (!imgEl || !imgEl.complete || !imgEl.naturalWidth) return null;\n  var quad = itemScreenQuad(item);\n  if (!quad) return null;\n  // An all-defaults filter string is a no-op, but setting ctx.filter at all\n  // still routes the draw through a filtered path in some engines. Compare\n  // against the default rather than guessing which keys exist.\n  var f = mediaFilterString(item);\n  var r = renderItemRegion(item, quad, {\n    filter: (f === mediaFilterString({})) ? '' : f\n  });\n  if (!r) return null;\n  var blob = await new Promise(function (res) {\n    try { r.canvas.toBlob(function (b) { res(b); }, 'image/png'); }\n    catch (e) { res(null); }\n  });\n  // A 6000x4000 canvas is ~96 MB. Release it now instead of waiting for GC to\n  // notice 300 of them piled up behind a loop.\n  try { r.canvas.width = 0; r.canvas.height = 0; } catch (e) {}\n  return blob;\n}\n\n// Export all images on the board (or only the selected ones) to disk.\n// opts.original \u2014 write the bytes that were imported, untouched.\nasync function exportAllImagesToFolder(opts) {\n  opts = opts || {};\n  const original = !!opts.original;\n  const isZh = (typeof _isZhUI === 'function') && _isZhUI();\n  // v7.5.0: off-screen images have their src detached; put every one back\n  // before reading pixels out of them.\n  _ensureAllImagesLive();\n  // Determine which images to export\n  let images = [];\n  const sel = (typeof getSelectedImages === 'function') ? getSelectedImages() : [];\n  if (sel && sel.length > 0) {\n    images = sel.filter(i => i && i.img && i.src);\n  } else {\n    images = state.items.filter(i => i && i.img && i.src && !i.isVideo);\n  }\n  if (images.length === 0) {\n    toast(isZh ? '\u6CA1\u6709\u56FE\u7247\u53EF\u5BFC\u51FA' : 'No images to export');\n    return;\n  }\n\n  const names = dedupeExportNames(images.map((it, i) => exportBaseName(it, i)));\n  const total = images.length;\n  // Cancelling SETS A FLAG; the loop below decides where it is safe to stop.\n  // Killing a write halfway leaves a truncated file on disk.\n  const prog = makeProgressUI({\n    cancelLabel: isZh ? '\u53D6\u6D88' : 'Cancel',\n    cancellingLabel: isZh ? '\u6B63\u5728\u53D6\u6D88\u2026' : 'Cancelling\u2026',\n    onCancel: function () {}\n  });\n\n  // Chrome/Edge write into the folder the user picks. Safari and Firefox have\n  // no File System Access API, and one <a download> per image means 300\n  // permission prompts \u2014 so they get ONE zip instead.\n  let dirHandle = null, zip = null;\n  if (hasFileSystemAccess()) {\n    dirHandle = await pickSaveFolder();\n    if (!dirHandle) { prog.done(); return; } // user cancelled\n  } else if (typeof JSZip !== 'undefined') {\n    zip = new JSZip();\n  } else {\n    prog.done();\n    toast(isZh ? '\u6B64\u6D4F\u89C8\u5668\u4E0D\u652F\u6301\u5BFC\u51FA\u56FE\u7247' : 'This browser cannot export images');\n    return;\n  }\n\n  let saved = 0, failed = 0;\n  for (let i = 0; i < total; i++) {\n    if (prog.cancelled()) break;\n    prog.update((original\n        ? (isZh ? '\u590D\u5236\u539F\u6863 ' : 'Copying original ')\n        : (isZh ? '\u6E32\u67D3 ' : 'Rendering ')) + (i + 1) + '/' + total,\n      { doneItems: i, totalItems: total, extra: names[i] });\n    try {\n      let blob = null, ext = 'png';\n      if (original) {\n        blob = await dataUrlToBlob(images[i].src);\n        if (!blob) { failed++; continue; }\n        ext = extFromMime(blob.type, extFromName(images[i].filename, 'png'));\n      } else {\n        blob = await bakeItemToBlob(images[i]);\n        if (!blob) { failed++; continue; }\n        ext = 'png';\n      }\n      if (dirHandle) {\n        const fn = await uniqueFilename(dirHandle, names[i], ext);\n        await writeBlobToFolder(dirHandle, fn, blob);\n      } else {\n        zip.file(names[i] + '.' + ext, blob);\n      }\n      saved++;\n    } catch (e) {\n      console.error('Export image failed', i, e);\n      failed++;\n    }\n  }\n\n  if (prog.cancelled()) {\n    prog.done();\n    toast((isZh ? '\u5DF2\u53D6\u6D88 \u2014 \u5DF2\u5B58 ' : 'Cancelled \u2014 saved ') + saved);\n    return;\n  }\n\n  if (dirHandle) {\n    prog.done();\n    if (failed === 0) {\n      toast((isZh ? '\u5DF2\u5B58 ' : 'Saved ') + saved\n        + (isZh ? ' \u5F20\u56FE\u5230 ' : ' image' + (saved === 1 ? '' : 's') + ' to ')\n        + dirHandle.name + '/');\n    } else {\n      toast((isZh ? '\u5DF2\u5B58 ' : 'Saved ') + saved\n        + (isZh ? '\uFF0C\u5931\u8D25 ' : ', failed ') + failed);\n    }\n    return;\n  }\n\n  // One zip, one save prompt, whatever the count.\n  prog.update((isZh ? '\u6B63\u5728\u6253\u5305\u2026 ' : 'Zipping\u2026 ') + '0%',\n    { doneItems: total, totalItems: total });\n  let zipBlob = null;\n  try {\n    // STORE, not DEFLATE: PNG is already compressed, so deflating 300 of them\n    // burns minutes of main-thread time to save a few percent.\n    zipBlob = await zip.generateAsync({ type: 'blob', compression: 'STORE' },\n      function (meta) {\n        prog.update((isZh ? '\u6B63\u5728\u6253\u5305\u2026 ' : 'Zipping\u2026 ') + Math.round(meta.percent) + '%');\n      });\n  } catch (e) {\n    console.error('Zip failed', e);\n  }\n  prog.done();\n  if (!zipBlob) { toast(isZh ? '\u6253\u5305\u5931\u8D25' : 'Zipping failed'); return; }\n  const zipName = sanitizeFilename(\n    'krafted_images_' + new Date().toISOString().slice(0, 19).replace(/[:T]/g, '-'),\n    'krafted-images') + '.zip';\n  const how = await kraftedSaveFile({ filename: zipName, blob: zipBlob, mime: 'application/zip' });\n  if (how !== 'cancelled') {\n    toast((isZh ? '\u5DF2\u5B58 ' : 'Saved ') + saved\n      + (isZh ? ' \u5F20\u56FE\uFF08' : ' image' + (saved === 1 ? '' : 's') + ' (')\n      + formatBytes(zipBlob.size) + ' zip)');\n  }\n}\n\n// Untouched bytes, original format, original file name \u2014 the escape hatch for\n// \"I wanted the file I dropped in, not what the board made of it\".\nfunction exportOriginalFilesToFolder() {\n  return exportAllImagesToFolder({ original: true });\n}\n// R88 \u2014 Auto-load .kpak from embedded base64 data.\n// When a .kpak is double-clicked, the launcher script base64-encodes the\n// entire kpak zip, injects it as window._kraftedAutoLoadKpak, and writes a\n// temp HTML file. This block decodes it, unzips, remaps media, and calls\n// restoreBoard \u2014 no manual \"Load\" needed.\n(function autoLoadKpak() {\n  var b64 = window._kraftedAutoLoadKpak;\n  if (!b64) return;\n  var fname = window._kraftedAutoLoadKpakName || '';\n  delete window._kraftedAutoLoadKpak;\n  delete window._kraftedAutoLoadKpakName;\n  var toastEl = document.getElementById('toast');\n  function toast(msg) {\n    if (!toastEl) return;\n    toastEl.textContent = msg; toastEl.classList.add('show');\n    clearTimeout(toastEl._t); toastEl._t = setTimeout(function(){ toastEl.classList.remove('show'); }, 2000);\n  }\n  function showProg(msg) {\n    var p = document.createElement('div');\n    p.className = 'save-progress';\n    p.innerHTML = '<div class=\"pct\">' + msg + '</div>';\n    document.body.appendChild(p);\n    return p;\n  }\n  function removeProg(p) { if (p && p.parentNode) p.parentNode.removeChild(p); }\n  (async function() {\n    var prog = null;\n    try {\n      var fSize = Math.round(b64.length * 0.75);\n      prog = showProg('Opening ' + fname + ' (' + formatBytes(fSize) + ')...');\n\n      // R91: Use fetch(data:\u2026) to decode base64 asynchronously instead of\n      // atob(b64) which blocks the main thread. For large files (100\u202FMB\u202F+)\n      // this prevents the browser tab from freezing during decoding.\n      var dataUrl = 'data:application/zip;base64,' + b64;\n      var resp = await fetch(dataUrl);\n      if (!resp.ok) throw new Error('Failed to decode package (HTTP ' + resp.status + ')');\n      var zipBlob = await resp.blob();\n      prog.innerHTML = '<div class=\"pct\">Unpacking...</div>';\n      var zip = await JSZip.loadAsync(zipBlob);\n      var manifestFile = zip.file('manifest.json');\n      if (!manifestFile) throw new Error('No manifest.json inside kpak');\n      var manifestJson = await manifestFile.async('string');\n      var data = JSON.parse(manifestJson);\n      // Remap media/ entries\n      var mediaEntries = Object.keys(zip.files).filter(function(p) { return p.startsWith('media/') && !p.endsWith('/'); });\n      var restoredCount = 0;\n      for (var j = 0; j < (data.items || []).length; j++) {\n        var dataItem = data.items[j];\n        var mediPrefix = 'media/' + dataItem.id + '.';\n        var entryPath = mediaEntries.find(function(p) { return p.startsWith(mediPrefix); });\n        if (!entryPath) continue;\n        try {\n          var blob = await zip.file(entryPath).async('blob');\n          if (blob && blob.size > 0) { dataItem.src = URL.createObjectURL(blob); restoredCount++; }\n        } catch(e) { console.warn('Auto-load media failed:', dataItem.id, e); }\n        // R91: yield every 2 items to let the browser paint and stay responsive\n        if (j % 2 === 1) await new Promise(function(r) { setTimeout(r, 0); });\n      }\n      if (typeof restoreBoard === 'function' && typeof hideWelcome === 'function') {\n        restoreBoard(data);\n        hideWelcome();\n        // R91: yield after synchronous restore so video elements can start\n        // their metadata loading without blocking the main thread.\n        await new Promise(function(r) { setTimeout(r, 50); });\n        removeProg(prog);\n        // R93: Release the decoded zip, base64, and fetch response to help\n        // the garbage collector free memory. For large videos, the zip can\n        // easily be 100+\u202FMB. The blob URLs we created hold independent\n        // copies, so the zip data is no longer needed after restore.\n        zip = null; zipBlob = null; b64 = null; resp = null; dataUrl = null;\n        if (window._kraftedAutoLoadKpak) { delete window._kraftedAutoLoadKpak; }\n        toast('Opened ' + fname + (restoredCount > 0 ? ' (' + restoredCount + ' media)' : ''));\n      } else {\n        throw new Error('Core functions not loaded');\n      }\n    } catch(e) {\n      removeProg(prog);\n      console.error('[AutoLoad] Failed:', e);\n      toast('Failed to open: ' + e.message);\n    }\n  })();\n})();\n\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// SCREEN SHARE MODE \u2014 \u6295\u5C4F\u6A21\u5F0F\uFF08v6.8.0\uFF09\n// \u5B89\u5168\u8BBE\u8BA1\uFF1A\u6240\u6709\u4F18\u5316\u53EA\u5728 body.screen-share-mode \u5B58\u5728\u65F6\u751F\u6548\n// \u4E0D\u3A52\u63A3 = \u96F6\u5F71\u54CD\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n\nvar isScreenShareMode = false;\nvar _ssAnnoCbs = [];\nvar _ssRafThrottleId = null;\nvar _ssRafLastTime = 0;\nvar _ssRafInterval = 33; // ~30fps\n\nfunction toggleScreenShareMode() {\n  isScreenShareMode = !isScreenShareMode;\n  if (isScreenShareMode) {\n    document.body.classList.add('screen-share-mode');\n    _applyScreenShareOptimizations();\n    try { localStorage.setItem('kraft_screen_share', '1'); } catch(e) {}\n    if (typeof toast === 'function') toast('\u6295\u5C4F\u6A21\u5F0F\u5DF2\u542F\u7528');\n    _updateSSIndicator(true);\n    _ssFpsStart();\n  } else {\n    document.body.classList.remove('screen-share-mode');\n    _restoreScreenShareOptimizations();\n    try { localStorage.setItem('kraft_screen_share', '0'); } catch(e) {}\n    if (typeof toast === 'function') toast('\u6295\u5C4F\u6A21\u5F0F\u5DF2\u5173\u95ED');\n    _updateSSIndicator(false);\n    _ssFpsStop();\n  }\n}\n\n(function _ssInit() {\n  try {\n    if (localStorage.getItem('kraft_screen_share') === '1') {\n      isScreenShareMode = true;\n      document.body.classList.add('screen-share-mode');\n      _updateSSIndicator(true);\n      setTimeout(function() { _ssFpsStart(); }, 1000);\n    }\n  } catch(e) {}\n  _ssEnsureBannerElements();\n  _ssEnsureIndicator();\n  setTimeout(function() {\n    if (isScreenShareMode) _applyScreenShareOptimizations();\n  }, 500);\n})();\n\nfunction _ssEnsureIndicator() {\n  var st = document.getElementById('status');\n  if (!st) return setTimeout(_ssEnsureIndicator, 100);\n  var el = document.getElementById('status-ss-indicator');\n  if (!el) {\n    el = document.createElement('span');\n    el.id = 'status-ss-indicator';\n    el.textContent = 'Screen Share';\n    st.appendChild(el);\n  }\n}\n\nfunction _ssEnsureBannerElements() {\n  // \u9876\u90E8\u6A2A\u5E45\uFF08minimalist \u2014 \u65E0 emoji\u3001\u5B57\u5C11\u3001\u5355\u8272\uFF09\n  if (!document.getElementById('ss-banner')) {\n    var banner = document.createElement('div');\n    banner.id = 'ss-banner';\n    banner.innerHTML = '<b>SCREEN SHARE</b> \u00B7 GPU optimized \u00B7 click to exit';\n    banner.style.cursor = 'pointer';\n    banner.onclick = toggleScreenShareMode;\n    document.body.appendChild(banner);\n  }\n  // \u53F3\u4E0B\u89D2\u6D6E\u6C34\u5370\uFF08minimalist\uFF09\n  if (!document.getElementById('ss-watermark')) {\n    var wm = document.createElement('div');\n    wm.id = 'ss-watermark';\n    wm.textContent = 'SCREEN SHARE';\n    document.body.appendChild(wm);\n  }\n}\nfunction _updateSSIndicator(on) {\n  var el = document.getElementById('status-ss-indicator');\n  if (el) el.style.display = on ? 'inline' : 'none';\n}\n\nfunction _applyScreenShareOptimizations() {\n  try {\n    if (typeof state !== 'undefined' && state && state.items) {\n      state.items.forEach(function(item) {\n        if (item && item.video && item.el && item.el._perfLastRenderKey !== undefined) {\n          item.el._perfLastRenderKey = null;\n          item.el._ssLowDpr = true;\n          var annoCanvas = item.el.querySelector('.media-anno-canvas');\n          if (annoCanvas) {\n            _ssAnnoCbs.push({ canvas: annoCanvas, item: item, el: item.el });\n          }\n        }\n      });\n    }\n  } catch(e) {}\n  _ssAnnoCbs.forEach(function(cb) {\n    try {\n      var dpr = 1;\n      var cw = cb.canvas.clientWidth;\n      var ch = cb.canvas.clientHeight;\n      if (cw > 1 && ch > 1) {\n        cb.canvas.width = Math.round(cw * dpr);\n        cb.canvas.height = Math.round(ch * dpr);\n        if (cb.el._renderAnnoCanvas) cb.el._renderAnnoCanvas();\n      }\n    } catch(e) {}\n  });\n}\n\nfunction _restoreScreenShareOptimizations() {\n  _ssAnnoCbs = [];\n  try {\n    if (typeof state !== 'undefined' && state && state.items) {\n      state.items.forEach(function(item) {\n        if (item && item.el) {\n          item.el._perfLastRenderKey = null;\n          item.el._ssLowDpr = false;\n        }\n      });\n    }\n  } catch(e) {}\n}\n\n// Monkey-patch devicePixelRatio\uFF1A\u6295\u5C4F\u6A21\u5F0F\u5F3A\u5236 1x DPR\nvar _ssOrigDPR = Object.getOwnPropertyDescriptor(Window.prototype, 'devicePixelRatio');\nif (_ssOrigDPR && _ssOrigDPR.get) {\n  var _ssOrigGetter = _ssOrigDPR.get;\n  Object.defineProperty(window, 'devicePixelRatio', {\n    get: function() {\n      if (isScreenShareMode && document.body.classList.contains('screen-share-mode')) return 1;\n      return _ssOrigGetter.call(this);\n    },\n    configurable: true\n  });\n}\n\nif (typeof window !== 'undefined') {\n  window.isScreenShareMode = isScreenShareMode;\n  window.toggleScreenShareMode = toggleScreenShareMode;\n}\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// rAF THROTTLE \u2014 \u6295\u5C4F\u6A21\u5F0F\u964D\u5230 ~30fps\uFF0C\u91CA\u653E\u4E00\u534A frame budget\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n(function() {\n  var _origRAF = window.requestAnimationFrame;\n  var _origCAF = window.cancelAnimationFrame;\n  var _skipNext = false;\n  var _rafMap = {};     // fakeId \u2192 { realId, callback }\n  var _nextFakeId = 1;\n\n  window.requestAnimationFrame = function(callback) {\n    if (!isScreenShareMode || !document.body.classList.contains('screen-share-mode')) {\n      return _origRAF.call(window, callback);\n    }\n    // \u6295\u5C4F\u6A21\u5F0F\uFF1A\u6BCF\u9694\u4E00\u5E27\u5148\u771F\u6B63 call\uFF0Cskip \u5605\u5E27 defer \u5230\u4E0B\u4E00\u5E27\n    var fid = _nextFakeId++;\n    if (_skipNext) {\n      _skipNext = false;\n      // Defer: \u7B49\u4E0B\u4E00\u5E27\u5148 call\n      var realId = _origRAF.call(window, function(ts) {\n        var entry = _rafMap[fid];\n        if (entry) { entry.callback(ts); delete _rafMap[fid]; }\n      });\n      _rafMap[fid] = { realId: realId, callback: callback };\n    } else {\n      _skipNext = true;\n      var realId2 = _origRAF.call(window, function(ts) {\n        var entry = _rafMap[fid];\n        if (entry) { entry.callback(ts); delete _rafMap[fid]; }\n      });\n      _rafMap[fid] = { realId: realId2, callback: callback };\n    }\n    return fid;\n  };\n\n  window.cancelAnimationFrame = function(id) {\n    var entry = _rafMap[id];\n    if (entry) {\n      _origCAF.call(window, entry.realId);\n      delete _rafMap[id];\n      return;\n    }\n    return _origCAF.call(window, id);\n  };\n})();\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// FPS COUNTER \u2014 \u53EA\u5728\u6295\u5C4F\u6A21\u5F0F\u65F6\u624D\u542F\u52A8\uFF0C\u5173\u95ED\u5373\u505C\uFF0C\u5E73\u65F6\u96F6 overhead\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\nvar _ssFpsFrames = 0, _ssFpsLastTime = 0, _ssFpsEl = null, _ssFpsRafId = null;\n\nfunction _ssFpsEnsureEl() {\n  if (_ssFpsEl) return;\n  _ssFpsEl = document.createElement('div');\n  _ssFpsEl.id = 'ss-fps';\n  _ssFpsEl.textContent = 'FPS: --';\n  document.body.appendChild(_ssFpsEl);\n}\n\nfunction _ssFpsLoop() {\n  _ssFpsFrames++;\n  var now = performance.now();\n  if (now - _ssFpsLastTime >= 1000) {\n    var fps = Math.round(_ssFpsFrames / ((now - _ssFpsLastTime) / 1000));\n    _ssFpsEl.textContent = 'FPS: ' + fps + ' (\u6295\u5C4F)';\n    _ssFpsFrames = 0;\n    _ssFpsLastTime = now;\n  }\n  _ssFpsRafId = window.requestAnimationFrame(_ssFpsLoop);\n}\n\nfunction _ssFpsStart() {\n  _ssFpsEnsureEl();\n  _ssFpsFrames = 0;\n  _ssFpsLastTime = performance.now();\n  _ssFpsEl.style.display = 'block';\n  if (_ssFpsRafId !== null) { window.cancelAnimationFrame(_ssFpsRafId); }\n  _ssFpsRafId = window.requestAnimationFrame(_ssFpsLoop);\n}\n\nfunction _ssFpsStop() {\n  if (_ssFpsRafId !== null) { window.cancelAnimationFrame(_ssFpsRafId); _ssFpsRafId = null; }\n  if (_ssFpsEl) _ssFpsEl.style.display = 'none';\n}\n\n","blob:https://jokerhead912-ctrl.github.io/8846f47c-9669-438d-a2c2-57f01fc2ec4a","loadBoardFile(event)","media/9.png","media/11.png","media/13.png","media/15.png","media/17.png","media/19.png","media/23.png","media/25.png","media/27.png","media/29.png","media/31.png","media/33.png","media/35.png","media/37.png","media/41.png","media/43.png","media/45.png","media/47.png","media/49.png","media/51.png","media/53.png","media/55.png","media/57.png","media/59.png","media/62.png","media/64.png","media/66.png","media/74.png","media/76.png","media/86.png","media/88.png","media/90.png","media/93.png","media/94.png","media/95.png","media/96.png","media/97.png","media/98.png","media/99.png","media/100.png","media/101.png","m