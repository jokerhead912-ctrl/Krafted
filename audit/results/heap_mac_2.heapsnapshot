   'Tidied ... items': '\u5DF2\u6574\u7406 ... \u4E2A\u9879\u76EE',\n    'Comment added at frame': '\u5DF2\u5728\u5E27\u65B0\u589E\u7559\u8A00',\n    'Comment removed': '\u7559\u8A00\u5DF2\u5220\u9664',\n    'Comment cannot be empty': '\u7559\u8A00\u4E0D\u53EF\u4E3A\u7A7A',\n    'Comment updated': '\u7559\u8A00\u5DF2\u66F4\u65B0',\n    'No comments to export \u2014 add at least one frame comment first': '\u6CA1\u6709\u7559\u8A00\u53EF\u5BFC\u51FA \u2014 \u8BF7\u5148\u65B0\u589E\u81F3\u5C11\u4E00\u5219\u5E27\u7559\u8A00',\n    'Comments saved \u2014 load it later to continue editing': '\u7559\u8A00\u5DF2\u4FDD\u5B58 \u2014 \u7A0D\u540E\u8F7D\u5165\u53EF\u7EE7\u7EED\u7F16\u8F91',\n    'No comments to translate': '\u6CA1\u6709\u7559\u8A00\u53EF\u7FFB\u8BD1',\n    'All comments already have a translation': '\u6240\u6709\u7559\u8A00\u5DF2\u6709\u7FFB\u8BD1',\n    'No comments to clear': '\u6CA1\u6709\u7559\u8A00\u53EF\u6E05\u9664',\n    'Cleared all ... comments': '\u5DF2\u6E05\u9664\u5168\u90E8 ... \u5219\u7559\u8A00',\n    'No comments to send \u2014 add at least one frame comment first': '\u6CA1\u6709\u7559\u8A00\u53EF\u53D1\u9001',\n    'Sent ... comment(s) to board': '\u5DF2\u53D1\u9001 ... \u5219\u7559\u8A00\u5230\u9762\u677F',\n    'No strokes on any frame': '\u4EFB\u4F55\u5E27\u7686\u65E0\u7B14\u5212',\n    'No drawings to export \u2014 draw on at least one frame first': '\u6CA1\u6709\u7ED8\u56FE\u53EF\u5BFC\u51FA',\n    'Draw mode off \u2014 press the draw button to start again': '\u7ED8\u56FE\u6A21\u5F0F\u5DF2\u5173\u95ED \u2014 \u518D\u6309\u7ED8\u56FE\u6309\u94AE\u5F00\u59CB',\n    'Draw mode on \u2014 click \u2715 or the draw button to hide': '\u7ED8\u56FE\u6A21\u5F0F\u5DF2\u5F00\u542F',\n    'Following video': '\u5DF2\u8DDF\u968F\u89C6\u9891',\n    'Frame rate:': '\u5E27\u7387\uFF1A',\n    'fps (manual)': 'fps (\u624B\u52A8)',\n    'fps (auto)': 'fps (\u81EA\u52A8)',\n    'Saved as PNG': '\u5DF2\u4FDD\u5B58\u4E3A PNG',\n    'Capture discarded': '\u622A\u56F