sion from a blob's MIME type\nfunction mimeToExt(mime, fallback) {\n  if (!mime) return fallback || 'bin';\n  if (mime.includes('video/mp4')) return 'mp4';\n  if (mime.includes('video/webm')) return 'webm';\n  if (mime.includes('video/ogg')) return 'ogv';\n  if (mime.includes('video/quicktime')) return 'mov';\n  if (mime.includes('video/')) return 'mp4';\n  if (mime.includes('image/png')) return 'png';\n  if (mime.includes('image/gif')) return 'gif';\n  if (mime.includes('image/webp')) return 'webp';\n  if (mime.includes('image/jpeg')) return 'jpg';\n  if (mime.includes('image/svg')) return 'svg';\n  if (mime.includes('image/')) return 'png';\n  if (mime.includes('audio/wav')) return 'wav';\n  if (mime.includes('audio/mpeg')) return 'mp3';\n  if (mime.includes('audio/ogg')) return 'ogg';\n  if (mime.includes('audio/')) return 'mp3';\n  return fallback || 'bin';\n}\n\n// v7.0.27: UI-language helper for save/load progress strings\nfunction _isZhUI() { return (typeof I18N !== 'undefined' && I18N.getLang && I18N.getLang() === 'zh'); }\n// v7.0.27: human ETA / duration strings, language-aware\nfunction _fmtEtaSec(sec) {\n  if (!isFinite(sec) || sec < 0) return '';\n  const zh = _isZhUI();\n  if (sec < 60) return zh ? ('\u5269\u7EA6 ' + Math.ceil(sec) + ' \u79D2') : ('~' + Math.ceil(sec) + 's left');\n  const m = Math.floor(sec / 60), s = Math.round(sec % 60);\n  return zh ? ('\u5269\u7EA6 ' + m + ' \u5206 ' + s + ' \u79D2') : ('~' + m + 'm ' + s + 's left');\n}\nfunction _fmtDurSec(sec) {\n  const zh = _isZhUI();\n  if (sec < 60) return zh ? (Math.max(1, Math.round(sec)) + ' \u79D2') : (Math.max(1, Math.round(sec)) + 's');\n  const m = Math.floor(sec / 60), s = Math.round(sec % 60);\n  return zh ? (m + ' \u5206 ' + s + ' \u79D2') : (m + 'm ' + s + 's');\n}\n// v7.0.27: determinate progress UI \u2014 bar + % + bytes written + rolling-rate ETA.\n// Replaces the text-only .save-progress div. update(text, {doneBytes,\n// totalBytes, doneItems, totalItems, extra}); pass text=null to keep the label.\nfunction makeProgressUI(opts) {\n  opts = opts || {};\n  const el = document.createElement('div');\n  el.className = 'save-progress';\n  el.innerHTML = '<div class=\"pct\"></div><div class=\"bar\"><i></i></div><div class=\"sub\"></div>'\n    + (opts.onCancel\n        ? '<div class=\"pg-cancel\"><button type=\"button\">'\n          + (opts.cancelLabel || 'Cancel') + '</button></div>'\n        : '');\n  document.body.appendChild(el);\n  const pctEl = el.querySelector('.pct');\n  const barEl = el.querySelector('.bar > i');\n  const subEl = el.querySelector('.sub');\n  const t0 = performance.now();\n  // v7.9.0: opt-in, so every existing caller keeps the card it had. Cancelling\n  // only SETS THE FLAG \u2014 the loop owns stopping, because a half-written file\n  // is worse than a finished one.\n  let _cancelled = false;\n  if (opts.onCancel) {\n    const cBtn = el.querySelector('.pg-cancel > button');\n    if (cBtn) cBtn.addEventListener('click', function () {\n      _cancelled = true;\n      cBtn.disabled = true;\n      cBtn.textContent = opts.cancellingLabel || 'Cancelling\u2026';\n      try { opts.onCancel(); } catch (e) { console.error(e); }\n    });\n  }\n  const samples = [];\n  let lastBarT = 0;\n  return {\n    el: el,\n    update: function(text, o) {\n      o = o || {};\n      if (text != null) pctEl.textContent = text;\n      let pct = -1;\n      if (o.totalBytes > 0 && o.doneBytes != null) pct = Math.min(99, o.doneBytes / o.totalBytes * 100);\n      else if (o.totalItems > 0 && o.doneItems != null) pct = Math.min(99, o.doneItems / o.totalItems * 100);\n      const nowT = performance.now();\n      if (pct >= 0 && (nowT - lastBarT > 100)) { barEl.style.width = pct.toFixed(1) + '%'; lastBarT = nowT; }\n      let sub = '';\n      if (o.doneBytes != null) {\n        sub = formatBytes(o.doneBytes) + (o.totalBytes > 0 ? ' / ~' + formatBytes(o.totalBytes) : '');\n        samples.push({ t: nowT, b: o.doneBytes });\n        while (samples.length > 2 && nowT - samples[0].t > 4000) samples.shift();\n        if (o.totalBytes > 0 && o.doneBytes < o.totalBytes) {\n          if (samples.length >= 2) {\n            const dt = (nowT - samples[0].t) / 1000;\n            const rate = dt > 0.2 ? (o.doneBytes - samples[0].b) / dt : 0;\n            if (rate > 1024) { const eta = _fmtEtaSec((o.totalBytes - o.doneBytes) / rate); if (eta) sub += ' \u00B7 ' + eta; }\n            else sub += ' \u00B7 ' + (_isZhUI() ? '\u4F30\u7B97\u4E2D\u2026' : 'estimating\u2026');\n          } else if (o.doneBytes > 0) {\n            sub += ' \u00B7 ' + (_isZhUI() ? '\u4F30\u7B97\u4E2D\u2026' : 'estimating\u2026');\n          }\n        }\n      }\n      if (o.extra) sub = sub ? sub + ' \u00B7 ' + o.extra : o.extra;\n      subEl.textContent = sub;\n    },\n    elapsedSec: function() { return (performance.now() - t0) / 1000; },\n    cancelled: function() { return _cancelled; },\n    done: function() { try { el.remove(); } catch (e) {} }\n  };\n}\n\n// Build the .kpak zip file (manifest.json + all media blobs as raw files)\n// v6.3.0: Streaming kpak builder \u2014 writes directly to a WritableStream.\n// Replaces buildKpakBlob which held the entire zip in memory via JSZip.\nasync function buildKpakStream(writableStream, progressCallback, lockPassword) {\n  console.log('[KPACK] buildKpakStream starting...');\n\n  const zip = new StreamingZipWriter(writableStream);\n\n  // 1. Build manifest (embed lock metadata if password provided)\n  const manifest = buildManifest();\n  // v6.5.0: Lock support removed\n  await zip.addText('manifest.json', JSON.stringify(manifest));\n\n  // 2. Walk items and stream media blobs one at a time\n  let packed = 0, skipped = 0, idx = 0;\n  const blobItems = state.items.filter(it => it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')));\n  console.log('[KPACK] found', blobItems.length, 'blob items to stream');\n\n  for (const it of blobItems) {\n    idx++;\n    const label = it.isVideo ? 'Video' : it.isAudio ? 'Audio' : 'Image';\n    if (progressCallback) progressCallback('Packing ' + label + ' ' + idx + '/' + blobItems.length + '...');\n    try {\n      const resp = await fetch(it.src);\n      if (!resp.ok) { console.warn('[KPACK] fetch failed for', it.id, 'status:', resp.status); skipped++; continue; }\n      const blob = await resp.blob();\n      const ext = mimeToExt(blob.type, it.isVideo ? 'mp4' : it.isAudio ? 'mp3' : 'png');\n      const zipPath = 'media/' + it.id + '.' + ext;\n      await zip.addBlob(zipPath, blob);\n      packed++;\n      if (idx % 3 === 0) await new Promise(r => setTimeout(r, 0));\n    } catch (e) {\n      console.warn('[KPACK] failed to pack media for item', it.id, e.message);\n      skipped++;\n    }\n  }\n\n  if (progressCallback) progressCallback('Finalizing zip...');\n  console.log('[KPACK] finalizing streaming zip with', packed, 'files...');\n  await zip.finalize();\n  console.log('[KPACK] streaming zip finalized:', packed, 'packed,', skipped, 'skipped');\n  return { manifest, packed, skipped };\n}\n\n// Legacy fallback: build kpak as a blob via JSZip (used when File System Access API is unavailable).\n// Kept for non-Chrome browsers. For large projects, streaming via buildKpakStream is preferred.\nasync function buildKpakBlob(progressCallback) {\n  console.log('[KPACK] buildKpakBlob starting (JSZip fallback)...');\n  if (typeof JSZip === 'undefined') throw new Error('JSZip not loaded - refresh the page');\n  \n  const zip = new JSZip();\n  const manifest = buildManifest();\n  zip.file('manifest.json', JSON.stringify(manifest));\n\n  let packed = 0, skipped = 0, idx = 0;\n  const blobItems = state.items.filter(it => it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')));\n  console.log('[KPACK] found', blobItems.length, 'blob items to pack');\n  \n  for (const it of blobItems) {\n    idx++;\n    const label = it.isVideo ? 'Video' : it.isAudio ? 'Audio' : 'Image';\n    if (progressCallback) progressCallback('Packing ' + label + ' ' + idx + '/' + blobItems.length + '...');\n    try {\n      const resp = await fetch(it.src);\n      if (!resp.ok) { console.warn('[KPACK] fetch failed for', it.id, 'status:', resp.status); skipped++; continue; }\n      const blob = await resp.blob();\n      const ext = mimeToExt(blob.type, it.isVideo ? 'mp4' : it.isAudio ? 'mp3' : 'png');\n      const zipPath = 'media/' + it.id + '.' + ext;\n      zip.file(zipPath, blob, { binary: true });\n      packed++;\n      if (idx % 3 === 0) await new Promise(r => setTimeout(r, 0));\n    } catch (e) {\n      console.warn('[KPACK] failed to pack media for item', it.id, e.message);\n      skipped++;\n    }\n  }\n\n  if (progressCallback) progressCallback('Generating zip...');\n  console.log('[KPACK] generating zip with', packed, 'files...');\n  const zipBlob = await zip.generateAsync({ type: 'blob', compression: 'STORE' }, function(meta) {\n    if (progressCallback && meta.percent) {\n      progressCallback('Zipping ' + meta.percent.toFixed(0) + '%');\n    }\n  });\n  console.log('[KPACK] zip generated, size:', zipBlob.size);\n  return { zipBlob, manifest, packed, skipped };\n}\n\n// Fallback download helper \u2014 used when File System Access API is unavailable\nfunction downloadBlob(blob, suggestedName) {\n  return new Promise((resolve, reject) => {\n    try {\n      const url = URL.createObjectURL(blob);\n      const link = document.createElement('a');\n      link.download = suggestedName;\n      link.href = url;\n      document.body.appendChild(link);\n      link.click();\n      document.body.removeChild(link);\n      // v7.0.45: same race as the main save path. Revoking the URL on a fixed\n      // 5 s timer cuts the legs out from under any download the browser has\n      // not finished draining, which truncates the file. Hold it until the\n      // next save instead of guessing at a timeout.\n      _releaseLastSaveObjectUrl();\n      _lastSaveObjectUrl = url;\n      resolve(true);\n    } catch (e) { reject(e); }\n  });\n}\n\n// Save with native \"Save As\" dialog (File System Access API) \u2014 fallback to regular download\nasync function saveBlobWithPicker(blob, suggestedName, mimeType, extension) {\n  console.log('[SAVE-PICKER] blob size:', blob.size, 'type:', blob.type, 'name:', suggestedName);\n  console.log('[SAVE-PICKER] showSaveFilePicker available:', !!window.showSaveFilePicker);\n  \n  if (window.showSaveFilePicker) {\n    console.log('[SAVE-PICKER] attempting showSaveFilePicker...');\n    try {\n      const handle = await window.showSaveFilePicker({\n        suggestedName,\n        types: [{\n          description: extension === '.kpak' ? 'Krafted Package' : 'JSON File',\n          accept: { [mimeType]: [extension] }\n        }]\n      });\n      console.log('[SAVE-PICKER] handle obtained:', handle.name);\n      const writable = await handle.createWritable();\n      await writable.write(blob);\n      await writable.close();\n      console.log('[SAVE-PICKER] write complete');\n      return { ok: true, path: handle.name };\n    } catch (e) {\n      console.error('[SAVE-PICKER] showSaveFilePicker error:', e.name, e.message);\n      if (e.name === 'AbortError') { return { ok: false, cancelled: true }; }\n      // Other errors (e.g. permission denied, transient activation expired) \u2014 fall through to link download\n      console.warn('[SAVE-PICKER] falling back to link download');\n    }\n  }\n  // Fallback: regular download to default Downloads folder\n  console.log('[SAVE-PICKER] using fallback link download');\n  try {\n    await downloadBlob(blob, suggestedName);\n    console.log('[SAVE-PICKER] fallback download triggered');\n    return { ok: true, path: null, fallback: true };\n  } catch (e2) {\n    console.error('[SAVE-PICKER] fallback also failed:', e2);\n    return { ok: false, cancelled: false, error: e2.message };\n  }\n}\n\n// --- REQUEST file handle BEFORE building kpak (must happen while transient user activation is fresh) ---\nasync function requestSaveHandle(suggestedName, mimeType, extension) {\n  if (!window.showSaveFilePicker) return { handle: null, name: null };\n  try {\n    const handle = await window.showSaveFilePicker({\n      suggestedName,\n      types: [{\n        description: extension === '.kpak' ? 'Krafted Package' : 'JSON File',\n        accept: { [mimeType]: [extension] }\n      }]\n    });\n    return { handle, name: handle.name };\n  } catch (e) {\n    if (e.name === 'AbortError') return { handle: null, name: null, cancelled: true };\n    console.warn('[SAVE] showSaveFilePicker failed (' + e.name + '), will use download fallback');\n    return { handle: null, name: null };\n  }\n}\n\n// ============================================================\n// v6.5.0: Custom KPAK container format\n// ============================================================\n// Single-file, internally chunked. Save is streaming (append-only).\n// Load uses Blob.slice() for random access \u2014 NO JSZip, NO OOM.\n//\n// Format:\n//   [Data Blocks...] [Index] [Footer: \"KPAK\" + 8B index_offset]\n//\n// Each data block: [4B LE size][N bytes raw data]\n// Index: [4B entry_count][for each: 2B name_len + name + 8B offset + 8B size + 1B type]\n// Footer: \"KPAK\" (4B magic) + 8B LE index_offset\n// ============================================================\n\n// Write helpers for streaming\nfunction _kpakWriteU32(w, v) {\n  const b = new Uint8Array(4);\n  new DataView(b.buffer).setUint32(0, v, true); // LE\n  return w.write(b);\n}\nfunction _kpakWriteU64(w, v) {\n  const b = new Uint8Array(8);\n  new DataView(b.buffer).setBigUint64(0, BigInt(v), true); // LE\n  return w.write(b);\n}\nfunction _kpakWriteStr(w, s) {\n  const enc = new TextEncoder().encode(s);\n  const lenB = new Uint8Array(2);\n  new DataView(lenB.buffer).setUint16(0, enc.length, true); // LE\n  return w.write(lenB).then(() => w.write(enc));\n}\n\n// v6.5.0: Build kpak blob \u2014 writes manifest + all media as raw entries\n// Uses the custom container format. Two modes:\n//   1) With FileSystemWritableFileStream (Chrome/Edge): stream each entry directly to disk\n//   2) Fallback: build Blob from array of ArrayBuffers (1 entry in memory at a time)\nasync function buildKpakV6(progressCallback, writableStream, estTotalBytes) {\n  console.log('[KPAKv6] buildKpakV6 starting...', writableStream ? 'STREAMING' : 'BLOB');\n  const useStreaming = !!writableStream;\n\n  const manifest = buildManifest();\n  const manifestJson = JSON.stringify(manifest);\n  const manifestBytes = new TextEncoder().encode(manifestJson);\n\n  const blobItems = state.items.filter(it =>\n    (it._sourceBlob instanceof Blob && it._sourceBlob.size > 0) ||\n    (it._lazyZip && it._lazyEntry) ||\n    // v7.0.2: never-activated v6 KPAK lazy videos (_kpakEntry/_kpakBlob set,\n    // src still '') were previously excluded here entirely \u2014 they vanished\n    // from the save with ZERO warning because they never even entered the\n    // failedItems/expectedMediaCount accounting. Must be included so they\n    // get resolved into a real Blob below instead of silently dropped.\n    (it._kpakEntry && it._kpakBlob) ||\n    (it.src && (it.src.startsWith('blob:') || it.src.startsWith('data:')))\n  );\n  console.log('[KPAKv6] items to pack:', blobItems.length);\n\n  // v6.8.28: remember original media item count so we can warn if any vanish.\n  const expectedMediaCount = blobItems.length;\n\n  // Build entries list with metadata only \u2014 bytes are fetched on demand\n  const entryMetas = [];\n  entryMetas.push({ name: 'manifest.json', size: manifestBytes.length, type: 0, bytes: manifestBytes, isManifest: true });\n  for (const it of blobItems) {\n    entryMetas.push({\n      name: 'media/' + it.id + (it.isVideo ? '.mp4' : it.isAudio ? '.mp3' : '.png'),\n      size: it._fileSize || (it.isVideo ? 80 * 1024 * 1024 : 5 * 1024 * 1024),\n      type: it.isVideo ? 1 : it.isAudio ? 2 : 3,\n      src: it.src,\n      // v6.8.29/30: media items may retain a st