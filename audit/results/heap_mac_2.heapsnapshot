xt commit. A board snapshot per stroke would be far too expensive.\n//\n// Before v7.0.36 the handler tested `_top.seq === G._actionSeq` \u2014 an EXACT\n// equality. Any drift (a board op firing after the last stroke, a deferred\n// undo flushing at the end of a save, or the target element having been\n// rebuilt so the entry was stale) made the test fail, and Ctrl+Z then fell\n// through to the global board undo(). Because annotation strokes never take a\n// board snapshot, the snapshot on top of undoStack predated every stroke the\n// user had drawn \u2014 restoring it wiped all of the frame drawings and text in\n// one keypress. That is the \"\u4E00\u64B3 Ctrl+Z \u5C31\u5C07\u6211\u6240\u6709\u756B\u5605\u5BEB\u5605\u5622\u90FD\u522A\u9664\" report.\n//\n// The fix: give the board stack its own sequence numbers and decide by\n// COMPARISON, not equality. Whichever stack owns the higher sequence number\n// was touched last, so it is the one we undo. Equality is no longer a failure\n// mode, and a stale annotation entry is skipped instead of triggering a\n// whole-board restore.\n\nfunction currentBoardSeq() {\n  return state._boardSeq || 0;\n}\nfunction currentAnnoSeq() {\n  const st = G._annoUndoStack;\n  return (st && st.length) ? (st[st.length - 1].seq || 0) : -1;\n}\nfunction currentBoardRedoSeq() {\n  return (state._redoSeqs && state._redoSeqs.length)\n    ? state._redoSeqs[state._redoSeqs.length - 1] : -1;\n}\nfunction currentAnnoRedoSeq() {\n  const st = G._annoRedoStack;\n  return (st && st.length) ? (st[st.length - 1].seq || 0) : -1;\n}\n\n// Paint the annotation overlay after a stroke was added/removed.\nfunction _annoRefreshElement(el) {\n  try { if (el._syncStrokesForFrame) el._syncStrokesForFrame(); } catch (e) {}\n  el._perfLastRenderKey = '';\n  try { if (el._renderAnnoCanvas) el._renderAnnoCanvas(); } catch (e) {}\n  try { if (el._refreshDrawBtnBadge) el._refreshDrawBtnBadge(); } catch (e) {}\n  try { if (el._refreshAllSeekMarkers) el._refreshAllSeekMarkers(); } catch (e) {}\n  try { scheduleAutoSave(); } catch (e) {}\n}\n\n// Remove the newest still-valid annotation commit. Stale entries (element\n// deleted, or its frame array already emptied by something else) are dropped\n// rather than escalating to a board undo.\nfunction _annoUndoOne() {\n  const st = G._annoUndoStack;\n  if (!st || !st.length) return false;\n  while (st.length) {\n    const top = st.pop();\n    const el = top && top.el;\n    const ds = el && el.isConnected && el._annoDrawState;\n    const arr = ds && ds.strokesByFrame && ds.strokesByFrame[top.frame];\n    if (!arr || !arr.length) continue;   // stale \u2014 try the next entry\n    const stroke = arr.pop();\n    if (!arr.length) { try { delete ds.strokesByFrame[top.frame]; } catch (e) {} }\n    try {\n      G._annoRedoStack = G._annoRedoStack || [];\n      G._annoRedoStack.push({ el: el, frame: top.frame, seq: top.seq, stroke: stroke });\n      if (G._annoRedoStack.length > 100) G._annoRedoStack.shift();\n    } catch (e) {}\n    _annoRefreshElement(el);\n    return true;\n  }\n  return false;\n}\n\n// Re-apply the annotation commit removed by the last Ctrl+Z.\nfunction _annoRedoOne() {\n  const st = G._annoRedoStack;\n  if (!st || !st.length) return false;\n  while (st.length) {\n    const top = st.pop();\n    const el = top && top.el;\n    const ds = el && el.isConnected && el._annoDrawState;\n    if (!ds || !ds.strokesByFrame) continue;   // stale \u2014 try the next entry\n    if (!ds.strokesByFrame[top.frame]) ds.strokesByFrame[top.frame] = [];\n    ds.strokesByFrame[top.frame].push(top.stroke);\n    try {\n      G._annoUndoStack = G._annoUndoStack || [];\n      G._actionSeq = (G._actionSeq || 0) + 1;\n      G._annoUndoStack.push({ el: el, frame: top.frame, seq: G._actionSeq });\n      if (G._annoUndoStack.length > 100) G._annoUndoStack.shift();\n    } catch (e) {}\n    _annoRefreshElement(el);\n    return true;\n  }\n  return false;\n}\n\n// Ctrl+Z \u2014 undo whichever action happened last.\nfunction undoLastAction() {\n  if (currentAnnoSeq() >= currentBoardSeq() && _annoUndoOne()) return;\n  undo();\n}\n// Ctrl+Shift+Z / Ctrl+Y \u2014 redo whichever action was undone last.\nfunction redoLastAction() {\n  if (currentAnnoRedoSeq() >= currentBoardRedoSeq() && _annoRedoOne()) return;\n  redo();\n}\n\n\n// ==== selection.js ====\n\n\nfunction getSelectedItems() {\n  return [...state.items, ...state.texts, ...(state.todos||[]), ...(state.mindmaps||[])].filter(i => state.selected.has(i.id));\n}\nfunction getSelectedImages() {\n  return state.items.filter(i => state.selected.has(i.id));\n}\n\n// ============================================================\n//  SELECTION\n// ============================================================\nfunction selectOnly(id) {\n  state.selected.clear();\n  state.selected.add(id);\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction clearSelection() {\n  state.selected.clear();\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction toggleSelect(id) {\n  if (state.selected.has(id)) state.selected.delete(id);\n  else state.selected.add(id);\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction refreshSelection() {\n  document.querySelectorAll('.item, .text-item, .todo-item, .draw-item').forEach(el => el.classList.remove('selected'));\n  document.querySelectorAll('.item-handle, .item-rot').forEach(el => el.remove());\n  // Round 67 \u2014 also wipe the empty union multi-select container left\n  // behind after the 8 child handles were just removed. The container\n  // is empty (no styles, no children) but we drop it anyway to keep\n  // the DOM tidy across long sessions of reselecting.\n  document.querySelectorAll('.multi-sel-handles').forEach(el => el.remove());\n  document.querySelectorAll('.text-handles').forEach(el => el.remove());\n  // Don't add handles during reframe mode\n  if (state.reframing) return;\n  // Clean up mask editing if selected item changed\n  const sel = getSelectedItems();\n  if (sel.length !== 1 || !sel[0].masks || !sel[0].masks.find(m => m.id === activeMaskId)) {\n    if (maskBrushActive) { maskBrushActive = false; removeBrushCanvas(); }\n    if (maskPickColorActive) { maskPickColorActive = false; document.getElementById('viewport').classList.remove('mask-pick-mode'); }\n    activeMaskId = null;\n  }\n  // Round 67 \u2014 MULTI-SELECT UNION HANDLES: when 2+ items are selected,\n  // skip the per-item addHandles() loop and add ONE set of 8 resize\n  // handles at the corners of the union bounding box (Figma / Sketch\n  // behavior). Previously every item got its own 8 handles, scattering\n  // them around the canvas and looking like \"scale points outside the\n  // selection box\". The existing Round-41 multi-select scale path\n  // (in the mousedown handler) still kicks in because dataset.id points\n  // at a selected item and state.selected.size > 1.\n  if (sel.length >= 2) {\n    // Mark every selected item visually (blue outline etc.) but skip the\n    // per-item handle children. The 8 union handles do the resize job.\n    sel.forEach(item => item.el.classList.add('selected'));\n    addMultiSelectHandles(sel);\n    sel.filter(it => it.el.classList.contains('text-item')).forEach(it => addTextHandles(it, true));\n  } else {\n    sel.forEach(item => {\n      item.el.classList.add('selected');\n      // v6.3.6 / v6.5.0: activate lazy video on select\n      if (item._lazyEntry && window._activateLazyVideo) window._activateLazyVideo(item);\n      if (item._kpakEntry && window._activateLazyVideoV6) window._activateLazyVideoV6(item);\n      // v5.5.1: lazy-load video when selected (preload=\"none\" saves memory)\n      if (item.video && item.video.preload === 'none') {\n        item.video.preload = 'auto';\n        item.video.load();\n      }\n      if (item.img) addHandles(item);\n      else if (item.type === 'draw') addHandles(item);\n      else if (item.video) {\n        // Round 57: video items need the SAME 8 resize handles + 1 rotation\n        // handle as images. Previously the code fell through to addTextHandles\n        // which expects tx.x/y/w/h (text properties) \u2014 videos don't have\n        // those, so the .text-handles container got NaN dimensions and the\n        // 6 handles clustered at the top-left of the canvas, looking like\n        // \"many random scale dots\" on selection. addHandles reads item.el\n        // only, so it works for any element-based item type.\n        addHandles(item);\n      } else if (item.audio) {\n        // Audio items also need standard resize handles (their .item is\n        // a flex column with no text/text-handle semantics).\n        addHandles(item);\n      } else if (item.el && item.el.classList.contains('todo-item')) {\n        // Todo items: add resize handles for scaling\n        addHandles(item);\n      } else if (item.el && item.el.classList.contains('mindmap-item')) {\n        // Mind map items: add resize handles for manual scaling\n        addHandles(item);\n      } else if (item.isLink) {\n        // Link cards: also need standard resize handles\n        addHandles(item);\n      } else addTextHandles(item); // Text items get resize handles too\n    });\n  }\n  // Round 58: playhead-position label visibility is a multi-source OR:\n  //   - selected (this refreshSelection pass found it in `sel`)\n  //   - actively playing\n  //   - mid-drag (toggle handled in the mousedown/mouseup handler)\n  // Iterate ALL video items and reconcile, so the previously-selected\n  // video's label hides on deselect and the new one shows. Cheaper\n  // than a per-item hook.\n  document.querySelectorAll('.item.has-media .media-playhead-label').forEach(lbl => {\n    var itemEl = lbl.closest('.item');\n    if (!itemEl) return;\n    var isSelected = itemEl.classList.contains('selected');\n    var media = itemEl.querySelector('video, audio');\n    var isPlaying = media && !media.paused && !media.ended;\n    if (isSelected || isPlaying) {\n      lbl.classList.add('show');\n      lbl._forceVisible = true;\n    } else {\n      lbl.classList.remove('show');\n      lbl._forceVisible = false;\n    }\n  });\n  syncBoardTextUI();\n  updatePropsPanel();\n  updateStatus();\n  // v7.0.52: keep the Library highlight on the current selection. Cheap on\n  // purpose - it flips classes, it never rebuilds the list.\n  try { libSyncActive(); } catch (e) {}\n  // v7.0.53: the map tints the selected item too.\n  try { requestMinimapRefresh(); } catch (e) {}\n}\nfunction addHandles(item) {\n  const handles = [\n    { cls: 'nw', dir: 'nw' }, { cls: 'ne', dir: 'ne' },\n    { cls: 'sw', dir: 'sw' }, { cls: 'se', dir: 'se' },\n    { cls: 'n', dir: 'n' }, { cls: 's', dir: 's' },\n    { cls: 'e', dir: 'e' }, { cls: 'w', dir: 'w' },\n  ];\n  handles.forEach(h => {\n    const el = document.createElement('div');\n    el.className = `item-handle ${h.cls}`;\n    el.dataset.dir = h.dir;\n    el.dataset.id = item.id;\n    item.el.appendChild(el);\n  });\n  if (!item.locked) {\n    const rot = document.createElement('div');\n    rot.className = 'item-rot';\n    rot.dataset.id = item.id;\n    item.el.appendChild(rot);\n  }\n}\n\n// Round 67 \u2014 MULTI-SELECT UNION HANDLES.\n// When 2+ items are selected, instead of adding 8 scale handles + 1 rotation\n// handle on EACH item (which puts handles scattered around every individual\n// item \u2014 looking like \"scale points outside the [logical] selection box\"),\n// we draw a SINGLE set of 8 resize handles at the corners of the union\n// axis-aligned bounding box. This matches Figma / Sketch / Photoshop behavior\n// and is what the user expects when they select multiple things.\n//\n// The container is appended to canvasContent (the same parent as items),\n// so it inherits the canvas pan/zoom transform and the items inside it are\n// positioned in world coords. dataset.id points at the first non-locked\n// selected item so the existing mousedown handler can find it; the existing\n// multi-select scale path (Round 41) then takes over.\nfunction addMultiSelectHandles(sel) {\n  // Union AABB in world coords\n  let mx = Infinity, my = Infinity, mx2 = -Infinity, my2 = -Infinity;\n  for (const s of sel) {\n    if (s.x < mx) mx = s.x;\n    if (s.y < my) my = s.y;\n    if (s.x + s.w > mx2) mx2 = s.x + s.w;\n    if (s.y + s.h > my2) my2 = s.y + s.h;\n  }\n  const bw = mx2 - mx;\n  const bh = my2 - my;\n  // Pick the first non-locked item as the handle \"owner\" so the mousedown\n  // handler finds a resizable item (the existing multi-select path then\n  // scales every selected item together around the union bbox pivot).\n  const owner = sel.find(s => !s.locked) || sel[0];\n  // Highest z so the handles sit on top of every selected item\n  let maxZ = 0;\n  for (const s of sel) { if ((s.z || 1) > maxZ) maxZ = s.z || 1; }\n  const cont = document.createElement('div');\n  cont.className = 'multi-sel-handles';\n  // Position in world coords. The .item-handle CSS already positions each\n  // handle at the corners of its parent (top: -8px; left: -8px; etc), so\n  // the handle dots sit 8px OUTSIDE the bbox corners \u2014 exactly like the\n  // per-item handles, but at the union of all selected items.\n  cont.style.position = 'absolute';\n  cont.style.left = '0px';\n  cont.style.top = '0px';\n  cont.style.width = bw + 'px';\n  cont.style.height = bh + 'px';\n  cont.style.transform = `translate3d(${mx}px, ${my}px, 0)`;\n  cont.style.transformOrigin = '0 0';\n  cont.style.zIndex = (maxZ + 1) + '';\n  cont.style.pointerEvents = 'none'; // container is click-through; children re-enable\n  cont.dataset.ownerId = owner.id;\n  // 8 resize handles. dataset.id = owner.id so the mousedown handler in the\n  // SELECT TOOL branch can find the item and enter the Round-41 multi-select\n  // scale path (which scales every selected item together around the union\n  // bbox pivot). The same path triggers on ANY handle, so we don't need to\n  // change the resize logic at all.\n  const dirs = ['nw','ne','sw','se','n','s','e','w'];\n  for (const d of dirs) {\n    const el = document.createElement('div');\n    el.className = 'item-handle ' + d + ' multi-handle';\n    el.dataset.dir = d;\n    el.dataset.id = owner.id;\n    el.style.pointerEvents = 'auto';\n    cont.appendChild(el);\n  }\n  canvasContent.appendChild(cont);\n}\n\n// Text items get corner + edge handles for resizing\n// Handles go in a SIBLING container (.text-handles), NOT inside the contentEditable div\nfunction addTextHandles(tx, moveOnly) {\n  if (!tx.el || !tx.el.parentElement || tx.locked) return;\n  let box = tx.el.parentElement.querySelector('.text-handles[data-owner=\"' + tx.id + '\"]');\n  if (!box) {\n    box = document.createElement('div');\n    box.className = 'text-handles';\n    box.dataset.owner = tx.id;\n    tx.el.parentElement.appendChild(box);\n  }\n  box.replaceChildren();\n  box.style.left = tx.x + 'px';\n  box.style.top = tx.y + 'px';\n  box.style.width = tx.w + 'px';\n  box.style.height = tx.h + 'px';\n  box.style.zIndex = (tx.z || 1) + 1;\n  box.style.transform = 'rotate(' + (tx.rot || 0) + 'deg)';\n  const grip = document.createElement('button');\n  grip.type = 'button';\n  grip.className = 'bt-move';\n  grip.dataset.id = tx.id;\n  grip.textContent = boardTextLabel('Move', '\u79FB\u52A8');\n  grip.title = boardTextLabel('Drag to move; double-click text to edit', '\u62D6\u52A8\u628A\u624B\u79FB\u52A8\uFF1B\u53CC\u51FB\u6B63\u6587\u7F16\u8F91');\n  grip.setAttribute('aria-label', grip.title);\n  grip.style.transform = 'scale(' + (1 / Math.max(.05, state.zoom)) + ')';\n  box.appendChild(grip);\n  if (moveOnly) return;\n  ['n','s'].forEach(dir => {\n    const border = document.createElement('div');\n    border.className = 'bt-select-edge ' + dir;\n    border.dataset.id = tx.id;\n    box.appendChild(border);\n  });\n  ['e','w'].forEach(dir => {\n    const handle = document.createElement('div');\n    handle.className = 'item-handle ' + dir;\n    handle.dataset.id = tx.id;\n    handle.dataset.dir = dir;\n    handle.dataset.textHandle = '1';\n    handle.title = boardTextLabel('Change width; keep font size', '\u8C03\u6574\u5BBD\u5EA6\uFF0C\u4E0D\u6539\u53D8\u5B57\u53F7');\n    box.appendChild(handle);\n  });\n  // v7.20.0: corner handles, so a text card scales like an IMAGE \u2014 aspect\n  // locked, and the font scales with the box (see scaleBoardTextFontSize).\n  // Edge handles keep the old width-only meaning on purpose: \"resize the\n  // box, not the type\" is still a thing people want.\n  ['nw','ne','sw','se'].forEach(dir => {\n    const handle = document.createElement('div');\n    handle.className = 'item-handle ' + dir;\n    handle.dataset.id = tx.id;\n    handle.dataset.dir = dir;\n    handle.dataset.textHandle = '1';\n    handle.title = boardTextLabel('Scale text; font scales too', '\u6574\u4F53\u7F29\u653E\uFF0C\u5B57\u53F7\u540C\u6B65\u653E\u5927');\n    box.appendChild(handle);\n  });\n}\n\n// \u2500\u2500 v5.5.1: hover-based video lazy load \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// When the mouse hovers over a video that hasn't been loaded yet\n// (preload=\"none\"), trigger load so the user sees a thumbnail.\nvar _videoLazyLoadObserver = null;\nfunction initVideoLazyLoad() {\n  if (_videoLazyLoadObserver) return;\n  var hoveredVideo = null;\n  document.addEventListener('mousemove', function(e) {\n    var el = document.elementFromPoint(e.clientX, e.clientY);\n    if (!el) return;\n    var itemEl = el.closest('.item.has-media');\n    if (!itemEl) {\n      if (hoveredVideo) { hoveredVideo = null; }\n      return;\n    }\n    // Avoid re-checking the same element every mousemove tick\n    if (itemEl === hoveredVideo) return;\n    hoveredVideo = itemEl;\n    // Find the video element inside\n    var vid = itemEl.querySelector('video');\n    // v6.3.6 / v6.5.0: activate lazy video on hover\n    if (itemEl._item && itemEl._item._lazyEntry && window._activateLazyVideo) {\n      window._activateLazyVideo(itemEl._item);\n    }\n    if (itemEl._item && itemEl._item._kpakEntry && window._activateLazyVideoV6) {\n      window._activateLazyVideoV6(itemEl._item);\n    }\n    if (vid && vid.preload === 'none') {\n      vid.preload = 'auto';\n      vid.load();\n    }\n  }, { passive: true });\n}\n\n\n// ==== layout-tidy.js ====\n\n\n// ============================================================\n//  TIDY SELECTION \u2014 Masonry layout for selected items\n// ============================================================\n// \u2500\u2500 Tidy column widths (v7.0.38) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// TIDY_COL_W is the plain image/text column: dense, Pinterest-like.\n// TIDY_MEDIA_COL_W is the floor for any selection that contains a video or\n// an audio clip. It is not a taste value \u2014 it is measured. The player\n// controls bar at its \"micro\" density (see .media-controls-row.micro) needs\n// ~343px of intrinsic width to fit play + draw + both time labels + the\n// seek bar + comments + snap without scrolling. 380 leaves ~37px of slack\n// for font rendering differences across platforms.\nvar TIDY_COL_W = 280;\nvar TIDY_MEDIA_COL_W = 380;\n// Does this entry carry a player controls bar? Both shapes exist in the\n// wild \u2014 items created in-session carry isVideo/isAudio booleans, items\n// rebuilt from a .kpak may only carry type === 'video'.\nfunction _itemHasPlayerControls(o) {\n  if (!o) return false;\n  return !!(o.isVideo || o.isAudio || o.type === 'video' || o.type === 'audio');\n}\n\n// Arranges all selected items (items, texts, todos, mindmaps) in a compact\n// masonry (Pinterest-style) grid centered on the original selection bounding\n// box. All items are scaled to a uniform column width preserving aspect\n// ratio. Uses minimum 2 columns for 2+ items.\n// After layout, auto-frames the viewport to show all tidied items.\n// Bound to Ctrl+Shift+T (Cmd+Shift+T on Mac) and the \uF9F9 toolbar button.\n// v7.0.38: the column width is no longer a flat 280 \u2014 see TIDY_COL_W /\n// TIDY_MEDIA_COL_W below. 280 was picked for images and it silently turned\n// every tidied video into a control strip you had to scroll sideways.\nfunction tidySelection() {\n  var sel = state.selected;\n  if (!sel || sel.size === 0) {\n    try { toast('Select items to tidy first'); } catch (e) {}\n    return;\n  }\n\n  // --- Collect all selected items with their world-coordinate bounds ---\n  var selItems = [];\n  var selArr = Array.from(sel);\n  var COL_W = TIDY_COL_W;\n  var GAP = 16;\n\n  for (var si = 0; si < selArr.length; si++) {\n    var id = selArr[si];\n\n    // Image / video / link / draw items\n    var it = (state.items || []).find(function(i) { return i.id === id; });\n    if (it) {\n      selItems.push({\n        id: id, x: it.x, y: it.y, w: it.w, h: it.h,\n        el: it.el, isText: false, isTodo: false, isMindmap: false,\n        item: it\n      });\n      continue;\n    }\n\n    // Text items \u2014 get world-coord size from BCR\n    var tx = (state.texts || []).find(function(t) { return t.id === id; });\n    if (tx && tx.el) {\n      var r = tx.el.getBoundingClientRect();\n      var wx = (r.left - state.pan.x) / state.zoom;\n      var wy = (r.top  - state.pan.y) / state.zoom;\n      var ww = r.width  / state.zoom;\n      var wh = r.height / state.zoom;\n      selItems.push({\n        id: id, x: wx, y: wy, w: ww, h: wh,\n        el: tx.el, isText: true, isTodo: false, isMindmap: false,\n        item: tx\n      });\n      continue;\n    }\n\n    // Todo items\n    var td = (state.todos || []).find(function(t) { return t.id === id; });\n    if (td && td.el) {\n      var r2 = td.el.getBoundingClientRect();\n      var wx2 = (r2.left - state.pan.x) / state.zoom;\n      var wy2 = (r2.top  - state.pan.y) / state.zoom;\n      var ww2 = r2.width  / state.zoom;\n      var wh2 = r2.height / state.zoom;\n      selItems.push({\n        id: id, x: wx2, y: wy2, w: ww2, h: wh2,\n        el: td.el, isText: false, isTodo: true, isMindmap: false,\n        item: td\n      });\n      continue;\n    }\n\n    // Mindmap items \u2014 use the bounding box of all nodes\n    var mm = (state.mindmaps || []).find(function(m) { return m.id === id; });\n    if (mm && Array.isArray(mm.nodes) && mm.nodes.length > 0) {\n      var mMinX = Infinity, mMinY = Infinity, mMaxX = -Infinity, mMaxY = -Infinity;\n      mm.nodes.forEach(function(n) {\n        if (typeof n.x === 'number' && typeof n.y === 'number') {\n          if (n.x < mMinX) mMinX = n.x;\n          if (n.y < mMinY) mMinY = n.y;\n          // Mindmap node approximate size: 120x40\n          var nw = n.w || 120;\n          var nh = n.h || 40;\n          if (n.x + nw > mMaxX) mMaxX = n.x + nw;\n          if (n.y + nh > mMaxY) mMaxY = n.y + nh;\n        }\n      });\n      if (isFinite(mMinX) && isFinite(mMaxX)) {\n        selItems.push({\n          id: id, x: mMinX, y: mMinY, w: mMaxX - mMinX, h: mMaxY - mMinY,\n          el: mm.el, isText: false, isTodo: false, isMindmap: true,\n          item: mm, origMinX: mMinX, origMinY: mMinY\n        });\n      }\n    }\n  }\n\n  if (selItems.length === 0) {\n    try { toast('Select items to tidy first'); } catch (e) {}\n    return;\n  }\n\n  // --- v7.0.38: widen the column when the selection carries players ---\n  // One video among forty images is enough. A 280px column leaves the\n  // controls bar scrolling, so every button past the seek bar needs a\n  // sideways drag to reach \u2014 which is exactly why videos were being\n  // resized by hand after every tidy.\n  var _hasPlayer = false;\n  for (var _pi = 0; _pi < selItems.length; _pi++) {\n    if (_itemHasPlayerControls(selItems[_pi].item)) { _hasPlayer = true; break; }\n  }\n  if (_hasPlayer && COL_W < TIDY_MEDIA_COL_W) COL_W = TIDY_MEDIA_COL_W;\n\n  // --- Push undo before modifying ---\n  try { pushUndo(); } catch (e) {}\n\n  // --- Find the center of the current selection bounding box ---\n  var cMinX = Infinity, cMinY = Infinity, cMaxX = -Infinity, cMaxY = -Infinity;\n  for (var ci = 0; ci < selItems.length; ci++) {\n    var siBox = selItems[ci];\n    if (siBox.x < cMinX) cMinX = siBox.x;\n    if (siBox.y < cMinY) cMinY = siBox.y;\n    if (siBox.x + siBox.w > cMaxX) cMaxX = siBox.x + siBox.w;\n    if (siBox.y + siBox.h > cMaxY) cMaxY = siBox.y + siBox.h;\n  }\n  var centerX = (cMinX + cMaxX) / 2;\n  var centerY = (cMinY + cMaxY) / 2;\n\n  // --- Masonry layout ---\n  // Minimum 2 columns for 2+ items; sqrt-based for larger counts\n  var cols = selItems.length <= 1 ? 1 : Math.max(2, Math.ceil(Math.sqrt(selItems.length)));\n\n  // Sort by height descending (larger items first reduces gaps)\n  selItems.sort(function(a, b) { return b.h - a.h; });\n\n  var colHeights = new Array(cols);\n  for (var cj = 0; cj < cols; cj++) { colHeights[cj] = 0; }\n\n  // --- Pass 1: compute relative positions (relative to 0,0) ---\n  // Also store scaled w/h for each item.\n  var _z = Math.max(0.02, Math.min(10, state.zoom || 1));\n  for (var pk = 0; pk < selItems.length; pk++) {\n    var ssi = selItems[pk];\n\n    // Find the shortest column\n    var shortestCol = 0;\n    for (var ck = 1; ck < cols; ck++) {\n      if (colHeights[ck] < colHeights[shortestCol]) shortestCol = ck;\n    }\n\n    // Scale to uniform column width, preserve aspect ratio\n    // v5.5.7: when there's only ONE item, don't squeeze it to COL_W \u2014\n    // that destroys wide videos/images and forces the controls bar\n    // (min content width) to overflow the container. Keep the\n    // original size and only recenter it.\n    var scale, newW, newH;\n    if (selItems.length === 1) {\n      newW = ssi.w;\n      newH = ssi.h;\n      // v7.0.38: a lone media item still gets the controls-bar floor.\n      // Tidy used to leave a single-item selection completely untouched\n      // (deliberately \u2014 to avoid squeezing a wide video), so a clip\n      // imported at 240px stayed at 240px with a bar you could not read,\n      // and the only cure was dragging a corner handle by hand.\n      if (_itemHasPlayerControls(ssi.item) && newW > 0 && newW < TIDY_MEDIA_COL_W) {\n        scale = TIDY_MEDIA_COL_W / newW;\n        newW = TIDY_MEDIA_COL_W;\n        newH = newH * scale;\n      }\n    } else {\n      scale = COL_W / ssi.w;\n      newW = COL_W;\n      newH = ssi.h * scale;\n    }\n\n    // Store scaled dimensions for framing\n    ssi._newW = newW;\n    ssi._newH = newH;\n\n    // Compute relative position\n    ssi._relX = shortestCol * (COL_W + GAP);\n    ssi._relY = colHeights[shortestCol];\n    ssi._relCol = shortestCol;\n\n    // Update column height\n    colHeights[shortestCol] += newH + GAP;\n  }\n\n  // --- Compute the origin so the layout is centered on the selection ---\n  var totalW = cols * (COL_W + GAP) - GAP;\n  var maxColH = 0;\n  for (var cm = 0; cm < colHeights.length; cm++) {\n    if (colHeights[cm] > maxColH) maxColH = colHeights[cm];\n  }\n  var totalH = maxColH - GAP;\n  if (totalH < 1) totalH = 1;\n  var originX = centerX - totalW / 2;\n  var originY = centerY - totalH / 2;\n\n  // --- Pass 2: apply positions with the origin offset ---\n  for (var pa = 0; pa < selItems.length; pa++) {\n    var si = selItems[pa];\n    var finalX = originX + si._relX;\n    var finalY = originY + si._relY;\n\n    // --- Apply new position and scaled size to the underlying item ---\n    if (si.isMindmap) {\n      // Mindmap: shift all nodes by the delta from original top-left\n      var dx = finalX - si.origMinX;\n      var dy = finalY - si.origMinY;\n      si.item.nodes.forEach(function(n) {\n        if (typeof n.x === 'number') n.x += dx;\n        if (typeof n.y === 'number') n.y += dy;\n      });\n      // Update connectors and DOM position\n      try { mmUpdateConnectors(si.item); } catch (e) {}\n    } else if (si.isText) {\n      // v6.8.26: text items are world-coord now \u2014 x/y/w/h all world px.\n      // v6.6.0: Tidy may resize text items. Sync font size proportionally\n      // so the visual result matches the new dimensions.\n      var _oldW = si.item.w || 160;\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n      if (_oldW > 0 && si.item.w !== _oldW) {\n        si.item.size = (si.item.size || 24) * (si.item.w / _oldW);\n      }\n    } else if (si.isTodo) {\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n    } else {\n      // Regular items (images, videos, etc.)\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n    }\n\n    // Update DOM via updateItemStyle\n    try { updateItemStyle(si.item); } catch (e) {}\n    // v6.6.0: text items need applyTextProps to sync fontSize (updateItemStyle skips it)\n    if (si.isText && typeof applyTextProps === 'function') {\n      try { applyTextProps(si.item); } catch (e) {}\n      // v6.6.0: refresh text handle container position/size after tidy\n      // \u2014 otherwise resize handles stay at old position and break resize.\n      try {\n        var hCont = si.item.el.parentElement.querySelector('.text-handles[data-owner=\"' + si.item.id + '\"]');\n        if (hCont) {\n          hCont.style.left = si.item.x + 'px';\n          hCont.style.top = si.item.y + 'px';\n          hCont.style.width = si.item.w + 'px';\n          hCont.style.height = si.item.h + 'px';\n        }\n      } catch (e) {}\n    }\n\n    // Store tidied position for framing (use new scaled w/h)\n    si._newX = finalX;\n    si._newY = finalY;\n  }\n\n  // --- Refresh canvas ---\n  try { updateCanvas(); } catch (e) {}\n\n  // v6.5.0: DON'T auto-frame after tidy \u2014 user wants to keep their current view.\n  // The zoom-jump was disorienting, especially on large boards.\n  // frameTidiedSelection(selItems);\n\n  // --- Schedule auto-save ---\n  try { scheduleAutoSave(); } catch (e) {}\n\n  try {\n    toast('Tidied ' + selItems.length + ' items \u00B7 ' + Math.round(COL_W) + 'px columns'\n      + (_hasPlayer ? ' (media)' : ''));\n  } catch (e) {}\n}\n\n// Tidy all items on the board \u2014 select everything then run tidySelection\nfunction tidyAll() {\n  state.selected.clear();\n  [...state.items, ...state.texts, ...(state.todos||[]), ...(state.mindmaps||[])].forEach(function(i) {\n    state.selected.add(i.id);\n  });\n  tidySelection();\n}\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n//  VIDEO SEGMENT (TRIM) \u2014 v7.0.38\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// item.trimStart / item.trimEnd were already the single source of truth.\n// The player's timeupdate handler loops back to trimStart the moment it\n// passes trimEnd, the `play` handler re-seeds the playhead, and both values\n// serialise into .kpak. The feature was complete \u2014 it was just unreachable\n// unless you already knew that I and O work while the cursor happens to be\n// sitting on the seek bar. These are the front doors.\n\nfunction selectedVideoItems() {\n  const out = [];\n  (state.items || []).forEach(function (it) {\n    if (!it || !(it.isVideo || it.type === 'video')) return;\n    if (!state.selected || !state.selected.has(it.id)) return;\n    out.push(it);\n  });\n  return out;\n}\n\n// Repaint both trim strips (the mini bar under the controls and the handles\n// on the main seek bar) plus the right-hand panel timeline.\nfunction refreshTrimUIFor(items) {\n  (items || []).forEach(function (it) {\n    if (!it) return;\n    try {\n      if (it.el && typeof it.el._refreshInPlayerTrimUI === 'function') it.el._refreshInPlayerTrimUI();\n    } catch (e) {}\n    try {\n      if (typeof updateVideoTimeline === 'function') updateVideoTimeline(it);\n    } catch (e) {}\n  });\n}\n\n// v7.0.41 \u2014 ONE trim-marking implementation, shared by the context menu and\n// the I/O hotkey. They used to be two hand-rolled copies that disagreed about\n// the minimum segment length (0.1s vs 0.05s) and about whether the playhead\n// gets dragged along; the hotkey's copy also lacked an undo step entirely.\n//\n// clampTrimMark() is deliberately PURE \u2014 it reads and never writes, so a\n// caller can ask \"would this press actually change anything?\" before it\n// decides whether the press is worth an undo step. Being able to ask that\n// question is what makes the silent no-op fixable at all.\n\nvar TRIM_MIN_GAP = 0.05;   // shortest legal segment, seconds\n\n// The edge this call would overwrite, resolved the same way every reader in\n// the app resolves it: an unset or zero trimEnd means \"the whole clip\".\nfunction trimEdgeOf(it, which, dur) {\n  if (which === 'in') return (typeof it.trimStart === 'number') ? it.trimStart : 0;\n  return (typeof it.trimEnd === 'number' && it.trimEnd > 0) ? it.trimEnd : dur;\n}\n\nfunction clampTrimMark(it, which, t, dur) {\n  if (!isFinite(dur) || dur <= 0) return null;\n  let val = Math.max(0, Math.min(dur, (typeof t === 'number' && isFinite(t)) ? t : 0));\n  if (which === 'in') {\n    const te = (typeof it.trimEnd === 'number' && it.trimEnd > 0) ? it.trimEnd : dur;\n    val = Math.max(0, Math.min(val, Math.max(0, te - TRIM_MIN_GAP)));\n  } else {\n    const ts = (typeof it.trimStart === 'number') ? it.trimStart : 0;\n    val = Math.min(dur, Math.max(val, Math.min(dur, ts + TRIM_MIN_GAP)));\n  }\n  return val;\n}\n\nfunction applyTrimMark(it, which, val) {\n  // v7.0.44: this used to drag the playhead forward onto a new in point, on\n  // the grounds that the loop would do it on the next tick anyway. Two\n  // things were wrong. The loop no longer touches a paused playhead (see\n  // setupVideoTrim), and moving it parked the playhead EXACTLY on the mark\n  // \u2014 so the very next press of the other key read that same time back and\n  // produced a segment one minimum-gap long, with both handles glued\n  // together. Premiere leaves the playhead alone: moving a mark must not\n  // move your place in the clip.\n  if (which === 'in') { it.trimStart = val; } else { it.trimEnd = val; }\n}\n\n// \u2500\u2500 Conflicting marks (v7.0.44) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// A request that lands on or across the OPPOSITE mark is not a number to\n// clamp \u2014 it is a contradiction, and clamping it is precisely what glued\n// the two handles together. Asking for an out point at 0:08 when the in\n// point is 0:10 does not mean \"0:08\"; it means the 0:10 in point is no\n// longer the one you want. Clamping answers \"0:08\" with \"0:10.05\" and\n// leaves the user staring at a collapsed segment with nowhere to go.\n//\n// Premiere's answer is to refuse, and make you run Marker > Clear In or\n// Clear Out by hand. Krafted's answer is to clear the stale mark for you\n// and say so out loud: the range reopens, and the next press sets the\n// boundary you actually meant. One undo step restores both.\n//\n// The three clear commands Premiere puts in its Marker menu exist here too\n// \u2014 context menu, and Shift+I / Shift+O. The only difference is that a\n// contradictory press runs the clear for you instead of doing nothing.\nfunction markIsSet(it, which, dur) {\n  // \"Unset\" and \"sitting on the clip edge\" are the same state in this data\n  // model (see trimEdgeOf), so an unset mark must not be treated as\n  // something to clear \u2014 otherwise clearing it is a no-op that still\n  // consumes the press.\n  if (which === 'in') return (typeof it.trimStart === 'number' && it.trimStart > 0.001);\n  return (typeof it.trimEnd === 'number' && it.trimEnd > 0 &&\n          it.trimEnd < dur - 0.001);\n}\n\nfunction planTrimMark(it, which, t, dur) {\n  if (!isFinite(dur) || dur <= 0) return null;\n  const raw = Math.max(0, Math.min(dur, (typeof t === 'number' && isFinite(t)) ? t : 0));\n  const ts = trimEdgeOf(it, 'in', dur);\n  const te = trimEdgeOf(it, 'out', dur);\n  const conflict = (which === 'in') ? (raw >= te - TRIM_MIN_GAP)\n                                    : (raw <= ts + TRIM_MIN_GAP);\n  if (conflict && markIsSet(it, which === 'in' ? 'out' : 'in', dur)) {\n    return { which: which, val: raw, clearsOpp: true,\n             oppWas: (which === 'in') ? te : ts };\n  }\n  const val = clampTrimMark(it, which, raw, dur);\n  if (val == null) return null;\n  return { which: which, val: val, clearsOpp: false, oppWas: null };\n}\n\nfunction applyTrimPlan(it, plan, dur) {\n  if (!plan) return;\n  if (plan.clearsOpp) {\n    // Clearing sets the far edge to the clip boundary, which is how\n    // \"unset\" is spelled everywhere else in the app \u2014 trimEdgeOf, and the\n    // loadedmetadata handler in setupVideoTrim. No third state to sync.\n    if (plan.which === 'in') { it.trimStart = plan.val; it.trimEnd = dur; }\n    else { it.trimStart = 0; it.trimEnd = plan.val; }\n    return;\n  }\n  applyTrimMark(it, plan.which, plan.val);\n}\n\n// Brief flash on the matching handle \u2014 the only confirmation that a press\n// landed on THIS clip and THIS edge.\nfunction flashTrimHandle(it, which) {\n  if (!it || !it.el) return;\n  try {\n    const h = it.el.querySelector('.media-trim-mini .trim-handle-' + which);\n    if (!h) return;\n    h.classList.add('trim-handle-flash');\n    setTimeout(function () { try { h.classList.remove('trim-handle-flash'); } catch (e) {} }, 450);\n  } catch (e) {}\n}\n\nfunction setTrimFromPlayhead(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  // Plan the whole batch before touching anything: an undo step is only worth\n  // pushing if at least one clip actually moves.\n  const plan = [];\n  let skipped = 0;\n  vids.forEach(function (it) {\n    const v = it.video;\n    if (!v || !isFinite(v.duration) || v.duration <= 0) { skipped++; return; }\n    const t = Math.max(0, Math.min(v.duration, v.currentTime || 0));\n    const p = planTrimMark(it, which, t, v.duration);\n    if (!p) { skipped++; return; }\n    if (p.clearsOpp || Math.abs(p.val - trimEdgeOf(it, which, v.duration)) > 0.001) {\n      plan.push({ it: it, p: p, dur: v.duration });\n    }\n  });\n  if (!plan.length) {\n    try {\n      toast(skipped ? 'Video not ready yet'\n                    : 'Trim ' + which + ' is already at the playhead');\n    } catch (e) {}\n    return;\n  }\n  try { pushUndo(); } catch (e) {}\n  plan.forEach(function (e) { applyTrimPlan(e.it, e.p, e.dur); });\n  refreshTrimUIFor(plan.map(function (e) { return e.it; }));\n  try { scheduleAutoSave(); } catch (e) {}\n  const it0 = plan[0].it;\n  const v0 = it0.video;\n  const end0 = (it0.trimEnd && it0.trimEnd > 0) ? it0.trimEnd : (v0 ? v0.duration : 0);\n  try {\n    if (plan[0].p.clearsOpp) {\n      toast((which === 'in' ? 'Trim in ' : 'Trim out ') + formatTime(plan[0].p.val)\n        + ' \u00B7 ' + (which === 'in' ? 'out' : 'in') + ' ' + formatTime(plan[0].p.oppWas)\n        + ' cleared' + (plan.length > 1 ? ' \u00B7 ' + plan.length + ' clips' : ''));\n    } else {\n      toast((which === 'in' ? 'Trim in ' : 'Trim out ') + formatTime(plan[0].p.val)\n        + ' \u00B7 segment ' + formatTime(Math.max(0, end0 - (it0.trimStart || 0)))\n        + (plan.length > 1 ? ' \u00B7 ' + plan.length + ' clips' : ''));\n    }\n  } catch (e) {}\n}\n\n// v7.0.44: clear ONE mark. Premiere calls these Marker > Clear In and\n// Marker > Clear Out, and having only \"clear both\" meant that undoing half\n// a trim threw away the half that was right. Returns false when there was\n// nothing to act on, so the key dispatcher can leave the keystroke alone\n// instead of swallowing it.\nfunction clearTrimMark(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return false; }\n  try { pushUndo(); } catch (e) {}\n  vids.forEach(function (it) {\n    const dur = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n    if (which === 'in') { it.trimStart = 0; }\n    else { it.trimEnd = dur; }\n  });\n  refreshTrimUIFor(vids);\n  try { scheduleAutoSave(); } catch (e) {}\n  try {\n    toast((which === 'in' ? 'In' : 'Out') + ' point cleared \u00B7 '\n      + (which === 'in' ? 'clip starts at 0:00' : 'clip runs to the end'));\n  } catch (e) {}\n  return true;\n}\n\nfunction clearTrimSelected() {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  try { pushUndo(); } catch (e) {}\n  vids.forEach(function (it) {\n    it.trimStart = 0;\n    it.trimEnd = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n  });\n  refreshTrimUIFor(vids);\n  try { scheduleAutoSave(); } catch (e) {}\n  try { toast('Trim cleared \u00B7 full clip'); } catch (e) {}\n}\n\n// \u2500\u2500 I / O hotkey (v7.0.41) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Where does the mark land? Two candidates, and the code now says which one\n// it picked:\n//   \u2022 the CURSOR, when it is over one of the clip's timeline strips \u2014 the\n//     seek bar or the trim mini-bar. Those are the only two things on a\n//     player that have a time axis.\n//   \u2022 the PLAYHEAD otherwise.\n//\n// The version this replaces read the cursor off the key event (e.clientX),\n// and two separate things went wrong there. Both present to the user as\n// \"it worked the first time, then stopped responding\":\n//\n//   1. A key event's clientX/clientY are 0 whenever the browser does not\n//      carry the pointer position on keyboard events, and they are 0 when\n//      the pointer has never moved. elementFromPoint(0, 0) is the <html>\n//      element, so the \"is the cursor on a timeline?\" test failed, the\n//      handler silently fell through to the playhead, and the press wrote\n//      back the value that was already there. The board already tracks the\n//      pointer on a document-level mousemove (state.mouse) and the hover\n//      test a few blocks down already trusts it \u2014 so does this now.\n//\n//   2. Even with a perfect cursor, the fallback was SILENT. The cursor is\n//      usually on the PICTURE \u2014 that is the frame you are judging \u2014 and a\n//      picture has no time axis. So the handler wrote the unchanged\n//      playhead back and reported success. The first press looks like it\n//      worked because the playhead happens to be wherever you just\n//      scrubbed it to; every press after that only moves the mouse, and\n//      the mouse is not the playhead.\n//\n// So the mark still follows the cursor when there is a cursor on a\n// timeline \u2014 but a press that would change nothing now says so, and says\n// how to change it.\n//\n// v7.0.44: the shrink-only guidance added in v7.0.42 is gone, because the\n// thing it was working around is fixed. It told the user to hover the seek\n// bar to expand, since that was the only way to reach a time the trap had\n// made unreachable. Nowhere is unreachable now \u2014 a paused playhead goes\n// anywhere \u2014 so the plain thing works and the special case does not need\n// explaining. What replaces it is the conflict rule above: a press that\n// lands on the other mark clears it instead of collapsing onto it.\n\n// Last known pointer position, or null when the pointer has never moved\n// (state.mouse starts at 0,0). A null here means \"pure keyboard press\".\nfunction _trimPointer() {\n  if (state && state.mouse && (state.mouse.x || state.mouse.y)) {\n    return { x: state.mouse.x, y: state.mouse.y };\n  }\n  return null;\n}\n\n// Time under the pointer on one of the clip's timeline strips, or null when\n// the pointer is somewhere with no time axis (the picture, the canvas, a\n// toolbar). Measured on the visible TRACK for precision, but accepted\n// anywhere inside the seek bar, so the 8px of vertical padding wrapped\n// around a 6px track still counts as \"on the timeline\".\nfunction trimTimeAtPointer(item) {\n  const pt = _trimPointer();\n  if (!pt || !item || !item.el || !item.video) return null;\n  const dur = item.video.duration;\n  if (!isFinite(dur) || dur <= 0) return null;\n  let node = null;\n  try { node = document.elementFromPoint(pt.x, pt.y); } catch (e) { return null; }\n  if (!node) return null;\n  const timeIn = function (barEl, trackSel) {\n    if (!barEl) return null;\n    if (node !== barEl && !barEl.contains(node)) return null;\n    const track = trackSel ? barEl.querySelector(trackSel) : null;\n    const rect = (track || barEl).getBoundingClientRect();\n    if (rect.width <= 0) return null;\n    return Math.max(0, Math.min(1, (pt.x - rect.left) / rect.width)) * dur;\n  };\n  const onSeek = timeIn(item.el.querySelector('.media-seek-bar'), '.media-seek-track');\n  if (onSeek != null) return onSeek;\n  return timeIn(item.el.querySelector('.media-trim-mini'), null);\n}\n\n// Returns true when the press was consumed (so the dispatcher can swallow\n// it), false when it was not a trim press at all.\nfunction trimHotkey(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) return false;\n  const it = vids[0];\n  const v = it.video;\n  if (!it.el || !v) return false;\n  // Intent gate: the pointer has to be on THIS clip's player. With no pointer\n  // at all (pure keyboard), the selection alone is the intent.\n  const pt = _trimPointer();\n  if (pt) {\n    let node = null;\n    try { node = document.elementFromPoint(pt.x, pt.y); } catch (e) { node = null; }\n    if (!node || (node !== it.el && !it.el.contains(node))) return false;\n  }\n  if (!isFinite(v.duration) || v.duration <= 0) {\n    try { toast('Video not ready yet'); } catch (e) {}\n    return true;\n  }\n  try { if (!v.paused) v.pause(); } catch (e) {}\n  const hoverT = trimTimeAtPointer(it);\n  const t = (hoverT != null) ? hoverT : (v.currentTime || 0);\n  const plan = planTrimMark(it, which, t, v.duration);\n  if (!plan) { try { toast('Video not ready yet'); } catch (e) {} return true; }\n  const currentEdge = trimEdgeOf(it, which, v.duration);\n  const moved = plan.clearsOpp || Math.abs(plan.val - currentEdge) > 0.001;\n\n  if (moved) {\n    try { pushUndo(); } catch (e) {}\n    applyTrimPlan(it, plan, v.duration);\n    refreshTrimUIFor([it]);\n    try { scheduleAutoSave(); } catch (e) {}\n  }\n  flashTrimHandle(it, which);\n  // A cleared mark moves the OTHER handle too. Flash it, or the change\n  // reads as the segment simply refusing to move.\n  if (plan.clearsOpp) { flashTrimHandle(it, which === 'in' ? 'out' : 'in'); }\n\n  const endT = (it.trimEnd && it.trimEnd > 0) ? it.trimEnd : v.duration;\n  try {\n    if (plan.clearsOpp) {\n      toast('Trim ' + which + ' ' + formatTime(plan.val)\n        + ' \u00B7 ' + (which === 'in' ? 'out' : 'in') + ' ' + formatTime(plan.oppWas)\n        + ' cleared \u2014 press ' + (which === 'in' ? 'O' : 'I') + ' to set a new one');\n    } else if (moved) {\n      toast('Trim ' + which + ' ' + formatTime(plan.val)\n        + ' \u00B7 segment ' + formatTime(Math.max(0, endT - (it.trimStart || 0)))\n        + (hoverT != null ? '  (at cursor)' : ''));\n    } else if (hoverT != null) {\n      toast('Trim ' + which + ' stays at ' + formatTime(plan.val) + ' \u2014 the cursor is already there.');\n    } else {\n      toast('Trim ' + which + ' stays at ' + formatTime(plan.val)\n        + ' \u2014 move the playhead (or the cursor) where you want it and press '\n        + (which === 'in' ? 'I' : 'O') + '.');\n    }\n  } catch (e) {}\n  return true;\n}\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n//  CONTACT SHEET (v7.0.38) \u2014 \u63D0\u6848 A\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// Pulls N evenly spaced stills out of a clip and lays them out as one\n// filmstrip image. This is the shot-level read a director wants: rhythm,\n// framing drift and lighting changes across a cut, all in one glance\n// instead of dragging the playhead back and forth.\n\nvar CONTACT_SHEET_COUNTS = [4, 6, 9, 12, 24];\nvar CONTACT_SHEET_CELL_W = 320;   // plenty for judging composition\nvar CONTACT_SHEET_SEEK_TIMEOUT = 12000;\nvar _cs = { itemId: null, count: 9, scope: 'trim', timecode: true, dataUrl: '', token: 0 };\n\n// Column counts chosen so the strip stays close to the source aspect\n// instead of collapsing into a tall thin column.\nfunction contactSheetColumns(count) {\n  if (count <= 4) return count;\n  if (count <= 6) return 3;\n  if (count <= 9) return 3;\n  if (count <= 12) return 4;\n  return 6;\n}\n\n// Always m:ss.cc in the exported pixels. The in-app formatTime() follows\n// the user's frame/time toggle, which would bake a preference into a\n// static image and make it wrong the moment they flip the toggle.\nfunction contactSheetTimecode(t) {\n  if (!isFinite(t)) return '0:00.00';\n  const m = Math.floor(t / 60);\n  const s = Math.floor(t % 60);\n  const cs = Math.floor((t * 100) % 100);\n  return m + ':' + String(s).padStart(2, '0') + '.' + String(cs).padStart(2, '0');\n}\n\nfunction _csItem() {\n  if (!_cs.itemId) return null;\n  const list = state.items || [];\n  for (let i = 0; i < list.length; i++) {\n    if (list[i] && list[i].id === _cs.itemId) return list[i];\n  }\n  return null;\n}\n\nfunction _csRange(item, scope) {\n  const v = item && item.video;\n  const dur = (v && isFinite(v.duration) && v.duration > 0) ? v.duration : 0;\n  if (scope !== 'trim') return { lo: 0, hi: dur };\n  const lo = Math.max(0, Math.min(dur, item.trimStart || 0));\n  const hi = (item.trimEnd && item.trimEnd > 0) ? Math.min(dur, item.trimEnd) : dur;\n  return { lo: lo, hi: Math.max(lo + 0.1, hi) };\n}\n\n// Frames are pulled from a SEPARATE video element, never from the item's\n// live player. Seeking the on-board element would yank the user's playhead\n// out from under them mid-review, and the media playback budget tracks that\n// element. The probe is detached and torn down the moment it is done.\nfunction buildContactSheet(item, opts) {\n  const o = opts || {};\n  const count = Math.max(1, Math.min(60, o.count || 9));\n  const withTC = o.timecode !== false;\n  const cols = contactSheetColumns(count);\n  const rows = Math.ceil(count / cols);\n\n  return new Promise(function (resolve, reject) {\n    const live = item && item.video;\n    const src = (live && live.src) || (item && item.src) || '';\n    if (!src) { reject(new Error('empty-src')); return; }\n\n    const v = makeVideoElement(src, { preload: 'auto', onError: false });\n    v.loop = false;\n    v.muted = true;\n\n    let settled = false;\n    const teardown = function () {\n      try { v.pause(); } catch (e) {}\n      // Never park a media element with removeAttribute('src') \u2014 see the\n      // media playback notes. This probe is thrown away entirely instead.\n    };\n    const fail = function (msg) {\n      if (settled) return;\n      settled = true;\n      teardown();\n      reject(new Error(msg));\n    };\n    v.addEventListener('error', function () {\n      const c = v.error ? v.error.code : 0;\n      fail(c === 4 ? 'codec' : ('load-' + c));\n    });\n\n    v.addEventListener('loadedmetadata', function () {\n      const dur = v.duration;\n      if (!isFinite(dur) || dur <= 0) { fail('no-duration'); return; }\n      const vw = v.videoWidth, vh = v.videoHeight;\n      if (!vw || !vh) { fail('no-frame'); return; }\n\n      const r = _csRange(item, o.scope);\n      const lo = Math.max(0, Math.min(dur, r.lo));\n      const hi = Math.max(lo + 0.1, Math.min(dur, r.hi || dur));\n\n      const cellW = CONTACT_SHEET_CELL_W;\n      const cellH = Math.round(cellW * (vh / vw));\n      const tcH = withTC ? 20 : 0;\n      const pad = 4;\n      const sheetW = cols * cellW + (cols + 1) * pad;\n      const sheetH = rows * (cellH + tcH) + (rows + 1) * pad;\n      // Same ceiling as board export: past ~16384px a side or ~268MP\n      // Chrome hands back a blank canvas and says nothing.\n      const budget = (typeof exportPixelBudget === 'function') ? exportPixelBudget(sheetW, sheetH, 1) : 1;\n      const s = Math.max(0.25, Math.min(1, budget));\n\n      const cv = document.createElement('canvas');\n      cv.width = Math.max(1, Math.round(sheetW * s));\n      cv.height = Math.max(1, Math.round(sheetH * s));\n      const ctx = cv.getContext('2d');\n      ctx.fillStyle = '#0d0d11';\n      ctx.fillRect(0, 0, cv.width, cv.height);\n      ctx.scale(s, s);\n\n      let i = 0;\n      const step = function () {\n        if (o.cancelled && o.cancelled()) { fail('cancelled'); return; }\n        if (i >= count) {\n          settled = true;\n          teardown();\n          let url = '';\n          try {\n            url = cv.toDataURL('image/jpeg', 0.9);\n          } catch (e) {\n            // Tainted canvas. A cross-origin clip without CORS headers\n            // still *plays* fine, it just cannot be read back out.\n            settled = false;\n            fail('cors');\n            return;\n          }\n          resolve({ dataUrl: url, width: cv.width, height: cv.height, count: count, cols: cols, rows: rows });\n          return;\n        }\n        const t = lo + (hi - lo) * ((i + 0.5) / count);\n        const idx = i;\n        let done = false;\n        const onSeeked = function () {\n          if (done) return;\n          done = true;\n          clearTimeout(timer);\n          v.removeEventListener('seeked', onSeeked);\n          try {\n            const cx = pad + (idx % cols) * (cellW + pad);\n            const cy = pad + Math.floor(idx / cols) * (cellH + tcH + pad);\n            ctx.drawImage(v, cx, cy, cellW, cellH);\n            if (withTC) {\n              ctx.fillStyle = 'rgba(0,0,0,0.72)';\n              ctx.fillRect(cx, cy + cellH, cellW, tcH);\n              ctx.fillStyle = '#00e5ff';\n              ctx.font = '600 13px Inter, sans-serif';\n              ctx.textBaseline = 'middle';\n              ctx.fillText(contactSheetTimecode(v.currentTime || t), cx + 6, cy + cellH + tcH / 2);\n            }\n          } catch (e) {}\n          i++;\n          if (o.onProgress) o.onProgress(i, count);\n          step();\n        };\n        // A seek can hang indefinitely on a codec the decoder dislikes.\n        // Without this the progress line would sit at \"3 / 24\" forever.\n        const timer = setTimeout(function () {\n          if (done) return;\n          done = true;\n          v.removeEventListener('seeked', onSeeked);\n          fail('seek-timeout');\n        }, CONTACT_SHEET_SEEK_TIMEOUT);\n        v.addEventListener('seeked', onSeeked);\n        try { v.currentTime = t; } catch (e) { clearTimeout(timer); fail('seek-failed'); }\n      };\n      step();\n    });\n  });\n}\n\nfunction openContactSheetDialog() {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  const it = vids[0];\n  if (!it) return;\n  const modal = document.getElementById('contact-sheet-modal');\n  if (!modal) { try { toast('Contact sheet unavailable'); } catch (e) {} return; }\n\n  _cs.itemId = it.id;\n  _cs.dataUrl = '';\n  if (CONTACT_SHEET_COUNTS.indexOf(_cs.count) < 0) _cs.count = 9;\n  // Default to the trimmed segment when there is one. The user trimmed it\n  // precisely because that is the part they care about.\n  const r = _csRange(it, 'trim');\n  const dur = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n  _cs.scope = (dur && (r.lo > 0.05 || r.hi < dur - 0.05)) ? 'trim' : 'all';\n\n  const sub = document.getElementById('cs-subtitle');\n  if (sub) {\n    sub.textContent = (it.filename || 'Clip') + ' \u00B7 '\n      + (dur ? contactSheetTimecode(dur) : 'loading') + ' total'\n      + (dur && _cs.scope === 'trim' ? ' \u00B7 segment ' + contactSheetTimecode(r.hi - r.lo) : '');\n  }\n  if (!modal._csWired) {\n    modal._csWired = true;\n    modal.addEventListener('mousedown', function (ev) {\n      if (ev.target === modal) closeContactSheet();\n    });\n    // Capture phase, because Escape is also bound to \"cancel / deselect\"\n    // on the document \u2014 without swallowing it here the sheet would close\n    // AND drop the user's selection in the same keystroke.\n    document.addEventListener('keydown', function (ev) {\n      if (ev.key === 'Escape' && modal.classList.contains('active')) {\n        ev.stopPropagation();\n        closeContactSheet();\n      }\n    }, true);\n  }\n\n  modal.classList.add('active');\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction syncContactSheetUI() {\n  const modal = document.getElementById('contact-sheet-modal');\n  if (!modal) return;\n  const counts = modal.querySelectorAll('.cs-preset[data-count]');\n  for (let i = 0; i < counts.length; i++) {\n    counts[i].classList.toggle('active', Number(counts[i].getAttribute('data-count')) === _cs.count);\n  }\n  const scopes = modal.querySelectorAll('.cs-preset[data-scope]');\n  for (let i = 0; i < scopes.length; i++) {\n    scopes[i].classList.toggle('active', scopes[i].getAttribute('data-scope') === _cs.scope);\n  }\n  const note = document.getElementById('cs-note');\n  if (note) note.textContent = contactSheetColumns(_cs.count) + ' \u00D7 ' + Math.ceil(_cs.count / contactSheetColumns(_cs.count));\n  const add = document.getElementById('cs-add-btn');\n  const save = document.getElementById('cs-save-btn');\n  if (add) add.disabled = !_cs.dataUrl;\n  if (save) save.disabled = !_cs.dataUrl;\n}\n\nfunction setContactSheetCount(n) {\n  if (_cs.count === n) return;\n  _cs.count = n;\n  _cs.dataUrl = '';\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction setContactSheetScope(s) {\n  if (_cs.scope === s) return;\n  _cs.scope = s;\n  _cs.dataUrl = '';\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction renderContactSheet() {\n  const it = _csItem();\n  if (!it) return;\n  const prog = document.getElementById('cs-progress');\n  const cv = document.getElementById('cs-preview');\n  const tc = document.getElementById('cs-timeco