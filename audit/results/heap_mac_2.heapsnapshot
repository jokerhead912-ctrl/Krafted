s.length === 0) return;\n  }\n  // Sort: images first, then videos, then audio\n  var images = [], videos = [], audios = [];\n  allFiles.forEach(function(f) {\n    if (f.type.startsWith('image/')) images.push(f);\n    else if (f.type.startsWith('video/')) videos.push(f);\n    else if (f.type.startsWith('audio/') || /\\.(mp3|wav|aiff|aif|flac|ogg|m4a)$/i.test(f.name)) audios.push(f);\n  });\n  // v7.4.0: folder-major. The old flat images->videos->audio order interleaved\n  // folders, so a two-folder drop produced two bounding boxes covering almost\n  // the same area and the group borders came out as spaghetti. Type order is\n  // kept inside one folder, and sort() is stable so the directory traversal\n  // order survives inside each (folder, type) bucket.\n  function _importTypeRank(f) {\n    if (f.type && f.type.indexOf('image/') === 0) return 0;\n    if (f.type && f.type.indexOf('video/') === 0) return 1;\n    return 2;\n  }\n  var sorted = images.concat(videos).concat(audios);\n  sorted.sort(function (a, b) {\n    var ka = folderGroupKey(a._kraftedPath), kb = folderGroupKey(b._kraftedPath);\n    if (ka !== kb) return ka < kb ? -1 : 1;\n    return _importTypeRank(a) - _importTypeRank(b);\n  });\n  console.log('[FileDrop] Folder import: ' + sorted.length + ' files (' + images.length + ' images, ' + videos.length + ' videos, ' + audios.length + ' audio)');\n  if (typeof window.toast === 'function') {\n    var _fNames = [];\n    allFiles.forEach(function (f) {\n      var _segs = folderTagsFromPath(f._kraftedPath);\n      if (_segs.length && _fNames.indexOf(_segs[0]) < 0) _fNames.push(_segs[0]);\n    });\n    // One folder reads  \"Head\"   two read  \"A\", \"B\"   more read  \"A\", \"B\" +3\n    // so dropping thirty folders cannot produce an endless toast.\n    var _fShown = _fNames.slice(0, 2).join('\", \"');\n    var _fMore = _fNames.length > 2 ? (' +' + (_fNames.length - 2)) : '';\n    var _fLabel = _fNames.length ? (' \"' + _fShown + '\"' + _fMore) : '';\n    var _fSeen = [], _fBlocks = 0;\n    sorted.forEach(function (f) {\n      var k = folderGroupKey(f._kraftedPath);\n      if (k && _fSeen.indexOf(k) < 0) { _fSeen.push(k); _fBlocks++; }\n    });\n    var _fBlockLabel = _fBlocks > 1 ? (' \u00B7 ' + _fBlocks + ' blocks') : '';\n    window.toast('\uF4C1 Importing ' + sorted.length + ' files from folder' + _fLabel + ' - folder name saved as tag' + _fBlockLabel);\n  }\n  // v7.7.0 \u2014 auto-tidy the imported items so a multi-folder drop packs into\n  // a non-overlapping block instead of a badly-overlapping cascade. Only\n  // folder imports arm this; plain drops and pastes do not.\n  if (sorted.length) _armFolderTidy(sorted.length);\n  _handleFileDrop(e, sorted);\n}\n\n// v7.0.37 \u2014 P1-9. Cascade placement for a multi-file drop / paste.\n// Every file used to be offset by a flat 20px, so a drop of 30 images\n// landed as one 97%-overlapping stack: the user could not see or grab any\n// of them, and the only clue was the toast saying \"Imported 30 files\".\n// Now each item steps by a fraction of its OWN size, and wraps to a new row\n// every `cols` so a big drop stays a compact block rather than a 4000px\n// diagonal walk off screen. Returns a function you call with (w, h) of the\n// item you are about to place; it answers where that item should go.\nfunction makeCascade(originX, originY, cols) {\n  let n = 0, step = 0;\n  const COLS = cols || 6;\n  return function (w, h) {\n    const s = Math.max(32, Math.min(200, Math.min(w || 720, h || 720) * 0.22));\n    // Step only ever grows: a big item later in the batch must not end up\n    // hidden behind the small one that happened to be placed before it.\n    if (s > step) step = s;\n    const col = n % COLS, row = (n / COLS) | 0;\n    n++;\n    return { x: originX + col * step, y: originY + row * step };\n  };\n}\n\n// v7.0.37 \u2014 P2. One image-import normaliser. The rule used to be inlined in\n// the web drag-in path only (v7.0.22), so an 8000px PNG pasted from disk