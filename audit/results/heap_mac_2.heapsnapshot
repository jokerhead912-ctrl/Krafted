/ mid-flight (which can corrupt redo history and add memory pressure).\n  //\n  // v7.0.30: the old code just `return`ed here, which SILENTLY DROPPED the\n  // undo step. Anything the user did during an autosave was therefore\n  // unrecoverable, and the next Ctrl+Z jumped back past every dropped step \u2014\n  // the board appeared to lose a chunk of work in one go. Capture the\n  // snapshot now and push it once the save finishes instead.\n  if (state._saving) {\n    if (!state._deferredUndo) state._deferredUndo = _captureSnapshotSafe();\n    return;\n  }\n  const snapStr = _captureSnapshotSafe();\n  if (!snapStr) return;\n  // v7.0.10: bump the global action sequence so the Ctrl+Z handler can tell\n  // whether the most recent action was a board op (covered by this stack) or\n  // a video-annotation stroke commit (covered by G._annoUndoStack).\n  G._actionSeq = (G._actionSeq || 0) + 1;\n  state.undoStack.push(snapStr);\n  if (!state._undoSeqs) state._undoSeqs = [];\n  // v7.0.36: this snapshot holds the board as it was BEFORE the action, i.e.\n  // the state we are leaving. Advancing _boardSeq to the new action's number\n  // is what tells Ctrl+Z that the board was touched more recently than any\n  // pending annotation stroke.\n  state._undoSeqs.push(state._boardSeq || 0);\n  state._boardSeq = G._actionSeq;\n  // v5.5.1: cap undo history at 100 steps to prevent memory bloat\n  // on long sessions with large boards (each snapshot can be 1-5MB+)\n  // v6.8.27: also drop oldest entries if total snapshot bytes exceed ~300MB,\n  // so boards with many images cannot eat all RAM through undo history.\n  _trimStack(state.undoStack, '_undoBytes', '_undoSeqs');\n  state.redoStack = [];\n  state._redoBytes = 0;\n  state._redoSeqs = [];\n  // v7.0.36: a fresh board action invalidates pending annotation REDO history\n  // (the redo stack holds strokes removed by Ctrl+Z; once the user does\n  // something new those strokes must not come back).\n  G._annoRedoStack = [];\n  upd