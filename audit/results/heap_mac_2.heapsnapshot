e value actually changes.\n      if (frameCodeDisplay || infoBar) {\n        var _fps = getFps();\n        var _fIdx = Math.max(0, Math.round(_t * _fps));\n        var _fTotal = Math.max(0, Math.round(_dur * _fps));\n        var _tc = _p0FmtTc(_t);\n\n        if (_fcCurEl && (force || _fIdx !== _p0LastFrame)) _fcCurEl.textContent = 'F ' + _fIdx;\n        if (_fcTotalEl && (force || _fTotal !== _p0LastFrameTotal)) _fcTotalEl.textContent = '/ ' + _fTotal;\n        if (_fcTimeEl && (force || _tc !== _p0LastTc)) _fcTimeEl.textContent = _tc;\n\n        if (_ibFcurEl && (force || _fIdx !== _p0LastFrame)) _ibFcurEl.textContent = 'F ' + _fIdx;\n        if (_ibFtotEl && (force || _fTotal !== _p0LastFrameTotal)) _ibFtotEl.textContent = '/ ' + _fTotal;\n        if (_ibTimeEl && (force || _tc !== _p0LastTc)) _ibTimeEl.textContent = _tc;\n        if (_ibFpsEl && (force || _fps !== _p0LastFps)) _ibFpsEl.textContent = formatFpsLabel(_fps) + ' fps';\n\n        _p0LastFrame = _fIdx;\n        _p0LastFrameTotal = _fTotal;\n        _p0LastFps = _fps;\n        _p0LastTc = _tc;\n      }\n    }\n\n    function _p0StopRvfc() {\n      if (_p0RvfcId != null && typeof mediaEl.cancelVideoFrameCallback === 'function') {\n        try { mediaEl.cancelVideoFrameCallback(_p0RvfcId); } catch (e) {}\n      }\n      _p0RvfcId = null;\n    }\n\n    function _p0RvfcTick() {\n      _p0RvfcId = null;\n      if (mediaEl.paused || mediaEl.ended) return;\n      _p0UpdatePlaybackHud(false);\n      _p0RvfcId = mediaEl.requestVideoFrameCallback(_p0RvfcTick);\n    }\n\n    function _p0StartRvfc() {\n      if (!_supportsRvfc) return;\n      _p0StopRvfc();\n      _p0UpdatePlaybackHud(true);\n      _p0RvfcId = mediaEl.requestVideoFrameCallback(_p0RvfcTick);\n    }\n\n    // Fallback + non-RVFC browsers path.\n    mediaEl.addEventListener('timeupdate', function() {\n      if (!mediaEl.duration) return;\n      if (seeking) return;\n      var now = performance.now();\n      if (mediaEl._lastTimeUpdate && now - mediaEl