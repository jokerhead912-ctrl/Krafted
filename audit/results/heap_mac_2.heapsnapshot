 '', style: r.style || 'orthogonal', color: r.color || '#00e5ff', lineWidth: r.lineWidth || 6, labelSize: r.labelSize || 16 }; });\n  if (append) {\n    // v6.8.3: appending must ADD relations, not replace them. The old code\n    // overwrote state.relations, silently wiping every arrow already on the\n    // canvas. Relation ids are also renumbered to avoid colliding with the\n    // existing ones.\n    let _relMax = (state.relations || []).reduce(function(m, r) {\n      const n = typeof r.id === 'number' ? r.id : 0;\n      return Math.max(m, n);\n    }, 0);\n    _loadedRelations.forEach(function(r) { r.id = ++_relMax; state.relations.push(r); });\n  } else {\n    state.relations = _loadedRelations;\n  }\n  state.selectedRelation = null;\n  // Restore groups\n  // v6.8.3: only wipe existing groups on a full load. Appending used to\n  // delete every group already on the canvas.\n  if (!append) {\n    state.groups.forEach(disposeGroupEl);\n    state.groups = [];\n  }\n  if (data.groups) {\n    if (append) {\n      // Keep counting from whatever the canvas is already using.\n      G.nextGroupId = state.groups.reduce(function(m, g) {\n        const n = typeof g.id === 'number' ? g.id : 0;\n        return Math.max(m, n + 1);\n      }, G.nextGroupId || 1);\n    } else {\n      G.nextGroupId = (data.G && data.G.nextGroupId) || data.nextGroupId || (Math.max(...data.groups.map(g => g.id), 0) + 1);\n    }\n    data.groups.forEach(gd => {\n      // v6.8.3: memberIds must go through _idRemap too (see relations above).\n      // Without this, appending a board whose ids collided would leave the\n      // group pointing at the pre-existing items instead of its own.\n      // Group ids are renumbered when appending so two boards' groups can't\n      // share an id (ungroup / border updates look groups up by id).\n      const _gid = append ? (G.nextGroupId++) : gd.id;\n      state.groups.push(makeGroupEl({ id: _gid, color: gd.color, name: gd.name, memberIds: (gd.memberIds || []).