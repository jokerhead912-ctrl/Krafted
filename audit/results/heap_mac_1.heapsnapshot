 _dur) * 100));\n\n      if (fill && (force || Math.abs(_pct - _p0LastHudPct) >= 0.05)) {\n        fill.style.width = _pct + '%';\n        _p0LastHudPct = _pct;\n      }\n\n      var _label = fmt(_t);\n      if (tCur && (force || _label !== _p0LastHudTime)) {\n        tCur.textContent = _label;\n        _p0LastHudTime = _label;\n      }\n\n      if (trimPlayheadEl) {\n        trimPlayheadEl.style.left = _pct + '%';\n      }\n\n      if (typeof updatePlayheadLabel === 'function') {\n        updatePlayheadLabel(_pct / 100);\n      }\n\n      // Round 57/68: frame/timecode overlay + info bar. Keep DOM writes\n      // minimal by only writing when the value actually changes.\n      if (frameCodeDisplay || infoBar) {\n        var _fps = getFps();\n        var _fIdx = Math.max(0, Math.round(_t * _fps));\n        var _fTotal = Math.max(0, Math.round(_dur * _fps));\n        var _tc = _p0FmtTc(_t);\n\n        if (_fcCurEl && (force || _fIdx !== _p0LastFrame)) _fcCurEl.textContent = 'F ' + _fIdx;\n        if (_fcTotalEl && (force || _fTotal !== _p0LastFrameTotal)) _fcTotalEl.textContent = '/ ' + _fTotal;\n        if (_fcTimeEl && (force || _tc !== _p0LastTc)) _fcTimeEl.textContent = _tc;\n\n        if (_ibFcurEl && (force || _fIdx !== _p0LastFrame)) _ibFcurEl.textContent = 'F ' + _fIdx;\n        if (_ibFtotEl && (force || _fTotal !== _p0LastFrameTotal)) _ibFtotEl.textContent = '/ ' + _fTotal;\n        if (_ibTimeEl && (force || _tc !== _p0LastTc)) _ibTimeEl.textContent = _tc;\n        if (_ibFpsEl && (force || _fps !== _p0LastFps)) _ibFpsEl.textContent = formatFpsLabel(_fps) + ' fps';\n\n        _p0LastFrame = _fIdx;\n        _p0LastFrameTotal = _fTotal;\n        _p0LastFps = _fps;\n        _p0LastTc = _tc;\n      }\n    }\n\n    function _p0StopRvfc() {\n      if (_p0RvfcId != null && typeof mediaEl.cancelVideoFrameCallback === 'function') {\n        try { mediaEl.cancelVideoFrameCallback(_p0RvfcId); } catch (e) {}\n      }\n      _p0RvfcId = null;\n    }\n\n    function _p0