where the wrapped content may need MORE vertical\n// room than the box currently has. Never shrinks \u2014 a height the user\n// deliberately dragged taller stays taller.\nfunction growTextHeightToFit(tx) {\n  const el = tx.el;\n  if (!el || !el.isConnected || !tx.w) return;\n  const oldMin = el.style.minWidth;\n  el.style.minWidth = '0';\n  el.style.width = tx.w + 'px';\n  el.style.height = 'auto';\n  // v7.17.0: an imported .md is one card, not two screens of text. The cap\n  // lives here (not only in CSS) so tx.h and the drawn box agree, and so\n  // editing cannot grow the card past it either.\n  const _naturalH = Math.max(32, Math.ceil(el.scrollHeight) + 2);\n  const _capH = el.classList.contains('doc-card') ? DOC_TEXT_MAX_H : Infinity;\n  const nextH = Math.min(_naturalH, _capH);\n  el.style.minWidth = oldMin;\n  tx.h = nextH;\n  updateItemStyle(tx);\n  updateAutoFitPaper();\n  positionBoardTextUI();\n}\n// v7.19.0: ONE sync for the .text-handles sibling (the Move-grip box). This\n// used to be hand-written only in the full style path, so the lightweight\n// move-drag pass early-returned ABOVE it and the grip stayed at the drag-start\n// spot for the whole gesture. The two resize fast paths each carried their own\n// copy of the same writes \u2014 one definition, every path, ends that.\nfunction syncTextHandleBox(item) {\n  const el = item.el;\n  if (!el || !el.classList.contains('text-item')) return;\n  const hCont = el.parentElement ? el.parentElement.querySelector('.text-handles[data-owner=\"' + item.id + '\"]') : null;\n  if (hCont) {\n    hCont.style.left = item.x + 'px';\n    hCont.style.top = item.y + 'px';\n    hCont.style.width = item.w + 'px';\n    hCont.style.height = item.h + 'px';\n    hCont.style.zIndex = item.z || 1;\n  }\n}\nfunction updateItemStyle(item, lightweight) {\n  const el = item.el;\n  // Skip style updates on the container during reframe \u2014 img is manually controlled\n  if (el.classList.contains('reframing')) return;\n  // v6.3.