an style=\"color:..\">\n    // from per-word recolor). Fall back to textContent for older data.\n    if (d.html && d.html.trim()) {\n      el.innerHTML = sanitizeTextHtml(d.html);\n    } else if (d.content) {\n      el.textContent = d.content;\n    }\n    canvasContent.appendChild(el);\n    const txId = _claimId(d.id);\n    const tx = { ...d, id: txId, el };\n    normalizeBoardTextMeta(tx, d);\n    delete tx.content;\n    delete tx.html;\n    // v6.8.26: convert old on-screen px to world px (no-op for new files)\n    if (_textMigZ !== 1) {\n      if (typeof tx.w === 'number') tx.w = tx.w / _textMigZ;\n      if (typeof tx.h === 'number') tx.h = tx.h / _textMigZ;\n      if (typeof tx.size === 'number') tx.size = Math.round(tx.size / _textMigZ * 10) / 10;\n    }\n    G.nextZ = Math.max(G.nextZ, tx.z + 1);\n    state.texts.push(tx);\n    // v6.8.26: texts are WORLD coords now (converted above for old files).\n    // applyTextProps / updateItemStyle write tx.w/tx.h/tx.size directly as\n    // inline CSS \u2014 the canvas transform scales them with everything else.\n    applyTextProps(tx);\n    updateItemStyle(tx);\n    // v6.8.22: a restored box already has its final w/h. Lock the width so\n    // a later auto-grow can never fall into the shrink-wrap branch and\n    // rewrite it \u2014 that path was what visibly deformed restored text boxes\n    // when the user clicked them (e.g. right after switching to Board Pen).\n    if (tx.w) tx._autoGrowLocked = true;\n    console.log('[LOAD-TEXT] id=' + tx.id + ' w=' + tx.w + ' h=' + tx.h + ' size=' + tx.size + ' zoom=' + state.zoom + ' cssW=[\"' + el.style.width + '\"] cssH=[\"' + el.style.height + '\"] cssFS=[\"' + el.style.fontSize + '\"] userResized=' + tx.userResized);\n    // v6.8.2: shared wiring (was a third hand-rolled copy, also missing\n    // updateTextColorPalette / updateAutoFitPaper)\n    attachTextListeners(tx);\n    // v6.7.22: removed setTimeout(autoGrow) on load \u2014 it was measuring\n    // el.scrollHeight right after restore and overwriting tx.h with a\n    // huge value (e.g. 812 for a 5-char word that wraps to many lines\n    // because the CSS width hadn't settled yet). Autogrow now only runs\n    // on user focus/input, when the box is being actively used.\n  });\n  // Restore todo items\n  state.todos = [];\n  (data.todos || []).forEach(d => {\n    const el = document.createElement('div');\n    el.className = 'todo-item';\n    canvasContent.appendChild(el);\n    const todoId = _claimId(d.id);\n    const todo = {\n      ...d, id: todoId, el,\n      items: (d.items || []).map(it => ({ text: it.text || '', done: !!it.done })),\n    };\n    G.nextZ = Math.max(G.nextZ, todo.z + 1);\n    state.todos.push(todo);\n    renderTodo(todo);\n    updateItemStyle(todo);\n  });\n  // Restore mindmap items\n  state.mindmaps = [];\n  (data.mindmaps || []).forEach(d => {\n    const el = document.createElement('div');\n    el.className = 'mindmap-item';\n    canvasContent.appendChild(el);\n    const mmId = _claimId(d.id);\n    const mm = {\n      ...d, id: mmId, el,\n      nodes: (d.nodes || []).map(n => ({ ...n })),\n      connections: (d.connections || []).map(c => ({ ...c })),\n    };\n    G.nextZ = Math.max(G.nextZ, mm.z + 1);\n    state.mindmaps.push(mm);\n    renderMindMap(mm);\n    updateItemStyle(mm);\n  });\n  // Restore G.nextId \u2014 use saved value or compute from max ID seen\n  // Support both flat format (buildManifest) and nested G format (legacy)\n  // v6.8.3: in append mode the file's saved nextId is meaningless (it\n  // belongs to the OTHER board's numbering), and _claimId may have handed\n  // out ids above it. Always derive from maxId when appending, otherwise\n  // the next new item could collide all over again.\n  if (append) {\n    G.nextId = Math.max(G.nextId || 1, maxId + 1);\n  } else {\n    G.nextId = (data.G && data.G.nextId) || data.nextId || (maxId + 1);\n  }\n  G.nextZ = (data.G && data.G.nextZ) || data.nextZ || G.nextZ;\n  G.nextStrokeId = (data.G && data.G.nextStrokeId) || data.nextStrokeId || G.nextStrokeId;\n  // Restore draw strokes (with backward compat for old drawLayers / strokes formats)\n  // v6.8.3: appending must ADD strokes, not wipe them. Every branch below used\n  // to do `G.drawStrokes.length = 0` first, which deleted all existing drawings\n  // when loading a second board onto the canvas. Stroke ids are renumbered on\n  // append so they can't collide with the strokes already present (draw-items\n  // reference their stroke via item.strokeId).\n  const _loadedStrokes =\n    Array.isArray((data.G && data.G.drawStrokes) || data.drawStrokes)\n      ? ((data.G && data.G.drawStrokes) || data.drawStrokes)\n      : Array.isArray(data.drawLayers)\n        ? data.drawLayers.flatMap(l => l.strokes || [])\n        : Array.isArray(data.strokes)\n          ? data.strokes\n          : [];\n  if (append) {\n    // Renumber incoming stroke ids and point the matching draw-items at them.\n    let _strokeMax = G.drawStrokes.reduce(function(m, s) {\n      const n = (s && typeof s.id === 'number') ? s.id : 0;\n      return Math.max(m, n);\n    }, 0);\n    const _strokeRemap = new Map();\n    _loadedStrokes.forEach(function(s) {\n      if (!s) return;\n      const oldId = s.id;\n      const nid = ++_strokeMax;\n      if (oldId !== undefined) _strokeRemap.set(oldId, nid);\n      s.id = nid;\n      G.drawStrokes.push(s);\n    });\n    // Draw-items created earlier in this restore carry the OLD strokeId.\n    // _idRemap already fixed their item ids; this fixes their stroke link.\n    (state.items || []).forEach(function(it) {\n      if (it && it.type === 'draw' && _strokeRemap.has(it.strokeId)) {\n        it.strokeId = _strokeRemap.get(it.strokeId);\n      }\n    });\n    G.nextStrokeId = Math.max(G.nextStrokeId || 1, _strokeMax + 1);\n  } else {\n    G.drawStrokes.length = 0;\n    _loadedStrokes.forEach(s => G.drawStrokes.push(s));\n  }\n  // v6.4.1: in append mode, preserve existing zoom/pan \u2014 don't overwrite