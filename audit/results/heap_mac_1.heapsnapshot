.todos || []).forEach(data => {\n    const el = document.createElement('div');\n    el.className = 'todo-item';\n    canvasContent.appendChild(el);\n    const todo = {\n      ...data, el,\n      items: (data.items || []).map(it => ({ text: it.text || '', done: !!it.done })),\n    };\n    state.todos.push(todo);\n    renderTodo(todo);\n    updateItemStyle(todo);\n  });\n  // Restore mindmaps\n  state.mindmaps = [];\n  (snap.mindmaps || []).forEach(data => {\n    const el = document.createElement('div');\n    el.className = 'mindmap-item';\n    canvasContent.appendChild(el);\n    const mm = {\n      ...data, el,\n      nodes: (data.nodes || []).map(n => ({ ...n })),\n      connections: (data.connections || []).map(c => ({ ...c })),\n    };\n    state.mindmaps.push(mm);\n    renderMindMap(mm);\n    updateItemStyle(mm);\n  });\n  // Restore groups\n  state.groups.forEach(disposeGroupEl);\n  state.groups = [];\n  if (snap.groups) {\n    G.nextGroupId = snap.nextGroupId || G.nextGroupId;\n    snap.groups.forEach(gd => {\n      state.groups.push(makeGroupEl({ id: gd.id, color: gd.color, name: gd.name, memberIds: gd.memberIds }));\n    });\n    setTimeout(() => updateAllGroupBorders(), 100);\n  }\n  // v7.0.40: restore named views. Nothing to rebuild \u2014 a view is data only \u2014\n  // but the panel has to be redrawn or the list keeps showing the pre-undo\n  // rows, which is exactly the \"I deleted a view and it came back\" confusion\n  // in reverse.\n  state.views = (snap.views || []).map(function (v) { return deserializeView(v); });\n  G.nextViewId = Number.isFinite(snap.nextViewId) ? snap.nextViewId : undefined;\n  if (state._activeViewIndex >= state.views.length) state._activeViewIndex = -1;\n  try { renderViewsPanel(); } catch (e) {}\n  // R72: restore the selection that was active when this snapshot was\n  // taken. The IDs round-trip cleanly because all item arrays were\n  // rebuilt with the same IDs above. Without this, undo would visually\n  // deselect everything \u2014 the small panel (props) goes back to the\n  // empty state, the resize handles vanish, the video loses its\n  // highlight, and the user thinks \"the mov player will close\" / \"all\n  // functions are abnormal\". A stale ID in the saved set (e.g. a text\n  // item that was just deleted) is harmless \u2014 it just won't match\n  // anything in the rebuilt state and gets dropped on refreshSelection.\n  state.selected = new Set(Array.isArray(snap.selected) ? snap.selected : []);\n  refreshSelection();\n  // Re-render draw strokes (draw item DOMs were rebuilt above)\n  redrawDrawLayer();\n  // Restore relation lines from snapshot\n  state.relations = (snap.relations || []).map(function(r) { return { id: r.id, fromId: r.fromId, toId: r.toId, fromAnchor: r.fromAnchor, toAnchor: r.toAnchor, label: r.label || '', style: r.style || 'orthogonal', color: r.color || '#00e5ff', lineWidth: r.lineWidth || 3, labelSize: r.labelSize || 16 }; });\n  state.selectedRelation = null;\n  renderRelations();\n  scheduleAutoSave();\n  updateAutoFitPaper();\n  // R73: re-render the frame-comment list for any video item that has\n  // annotation data. Without this, after Ctrl+Z the comment list still\n  // shows the OLD comment objects (with snapshot data) even though the\n  // rebuilt state.items now have the restored comments \u2014 leading to a\n  // mix where some thumbnails look fine (the old DOM) and others go\n  // blank (when the list is rebuilt from scratch). Call the per-item\n  // refresh hook for every video so all popovers/list panels update.\n  try {\n    state.items.forEach(it => {\n      if (it && it.isVideo && it.anno && it.el) {\n        if (typeof videoAnnoRefreshCommentList === 'function') {\n          videoAnnoRefreshCommentList(it);\n        }\n        if (it.el._refreshListBody) it.el._refreshListBody();\n        if (it.el._refreshAnnoBadges) it.el._refreshAnnoBadges();\n        if (it.el._refreshSeekMarkers) it.el._refreshSeekMarkers();\n      }\n    });\n  } catch (e) { /* non-fatal */ }\n}\nfunction undo() {\n  if (state.undoStack.length === 0) return;\n  // v7.0.36: pop the sequence number in lockstep with the snapshot. It is the\n  // sequence of the state we are about to show, so it becomes _boardSeq; the\n  // state we are leaving is what the redo entry has to carry.\n  const backSeq = (state._undoSeqs && state._undoSeqs.length)\n    ? state._undoSeqs.pop() : 0;\n  const pushed = _pushRedo(state._boardSeq || 0);\n  // Whatever _pushRedo() just captured IS the live board \u2014 reuse it as the\n  // restore's safety net instead of serialising a second time.\n  const safety = pushed ? (state.redoStack[state.redoStack.length - 1] || null) : null;\n  restoreSnapshot(state.undoStack.pop(), safety);\n  state._boardSeq = backSeq;\n  updateStatus();\n}\nfunction redo() {\n  if (state.redoStack.length === 0) return;\n  const fwdSeq = (state._redoSeqs && state._redoSeqs.length)\n    ? state._redoSeqs.pop() : null;\n  const backSeq = state._boardSeq || 0;\n  const snapStr = _captureSnapshotSafe();\n  if (snapStr) {\n    state.undoStack.push(snapStr);\n    state._undoBytes += snapStr.length;\n    if (!state._undoSeqs) state._undoSeqs = [];\n    state._undoSeqs.push(backSeq);\n    _trimStack(state.undoStack, '_undoBytes', '_undoSeqs');\n  }\n  restoreSnapshot(state.redoStack.pop(), snapStr || null);\n  if (fwdSeq !== null) state._boardSeq = fwdSeq;\n  updateStatus();\n}\n\n// ============================================================\n//  v7.0.36 \u2014 ONE decision point for Ctrl+Z / Ctrl+Shift+Z\n// ============================================================\n//\n// Two stacks cover two very different kinds of action:\n//   \u2022 state.undoStack \u2014 full board snapshots (pushUndo). Heavy, but a single\n//     snapshot restores everything: items, text, board pen strokes, and\n//     (since R85) each video's live per-frame annotation strokes.\n//   \u2022 G._annoUndoStack \u2014 one lightweight entry per video-annotation stroke or\n//     text commit. A board snapshot per stroke would be far too expensive.\n//\n// Before v7.0.36 the handler tested `_top.seq === G._actionSeq` \u2014 an EXACT\n// equality. Any drift (a board op firing after the last stroke, a deferred\n// undo flushing at the end of a save, or the target element having been\n// rebuilt so the entry was stale) made the test fail, and Ctrl+Z then fell\n// through to the global board undo(). Because annotation strokes never take a\n// board snapshot, the snapshot on top of undoStack predated every stroke the\n// user had drawn \u2014 restoring it wiped all of the frame drawings and text in\n// one keypress. That is the \"\u4E00\u64B3 Ctrl+Z \u5C31\u5C07\u6211\u6240\u6709\u756B\u5605\u5BEB\u5605\u5622\u90FD\u522A\u9664\" report.\n//\n// The fix: give the board stack its own sequence numbers and decide by\n// COMPARISON, not equality. Whichever stack owns the higher sequence number\n// was touched last, so it is the one we undo. Equality is no longer a failure\n// mode, and a stale annotation entry is skipped instead of triggering a\n// whole-board restore.\n\nfunction currentBoardSeq() {\n  return state._boardSeq || 0;\n}\nfunction currentAnnoSeq() {\n  const st = G._annoUndoStack;\n  return (st && st.length) ? (st[st.length - 1].seq || 0) : -1;\n}\nfunction currentBoardRedoSeq() {\n  return (state._redoSeqs && state._redoSeqs.length)\n    ? state._redoSeqs[state._redoSeqs.length - 1] : -1;\n}\nfunction currentAnnoRedoSeq() {\n  const st = G._annoRedoStack;\n  return (st && st.length) ? (st[st.length - 1].seq || 0) : -1;\n}\n\n// Paint the annotation overlay after a stroke was added/removed.\nfunction _annoRefreshElement(el) {\n  try { if (el._syncStrokesForFrame) el._syncStrokesForFrame(); } catch (e) {}\n  el._perfLastRenderKey = '';\n  try { if (el._renderAnnoCanvas) el._renderAnnoCanvas(); } catch (e) {}\n  try { if (el._refreshDrawBtnBadge) el._refreshDrawBtnBadge(); } catch (e) {}\n  try { if (el._refreshAllSeekMarkers) el._refreshAllSeekMarkers(); } catch (e) {}\n  try { scheduleAutoSave(); } catch (e) {}\n}\n\n// Remove the newest still-valid annotation commit. Stale entries (element\n// deleted, or its frame array already emptied by something else) are dropped\n// rather than escalating to a board undo.\nfunction _annoUndoOne() {\n  const st = G._annoUndoStack;\n  if (!st || !st.length) return false;\n  while (st.length) {\n    const top = st.pop();\n    const el = top && top.el;\n    const ds = el && el.isConnected && el._annoDrawState;\n    const arr = ds && ds.strokesByFrame && ds.strokesByFrame[top.frame];\n    if (!arr || !arr.length) continue;   // stale \u2014 try the next entry\n    const stroke = arr.pop();\n    if (!arr.length) { try { delete ds.strokesByFrame[top.frame]; } catch (e) {} }\n    try {\n      G._annoRedoStack = G._annoRedoStack || [];\n      G._annoRedoStack.push({ el: el, frame: top.frame, seq: top.seq, stroke: stroke });\n      if (G._annoRedoStack.length > 100) G._annoRedoStack.shift();\n    } catch (e) {}\n    _annoRefreshElement(el);\n    return true;\n  }\n  return false;\n}\n\n// Re-apply the annotation commit removed by the last Ctrl+Z.\nfunction _annoRedoOne() {\n  const st = G._annoRedoStack;\n  if (!st || !st.length) return false;\n  while (st.length) {\n    const top = st.pop();\n    const el = top && top.el;\n    const ds = el && el.isConnected && el._annoDrawState;\n    if (!ds || !ds.strokesByFrame) continue;   // stale \u2014 try the next entry\n    if (!ds.strokesByFrame[top.frame]) ds.strokesByFrame[top.frame] = [];\n    ds.strokesByFrame[top.frame].push(top.stroke);\n    try {\n      G._annoUndoStack = G._annoUndoStack || [];\n      G._actionSeq = (G._actionSeq || 0) + 1;\n      G._annoUndoStack.push({ el: el, frame: top.frame, seq: G._actionSeq });\n      if (G._annoUndoStack.length > 100) G._annoUndoStack.shift();\n    } catch (e) {}\n    _annoRefreshElement(el);\n    return true;\n  }\n  return false;\n}\n\n// Ctrl+Z \u2014 undo whichever action happened last.\nfunction undoLastAction() {\n  if (currentAnnoSeq() >= currentBoardSeq() && _annoUndoOne()) return;\n  undo();\n}\n// Ctrl+Shift+Z / Ctrl+Y \u2014 redo whichever action was undone last.\nfunction redoLastAction() {\n  if (currentAnnoRedoSeq() >= currentBoardRedoSeq() && _annoRedoOne()) return;\n  redo();\n}\n\n\n// ==== selection.js ====\n\n\nfunction getSelectedItems() {\n  return [...state.items, ...state.texts, ...(state.todos||[]), ...(state.mindmaps||[])].filter(i => state.selected.has(i.id));\n}\nfunction getSelectedImages() {\n  return state.items.filter(i => state.selected.has(i.id));\n}\n\n// ============================================================\n//  SELECTION\n// ============================================================\nfunction selectOnly(id) {\n  state.selected.clear();\n  state.selected.add(id);\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction clearSelection() {\n  state.selected.clear();\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction toggleSelect(id) {\n  if (state.selected.has(id)) state.selected.delete(id);\n  else state.selected.add(id);\n  refreshSelection();\n  updateTextColorPalette();\n}\nfunction refreshSelection() {\n  document.querySelectorAll('.item, .text-item, .todo-item, .draw-item').forEach(el => el.classList.remove('selected'));\n  document.querySelectorAll('.item-handle, .item-rot').forEach(el => el.remove());\n  // Round 67 \u2014 also wipe the empty union multi-select container left\n  // behind after the 8 child handles were just removed. The container\n  // is empty (no styles, no children) but we drop it anyway to keep\n  // the DOM tidy across long sessions of reselecting.\n  document.querySelectorAll('.multi-sel-handles').forEach(el => el.remove());\n  document.querySelectorAll('.text-handles').forEach(el => el.remove());\n  // Don't add handles during reframe mode\n  if (state.reframing) return;\n  // Clean up mask editing if selected item changed\n  const sel = getSelectedItems();\n  if (sel.length !== 1 || !sel[0].masks || !sel[0].masks.find(m => m.id === activeMaskId)) {\n    if (maskBrushActive) { maskBrushActive = false; removeBrushCanvas(); }\n    if (maskPickColorActive) { maskPickColorActive = false; document.getElementById('viewport').classList.remove('mask-pick-mode'); }\n    activeMaskId = null;\n  }\n  // Round 67 \u2014 MULTI-SELECT UNION HANDLES: when 2+ items are selected,\n  // skip the per-item addHandles() loop and add ONE set of 8 resize\n  // handles at the corners of the union bounding box (Figma / Sketch\n  // behavior). Previously every item got its own 8 handles, scattering\n  // them around the canvas and looking like \"scale points outside the\n  // selection box\". The existing Round-41 multi-select scale path\n  // (in the mousedown handler) still kicks in because dataset.id points\n  // at a selected item and state.selected.size > 1.\n  if (sel.length >= 2) {\n    // Mark every selected item visually (blue outline etc.) but skip the\n    // per-item handle children. The 8 union handles do the resize job.\n    sel.forEach(item => item.el.classList.add('selected'));\n    addMultiSelectHandles(sel);\n    sel.filter(it => it.el.classList.contains('text-item')).forEach(it => addTextHandles(it, true));\n  } else {\n    sel.forEach(item => {\n      item.el.classList.add('selected');\n      // v6.3.6 / v6.5.0: activate lazy video on select\n      if (item._lazyEntry && window._activateLazyVideo) window._activateLazyVideo(item);\n      if (item._kpakEntry && window._activateLazyVideoV6) window._activateLazyVideoV6(item);\n      // v5.5.1: lazy-load video when selected (preload=\"none\" saves memory)\n      if (item.video && item.video.preload === 'none') {\n        item.video.preload = 'auto';\n        item.video.load();\n      }\n      if (item.img) addHandles(item);\n      else if (item.type === 'draw') addHandles(item);\n      else if (item.video) {\n        // Round 57: video items need the SAME 8 resize handles + 1 rotation\n        // handle as images. Previously the code fell through to addTextHandles\n        // which expects tx.x/y/w/h (text properties) \u2014 videos don't have\n        // those, so the .text-handles container got NaN dimensions and the\n        // 6 handles clustered at the top-left of the canvas, looking like\n        // \"many random scale dots\" on selection. addHandles reads item.el\n        // only, so it works for any element-based item type.\n        addHandles(item);\n      } else if (item.audio) {\n        // Audio items also need standard resize handles (their .item is\n        // a flex column with no text/text-handle semantics).\n        addHandles(item);\n      } else if (item.el && item.el.classList.contains('todo-item')) {\n        // Todo items: add resize handles for scaling\n        addHandles(item);\n      } else if (item.el && item.el.classList.contains('mindmap-item')) {\n        // Mind map items: add resize handles for manual scaling\n        addHandles(item);\n      } else if (item.isLink) {\n        // Link cards: also need standard resize handles\n        addHandles(item);\n      } else addTextHandles(item); // Text items get resize handles too\n    });\n  }\n  // Round 58: playhead-position label visibility is a multi-source OR:\n  //   - selected (this refreshSelection pass found it in `sel`)\n  //   - actively playing\n  //   - mid-drag (toggle handled in the mousedown/mouseup handler)\n  // Iterate ALL video items and reconcile, so the previously-selected\n  // video's label hides on deselect and the new one shows. Cheaper\n  // than a per-item hook.\n  document.querySelectorAll('.item.has-media .media-playhead-label').forEach(lbl => {\n    var itemEl = lbl.closest('.item');\n    if (!itemEl) return;\n    var isSelected = itemEl.classList.contains('selected');\n    var media = itemEl.querySelector('video, audio');\n    var isPlaying = media && !media.paused && !media.ended;\n    if (isSelected || isPlaying) {\n      lbl.classList.add('show');\n      lbl._forceVisible = true;\n    } else {\n      lbl.classList.remove('show');\n      lbl._forceVisible = false;\n    }\n  });\n  syncBoardTextUI();\n  updatePropsPanel();\n  updateStatus();\n  // v7.0.52: keep the Library highlight on the current selection. Cheap on\n  // purpose - it flips classes, it never rebuilds the list.\n  try { libSyncActive(); } catch (e) {}\n  // v7.0.53: the map tints the selected item too.\n  try { requestMinimapRefresh(); } catch (e) {}\n}\nfunction addHandles(item) {\n  const handles = [\n    { cls: 'nw', dir: 'nw' }, { cls: 'ne', dir: 'ne' },\n    { cls: 'sw', dir: 'sw' }, { cls: 'se', dir: 'se' },\n    { cls: 'n', dir: 'n' }, { cls: 's', dir: 's' },\n    { cls: 'e', dir: 'e' }, { cls: 'w', dir: 'w' },\n  ];\n  handles.forEach(h => {\n    const el = document.createElement('div');\n    el.className = `item-handle ${h.cls}`;\n    el.dataset.dir = h.dir;\n    el.dataset.id = item.id;\n    item.el.appendChild(el);\n  });\n  if (!item.locked) {\n    const rot = document.createElement('div');\n    rot.className = 'item-rot';\n    rot.dataset.id = item.id;\n    item.el.appendChild(rot);\n  }\n}\n\n// Round 67 \u2014 MULTI-SELECT UNION HANDLES.\n// When 2+ items are selected, instead of adding 8 scale handles + 1 rotation\n// handle on EACH item (which puts handles scattered around every individual\n// item \u2014 looking like \"scale points outside the [logical] selection box\"),\n// we draw a SINGLE set of 8 resize handles at the corners of the union\n// axis-aligned bounding box. This matches Figma / Sketch / Photoshop behavior\n// and is what the user expects when they select multiple things.\n//\n// The container is appended to canvasContent (the same parent as items),\n// so it inherits the canvas pan/zoom transform and the items inside it are\n// positioned in world coords. dataset.id points at the first non-locked\n// selected item so the existing mousedown handler can find it; the existing\n// multi-select scale path (Round 41) then takes over.\nfunction addMultiSelectHandles(sel) {\n  // Union AABB in world coords\n  let mx = Infinity, my = Infinity, mx2 = -Infinity, my2 = -Infinity;\n  for (const s of sel) {\n    if (s.x < mx) mx = s.x;\n    if (s.y < my) my = s.y;\n    if (s.x + s.w > mx2) mx2 = s.x + s.w;\n    if (s.y + s.h > my2) my2 = s.y + s.h;\n  }\n  const bw = mx2 - mx;\n  const bh = my2 - my;\n  // Pick the first non-locked item as the handle \"owner\" so the mousedown\n  // handler finds a resizable item (the existing multi-select path then\n  // scales every selected item together around the union bbox pivot).\n  const owner = sel.find(s => !s.locked) || sel[0];\n  // Highest z so the handles sit on top of every selected item\n  let maxZ = 0;\n  for (const s of sel) { if ((s.z || 1) > maxZ) maxZ = s.z || 1; }\n  const cont = document.createElement('div');\n  cont.className = 'multi-sel-handles';\n  // Position in world coords. The .item-handle CSS already positions each\n  // handle at the corners of its parent (top: -8px; left: -8px; etc), so\n  // the handle dots sit 8px OUTSIDE the bbox corners \u2014 exactly like the\n  // per-item handles, but at the union of all selected items.\n  cont.style.position = 'absolute';\n  cont.style.left = '0px';\n  cont.style.top = '0px';\n  cont.style.width = bw + 'px';\n  cont.style.height = bh + 'px';\n  cont.style.transform = `translate3d(${mx}px, ${my}px, 0)`;\n  cont.style.transformOrigin = '0 0';\n  cont.style.zIndex = (maxZ + 1) + '';\n  cont.style.pointerEvents = 'none'; // container is click-through; children re-enable\n  cont.dataset.ownerId = owner.id;\n  // 8 resize handles. dataset.id = owner.id so the mousedown handler in the\n  // SELECT TOOL branch can find the item and enter the Round-41 multi-select\n  // scale path (which scales every selected item together around the union\n  // bbox pivot). The same path triggers on ANY handle, so we don't need to\n  // change the resize logic at all.\n  const dirs = ['nw','ne','sw','se','n','s','e','w'];\n  for (const d of dirs) {\n    const el = document.createElement('div');\n    el.className = 'item-handle ' + d + ' multi-handle';\n    el.dataset.dir = d;\n    el.dataset.id = owner.id;\n    el.style.pointerEvents = 'auto';\n    cont.appendChild(el);\n  }\n  canvasContent.appendChild(cont);\n}\n\n// Text items get corner + edge handles for resizing\n// Handles go in a SIBLING container (.text-handles), NOT inside the contentEditable div\nfunction addTextHandles(tx, moveOnly) {\n  if (!tx.el || !tx.el.parentElement || tx.locked) return;\n  let box = tx.el.parentElement.querySelector('.text-handles[data-owner=\"' + tx.id + '\"]');\n  if (!box) {\n    box = document.createElement('div');\n    box.className = 'text-handles';\n    box.dataset.owner = tx.id;\n    tx.el.parentElement.appendChild(box);\n  }\n  box.replaceChildren();\n  box.style.left = tx.x + 'px';\n  box.style.top = tx.y + 'px';\n  box.style.width = tx.w + 'px';\n  box.style.height = tx.h + 'px';\n  box.style.zIndex = (tx.z || 1) + 1;\n  box.style.transform = 'rotate(' + (tx.rot || 0) + 'deg)';\n  const grip = document.createElement('button');\n  grip.type = 'button';\n  grip.className = 'bt-move';\n  grip.dataset.id = tx.id;\n  grip.textContent = boardTextLabel('Move', '\u79FB\u52A8');\n  grip.title = boardTextLabel('Drag to move; double-click text to edit', '\u62D6\u52A8\u628A\u624B\u79FB\u52A8\uFF1B\u53CC\u51FB\u6B63\u6587\u7F16\u8F91');\n  grip.setAttribute('aria-label', grip.title);\n  grip.style.transform = 'scale(' + (1 / Math.max(.05, state.zoom)) + ')';\n  box.appendChild(grip);\n  if (moveOnly) return;\n  ['n','s'].forEach(dir => {\n    const border = document.createElement('div');\n    border.className = 'bt-select-edge ' + dir;\n    border.dataset.id = tx.id;\n    box.appendChild(border);\n  });\n  ['e','w'].forEach(dir => {\n    const handle = document.createElement('div');\n    handle.className = 'item-handle ' + dir;\n    handle.dataset.id = tx.id;\n    handle.dataset.dir = dir;\n    handle.dataset.textHandle = '1';\n    handle.title = boardTextLabel('Change width; keep font size', '\u8C03\u6574\u5BBD\u5EA6\uFF0C\u4E0D\u6539\u53D8\u5B57\u53F7');\n    box.appendChild(handle);\n  });\n  // v7.20.0: corner handles, so a text card scales like an IMAGE \u2014 aspect\n  // locked, and the font scales with the box (see scaleBoardTextFontSize).\n  // Edge handles keep the old width-only meaning on purpose: \"resize the\n  // box, not the type\" is still a thing people want.\n  ['nw','ne','sw','se'].forEach(dir => {\n    const handle = document.createElement('div');\n    handle.className = 'item-handle ' + dir;\n    handle.dataset.id = tx.id;\n    handle.dataset.dir = dir;\n    handle.dataset.textHandle = '1';\n    handle.title = boardTextLabel('Scale text; font scales too', '\u6574\u4F53\u7F29\u653E\uFF0C\u5B57\u53F7\u540C\u6B65\u653E\u5927');\n    box.appendChild(handle);\n  });\n}\n\n// \u2500\u2500 v5.5.1: hover-based video lazy load \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// When the mouse hovers over a video that hasn't been loaded yet\n// (preload=\"none\"), trigger load so the user sees a thumbnail.\nvar _videoLazyLoadObserver = null;\nfunction initVideoLazyLoad() {\n  if (_videoLazyLoadObserver) return;\n  var hoveredVideo = null;\n  document.addEventListener('mousemove', function(e) {\n    var el = document.elementFromPoint(e.clientX, e.clientY);\n    if (!el) return;\n    var itemEl = el.closest('.item.has-media');\n    if (!itemEl) {\n      if (hoveredVideo) { hoveredVideo = null; }\n      return;\n    }\n    // Avoid re-checking the same element every mousemove tick\n    if (itemEl === hoveredVideo) return;\n    hoveredVideo = itemEl;\n    // Find the video element inside\n    var vid = itemEl.querySelector('video');\n    // v6.3.6 / v6.5.0: activate lazy video on hover\n    if (itemEl._item && itemEl._item._lazyEntry && window._activateLazyVideo) {\n      window._activateLazyVideo(itemEl._item);\n    }\n    if (itemEl._item && itemEl._item._kpakEntry && window._activateLazyVideoV6) {\n      window._activateLazyVideoV6(itemEl._item);\n    }\n    if (vid && vid.preload === 'none') {\n      vid.preload = 'auto';\n      vid.load();\n    }\n  }, { passive: true });\n}\n\n\n// ==== layout-tidy.js ====\n\n\n// ============================================================\n//  TIDY SELECTION \u2014 Masonry layout for selected items\n// ============================================================\n// \u2500\u2500 Tidy column widths (v7.0.38) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// TIDY_COL_W is the plain image/text column: dense, Pinterest-like.\n// TIDY_MEDIA_COL_W is the floor for any selection that contains a video or\n// an audio clip. It is not a taste value \u2014 it is measured. The player\n// controls bar at its \"micro\" density (see .media-controls-row.micro) needs\n// ~343px of intrinsic width to fit play + draw + both time labels + the\n// seek bar + comments + snap without scrolling. 380 leaves ~37px of slack\n// for font rendering differences across platforms.\nvar TIDY_COL_W = 280;\nvar TIDY_MEDIA_COL_W = 380;\n// Does this entry carry a player controls bar? Both shapes exist in the\n// wild \u2014 items created in-session carry isVideo/isAudio booleans, items\n// rebuilt from a .kpak may only carry type === 'video'.\nfunction _itemHasPlayerControls(o) {\n  if (!o) return false;\n  return !!(o.isVideo || o.isAudio || o.type === 'video' || o.type === 'audio');\n}\n\n// Arranges all selected items (items, texts, todos, mindmaps) in a compact\n// masonry (Pinterest-style) grid centered on the original selection bounding\n// box. All items are scaled to a uniform column width preserving aspect\n// ratio. Uses minimum 2 columns for 2+ items.\n// After layout, auto-frames the viewport to show all tidied items.\n// Bound to Ctrl+Shift+T (Cmd+Shift+T on Mac) and the \uF9F9 toolbar button.\n// v7.0.38: the column width is no longer a flat 280 \u2014 see TIDY_COL_W /\n// TIDY_MEDIA_COL_W below. 280 was picked for images and it silently turned\n// every tidied video into a control strip you had to scroll sideways.\nfunction tidySelection() {\n  var sel = state.selected;\n  if (!sel || sel.size === 0) {\n    try { toast('Select items to tidy first'); } catch (e) {}\n    return;\n  }\n\n  // --- Collect all selected items with their world-coordinate bounds ---\n  var selItems = [];\n  var selArr = Array.from(sel);\n  var COL_W = TIDY_COL_W;\n  var GAP = 16;\n\n  for (var si = 0; si < selArr.length; si++) {\n    var id = selArr[si];\n\n    // Image / video / link / draw items\n    var it = (state.items || []).find(function(i) { return i.id === id; });\n    if (it) {\n      selItems.push({\n        id: id, x: it.x, y: it.y, w: it.w, h: it.h,\n        el: it.el, isText: false, isTodo: false, isMindmap: false,\n        item: it\n      });\n      continue;\n    }\n\n    // Text items \u2014 get world-coord size from BCR\n    var tx = (state.texts || []).find(function(t) { return t.id === id; });\n    if (tx && tx.el) {\n      var r = tx.el.getBoundingClientRect();\n      var wx = (r.left - state.pan.x) / state.zoom;\n      var wy = (r.top  - state.pan.y) / state.zoom;\n      var ww = r.width  / state.zoom;\n      var wh = r.height / state.zoom;\n      selItems.push({\n        id: id, x: wx, y: wy, w: ww, h: wh,\n        el: tx.el, isText: true, isTodo: false, isMindmap: false,\n        item: tx\n      });\n      continue;\n    }\n\n    // Todo items\n    var td = (state.todos || []).find(function(t) { return t.id === id; });\n    if (td && td.el) {\n      var r2 = td.el.getBoundingClientRect();\n      var wx2 = (r2.left - state.pan.x) / state.zoom;\n      var wy2 = (r2.top  - state.pan.y) / state.zoom;\n      var ww2 = r2.width  / state.zoom;\n      var wh2 = r2.height / state.zoom;\n      selItems.push({\n        id: id, x: wx2, y: wy2, w: ww2, h: wh2,\n        el: td.el, isText: false, isTodo: true, isMindmap: false,\n        item: td\n      });\n      continue;\n    }\n\n    // Mindmap items \u2014 use the bounding box of all nodes\n    var mm = (state.mindmaps || []).find(function(m) { return m.id === id; });\n    if (mm && Array.isArray(mm.nodes) && mm.nodes.length > 0) {\n      var mMinX = Infinity, mMinY = Infinity, mMaxX = -Infinity, mMaxY = -Infinity;\n      mm.nodes.forEach(function(n) {\n        if (typeof n.x === 'number' && typeof n.y === 'number') {\n          if (n.x < mMinX) mMinX = n.x;\n          if (n.y < mMinY) mMinY = n.y;\n          // Mindmap node approximate size: 120x40\n          var nw = n.w || 120;\n          var nh = n.h || 40;\n          if (n.x + nw > mMaxX) mMaxX = n.x + nw;\n          if (n.y + nh > mMaxY) mMaxY = n.y + nh;\n        }\n      });\n      if (isFinite(mMinX) && isFinite(mMaxX)) {\n        selItems.push({\n          id: id, x: mMinX, y: mMinY, w: mMaxX - mMinX, h: mMaxY - mMinY,\n          el: mm.el, isText: false, isTodo: false, isMindmap: true,\n          item: mm, origMinX: mMinX, origMinY: mMinY\n        });\n      }\n    }\n  }\n\n  if (selItems.length === 0) {\n    try { toast('Select items to tidy first'); } catch (e) {}\n    return;\n  }\n\n  // --- v7.0.38: widen the column when the selection carries players ---\n  // One video among forty images is enough. A 280px column leaves the\n  // controls bar scrolling, so every button past the seek bar needs a\n  // sideways drag to reach \u2014 which is exactly why videos were being\n  // resized by hand after every tidy.\n  var _hasPlayer = false;\n  for (var _pi = 0; _pi < selItems.length; _pi++) {\n    if (_itemHasPlayerControls(selItems[_pi].item)) { _hasPlayer = true; break; }\n  }\n  if (_hasPlayer && COL_W < TIDY_MEDIA_COL_W) COL_W = TIDY_MEDIA_COL_W;\n\n  // --- Push undo before modifying ---\n  try { pushUndo(); } catch (e) {}\n\n  // --- Find the center of the current selection bounding box ---\n  var cMinX = Infinity, cMinY = Infinity, cMaxX = -Infinity, cMaxY = -Infinity;\n  for (var ci = 0; ci < selItems.length; ci++) {\n    var siBox = selItems[ci];\n    if (siBox.x < cMinX) cMinX = siBox.x;\n    if (siBox.y < cMinY) cMinY = siBox.y;\n    if (siBox.x + siBox.w > cMaxX) cMaxX = siBox.x + siBox.w;\n    if (siBox.y + siBox.h > cMaxY) cMaxY = siBox.y + siBox.h;\n  }\n  var centerX = (cMinX + cMaxX) / 2;\n  var centerY = (cMinY + cMaxY) / 2;\n\n  // --- Masonry layout ---\n  // Minimum 2 columns for 2+ items; sqrt-based for larger counts\n  var cols = selItems.length <= 1 ? 1 : Math.max(2, Math.ceil(Math.sqrt(selItems.length)));\n\n  // Sort by height descending (larger items first reduces gaps)\n  selItems.sort(function(a, b) { return b.h - a.h; });\n\n  var colHeights = new Array(cols);\n  for (var cj = 0; cj < cols; cj++) { colHeights[cj] = 0; }\n\n  // --- Pass 1: compute relative positions (relative to 0,0) ---\n  // Also store scaled w/h for each item.\n  var _z = Math.max(0.02, Math.min(10, state.zoom || 1));\n  for (var pk = 0; pk < selItems.length; pk++) {\n    var ssi = selItems[pk];\n\n    // Find the shortest column\n    var shortestCol = 0;\n    for (var ck = 1; ck < cols; ck++) {\n      if (colHeights[ck] < colHeights[shortestCol]) shortestCol = ck;\n    }\n\n    // Scale to uniform column width, preserve aspect ratio\n    // v5.5.7: when there's only ONE item, don't squeeze it to COL_W \u2014\n    // that destroys wide videos/images and forces the controls bar\n    // (min content width) to overflow the container. Keep the\n    // original size and only recenter it.\n    var scale, newW, newH;\n    if (selItems.length === 1) {\n      newW = ssi.w;\n      newH = ssi.h;\n      // v7.0.38: a lone media item still gets the controls-bar floor.\n      // Tidy used to leave a single-item selection completely untouched\n      // (deliberately \u2014 to avoid squeezing a wide video), so a clip\n      // imported at 240px stayed at 240px with a bar you could not read,\n      // and the only cure was dragging a corner handle by hand.\n      if (_itemHasPlayerControls(ssi.item) && newW > 0 && newW < TIDY_MEDIA_COL_W) {\n        scale = TIDY_MEDIA_COL_W / newW;\n        newW = TIDY_MEDIA_COL_W;\n        newH = newH * scale;\n      }\n    } else {\n      scale = COL_W / ssi.w;\n      newW = COL_W;\n      newH = ssi.h * scale;\n    }\n\n    // Store scaled dimensions for framing\n    ssi._newW = newW;\n    ssi._newH = newH;\n\n    // Compute relative position\n    ssi._relX = shortestCol * (COL_W + GAP);\n    ssi._relY = colHeights[shortestCol];\n    ssi._relCol = shortestCol;\n\n    // Update column height\n    colHeights[shortestCol] += newH + GAP;\n  }\n\n  // --- Compute the origin so the layout is centered on the selection ---\n  var totalW = cols * (COL_W + GAP) - GAP;\n  var maxColH = 0;\n  for (var cm = 0; cm < colHeights.length; cm++) {\n    if (colHeights[cm] > maxColH) maxColH = colHeights[cm];\n  }\n  var totalH = maxColH - GAP;\n  if (totalH < 1) totalH = 1;\n  var originX = centerX - totalW / 2;\n  var originY = centerY - totalH / 2;\n\n  // --- Pass 2: apply positions with the origin offset ---\n  for (var pa = 0; pa < selItems.length; pa++) {\n    var si = selItems[pa];\n    var finalX = originX + si._relX;\n    var finalY = originY + si._relY;\n\n    // --- Apply new position and scaled size to the underlying item ---\n    if (si.isMindmap) {\n      // Mindmap: shift all nodes by the delta from original top-left\n      var dx = finalX - si.origMinX;\n      var dy = finalY - si.origMinY;\n      si.item.nodes.forEach(function(n) {\n        if (typeof n.x === 'number') n.x += dx;\n        if (typeof n.y === 'number') n.y += dy;\n      });\n      // Update connectors and DOM position\n      try { mmUpdateConnectors(si.item); } catch (e) {}\n    } else if (si.isText) {\n      // v6.8.26: text items are world-coord now \u2014 x/y/w/h all world px.\n      // v6.6.0: Tidy may resize text items. Sync font size proportionally\n      // so the visual result matches the new dimensions.\n      var _oldW = si.item.w || 160;\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n      if (_oldW > 0 && si.item.w !== _oldW) {\n        si.item.size = (si.item.size || 24) * (si.item.w / _oldW);\n      }\n    } else if (si.isTodo) {\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n    } else {\n      // Regular items (images, videos, etc.)\n      si.item.x = finalX;\n      si.item.y = finalY;\n      si.item.w = si._newW;\n      si.item.h = si._newH;\n    }\n\n    // Update DOM via updateItemStyle\n    try { updateItemStyle(si.item); } catch (e) {}\n    // v6.6.0: text items need applyTextProps to sync fontSize (updateItemStyle skips it)\n    if (si.isText && typeof applyTextProps === 'function') {\n      try { applyTextProps(si.item); } catch (e) {}\n      // v6.6.0: refresh text handle container position/size after tidy\n      // \u2014 otherwise resize handles stay at old position and break resize.\n      try {\n        var hCont = si.item.el.parentElement.querySelector('.text-handles[data-owner=\"' + si.item.id + '\"]');\n        if (hCont) {\n          hCont.style.left = si.item.x + 'px';\n          hCont.style.top = si.item.y + 'px';\n          hCont.style.width = si.item.w + 'px';\n          hCont.style.height = si.item.h + 'px';\n        }\n      } catch (e) {}\n    }\n\n    // Store tidied position for framing (use new scaled w/h)\n    si._newX = finalX;\n    si._newY = finalY;\n  }\n\n  // --- Refresh canvas ---\n  try { updateCanvas(); } catch (e) {}\n\n  // v6.5.0: DON'T auto-frame after tidy \u2014 user wants to keep their current view.\n  // The zoom-jump was disorienting, especially on large boards.\n  // frameTidiedSelection(selItems);\n\n  // --- Schedule auto-save ---\n  try { scheduleAutoSave(); } catch (e) {}\n\n  try {\n    toast('Tidied ' + selItems.length + ' items \u00B7 ' + Math.round(COL_W) + 'px columns'\n      + (_hasPlayer ? ' (media)' : ''));\n  } catch (e) {}\n}\n\n// Tidy all items on the board \u2014 select everything then run tidySelection\nfunction tidyAll() {\n  state.selected.clear();\n  [...state.items, ...state.texts, ...(state.todos||[]), ...(state.mindmaps||[])].forEach(function(i) {\n    state.selected.add(i.id);\n  });\n  tidySelection();\n}\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n//  VIDEO SEGMENT (TRIM) \u2014 v7.0.38\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// item.trimStart / item.trimEnd were already the single source of truth.\n// The player's timeupdate handler loops back to trimStart the moment it\n// passes trimEnd, the `play` handler re-seeds the playhead, and both values\n// serialise into .kpak. The feature was complete \u2014 it was just unreachable\n// unless you already knew that I and O work while the cursor happens to be\n// sitting on the seek bar. These are the front doors.\n\nfunction selectedVideoItems() {\n  const out = [];\n  (state.items || []).forEach(function (it) {\n    if (!it || !(it.isVideo || it.type === 'video')) return;\n    if (!state.selected || !state.selected.has(it.id)) return;\n    out.push(it);\n  });\n  return out;\n}\n\n// Repaint both trim strips (the mini bar under the controls and the handles\n// on the main seek bar) plus the right-hand panel timeline.\nfunction refreshTrimUIFor(items) {\n  (items || []).forEach(function (it) {\n    if (!it) return;\n    try {\n      if (it.el && typeof it.el._refreshInPlayerTrimUI === 'function') it.el._refreshInPlayerTrimUI();\n    } catch (e) {}\n    try {\n      if (typeof updateVideoTimeline === 'function') updateVideoTimeline(it);\n    } catch (e) {}\n  });\n}\n\n// v7.0.41 \u2014 ONE trim-marking implementation, shared by the context menu and\n// the I/O hotkey. They used to be two hand-rolled copies that disagreed about\n// the minimum segment length (0.1s vs 0.05s) and about whether the playhead\n// gets dragged along; the hotkey's copy also lacked an undo step entirely.\n//\n// clampTrimMark() is deliberately PURE \u2014 it reads and never writes, so a\n// caller can ask \"would this press actually change anything?\" before it\n// decides whether the press is worth an undo step. Being able to ask that\n// question is what makes the silent no-op fixable at all.\n\nvar TRIM_MIN_GAP = 0.05;   // shortest legal segment, seconds\n\n// The edge this call would overwrite, resolved the same way every reader in\n// the app resolves it: an unset or zero trimEnd means \"the whole clip\".\nfunction trimEdgeOf(it, which, dur) {\n  if (which === 'in') return (typeof it.trimStart === 'number') ? it.trimStart : 0;\n  return (typeof it.trimEnd === 'number' && it.trimEnd > 0) ? it.trimEnd : dur;\n}\n\nfunction clampTrimMark(it, which, t, dur) {\n  if (!isFinite(dur) || dur <= 0) return null;\n  let val = Math.max(0, Math.min(dur, (typeof t === 'number' && isFinite(t)) ? t : 0));\n  if (which === 'in') {\n    const te = (typeof it.trimEnd === 'number' && it.trimEnd > 0) ? it.trimEnd : dur;\n    val = Math.max(0, Math.min(val, Math.max(0, te - TRIM_MIN_GAP)));\n  } else {\n    const ts = (typeof it.trimStart === 'number') ? it.trimStart : 0;\n    val = Math.min(dur, Math.max(val, Math.min(dur, ts + TRIM_MIN_GAP)));\n  }\n  return val;\n}\n\nfunction applyTrimMark(it, which, val) {\n  // v7.0.44: this used to drag the playhead forward onto a new in point, on\n  // the grounds that the loop would do it on the next tick anyway. Two\n  // things were wrong. The loop no longer touches a paused playhead (see\n  // setupVideoTrim), and moving it parked the playhead EXACTLY on the mark\n  // \u2014 so the very next press of the other key read that same time back and\n  // produced a segment one minimum-gap long, with both handles glued\n  // together. Premiere leaves the playhead alone: moving a mark must not\n  // move your place in the clip.\n  if (which === 'in') { it.trimStart = val; } else { it.trimEnd = val; }\n}\n\n// \u2500\u2500 Conflicting marks (v7.0.44) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// A request that lands on or across the OPPOSITE mark is not a number to\n// clamp \u2014 it is a contradiction, and clamping it is precisely what glued\n// the two handles together. Asking for an out point at 0:08 when the in\n// point is 0:10 does not mean \"0:08\"; it means the 0:10 in point is no\n// longer the one you want. Clamping answers \"0:08\" with \"0:10.05\" and\n// leaves the user staring at a collapsed segment with nowhere to go.\n//\n// Premiere's answer is to refuse, and make you run Marker > Clear In or\n// Clear Out by hand. Krafted's answer is to clear the stale mark for you\n// and say so out loud: the range reopens, and the next press sets the\n// boundary you actually meant. One undo step restores both.\n//\n// The three clear commands Premiere puts in its Marker menu exist here too\n// \u2014 context menu, and Shift+I / Shift+O. The only difference is that a\n// contradictory press runs the clear for you instead of doing nothing.\nfunction markIsSet(it, which, dur) {\n  // \"Unset\" and \"sitting on the clip edge\" are the same state in this data\n  // model (see trimEdgeOf), so an unset mark must not be treated as\n  // something to clear \u2014 otherwise clearing it is a no-op that still\n  // consumes the press.\n  if (which === 'in') return (typeof it.trimStart === 'number' && it.trimStart > 0.001);\n  return (typeof it.trimEnd === 'number' && it.trimEnd > 0 &&\n          it.trimEnd < dur - 0.001);\n}\n\nfunction planTrimMark(it, which, t, dur) {\n  if (!isFinite(dur) || dur <= 0) return null;\n  const raw = Math.max(0, Math.min(dur, (typeof t === 'number' && isFinite(t)) ? t : 0));\n  const ts = trimEdgeOf(it, 'in', dur);\n  const te = trimEdgeOf(it, 'out', dur);\n  const conflict = (which === 'in') ? (raw >= te - TRIM_MIN_GAP)\n                                    : (raw <= ts + TRIM_MIN_GAP);\n  if (conflict && markIsSet(it, which === 'in' ? 'out' : 'in', dur)) {\n    return { which: which, val: raw, clearsOpp: true,\n             oppWas: (which === 'in') ? te : ts };\n  }\n  const val = clampTrimMark(it, which, raw, dur);\n  if (val == null) return null;\n  return { which: which, val: val, clearsOpp: false, oppWas: null };\n}\n\nfunction applyTrimPlan(it, plan, dur) {\n  if (!plan) return;\n  if (plan.clearsOpp) {\n    // Clearing sets the far edge to the clip boundary, which is how\n    // \"unset\" is spelled everywhere else in the app \u2014 trimEdgeOf, and the\n    // loadedmetadata handler in setupVideoTrim. No third state to sync.\n    if (plan.which === 'in') { it.trimStart = plan.val; it.trimEnd = dur; }\n    else { it.trimStart = 0; it.trimEnd = plan.val; }\n    return;\n  }\n  applyTrimMark(it, plan.which, plan.val);\n}\n\n// Brief flash on the matching handle \u2014 the only confirmation that a press\n// landed on THIS clip and THIS edge.\nfunction flashTrimHandle(it, which) {\n  if (!it || !it.el) return;\n  try {\n    const h = it.el.querySelector('.media-trim-mini .trim-handle-' + which);\n    if (!h) return;\n    h.classList.add('trim-handle-flash');\n    setTimeout(function () { try { h.classList.remove('trim-handle-flash'); } catch (e) {} }, 450);\n  } catch (e) {}\n}\n\nfunction setTrimFromPlayhead(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  // Plan the whole batch before touching anything: an undo step is only worth\n  // pushing if at least one clip actually moves.\n  const plan = [];\n  let skipped = 0;\n  vids.forEach(function (it) {\n    const v = it.video;\n    if (!v || !isFinite(v.duration) || v.duration <= 0) { skipped++; return; }\n    const t = Math.max(0, Math.min(v.duration, v.currentTime || 0));\n    const p = planTrimMark(it, which, t, v.duration);\n    if (!p) { skipped++; return; }\n    if (p.clearsOpp || Math.abs(p.val - trimEdgeOf(it, which, v.duration)) > 0.001) {\n      plan.push({ it: it, p: p, dur: v.duration });\n    }\n  });\n  if (!plan.length) {\n    try {\n      toast(skipped ? 'Video not ready yet'\n                    : 'Trim ' + which + ' is already at the playhead');\n    } catch (e) {}\n    return;\n  }\n  try { pushUndo(); } catch (e) {}\n  plan.forEach(function (e) { applyTrimPlan(e.it, e.p, e.dur); });\n  refreshTrimUIFor(plan.map(function (e) { return e.it; }));\n  try { scheduleAutoSave(); } catch (e) {}\n  const it0 = plan[0].it;\n  const v0 = it0.video;\n  const end0 = (it0.trimEnd && it0.trimEnd > 0) ? it0.trimEnd : (v0 ? v0.duration : 0);\n  try {\n    if (plan[0].p.clearsOpp) {\n      toast((which === 'in' ? 'Trim in ' : 'Trim out ') + formatTime(plan[0].p.val)\n        + ' \u00B7 ' + (which === 'in' ? 'out' : 'in') + ' ' + formatTime(plan[0].p.oppWas)\n        + ' cleared' + (plan.length > 1 ? ' \u00B7 ' + plan.length + ' clips' : ''));\n    } else {\n      toast((which === 'in' ? 'Trim in ' : 'Trim out ') + formatTime(plan[0].p.val)\n        + ' \u00B7 segment ' + formatTime(Math.max(0, end0 - (it0.trimStart || 0)))\n        + (plan.length > 1 ? ' \u00B7 ' + plan.length + ' clips' : ''));\n    }\n  } catch (e) {}\n}\n\n// v7.0.44: clear ONE mark. Premiere calls these Marker > Clear In and\n// Marker > Clear Out, and having only \"clear both\" meant that undoing half\n// a trim threw away the half that was right. Returns false when there was\n// nothing to act on, so the key dispatcher can leave the keystroke alone\n// instead of swallowing it.\nfunction clearTrimMark(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return false; }\n  try { pushUndo(); } catch (e) {}\n  vids.forEach(function (it) {\n    const dur = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n    if (which === 'in') { it.trimStart = 0; }\n    else { it.trimEnd = dur; }\n  });\n  refreshTrimUIFor(vids);\n  try { scheduleAutoSave(); } catch (e) {}\n  try {\n    toast((which === 'in' ? 'In' : 'Out') + ' point cleared \u00B7 '\n      + (which === 'in' ? 'clip starts at 0:00' : 'clip runs to the end'));\n  } catch (e) {}\n  return true;\n}\n\nfunction clearTrimSelected() {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  try { pushUndo(); } catch (e) {}\n  vids.forEach(function (it) {\n    it.trimStart = 0;\n    it.trimEnd = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n  });\n  refreshTrimUIFor(vids);\n  try { scheduleAutoSave(); } catch (e) {}\n  try { toast('Trim cleared \u00B7 full clip'); } catch (e) {}\n}\n\n// \u2500\u2500 I / O hotkey (v7.0.41) \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Where does the mark land? Two candidates, and the code now says which one\n// it picked:\n//   \u2022 the CURSOR, when it is over one of the clip's timeline strips \u2014 the\n//     seek bar or the trim mini-bar. Those are the only two things on a\n//     player that have a time axis.\n//   \u2022 the PLAYHEAD otherwise.\n//\n// The version this replaces read the cursor off the key event (e.clientX),\n// and two separate things went wrong there. Both present to the user as\n// \"it worked the first time, then stopped responding\":\n//\n//   1. A key event's clientX/clientY are 0 whenever the browser does not\n//      carry the pointer position on keyboard events, and they are 0 when\n//      the pointer has never moved. elementFromPoint(0, 0) is the <html>\n//      element, so the \"is the cursor on a timeline?\" test failed, the\n//      handler silently fell through to the playhead, and the press wrote\n//      back the value that was already there. The board already tracks the\n//      pointer on a document-level mousemove (state.mouse) and the hover\n//      test a few blocks down already trusts it \u2014 so does this now.\n//\n//   2. Even with a perfect cursor, the fallback was SILENT. The cursor is\n//      usually on the PICTURE \u2014 that is the frame you are judging \u2014 and a\n//      picture has no time axis. So the handler wrote the unchanged\n//      playhead back and reported success. The first press looks like it\n//      worked because the playhead happens to be wherever you just\n//      scrubbed it to; every press after that only moves the mouse, and\n//      the mouse is not the playhead.\n//\n// So the mark still follows the cursor when there is a cursor on a\n// timeline \u2014 but a press that would change nothing now says so, and says\n// how to change it.\n//\n// v7.0.44: the shrink-only guidance added in v7.0.42 is gone, because the\n// thing it was working around is fixed. It told the user to hover the seek\n// bar to expand, since that was the only way to reach a time the trap had\n// made unreachable. Nowhere is unreachable now \u2014 a paused playhead goes\n// anywhere \u2014 so the plain thing works and the special case does not need\n// explaining. What replaces it is the conflict rule above: a press that\n// lands on the other mark clears it instead of collapsing onto it.\n\n// Last known pointer position, or null when the pointer has never moved\n// (state.mouse starts at 0,0). A null here means \"pure keyboard press\".\nfunction _trimPointer() {\n  if (state && state.mouse && (state.mouse.x || state.mouse.y)) {\n    return { x: state.mouse.x, y: state.mouse.y };\n  }\n  return null;\n}\n\n// Time under the pointer on one of the clip's timeline strips, or null when\n// the pointer is somewhere with no time axis (the picture, the canvas, a\n// toolbar). Measured on the visible TRACK for precision, but accepted\n// anywhere inside the seek bar, so the 8px of vertical padding wrapped\n// around a 6px track still counts as \"on the timeline\".\nfunction trimTimeAtPointer(item) {\n  const pt = _trimPointer();\n  if (!pt || !item || !item.el || !item.video) return null;\n  const dur = item.video.duration;\n  if (!isFinite(dur) || dur <= 0) return null;\n  let node = null;\n  try { node = document.elementFromPoint(pt.x, pt.y); } catch (e) { return null; }\n  if (!node) return null;\n  const timeIn = function (barEl, trackSel) {\n    if (!barEl) return null;\n    if (node !== barEl && !barEl.contains(node)) return null;\n    const track = trackSel ? barEl.querySelector(trackSel) : null;\n    const rect = (track || barEl).getBoundingClientRect();\n    if (rect.width <= 0) return null;\n    return Math.max(0, Math.min(1, (pt.x - rect.left) / rect.width)) * dur;\n  };\n  const onSeek = timeIn(item.el.querySelector('.media-seek-bar'), '.media-seek-track');\n  if (onSeek != null) return onSeek;\n  return timeIn(item.el.querySelector('.media-trim-mini'), null);\n}\n\n// Returns true when the press was consumed (so the dispatcher can swallow\n// it), false when it was not a trim press at all.\nfunction trimHotkey(which) {\n  const vids = selectedVideoItems();\n  if (!vids.length) return false;\n  const it = vids[0];\n  const v = it.video;\n  if (!it.el || !v) return false;\n  // Intent gate: the pointer has to be on THIS clip's player. With no pointer\n  // at all (pure keyboard), the selection alone is the intent.\n  const pt = _trimPointer();\n  if (pt) {\n    let node = null;\n    try { node = document.elementFromPoint(pt.x, pt.y); } catch (e) { node = null; }\n    if (!node || (node !== it.el && !it.el.contains(node))) return false;\n  }\n  if (!isFinite(v.duration) || v.duration <= 0) {\n    try { toast('Video not ready yet'); } catch (e) {}\n    return true;\n  }\n  try { if (!v.paused) v.pause(); } catch (e) {}\n  const hoverT = trimTimeAtPointer(it);\n  const t = (hoverT != null) ? hoverT : (v.currentTime || 0);\n  const plan = planTrimMark(it, which, t, v.duration);\n  if (!plan) { try { toast('Video not ready yet'); } catch (e) {} return true; }\n  const currentEdge = trimEdgeOf(it, which, v.duration);\n  const moved = plan.clearsOpp || Math.abs(plan.val - currentEdge) > 0.001;\n\n  if (moved) {\n    try { pushUndo(); } catch (e) {}\n    applyTrimPlan(it, plan, v.duration);\n    refreshTrimUIFor([it]);\n    try { scheduleAutoSave(); } catch (e) {}\n  }\n  flashTrimHandle(it, which);\n  // A cleared mark moves the OTHER handle too. Flash it, or the change\n  // reads as the segment simply refusing to move.\n  if (plan.clearsOpp) { flashTrimHandle(it, which === 'in' ? 'out' : 'in'); }\n\n  const endT = (it.trimEnd && it.trimEnd > 0) ? it.trimEnd : v.duration;\n  try {\n    if (plan.clearsOpp) {\n      toast('Trim ' + which + ' ' + formatTime(plan.val)\n        + ' \u00B7 ' + (which === 'in' ? 'out' : 'in') + ' ' + formatTime(plan.oppWas)\n        + ' cleared \u2014 press ' + (which === 'in' ? 'O' : 'I') + ' to set a new one');\n    } else if (moved) {\n      toast('Trim ' + which + ' ' + formatTime(plan.val)\n        + ' \u00B7 segment ' + formatTime(Math.max(0, endT - (it.trimStart || 0)))\n        + (hoverT != null ? '  (at cursor)' : ''));\n    } else if (hoverT != null) {\n      toast('Trim ' + which + ' stays at ' + formatTime(plan.val) + ' \u2014 the cursor is already there.');\n    } else {\n      toast('Trim ' + which + ' stays at ' + formatTime(plan.val)\n        + ' \u2014 move the playhead (or the cursor) where you want it and press '\n        + (which === 'in' ? 'I' : 'O') + '.');\n    }\n  } catch (e) {}\n  return true;\n}\n\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n//  CONTACT SHEET (v7.0.38) \u2014 \u63D0\u6848 A\n// \u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\u2550\n// Pulls N evenly spaced stills out of a clip and lays them out as one\n// filmstrip image. This is the shot-level read a director wants: rhythm,\n// framing drift and lighting changes across a cut, all in one glance\n// instead of dragging the playhead back and forth.\n\nvar CONTACT_SHEET_COUNTS = [4, 6, 9, 12, 24];\nvar CONTACT_SHEET_CELL_W = 320;   // plenty for judging composition\nvar CONTACT_SHEET_SEEK_TIMEOUT = 12000;\nvar _cs = { itemId: null, count: 9, scope: 'trim', timecode: true, dataUrl: '', token: 0 };\n\n// Column counts chosen so the strip stays close to the source aspect\n// instead of collapsing into a tall thin column.\nfunction contactSheetColumns(count) {\n  if (count <= 4) return count;\n  if (count <= 6) return 3;\n  if (count <= 9) return 3;\n  if (count <= 12) return 4;\n  return 6;\n}\n\n// Always m:ss.cc in the exported pixels. The in-app formatTime() follows\n// the user's frame/time toggle, which would bake a preference into a\n// static image and make it wrong the moment they flip the toggle.\nfunction contactSheetTimecode(t) {\n  if (!isFinite(t)) return '0:00.00';\n  const m = Math.floor(t / 60);\n  const s = Math.floor(t % 60);\n  const cs = Math.floor((t * 100) % 100);\n  return m + ':' + String(s).padStart(2, '0') + '.' + String(cs).padStart(2, '0');\n}\n\nfunction _csItem() {\n  if (!_cs.itemId) return null;\n  const list = state.items || [];\n  for (let i = 0; i < list.length; i++) {\n    if (list[i] && list[i].id === _cs.itemId) return list[i];\n  }\n  return null;\n}\n\nfunction _csRange(item, scope) {\n  const v = item && item.video;\n  const dur = (v && isFinite(v.duration) && v.duration > 0) ? v.duration : 0;\n  if (scope !== 'trim') return { lo: 0, hi: dur };\n  const lo = Math.max(0, Math.min(dur, item.trimStart || 0));\n  const hi = (item.trimEnd && item.trimEnd > 0) ? Math.min(dur, item.trimEnd) : dur;\n  return { lo: lo, hi: Math.max(lo + 0.1, hi) };\n}\n\n// Frames are pulled from a SEPARATE video element, never from the item's\n// live player. Seeking the on-board element would yank the user's playhead\n// out from under them mid-review, and the media playback budget tracks that\n// element. The probe is detached and torn down the moment it is done.\nfunction buildContactSheet(item, opts) {\n  const o = opts || {};\n  const count = Math.max(1, Math.min(60, o.count || 9));\n  const withTC = o.timecode !== false;\n  const cols = contactSheetColumns(count);\n  const rows = Math.ceil(count / cols);\n\n  return new Promise(function (resolve, reject) {\n    const live = item && item.video;\n    const src = (live && live.src) || (item && item.src) || '';\n    if (!src) { reject(new Error('empty-src')); return; }\n\n    const v = makeVideoElement(src, { preload: 'auto', onError: false });\n    v.loop = false;\n    v.muted = true;\n\n    let settled = false;\n    const teardown = function () {\n      try { v.pause(); } catch (e) {}\n      // Never park a media element with removeAttribute('src') \u2014 see the\n      // media playback notes. This probe is thrown away entirely instead.\n    };\n    const fail = function (msg) {\n      if (settled) return;\n      settled = true;\n      teardown();\n      reject(new Error(msg));\n    };\n    v.addEventListener('error', function () {\n      const c = v.error ? v.error.code : 0;\n      fail(c === 4 ? 'codec' : ('load-' + c));\n    });\n\n    v.addEventListener('loadedmetadata', function () {\n      const dur = v.duration;\n      if (!isFinite(dur) || dur <= 0) { fail('no-duration'); return; }\n      const vw = v.videoWidth, vh = v.videoHeight;\n      if (!vw || !vh) { fail('no-frame'); return; }\n\n      const r = _csRange(item, o.scope);\n      const lo = Math.max(0, Math.min(dur, r.lo));\n      const hi = Math.max(lo + 0.1, Math.min(dur, r.hi || dur));\n\n      const cellW = CONTACT_SHEET_CELL_W;\n      const cellH = Math.round(cellW * (vh / vw));\n      const tcH = withTC ? 20 : 0;\n      const pad = 4;\n      const sheetW = cols * cellW + (cols + 1) * pad;\n      const sheetH = rows * (cellH + tcH) + (rows + 1) * pad;\n      // Same ceiling as board export: past ~16384px a side or ~268MP\n      // Chrome hands back a blank canvas and says nothing.\n      const budget = (typeof exportPixelBudget === 'function') ? exportPixelBudget(sheetW, sheetH, 1) : 1;\n      const s = Math.max(0.25, Math.min(1, budget));\n\n      const cv = document.createElement('canvas');\n      cv.width = Math.max(1, Math.round(sheetW * s));\n      cv.height = Math.max(1, Math.round(sheetH * s));\n      const ctx = cv.getContext('2d');\n      ctx.fillStyle = '#0d0d11';\n      ctx.fillRect(0, 0, cv.width, cv.height);\n      ctx.scale(s, s);\n\n      let i = 0;\n      const step = function () {\n        if (o.cancelled && o.cancelled()) { fail('cancelled'); return; }\n        if (i >= count) {\n          settled = true;\n          teardown();\n          let url = '';\n          try {\n            url = cv.toDataURL('image/jpeg', 0.9);\n          } catch (e) {\n            // Tainted canvas. A cross-origin clip without CORS headers\n            // still *plays* fine, it just cannot be read back out.\n            settled = false;\n            fail('cors');\n            return;\n          }\n          resolve({ dataUrl: url, width: cv.width, height: cv.height, count: count, cols: cols, rows: rows });\n          return;\n        }\n        const t = lo + (hi - lo) * ((i + 0.5) / count);\n        const idx = i;\n        let done = false;\n        const onSeeked = function () {\n          if (done) return;\n          done = true;\n          clearTimeout(timer);\n          v.removeEventListener('seeked', onSeeked);\n          try {\n            const cx = pad + (idx % cols) * (cellW + pad);\n            const cy = pad + Math.floor(idx / cols) * (cellH + tcH + pad);\n            ctx.drawImage(v, cx, cy, cellW, cellH);\n            if (withTC) {\n              ctx.fillStyle = 'rgba(0,0,0,0.72)';\n              ctx.fillRect(cx, cy + cellH, cellW, tcH);\n              ctx.fillStyle = '#00e5ff';\n              ctx.font = '600 13px Inter, sans-serif';\n              ctx.textBaseline = 'middle';\n              ctx.fillText(contactSheetTimecode(v.currentTime || t), cx + 6, cy + cellH + tcH / 2);\n            }\n          } catch (e) {}\n          i++;\n          if (o.onProgress) o.onProgress(i, count);\n          step();\n        };\n        // A seek can hang indefinitely on a codec the decoder dislikes.\n        // Without this the progress line would sit at \"3 / 24\" forever.\n        const timer = setTimeout(function () {\n          if (done) return;\n          done = true;\n          v.removeEventListener('seeked', onSeeked);\n          fail('seek-timeout');\n        }, CONTACT_SHEET_SEEK_TIMEOUT);\n        v.addEventListener('seeked', onSeeked);\n        try { v.currentTime = t; } catch (e) { clearTimeout(timer); fail('seek-failed'); }\n      };\n      step();\n    });\n  });\n}\n\nfunction openContactSheetDialog() {\n  const vids = selectedVideoItems();\n  if (!vids.length) { try { toast('Select a video first'); } catch (e) {} return; }\n  const it = vids[0];\n  if (!it) return;\n  const modal = document.getElementById('contact-sheet-modal');\n  if (!modal) { try { toast('Contact sheet unavailable'); } catch (e) {} return; }\n\n  _cs.itemId = it.id;\n  _cs.dataUrl = '';\n  if (CONTACT_SHEET_COUNTS.indexOf(_cs.count) < 0) _cs.count = 9;\n  // Default to the trimmed segment when there is one. The user trimmed it\n  // precisely because that is the part they care about.\n  const r = _csRange(it, 'trim');\n  const dur = (it.video && isFinite(it.video.duration)) ? it.video.duration : 0;\n  _cs.scope = (dur && (r.lo > 0.05 || r.hi < dur - 0.05)) ? 'trim' : 'all';\n\n  const sub = document.getElementById('cs-subtitle');\n  if (sub) {\n    sub.textContent = (it.filename || 'Clip') + ' \u00B7 '\n      + (dur ? contactSheetTimecode(dur) : 'loading') + ' total'\n      + (dur && _cs.scope === 'trim' ? ' \u00B7 segment ' + contactSheetTimecode(r.hi - r.lo) : '');\n  }\n  if (!modal._csWired) {\n    modal._csWired = true;\n    modal.addEventListener('mousedown', function (ev) {\n      if (ev.target === modal) closeContactSheet();\n    });\n    // Capture phase, because Escape is also bound to \"cancel / deselect\"\n    // on the document \u2014 without swallowing it here the sheet would close\n    // AND drop the user's selection in the same keystroke.\n    document.addEventListener('keydown', function (ev) {\n      if (ev.key === 'Escape' && modal.classList.contains('active')) {\n        ev.stopPropagation();\n        closeContactSheet();\n      }\n    }, true);\n  }\n\n  modal.classList.add('active');\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction syncContactSheetUI() {\n  const modal = document.getElementById('contact-sheet-modal');\n  if (!modal) return;\n  const counts = modal.querySelectorAll('.cs-preset[data-count]');\n  for (let i = 0; i < counts.length; i++) {\n    counts[i].classList.toggle('active', Number(counts[i].getAttribute('data-count')) === _cs.count);\n  }\n  const scopes = modal.querySelectorAll('.cs-preset[data-scope]');\n  for (let i = 0; i < scopes.length; i++) {\n    scopes[i].classList.toggle('active', scopes[i].getAttribute('data-scope') === _cs.scope);\n  }\n  const note = document.getElementById('cs-note');\n  if (note) note.textContent = contactSheetColumns(_cs.count) + ' \u00D7 ' + Math.ceil(_cs.count / contactSheetColumns(_cs.count));\n  const add = document.getElementById('cs-add-btn');\n  const save = document.getElementById('cs-save-btn');\n  if (add) add.disabled = !_cs.dataUrl;\n  if (save) save.disabled = !_cs.dataUrl;\n}\n\nfunction setContactSheetCount(n) {\n  if (_cs.count === n) return;\n  _cs.count = n;\n  _cs.dataUrl = '';\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction setContactSheetScope(s) {\n  if (_cs.scope === s) return;\n  _cs.scope = s;\n  _cs.dataUrl = '';\n  syncContactSheetUI();\n  renderContactSheet();\n}\n\nfunction renderContactSheet() {\n  const it = _csItem();\n  if (!it) return;\n  const prog = document.getElementById('cs-progress');\n  const cv = document.getElementById('cs-preview');\n  const tc = document.getElementById('cs-timecode');\n  _cs.timecode = tc ? !!tc.checked : true;\n  _cs.dataUrl = '';\n  syncContactSheetUI();\n\n  _cs.token++;\n  const token = _cs.token;\n  const cancelled = function () { return token !== _cs.token; };\n  if (prog) prog.textContent = 'Reading frames\u2026 0 / ' + _cs.count;\n\n  buildContactSheet(it, {\n    count: _cs.count,\n    scope: _cs.scope,\n    timecode: _cs.timecode,\n    cancelled: cancelled,\n    onProgress: function (i, n) {\n      if (cancelled()) return;\n      if (prog) prog.textContent = 'Reading frames\u2026 ' + i + ' / ' + n;\n    }\n  }).then(function (res) {\n    if (cancelled()) return;\n    _cs.dataUrl = res.dataUrl;\n    if (prog) prog.textContent = res.width + ' \u00D7 ' + res.height + ' px \u00B7 ' + res.cols + ' \u00D7 ' + res.rows;\n    syncContactSheetUI();\n    const img = new Image();\n    img.onload = function () {\n      if (cancelled()) return;\n      const c = cv.getContext('2d');\n      cv.width = img.width;\n      cv.height = img.height;\n      c.drawImage(img, 0, 0);\n      cv.style.display = 'block';\n    };\n    img.src = res.dataUrl;\n  }).catch(function (err) {\n    if (cancelled()) return;\n    const m = (err && err.message) || 'unknown';\n    const msg = (m === 'codec') ? 'This clip uses a codec the browser cannot decode \u2014 use H.264 MP4.'\n      : (m === 'cors') ? 'The clip is cross-origin, so its frames cannot be read into an image.'\n      : (m === 'seek-timeout') ? 'The clip took too long to seek \u2014 try a shorter range.'\n      : (m === 'no-frame') ? 'No frame available yet \u2014 play the clip once and try again.'\n      : (m === 'empty-src') ? 'The clip has no source loaded yet.'\n      : (m === 'cancelled') ? ''\n      : ('Could not build the sheet (' + m + ')');\n    if (prog) prog.textContent = msg;\n    if (msg) { try { toast(msg, 4500); } catch (e) {} }\n    syncContactSheetUI();\n  });\n}\n\nfunction contactSheetToBoard() {\n  if (!_cs.dataUrl) { try { toast('Nothing to add yet'); } catch (e) {} return; }\n  const it = _csItem();\n  if (!it) return;\n  const url = _cs.dataUrl;\n  const n = _cs.count;\n  const img = new Image();\n  img.onload = function () {\n    // item.h is the media box only \u2014 the player's controls bar hangs\n    // below it, so measuring the element is the only way to place the\n    // strip clear of the player instead of on top of it.\n    let belowY = it.y + (it.h || 0) + 24;\n    try {\n      if (it.el && it.el.getBoundingClientRect) {\n        const bcr = it.el.getBoundingClientRect();\n        if (bcr.height > 0) belowY = it.y + (bcr.height / (state.zoom || 1)) + 24;\n      }\n    } catch (e) {}\n    const w = Math.max(120, it.w || 640);\n    const h = Math.round(w * (img.height / img.width));\n    const newItem = addImage(url, img.width, img.height, it.x, belowY);\n    if (newItem) {\n      newItem.w = w;\n      newItem.h = h;\n      try { updateItemStyle(newItem); } catch (e) {}\n      try { updateCanvas(); } catch (e) {}\n    }\n    try { scheduleAutoSave(); } catch (e) {}\n    try { toast('Contact sheet added \u00B7 ' + n + ' frames'); } catch (e) {}\n    closeContactSheet();\n  };\n  img.onerror = function () { try { toast('Could not decode the sheet'); } catch (e) {} };\n  img.src = url;\n}\n\nfunction downloadContactSheet() {\n  if (!_cs.dataUrl) return;\n  const it = _csItem();\n  const base = (it && it.filename ? it.filename.replace(/\\.[^.]+$/, '') : 'clip') || 'clip';\n  try {\n    const a = document.createElement('a');\n    a.href = _cs.dataUrl;\n    a.download = base + '-contact-sheet-' + _cs.count + '.jpg';\n    document.body.appendChild(a);\n    a.click();\n    document.body.removeChild(a);\n  } catch (e) {\n    try { toast('Download failed'); } catch (e2) {}\n  }\n}\n\nfunction closeContactSheet() {\n  _cs.token++;   // cancels any in-flight frame read\n  const modal = document.getElementById('contact-sheet-modal');\n  if (modal) modal.classList.remove('active');\n  const cv = document.getElementById('cs-preview');\n  if (cv) cv.style.display = 'none';\n  const prog = document.getElementById('cs-progress');\n  if (prog) prog.textContent = '';\n  _cs.dataUrl = '';\n}\n\n// Helper: frame the viewport to show all tidied items.\n// Uses the _newW/_newH (scaled) dimensions from tidySelection for accurate\n// bounding box calculation, since item w/h may have been changed by tidy.\nfunction frameTidiedSelection(selItems) {\n  if (!selItems || selItems.length === 0) return;\n\n  var minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity;\n\n  for (var i = 0; i < selItems.length; i++) {\n    var si = selItems[i];\n    var nx = si._newX !== undefined ? si._newX : si.x;\n    var ny = si._newY !== undefined ? si._newY : si.y;\n    // Use the post-tidy scaled dimensions if available\n    var nw = si._newW !== undefined ? si._newW : si.w;\n    var nh = si._newH !== undefined ? si._newH : si.h;\n\n    if (nx < minX) minX = nx;\n    if (ny < minY) minY = ny;\n    if (nx + nw > maxX) maxX = nx + nw;\n    if (ny + nh > maxY) maxY = ny + nh;\n  }\n\n  if (!isFinite(minX) || !isFinite(maxX)) return;\n\n  // Clamp degenerate selections\n  if (maxX - minX < 1) { minX -= 40; maxX += 40; }\n  if (maxY - minY < 1) { minY -= 30; maxY += 30; }\n\n  var bboxCx = (minX + maxX) / 2;\n  var bboxCy = (minY + maxY) / 2;\n  var bboxW  = maxX - minX;\n  var bboxH  = maxY - minY;\n  var PADDING = 1.24;\n  var sw = window.innerWidth;\n  var sh = window.innerHeight;\n  var targetW = bboxW * PADDING;\n  var targetH = bboxH * PADDING;\n\n  var z = Math.min(sw / Math.max(1, targetW), sh / Math.max(1, targetH));\n  z = Math.max(0.02, Math.min(10, z));\n  state.zoom = z;\n  state.pan.x = sw / 2 - bboxCx * state.zoom;\n  state.pan.y = sh / 2 - bboxCy * state.zoom;\n  try { updateCanvas(); } catch (e) {}\n}\n\n\n// ==== add-items.js ====\n\n\n// ============================================================\nfunction addImage(src, natW, natH, x, y, isVideoFlag, isLast, fileSize, isGifFlag, sourceBlob) {\n  // BATCH MODE (isLast defined): caller manages the batch undo (push it ONCE at start),\n  // so we skip pushUndo here. We only call selectOnly on the last item so the final dropped\n  // image is the active selection. This prevents memory crash from N parallel FileReader/\n  // Image decodes and N JSON snapshot bloat in the undo stack.\n  // SINGLE MODE (isLast undefined): backward compat \u2014 push undo + select as before.\n  const isBatch = (isLast !== undefined);\n  if (!isBatch) pushUndo();\n  const isVideo = !!isVideoFlag;\n  // Bigger default for video so the player controls bar has room for all buttons\n  // including the 30 fps / fullscreen controls on the right.\n  const maxW = isVideo ? 1100 : 720;\n  let w = natW, h = natH;\n  if (w > maxW) { h = h * (maxW / w); w = maxW; }\n  const el = document.createElement('div');\n  el.className = 'item';\n  let mediaEl;\n  if (isVideo) {\n    // v7.0.37 \u2014 P2: shared builder. preload stays 'auto' here: a fresh blob\n    // is already fully in memory, so buffering it costs no network I/O and\n    // v6.1.13 measured that high-bitrate clips need it.\n    mediaEl = makeVideoElement(src, { preload: 'auto' });\n    mediaEl.style.cssText = 'display:block;width:100%;height:100%;pointer-events:none;background:#000;object-fit:contain;will-change:transform;';\n  } else {\n    mediaEl = document.createElement('img');\n    mediaEl.src = src;\n    mediaEl.style.cssText = 'display:block;width:100%;height:100%;pointer-events:none;';\n  }\n  mediaEl.draggable = false;\n  // \u2500\u2500 Video / GIF: use buildMediaControls helper \u2500\u2500\n  const isAnimatedGifSrc = isGifFlag || (!isVideo && isAnimatedGif(src));\n  if (isVideo) {\n    buildMediaControls(el, mediaEl, true, false);\n  } else if (isAnimatedGifSrc) {\n    // GIF: plain image append (no video player), freeze handled below\n    el.appendChild(mediaEl);\n  } else {\n    // Plain image: media goes directly in .item\n    el.appendChild(mediaEl);\n  }\n  canvasContent.appendChild(el);\n  const item = {\n    id: G.nextId++, el, img: isVideo ? null : mediaEl, video: isVideo ? mediaEl : null,\n    x: x !== undefined ? x : (window.innerWidth/2 - w/2 - state.pan.x) / state.zoom,\n    y: y !== undefined ? y : (window.innerHeight/2 - h/2 - state.pan.y) / state.zoom,\n    w, h, rot: 0, opacity: 1, flipH: false, flipV: false, locked: false,\n    z: G.nextZ++,\n    src, natW, natH, isVideo: isVideo, isGif: isAnimatedGifSrc,\n    // v6.8.29: retain an in-memory image Blob when available. Screenshot\n    // clipboard object URLs can fail later with Chrome ERR_UPLOAD_FILE_CHANGED;\n    // KPAK save uses this stable Blob directly instead of refetching src.\n    _sourceBlob: (sourceBlob instanceof Blob) ? sourceBlob : null,\n    // Original file name (for video/image export naming & display). Set by\n    // callers (drag-drop, paste) when known. Empty when not available.\n    filename: '',\n    cropX: 0, cropY: 0, cropW: natW, cropH: natH,\n    brightness: 100, contrast: 100, saturate: 100, hueRotate: 0, blur: 0, sepia: 0, grayscale: 0,\n    temp: 0, vignette: 0, shadow: 100, highlight: 100, grain: 0,\n    trimStart: 0, trimEnd: 0, playbackRate: 1,\n  };\n  state.items.push(item);\n  // Stash the item on its DOM element so closures defined inside the\n  // top-level `buildMediaControls` function (which cannot close over `item`\n  // from this function's scope) can look it up via `el._item` at event time.\n  el._item = item;\n  updateItemStyle(item);\n  if (isBatch ? isLast : true) selectOnly(item.id);\n  if (isVideo) { setupVideoTrim(item); }\n  // v6.1.12: When video is added with estimated/default dimensions\n  // (high-bitrate files skip the temp-video metadata wait), update\n  // the item's natW/natH once the real metadata loads asynchronously.\n  if (isVideo && mediaEl) {\n    var _metaHandler = function() {\n      mediaEl.removeEventListener('loadedmetadata', _metaHandler);\n      var vw = mediaEl.videoWidth || 0;\n      var vh = mediaEl.videoHeight || 0;\n      if (vw && vh && (vw !== item.natW || vh !== item.natH)) {\n        item.natW = vw; item.natH = vh;\n        // Recalculate display size preserving the same max-width constraint\n        var maxW = 1100;\n        var w2 = vw, h2 = vh;\n        if (w2 > maxW) { h2 = h2 * (maxW / w2); w2 = maxW; }\n        item.w = w2; item.h = h2;\n        updateItemStyle(item);\n        scheduleAutoSave();\n      }\n    };\n    mediaEl.addEventListener('loadedmetadata', _metaHandler);\n  }\n  // Round 13: sync the file name pill on the player. The badge is\n  // created in buildMediaControls with an empty name (because the\n  // item didn't exist yet). Now that the item is in hand, set the\n  // badge to item.filename if known. The drag-drop / paste callers\n  // may set item.filename AFTER addImage returns, in which case\n  // they'll call el._setFilenameBadge themselves.\n  if (el._setFilenameBadge) {\n    try { el._setFilenameBadge(item.filename || ''); } catch (e) {}\n  }\n  // Initial badge sync for the new item (buildMediaControls couldn't run it\n  // because `item` wasn't defined yet during the build). Use the stash ref\n  // on the .item element so we call the right item's closure.\n  if (isVideo && el._refreshAnnoBadges) {\n    try { el._refreshAnnoBadges(); } catch (e) {}\n  }\n  if (isVideo && el._refreshSeekMarkers) {\n    // Try once now, and again once metadata is loaded (for fresh items).\n    try { el._refreshSeekMarkers(); } catch (e) {}\n    if (el.video) {\n      el.video.addEventListener('loadedmetadata', function _mk(){\n        el.video.removeEventListener('loadedmetadata', _mk);\n        try { el._refreshSeekMarkers(); } catch (e) {}\n      });\n    }\n  }\n  // v6.2.11: freeze animated GIFs on import so they don't auto-play.\n  // The user double-clicks to play/pause (handled in buildMediaControls).\n  // Must wait for the img to finish decoding before drawImage, otherwise\n  // the canvas comes out blank and the GIF keeps animating.\n  // GIFs are tricky: img.complete can be true while naturalWidth is still 0\n  // (browser is still parsing the GIF frames). We poll with rAF until ready.\n  if (isAnimatedGifSrc && item.img) {\n    var _gifFreezeAttempts = 0;\n    var _gifFreezeTarget = item;  // capture item ref for closure\n    var _tryFreezeGif = function() {\n      _gifFreezeAttempts++;\n      if (_gifFreezeTarget.img.naturalWidth > 0 && _gifFreezeTarget.img.naturalHeight > 0) {\n        try {\n          var _c = document.createElement('canvas');\n          _c.width = _gifFreezeTarget.img.naturalWidth;\n          _c.height = _gifFreezeTarget.img.naturalHeight;\n          var _cctx = _c.getContext('2d');\n          _cctx.drawImage(_gifFreezeTarget.img, 0, 0);\n          var _staticSrc = _c.toDataURL('image/png');\n          _frozenGifs.set(_gifFreezeTarget.id, _gifFreezeTarget.img.src);\n          _gifFreezeTarget.img.src = _staticSrc;\n          _gifFreezeTarget._userFrozen = true;\n        } catch(e) { console.warn('[GIF freeze] failed:', e.message); }\n        return;\n      }\n      if (_gifFreezeAttempts < 100) {\n        requestAnimationFrame(_tryFreezeGif);\n      }\n    };\n    requestAnimationFrame(_tryFreezeGif);\n    // Double-click to toggle play/pause\n    el.addEventListener('dblclick', function(ev) {\n      ev.stopPropagation();\n      var it = state.items.find(function(i) { return i.el === el; });\n      if (it) toggleMediaItem(it.id);\n    });\n  }\n  scheduleAutoSave();\n  updateMediaBar();\n  updateAutoFitPaper();\n  // Apply viewport culling to new item (force-refresh cull state on every add)\n  if (typeof cullOffscreenItems === 'function') {\n    // Reset cache so the new item is always evaluated\n    _cullLast.vx = -1e9;\n    cullOffscreenItems();\n  }\n  // v6.2: store file size for pre-save size estimation\n  if (fileSize && fileSize > 0) item._fileSize = fileSize;\n  return item;\n}\nfunction addVideoItem(src, natW, natH, x, y) {\n  return addImage(src, natW, natH, x, y, true);\n}\n\n// ============================================================\n//  LINK CARDS \u2014 paste a URL, get a preview cover, click to open\n// ============================================================\nfunction openLinkModal() {\n  hideWelcome();\n  const modal = document.getElementById('link-modal');\n  const input = document.getElementById('link-url-input');\n  modal.classList.add('active');\n  input.value = '';\n  setTimeout(() => input.focus(), 50);\n}\nfunction closeLinkModal() {\n  document.getElementById('link-modal').classList.remove('active');\n  document.getElementById('link-loading-msg').style.display = 'none';\n}\nfunction confirmLinkModal() {\n  const input = document.getElementById('link-url-input');\n  let url = input.value.trim();\n  if (!url) return;\n  // Auto-add https:// if missing\n  if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;\n  closeLinkModal();\n  addLinkCard(url);\n}\n\nfunction extractYouTubeId(url) {\n  const patterns = [\n    /(?:youtube\\.com\\/watch\\?v=|youtu\\.be\\/|youtube\\.com\\/embed\\/|youtube\\.com\\/shorts\\/)([a-zA-Z0-9_-]{11})/,\n  ];\n  for (const p of patterns) {\n    const m = url.match(p);\n    if (m) return m[1];\n  }\n  return null;\n}\n\nfunction extractBilibiliId(url) {\n  // BV ID: bilibili.com/video/BV1xx411c7mD\n  const bvMatch = url.match(/bilibili\\.com\\/video\\/(BV[a-zA-Z0-9]+)/);\n  if (bvMatch) return { type: 'bvid', id: bvMatch[1] };\n  // AV ID: bilibili.com/video/av12345678\n  const avMatch = url.match(/bilibili\\.com\\/video\\/av(\\d+)/i);\n  if (avMatch) return { type: 'aid', id: avMatch[1] };\n  // Short URL: b23.tv/xxxxxxx\n  const shortMatch = url.match(/b23\\.tv\\/([a-zA-Z0-9]+)/);\n  if (shortMatch) return { type: 'short', id: shortMatch[1] };\n  return null;\n}\n\nfunction getHostname(url) {\n  try { return new URL(url).hostname.replace(/^www\\./, ''); } catch(e) { return url; }\n}\n\nfunction addLinkCard(url, opts) {\n  pushUndo();\n  const linkUrl = url;\n  const hostname = getHostname(url);\n  const placeX = (opts && opts.x !== undefined) ? opts.x : (window.innerWidth/2 - 200 - state.pan.x) / state.zoom;\n  const placeY = (opts && opts.y !== undefined) ? opts.y : (window.innerHeight/2 - 150 - state.pan.y) / state.zoom;\n  const w = 400, h = 300;\n\n  const el = document.createElement('div');\n  el.className = 'item link-card';\n  canvasContent.appendChild(el);\n\n  // Placeholder shown while fetching\n  const placeholder = document.createElement('div');\n  placeholder.className = 'link-placeholder';\n  placeholder.innerHTML = '<div class=\"link-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 9.5l3-3M6 10l-1 1a2 2 0 01-3-3l2-2a2 2 0 013 0M10 6l1-1a2 2 0 013 3l-2 2a2 2 0 01-3 0\"/></svg></div><div class=\"link-text\">' + hostname + '</div>';\n  el.appendChild(placeholder);\n\n  const item = {\n    id: G.nextId++, el, img: null, video: null,\n    x: placeX, y: placeY, w, h, rot: 0, opacity: 1, flipH: false, flipV: false, locked: false,\n    z: G.nextZ++,\n    src: '', natW: 400, natH: 300, isVideo: false,\n    isLink: true, linkUrl, linkTitle: hostname, linkDesc: '',\n    cropX: 0, cropY: 0, cropW: 400, cropH: 300,\n    brightness: 100, contrast: 100, saturate: 100, hueRotate: 0, blur: 0, sepia: 0, grayscale: 0,\n    temp: 0, vignette: 0, shadow: 100, highlight: 100, grain: 0,\n    trimStart: 0, trimEnd: 0, playbackRate: 1,\n  };\n  state.items.push(item);\n  updateItemStyle(item);\n  selectOnly(item.id);\n\n  // Double-click opens the link\n  el.addEventListener('dblclick', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n\n  // Try to fetch cover image\n  fetchLinkCover(url, el, item, placeholder);\n  scheduleAutoSave();\n  updateAutoFitPaper();\n  return item;\n}\n\nfunction fetchLinkCover(url, el, item, placeholder) {\n  const ytId = extractYouTubeId(url);\n  if (ytId) {\n    // YouTube \u2014 use thumbnail directly (no API needed)\n    const coverUrl = 'https://img.youtube.com/vi/' + ytId + '/hqdefault.jpg';\n    const title = 'YouTube Video';\n    applyLinkCover(el, item, placeholder, coverUrl, title, 480, 360, url);\n    return;\n  }\n  const biliId = extractBilibiliId(url);\n  if (biliId) {\n    // Bilibili \u2014 fetch video info via CORS proxy\n    if (biliId.type === 'short') {\n      // b23.tv short URL \u2014 need to resolve redirect first to get BV ID\n      fetchBilibiliShort(url, el, item, placeholder);\n      return;\n    }\n    fetchBilibiliVideoInfo(biliId, url, el, item, placeholder);\n    return;\n  }\n  // Other URLs \u2014 try microlink.io API\n  fetchMicrolink(url, el, item, placeholder);\n}\n\nfunction fetchBilibiliShort(url, el, item, placeholder) {\n  // Resolve b23.tv short URL to get the full URL (which contains BV ID)\n  // Try multiple CORS proxies in parallel, fastest wins\n  var proxyUrls = [\n    'https://corsproxy.io/?' + encodeURIComponent(url),\n    'https://api.allorigins.win/get?url=' + encodeURIComponent(url),\n    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(url),\n    'https://cors-anywhere.herokuapp.com/' + url\n  ];\n\n  var fetchWithTimeout = function(u) {\n    return new Promise(function(resolve, reject) {\n      var controller = new AbortController();\n      var timer = setTimeout(function() { controller.abort(); reject(new Error('timeout')); }, 8000);\n      fetch(u, { signal: controller.signal })\n        .then(function(r) {\n          clearTimeout(timer);\n          resolve(r);\n        })\n        .catch(function(e) { clearTimeout(timer); reject(e); });\n    });\n  };\n\n  Promise.any(proxyUrls.map(fetchWithTimeout))\n    .then(function(r) {\n      // Try to determine the resolved URL\n      if (r.redirected) {\n        onShortResolved(r.url);\n      } else {\n        // Might be allorigins /get JSON response \u2014 try parsing\n        r.json().then(function(data) {\n          onShortResolved((data.status && data.status.url) || url);\n        }).catch(function() {\n          onShortResolved(url);\n        });\n      }\n    })\n    .catch(function() {\n      onShortResolved(url);\n    });\n\n  function onShortResolved(resolvedUrl) {\n    var biliId = extractBilibiliId(resolvedUrl);\n    if (biliId && biliId.type !== 'short') {\n      fetchBilibiliVideoInfo(biliId, url, el, item, placeholder);\n    } else {\n      fetchMicrolink(url, el, item, placeholder);\n    }\n  }\n}\n\nfunction fetchBilibiliVideoInfo(biliId, originalUrl, el, item, placeholder) {\n  let apiUrl;\n  if (biliId.type === 'bvid') apiUrl = 'https://api.bilibili.com/x/web-interface/view?bvid=' + biliId.id;\n  else if (biliId.type === 'aid') apiUrl = 'https://api.bilibili.com/x/web-interface/view?aid=' + biliId.id;\n  else { fetchMicrolink(originalUrl, el, item, placeholder); return; }\n\n  // Multiple CORS proxies \u2014 tried in parallel, fastest wins\n  var proxyUrls = [\n    'https://corsproxy.io/?' + encodeURIComponent(apiUrl),\n    'https://api.allorigins.win/raw?url=' + encodeURIComponent(apiUrl),\n    'https://api.codetabs.com/v1/proxy?quest=' + encodeURIComponent(apiUrl),\n    'https://cors-anywhere.herokuapp.com/' + apiUrl,\n    'https://thingproxy.freeboard.io/fetch/' + apiUrl\n  ];\n\n  var fetchWithTimeout = function(url) {\n    return new Promise(function(resolve, reject) {\n      var controller = new AbortController();\n      var timer = setTimeout(function() { controller.abort(); reject(new Error('timeout')); }, 8000);\n      fetch(url, { signal: controller.signal })\n        .then(function(r) {\n          clearTimeout(timer);\n          if (!r.ok) { reject(new Error('status ' + r.status)); return; }\n          r.json().then(resolve).catch(reject);\n        })\n        .catch(function(e) { clearTimeout(timer); reject(e); });\n    });\n  };\n\n  Promise.any(proxyUrls.map(fetchWithTimeout))\n    .then(function(data) {\n      if (data && data.code === 0 && data.data) {\n        var coverUrl = data.data.pic || '';\n        var title = data.data.title || 'Bilibili Video';\n        var desc = data.data.desc || '';\n        if (coverUrl) {\n          // Bilibili CDN blocks hotlinking via Referer \u2014 use no-referrer\n          applyLinkCover(el, item, placeholder, coverUrl, title, 400, 300, originalUrl, desc, true);\n        } else {\n          applyLinkPlaceholder(el, item, placeholder, title, originalUrl);\n        }\n      } else {\n        fetchMicrolink(originalUrl, el, item, placeholder);\n      }\n    })\n    .catch(function() {\n      // All proxies failed \u2014 fallback to microlink\n      fetchMicrolink(originalUrl, el, item, placeholder);\n    });\n}\n\n// FIX-v6.0.1: use safeFetch and add json parse error handling\nfunction fetchMicrolink(url, el, item, placeholder) {\n  safeFetch('https://api.microlink.io/?url=' + encodeURIComponent(url))\n    .then(function(r) {\n      if (!r.ok) throw new Error('HTTP ' + r.status);\n      return r.json();\n    })\n    .then(function(data) {\n      if (data.status === 'success' && data.data) {\n        const coverUrl = (data.data.image && data.data.image.url) ||\n                         (data.data.screenshot && data.data.screenshot.url) || '';\n        const title = data.data.title || getHostname(url);\n        const desc = data.data.description || '';\n        const imgW = (data.data.image && data.data.image.width) || 400;\n        const imgH = (data.data.image && data.data.image.height) || 300;\n        if (coverUrl) {\n          applyLinkCover(el, item, placeholder, coverUrl, title, imgW, imgH, url, desc);\n        } else {\n          applyLinkPlaceholder(el, item, placeholder, title, url);\n        }\n      } else {\n        applyLinkPlaceholder(el, item, placeholder, getHostname(url), url);\n      }\n    })\n    .catch(function(err) {\n      console.warn('[fetchMicrolink] Failed:', err.message);\n      applyLinkPlaceholder(el, item, placeholder, getHostname(url), url);\n    });\n}\n\nfunction applyLinkCover(el, item, placeholder, coverUrl, title, imgW, imgH, url, desc, noCors) {\n  const img = new Image();\n  if (!noCors) img.crossOrigin = 'anonymous';\n  // Set no-referrer to bypass hotlink protection (e.g. Bilibili CDN blocks foreign Referer)\n  img.referrerPolicy = 'no-referrer';\n  img.onload = () => {\n    // Remove placeholder\n    if (placeholder && placeholder.parentNode) placeholder.remove();\n    // Create img element\n    const mediaEl = document.createElement('img');\n    mediaEl.src = coverUrl;\n    mediaEl.referrerPolicy = 'no-referrer';\n    mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n    mediaEl.draggable = false;\n    el.insertBefore(mediaEl, el.firstChild);\n    item.img = mediaEl;\n    item.src = coverUrl;\n    item.natW = img.naturalWidth || imgW;\n    item.natH = img.naturalHeight || imgH;\n    item.linkTitle = title;\n    item.linkDesc = desc || '';\n    // Adjust aspect ratio\n    const aspect = item.natW / item.natH;\n    item.w = 720;\n    item.h = Math.round(720 / aspect);\n    updateItemStyle(item);\n    // Add overlay elements\n    addLinkOverlay(el, item);\n    refreshSelection();\n    scheduleAutoSave();\n    updateAutoFitPaper();\n    toast('Link card added: ' + title);\n  };\n  img.onerror = () => {\n    // If direct load fails, try loading through an image proxy as last resort\n    const proxiedCoverUrl = 'https://images.weserv.nl/?url=' + encodeURIComponent(coverUrl.replace(/^https?:\\/\\//, ''));\n    const img2 = new Image();\n    img2.referrerPolicy = 'no-referrer';\n    img2.onload = () => {\n      if (placeholder && placeholder.parentNode) placeholder.remove();\n      const mediaEl = document.createElement('img');\n      mediaEl.src = proxiedCoverUrl;\n      mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n      mediaEl.draggable = false;\n      el.insertBefore(mediaEl, el.firstChild);\n      item.img = mediaEl;\n      item.src = proxiedCoverUrl;\n      item.natW = img2.naturalWidth || imgW;\n      item.natH = img2.naturalHeight || imgH;\n      item.linkTitle = title;\n      item.linkDesc = desc || '';\n      const aspect = item.natW / item.natH;\n      item.w = 720;\n      item.h = Math.round(720 / aspect);\n      updateItemStyle(item);\n      addLinkOverlay(el, item);\n      refreshSelection();\n      scheduleAutoSave();\n      updateAutoFitPaper();\n      toast('Link card added: ' + title);\n    };\n    img2.onerror = () => {\n      applyLinkPlaceholder(el, item, placeholder, title, url);\n    };\n    img2.src = proxiedCoverUrl;\n  };\n  img.src = coverUrl;\n}\n\nfunction applyLinkPlaceholder(el, item, placeholder, title, url) {\n  if (placeholder) {\n    placeholder.querySelector('.link-text').textContent = title || getHostname(url);\n  }\n  item.linkTitle = title || getHostname(url);\n  item.src = '';\n  addLinkOverlay(el, item);\n  refreshSelection();\n  scheduleAutoSave();\n  toast('Link added (no preview available)');\n}\n\nfunction addLinkOverlay(el, item) {\n  // Remove existing overlay if any\n  const existing = el.querySelectorAll('.link-overlay, .link-badge, .link-open-btn');\n  existing.forEach(e => e.remove());\n  // Info overlay at bottom\n  // FIX-v6.0.1: use textContent for user-controlled linkTitle to prevent XSS\n  const overlay = document.createElement('div');\n  overlay.className = 'link-overlay';\n  var titleDiv = document.createElement('div');\n  titleDiv.className = 'link-title';\n  titleDiv.textContent = item.linkTitle || '';\n  overlay.appendChild(titleDiv);\n  var urlDiv = document.createElement('div');\n  urlDiv.className = 'link-url';\n  urlDiv.textContent = getHostname(item.linkUrl);\n  overlay.appendChild(urlDiv);\n  el.appendChild(overlay);\n  // Badge\n  const badge = document.createElement('div');\n  badge.className = 'link-badge';\n  badge.textContent = 'LINK';\n  el.appendChild(badge);\n  // Hover open button\n  const openBtn = document.createElement('div');\n  openBtn.className = 'link-open-btn';\n  openBtn.innerHTML = 'Open Link';\n  openBtn.addEventListener('click', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n  el.appendChild(openBtn);\n}\n\nfunction openSelectedLink() {\n  const sel = getSelectedItems();\n  if (sel.length > 0 && sel[0].isLink && sel[0].linkUrl) {\n    window.open(sel[0].linkUrl, '_blank', 'noopener,noreferrer');\n  }\n}\n\n// Rebuild link overlay when restoring from saved state\nfunction rebuildLinkCard(item) {\n  const el = item.el;\n  el.className = 'item link-card';\n  if (item.src) {\n    // Has cover image \u2014 recreate it\n    const mediaEl = document.createElement('img');\n    mediaEl.src = item.src;\n    mediaEl.referrerPolicy = 'no-referrer';\n    mediaEl.style.cssText = ITEM_IMG_BASE_CSS;\n    mediaEl.draggable = false;\n    el.appendChild(mediaEl);\n    item.img = mediaEl;\n  } else {\n    // No cover \u2014 show placeholder\n    // FIX-v6.0.1: use textContent for linkTitle, keep SVG as innerHTML\n    const placeholder = document.createElement('div');\n    placeholder.className = 'link-placeholder';\n    placeholder.innerHTML = '<div class=\"link-icon\"><svg width=\"18\" height=\"18\" viewBox=\"0 0 16 16\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.5\" stroke-linecap=\"round\" stroke-linejoin=\"round\"><path d=\"M6.5 9.5l3-3M6 10l-1 1a2 2 0 01-3-3l2-2a2 2 0 013 0M10 6l1-1a2 2 0 013 3l-2 2a2 2 0 01-3 0\"/></svg></div>';\n    var textDiv = document.createElement('div');\n    textDiv.className = 'link-text';\n    textDiv.textContent = item.linkTitle || getHostname(item.linkUrl);\n    placeholder.appendChild(textDiv);\n    el.appendChild(placeholder);\n  }\n  addLinkOverlay(el, item);\n  // Double-click opens the link\n  el.addEventListener('dblclick', (e) => {\n    e.preventDefault();\n    e.stopPropagation();\n    window.open(item.linkUrl, '_blank', 'noopener,noreferrer');\n  });\n}\n// v6.8.2: single source of truth for text-item event wiring.\n// Previously addText() and the undo-restore path each hand-rolled their own\n// copy of these three listeners, and the two copies had drifted:\n// restore was missing updateTextColorPalette() (stale colour swatches after\n// an undo) and updateAutoFitPaper() (paper bounds not recomputed on blur).\n// Both paths now call this, so they can never diverge again.\nfunction serializeBoardText(t) {\n  const out = normalizeBoardTextMeta({\n    id: t.id, x: t.x, y: t.y, w: t.w, h: t.h, z: t.z,\n    rot: t.rot, opacity: t.opacity, locked: t.locked,\n    font: t.font, size: t.size, bold: t.bold, italic: t.italic,\n    underline: t.underline, strike: t.strike, highlight: t.highlight,\n    shadow: t.shadow, bg: t.bg, outline: t.outline, uppercase: t.uppercase,\n    color: t.color, highlightColor: t.highlightColor, align: t.align,\n    // \u5B9E\u65F6 DOM \u4F18\u5148\uFF1B\u65E0 DOM \u65F6\u4FDD\u7559\u5DF2\u6709 HTML \u6216\u7EAF\u6B63\u6587\uFF0C\u6B63\u6587\u4E0D\u4F5C\u4E3A HTML \u63D2\u5165\u3002\n    html: t.el ? t.el.innerHTML : (typeof t.html === 'string' ? t.html : ''),\n    content: t.el ? t.el.textContent : (typeof t.content === 'string' ? t.content : ''),\n    userResized: t.userResized || false,\n    _autoGrowLocked: t._autoGrowLocked || false,\n    _textZoom: 1,\n  }, t);\n  // v7.18.0: doc-card identity plus the original markdown, set AFTER\n  // normalizeBoardTextMeta. That helper reads its defaults from the live\n  // item (its second argument), so anything written into the literal\n  // above is a second copy of the same coercion that it then overwrites.\n  // The tell was mutation: breaking those literal fields changed nothing.\n  out.docCard = !!t.docCard;\n  out.mdMode = (t.mdMode === 'rendered' || t.mdMode === 'source') ? t.mdMode : '';\n  out.mdSrc = typeof t.mdSrc === 'string' ? t.mdSrc : '';\n  return out;\n}\n\nfunction normalizeBoardTextMeta(tx, data) {\n  data = data || {};\n  tx.name = typeof data.name === 'string' ? data.name : '';\n  tx.note = typeof data.note === 'string' ? data.note : '';\n  var tags = Array.isArray(data.tags) ? data.tags\n    : (typeof data.tags === 'string' ? splitTags(data.tags) : []);\n  // \u6BCF\u6B21\u751F\u6210\u72EC\u7ACB\u6570\u7EC4\uFF1B\u53EA\u89C4\u8303\u5316 metadata\uFF0C\u4E0D\u5E94\u7528\u9884\u8BBE\u6216\u6539\u53D8\u51E0\u4F55\u3001\u6837\u5F0F\u3002\n  tx.tags = tags.filter(function (tag) { return typeof tag === 'string'; })\n    .map(function (tag) { return tag.trim(); })\n    .filter(function (tag) { return tag.length > 0; });\n  tx.textPreset = typeof data.textPreset === 'string' ? data.textPreset : '';\n  // v7.18.0: doc-card flags. Restored from whatever the file carried, so a\n  // reloaded or undone card comes back as the same kind of card it was.\n  tx.docCard = !!data.docCard;\n  tx.mdMode = (data.mdMode === 'rendered' || data.mdMode === 'source') ? data.mdMode : '';\n  tx.mdSrc = typeof data.mdSrc === 'string' ? data.mdSrc : '';\n  return tx;\n}\n\n// Board Text: one edit lifecycle; controls remain outside the editable DOM.\nfunction boardTextIsComposing(e, el) {\n  return !!(e.isComposing || e.keyCode === 229 || (el && el._btComposing));\n}\nfunction beginBoardTextUndo(tx) {\n  if (tx.locked || tx.el._btUndo) return;\n  pushUndo();\n  tx.el._btUndo = true;\n}\nfunction finishBoardTextEditing() {\n  var tx = getEditingText();\n  if (tx && tx.el._btComposing) return;\n  if (tx) tx.el.blur();\n  if (state.tool === 'text') setTool('select');\n  clearSelection();\n  syncBoardTextUI();\n}\nwindow.addEventListener('board-text-done', finishBoardTextEditing);\nwindow.addEventListener('resize', function () { positionBoardTextUI(); });\nif (window.visualViewport) {\n  window.visualViewport.addEventListener('resize', positionBoardTextUI);\n  window.visualViewport.addEventListener('scroll', positionBoardTextUI);\n}\n\nfunction routeBoardTextMouse(e) {\n  if (e.button !== 0 || (state.tool !== 'select' && state.tool !== 'text')) return false;\n  const grip = e.target.closest('.bt-move');\n  const edge = e.target.closest('.bt-select-edge');\n  const resize = e.target.closest('.item-handle[data-text-handle]');\n  if (grip || resize) {\n    const editing = getEditingText();\n    if (editing) editing.el.blur();\n    if (state.tool !== 'select') setTool('select');\n    return false; // existing move/resize lifecycle owns the gesture\n  }\n  const textEl = e.target.closest('.text-item');\n  const tx = edge ? state.texts.find(t => t.id === Number(edge.dataset.id)) : state.texts.find(t => t.el === textEl);\n  if (!tx) return false;\n  if (tx.locked || edge || e.shiftKey || e.metaKey || e.ctrlKey) {\n    e.preventDefault();\n    if (textEl && document.activeElement === textEl) textEl.blur();\n    if (e.shiftKey || e.metaKey || e.ctrlKey) toggleSelect(tx.id);\n    else selectOnly(tx.id);\n    return true;\n  }\n  // v7.19.0: two-stage text interaction (Figma-style). Click 1 selects the\n  // card only. With the card ALREADY selected the router hands the gesture\n  // back (return false) so the canvas mousedown arms a move drag \u2014 dragging\n  // the body now MOVES the card, and a micro-click (cancelled by the 3px\n  // threshold in the move-mouseup handler) enters edit. A card that is\n  // already editing, or any body click with the text TOOL active, keeps\n  // one-click caret behaviour.\n  // Decide the branch BEFORE blurring the other editor: its blur handler can\n  // flip the tool back to 'select' (finishBoardTextEditing path), which would\n  // silently turn this one-click edit into a plain select.\n  const oneClickEdit = state.tool === 'text' || tx.el.classList.contains('editing');\n  const editingOther = getEditingText();\n  if (editingOther && editingOther !== tx) editingOther.el.blur();\n  if (oneClickEdit) {\n    // Do not preventDefault: native caret placement and drag-to-select remain intact.\n    tx.el.focus({preventScroll:true});\n    return true;\n  }\n  // v7.20.0: a text card that is NOT being edited behaves exactly like an\n  // image card \u2014 the press hands straight back to the canvas mousedown,\n  // which selects the card AND arms a move drag in the SAME gesture. There\n  // is no \"click 1 selects, click 2 acts\" stage any more; editing is\n  // double-click only (see the viewport dblclick handler).\n  //\n  // preventDefault is REQUIRED here, and it is the whole reason the old\n  // one-press drag could never work: the body is contentEditable even when\n  // it is not being edited, so a plain press FOCUSES the card (the focus\n  // listener then adds .editing) and a drag paints a native TEXT SELECTION\n  // instead of moving the card. Machine-verified in Chrome: preventDefault\n  // on mousedown suppresses focus and text selection, while dblclick still\n  // fires \u2014 which is exactly the split we want.\n  e.preventDefault();\n  return false;\n}\nfunction attachTextListeners(tx) {\n  const el = tx.el;\n  if (!el || el._textListenersAttached) return;\n  el._textListenersAttached = true;\n  el.setAttribute('role', 'textbox');\n  el.setAttribute('aria-multiline', 'true');\n  el.setAttribute('aria-label', boardTextLabel('Board text', '\u753B\u677F\u6587\u5B57'));\n  el.addEventListener('compositionstart', () => { el._btComposing = true; });\n  el.addEventListener('compositionend', () => { el._btComposing = false; autoGrowTextItem(tx); });\n  el.addEventListener('beforeinput', e => {\n    if (tx.locked) { e.preventDefault(); return; }\n    beginBoardTextUndo(tx);\n  });\n  el.addEventListener('input', () => {\n    // v7.18.0: in SOURCE mode the text you type IS the markdown, so keep\n    // the source in step with the card. In RENDERED mode the source no\n    // longer describes what you see, so we drop it (and with it the\n    // source/rendered toggle) rather than offer a re-render that would\n    // silently throw the edit away.\n    if (el.classList.contains('md-source')) tx.mdSrc = el.textContent;\n    else if (tx.mdSrc) tx.mdSrc = '';\n    if (tx.mdSrc === '') tx.mdMode = '';\n    autoGrowTextItem(tx);\n    scheduleAutoSave();\n    syncBoardTextUI();\n  });\n  el.addEventListener('keydown', ke => {\n    if (boardTextIsComposing(ke, el)) return;\n    if (ke.key === 'Escape' || (ke.key === 'Enter' && (ke.metaKey || ke.ctrlKey))) {\n      ke.preventDefault();\n      ke.stopPropagation();\n      // Esc now commits; undo, not Esc, is the explicit way to revert edits.\n      finishBoardTextEditing();\n    }\n  });\n  el.addEventListener('focus', () => {\n    if (tx.locked) { el.blur(); return; }\n    el.classList.add('editing');\n    el._focusSnapshot = el.innerHTML;\n    el._btUndo = false;\n    if (!state.selected.has(tx.id) || state.selected.size !== 1) selectOnly(tx.id);\n    syncBoardTextUI();\n  });\n  el.addEventListener('blur', () => {\n    el.classList.remove('editing');\n    if (!el.textContent.trim()) {\n      // Creation already has a pre-create snapshot; clearing existing content has beforeinput undo.\n      el.remove();\n      const handles = canvas.querySelector('.text-handles[data-owner=\"' + tx.id + '\"]');\n      if (handles) handles.remove();\n      state.texts = state.texts.filter(t => t.id !== tx.id);\n      clearSelection();\n    } else if (el._focusSnapshot !== undefined && el._focusSnapshot !== el.innerHTML) {\n      autoGrowTextItem(tx);\n    }\n    el._focusSnapshot = undefined;\n    el._btUndo = false;\n    if (state.tool === 'text') setTool('select');\n    scheduleAutoSave();\n    updateAutoFitPaper();\n    syncBoardTextUI();\n  });\n}\n// \u2500\u2500 v7.17.0: text documents on the board (.md / .txt) \u2500\u2500\n// One file becomes one editable text card. Markdown markers are stripped to\n// plain text \u2014 per-line font sizes would need real HTML and a second editing\n// mode, which is a much bigger change \u2014 and long documents are capped and\n// scroll inside the card instead of growing two screens tall.\nvar DOC_TEXT_MAX_H = 600;          // world px, same unit as every other item box\nvar DOC_TEXT_W = 560;              // world px\nvar DOC_TEXT_MAX_BYTES = 512 * 1024;\n\nfunction isDocTextFile(f) {\n  return !!f && /\\.(md|markdown|txt)$/i.test(String((f && f.name) || ''));\n}\n\nfunction stripMarkdownToPlain(raw) {\n  var lines = String(raw == null ? '' : raw).replace(/\\r\\n?/g, '\\n').split('\\n');\n  var parts = [];\n  for (var i = 0; i < lines.length; i++) {\n    var line = lines[i];\n    var indent = (line.match(/^\\s*/) || [''])[0];\n    var body = line.slice(indent.length);\n    if (/^#{1,6}\\s+/.test(body)) {\n      if (i > 0) parts.push('');\n      parts.push(indent + '\u258E' + body.replace(/^#{1,6}\\s+/, ''));\n      continue;\n    }\n    if (/^(-{3,}|\\*{3,}|_{3,})\\s*$/.test(body)) { parts.push('\u2014\u2014\u2014\u2014'); continue; }\n    if (/^>\\s?/.test(body)) { parts.push(indent + '  ' + body.replace(/^>\\s?/, '')); continue; }\n    if (/^([-*+])\\s+/.test(body)) { parts.push(indent + '\u2022 ' + body.replace(/^([-*+])\\s+/, '')); continue; }\n    var plain = body\n      .replace(/\\*\\*([^*]+)\\*\\*/g, '$1')\n      .replace(/__([^_]+)__/g, '$1')\n      .replace(/(^|[^\\*\\w])\\*([^*\\s][^*]*)\\*(?!\\*)/g, '$1$2')\n      .replace(/(^|[^_\\w])_([^_\\s][^_]*)_(?!_)/g, '$1$2');\n    parts.push(indent + plain);\n  }\n  return parts.join('\\n').replace(/\\n{3,}/g, '\\n\\n').replace(/^\\n+/, '').replace(/\\s+$/, '');\n}\n\nfunction readTextFile(file) {\n  if (file && typeof file.text === 'function') return file.text();\n  return new Promise(function (resolve, reject) {\n    var fr = new FileReader();\n    fr.onload = function () { resolve(String(fr.result || '')); };\n    fr.onerror = function () { reject(fr.error || new Error('read failed')); };\n    try { fr.readAsText(file); } catch (e) { reject(e); }\n  });\n}\n\nfunction importDocTextFiles(files, posAt) {\n  (files || []).forEach(function (file, i) {\n    if (!file) return;\n    if (file.size && file.size > DOC_TEXT_MAX_BYTES) {\n      var ok = false;\n      try {\n        ok = window.confirm(boardTextLabel(\n          '\"' + (file.name || '') + '\" is ' + Math.round(file.size / 1024) + ' KB. Import it anyway?',\n          '\u300C' + (file.name || '') + '\u300D\u6709 ' + Math.round(file.size / 1024) + ' KB\uFF0C\u4ECD\u7136\u6C47\u5165\uFF1F'));\n      } catch (e) { ok = true; }\n      if (!ok) return;\n    }\n    readTextFile(file).then(function (raw) {\n      // v7.18.0: .md renders (tables, heading sizes, real bold); .txt stays\n      // plain, because a .txt is usually not markdown and rendering it\n      // would surprise more than it helps.\n      var isMd = isMarkdownFile(file);\n      var body = isMd ? renderMarkdownToHtml(raw) : stripMarkdownToPlain(raw);\n      if (!String(raw == null ? '' : raw).trim() || !body) {\n        try { toast(boardTextLabel('Empty file: ', '\u7A7A\u6863\u6848\uFF1A') + (file.name || '')); } catch (e) {}\n        return;\n      }\n      var at = (typeof posAt === 'function' ? posAt(i) : null) || { x: 0, y: 0 };\n      var tx = addText(at.x, at.y, isMd ? '' : body, { noFocus: true, initW: DOC_TEXT_W });\n      if (!tx) return;\n      tx.name = String(file.name || '').replace(/\\.[^.]+$/, '');\n      // v7.18.0: these flags are what survive save / undo / load; the CSS\n      // classes are re-derived from them by syncDocCardClasses().\n      tx.docCard = true;\n      tx.mdMode = isMd ? 'rendered' : '';\n      tx.mdSrc = isMd ? String(raw) : '';\n      if (isMd) tx.el.innerHTML = sanitizeTextHtml(body);\n      syncDocCardClasses(tx);\n      requestAnimationFrame(function () { autoGrowTextItem(tx); });\n      try { toast(boardTextLabel('Imported ', '\u5DF2\u6C47\u5165 ') + (file.name || '')); } catch (e) {}\n    }).catch(function () {\n      try { toast(boardTextLabel('Could not read ', '\u8BFB\u5514\u5230 ') + (file.name || '')); } catch (e) {}\n    });\n  });\n}\n\nfunction handleTextUpload(ev) {\n  var input = ev && ev.target;\n  var list = [];\n  try { list = Array.prototype.slice.call((input && input.files) || []); } catch (e) {}\n  try { if (input) input.value = ''; } catch (e) {}\n  if (!list.length) return;\n  var cx = (window.innerWidth / 2 - DOC_TEXT_W / 2 - state.pan.x) / state.zoom;\n  var cy = (window.innerHeight / 2 - state.pan.y) / state.zoom;\n  importDocTextFiles(list, function (i) { return { x: cx + i * 28, y: cy + i * 28 }; });\n}\n\n// v7.17.0: a doc card consumes the wheel only while it can still scroll, and\n// never for pinch / Cmd zoom. Deciding first and swallowing second is the same\n// contract the board's own nested handlers follow \u2014 and because we return\n// WITHOUT calling preventDefault, the browser performs the scroll itself.\nfunction wheelDocCardTarget(e) {\n  var t = e && e.target;\n  if (!t || typeof t.closest !== 'function') return null;\n  return t.closest('.text-item.doc-card');\n}\nfunction docCardCanScroll(el, e) {\n  if (!el || !e) return false;\n  if (e.ctrlKey || e.metaKey) return false;\n  if (state.dragging) return false;\n  var dy = e.deltaY;\n  if (!dy) return false;\n  if (el.scrollHeight <= el.clientHeight + 1) return false;\n  if (dy < 0) return el.scrollTop > 0;\n  return el.scrollTop + el.clientHeight < el.scrollHeight - 1;\n}\n\n// \u2500\u2500 v7.18.0: render markdown into the card's own HTML \u2500\u2500\n// An imported .md is no longer flattened to plain text: headings get real\n// sizes, bold is real bold, and GFM tables become real tables. Everything is\n// escaped FIRST and only a closed set of tags is ever emitted, and the result\n// still goes through sanitizeTextHtml() on every save / undo / load, so a\n// hostile .md cannot smuggle script onto the board.\nfunction escMd(s) {\n  return String(s == null ? '' : s)\n    .replace(/&/g, '&amp;').replace(/</g, '&lt;')\n    .replace(/>/g, '&gt;').replace(/\"/g, '&quot;');\n}\nfunction safeMdUrl(u) {\n  var t = String(u == null ? '' : u).trim();\n  if (/^(https?:|mailto:)/i.test(t)) return t;\n  if (/^[#/]/.test(t) || /^\\.{1,2}\\//.test(t)) return t;\n  return '#';\n}\nfunction inlineMd(s) {\n  var t = escMd(s);\n  t = t.replace(/`([^`]+)`/g, '<code>$1</code>');\n  t = t.replace(/!\\[([^\\]]*)\\]\\(([^)\\s]*)\\)/g, function (m, a) {\n    return '<span>[' + (a || 'image') + ']</span>';\n  });\n  t = t.replace(/\\[([^\\]]+)\\]\\(([^)\\s]+)\\)/g, function (m, a, b) {\n    return '<a href=\"' + safeMdUrl(b) + '\">' + a + '</a>';\n  });\n  t = t.replace(/\\*\\*([^*]+)\\*\\*/g, '<strong>$1</strong>');\n  t = t.replace(/__([^_]+)__/g, '<strong>$1</strong>');\n  t = t.replace(/(^|[^\\w*])\\*([^*\\s][^*]*)\\*(?!\\*)/g, '$1<em>$2</em>');\n  t = t.replace(/(^|[^_\\w])_([^_\\s][^_]*)_(?!_)/g, '$1<em>$2</em>');\n  t = t.replace(/~~([^~]+)~~/g, '<del>$1</del>');\n  return t;\n}\nfunction splitMdRow(line) {\n  var s = String(line == null ? '' : line).trim();\n  if (s.charAt(0) === '|') s = s.slice(1);\n  if (s.charAt(s.length - 1) === '|') s = s.slice(0, -1);\n  return s.split('|').map(function (c) { return c.trim(); });\n}\nfunction mdAlignCell(c) {\n  var s = String(c == null ? '' : c).trim();\n  if (!/^:?-{1,}:?$/.test(s)) return '';\n  var l = s.charAt(0) === ':', r = s.charAt(s.length - 1) === ':';\n  if (l && r) return 'center';\n  if (r) return 'right';\n  if (l) return 'left';\n  return '';\n}\nvar MD_LIST_RE = /^(\\s*)([-*+]|\\d+[.)])\\s+(.*)$/;\nfunction mdListTree(flat, pos, indent) {\n  var items = [];\n  while (pos < flat.length) {\n    if (flat[pos].indent < indent) break;\n    if (flat[pos].indent > indent) {\n      if (!items.length) { items.push(flat[pos]); pos++; continue; }\n      var sub = mdListTree(flat, pos, flat[pos].indent);\n      items[items.length - 1].children = sub.items;\n      pos = sub.pos;\n      continue;\n    }\n    items.push(flat[pos]);\n    pos++;\n  }\n  return { items: items, pos: pos };\n}\nfunction mdRenderList(items, ordered) {\n  var tag = ordered ? 'ol' : 'ul';\n  var s = '<' + tag + '>';\n  for (var k = 0; k < items.length; k++) {\n    s += '<li>' + inlineMd(items[k].text);\n    var kids = items[k].children || [];\n    if (kids.length) s += mdRenderList(kids, !!kids[0].ordered);\n    s += '</li>';\n  }\n  return s + '</' + tag + '>';\n}\nfunction renderMarkdownToHtml(raw) {\n  var src = String(raw == null ? '' : raw).replace(/\\r\\n?/g, '\\n').replace(/\\t/g, '    ');\n  var lines = src.split('\\n');\n  var out = [];\n  var i = 0;\n  while (i < lines.length) {\n    var line = lines[i];\n    if (/^\\s*$/.test(line)) { i++; continue; }\n    var fence = line.match(/^\\s*(`{3,}|~{3,})\\s*[A-Za-z0-9_+-]*\\s*$/);\n    if (fence) {\n      var mark = fence[1].charAt(0), flen = fence[1].length, buf = [];\n      i++;\n      while (i < lines.length) {\n        var cm = lines[i].match(/^\\s*(`{3,}|~{3,})\\s*$/);\n        if (cm && cm[1].charAt(0) === mark && cm[1].length >= flen) { i++; break; }\n        buf.push(lines[i]); i++;\n      }\n      out.push('<pre><code>' + escMd(buf.join('\\n')) + '</code></pre>');\n      continue;\n    }\n    if (/^\\s*(-{3,}|\\*{3,}|_{3,})\\s*$/.test(line)) { out.push('<hr>'); i++; continue; }\n    var h = line.match(/^\\s*(#{1,6})\\s+(.*)$/);\n    if (h) {\n      var lv = Math.min(h[1].length, 6);\n      out.push('<h' + lv + '>' + inlineMd(h[2].replace(/\\s+#+\\s*$/, '')) + '</h' + lv + '>');\n      i++; continue;\n    }\n    if (line.indexOf('|') >= 0 && i + 1 < lines.length &&\n        /^\\s*\\|?\\s*:?-{1,}:?\\s*(\\|\\s*:?-{1,}:?\\s*)*\\|?\\s*$/.test(lines[i + 1])) {\n      var head = splitMdRow(line);\n      var align = splitMdRow(lines[i + 1]).map(mdAlignCell);\n      i += 2;\n      var rows = [];\n      while (i < lines.length && lines[i].indexOf('|') >= 0 && lines[i].trim() !== '') {\n        rows.push(splitMdRow(lines[i])); i++;\n      }\n      var th = '', r0, c1;\n      for (c1 = 0; c1 < head.length; c1++) {\n        th += '<th' + (align[c1] ? ' style=\"text-align:' + align[c1] + '\"' : '') + '>' + inlineMd(head[c1]) + '</th>';\n      }\n      var tb = '';\n      for (r0 = 0; r0 < rows.length; r0++) {\n        tb += '<tr>';\n        for (c1 = 0; c1 < head.length; c1++) {\n          tb += '<td' + (align[c1] ? ' style=\"text-align:' + align[c1] + '\"' : '') + '>' +\n                inlineMd(rows[r0][c1] == null ? '' : rows[r0][c1]) + '</td>';\n        }\n        tb += '</tr>';\n      }\n      out.push('<table><thead><tr>' + th + '</tr></thead><tbody>' + tb + '</tbody></table>');\n      continue;\n    }\n    if (/^\\s*>/.test(line)) {\n      var qb = [];\n      while (i < lines.length && /^\\s*>/.test(lines[i])) {\n        qb.push(lines[i].replace(/^\\s*>\\s?/, '')); i++;\n      }\n      out.push('<blockquote>' + renderMarkdownToHtml(qb.join('\\n')) + '</blockquote>');\n      continue;\n    }\n    if (MD_LIST_RE.test(line)) {\n      var flat = [];\n      while (i < lines.length) {\n        var lm = lines[i].match(MD_LIST_RE);\n        if (lm) {\n          flat.push({ indent: lm[1].length, ordered: /\\d/.test(lm[2]), text: lm[3], children: [] });\n          i++; continue;\n        }\n        if (flat.length && /^\\s{2,}\\S/.test(lines[i])) {\n          flat[flat.length - 1].text += ' ' + lines[i].trim(); i++; continue;\n        }\n        if (/^\\s*$/.test(lines[i])) {\n          var nx = i + 1;\n          if (nx < lines.length && MD_LIST_RE.test(lines[nx])) { i++; continue; }\n          break;\n        }\n        break;\n      }\n      var tree = mdListTree(flat, 0, flat.length ? flat[0].indent : 0);\n      out.push(mdRenderList(tree.items, tree.items.length ? !!tree.items[0].ordered : false));\n      continue;\n    }\n    var para = [];\n    while (i < lines.length && !/^\\s*$/.test(lines[i]) &&\n           !/^\\s*(#{1,6})\\s+/.test(lines[i]) && !/^\\s*>/.test(lines[i]) &&\n           !MD_LIST_RE.test(lines[i]) && lines[i].indexOf('|') < 0) {\n      para.push(lines[i]); i++;\n    }\n    if (!para.length) { para.push(lines[i]); i++; }\n    out.push('<p>' + inlineMd(para.join('\\n')) + '</p>');\n  }\n  return out.join('');\n}\nfunction isMarkdownFile(f) {\n  return !!f && /\\.(md|markdown)$/i.test(String((f && f.name) || ''));\n}\n// v7.18.0: the classes are DERIVED from the persisted flags on every style\n// pass, not stamped on once at import time. Stamping is what let a reload or\n// an undo restore the words while silently dropping the height cap and the\n// scrolling that make a long script usable.\nfunction syncDocCardClasses(tx) {\n  var el = tx && tx.el;\n  if (!el || !el.classList) return;\n  var wantDoc = !!tx.docCard;\n  var wantRen = wantDoc && tx.mdMode === 'rendered';\n  var wantSrc = wantDoc && tx.mdMode === 'source';\n  if (el.classList.contains('doc-card') !== wantDoc) el.classList.toggle('doc-card', wantDoc);\n  if (el.classList.contains('md-rendered') !== wantRen) el.classList.toggle('md-rendered', wantRen);\n  if (el.classList.contains('md-source') !== wantSrc) el.classList.toggle('md-source', wantSrc);\n}\nfunction docCardSetMode(tx, mode) {\n  if (!tx || !tx.el || typeof tx.mdSrc !== 'string' || !tx.mdSrc) return false;\n  tx.mdMode = (mode === 'source') ? 'source' : 'rendered';\n  if (tx.mdMode === 'source') tx.el.textContent = tx.mdSrc;\n  else tx.el.innerHTML = sanitizeTextHtml(renderMarkdownToHtml(tx.mdSrc));\n  syncDocCardClasses(tx);\n  autoGrowTextItem(tx);\n  scheduleAutoSave();\n  return true;\n}\nfunction toggleDocCardSource(id) {\n  var list = state.texts || [];\n  for (var i = 0; i < list.length; i++) {\n    if (list[i] && list[i].id === id) {\n      docCardSetMode(list[i], list[i].mdMode === 'source' ? 'rendered' : 'source');\n      return;\n    }\n  }\n}\n\nfunction addText(x, y, initialText, opts) {\n  pushUndo();\n  const el = document.createElement('div');\n  el.className = 'text-item';\n  el.contentEditable = true;\n  el.spellcheck = false;\n  el.setAttribute('data-placeholder', (typeof I18N !== 'undefined' && I18N.getLang && I18N.getLang() === 'zh') ? '\u8F93\u5165\u6587\u5B57\u2026' : 'Type here...');\n  // Do NOT set text