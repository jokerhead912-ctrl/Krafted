)',\n    'Save Board': '\u4FDD\u5B58\u9762\u677F',\n    'Save As\u2026': '\u53E6\u5B58\u65B0\u6863\u2026',\n    'Tidy Selection': '\u6574\u7406\u9009\u53D6',\n    'Tetris Align Up': '\u4FC4\u7F57\u65AF\u65B9\u5757\u5411\u4E0A\u5BF9\u9F50',\n    'Tetris Align Down': '\u4FC4\u7F57\u65AF\u65B9\u5757\u5411\u4E0B\u5BF9\u9F50',\n    'Tetris Align Left': '\u4FC4\u7F57\u65AF\u65B9\u5757\u5411\u5DE6\u5BF9\u9F50',\n    'Tetris Align Right': '\u4FC4\u7F57\u65AF\u65B9\u5757\u5411\u53F3\u5BF9\u9F50',\n    'Normalize Size': '\u6807\u51C6\u5316\u5927\u5C0F',\n    'Normalize Scale': '\u6807\u51C6\u5316\u7F29\u653E',\n    'Normalize Height': '\u6807\u51C6\u5316\u9AD8\u5EA6',\n    'Normalize Width': '\u6807\u51C6\u5316\u5BBD\u5EA6',\n    'Stack Items': '\u5806\u53E0\u9879\u76EE',\n    'Pan Canvas (hold)': '\u5E73\u79FB\u753B\u5E03 (\u6309\u4F4F)',\n    'Show Help / Shortcuts': '\u663E\u793A\u5E2E\u52A9 / \u5FEB\u6377\u952E',\n    'Cancel / Deselect': '\u53D6\u6D88 / \u53D6\u6D88\u9009\u53D6',\n    'Translate EN->\u4E2D\u6587': '\u7FFB\u8BD1 EN\u2192\u4E2D\u6587',\n    'Frame Step Left': '\u9010\u5E27\u5411\u5DE6',\n    'Frame Step Right': '\u9010\u5E27\u5411\u53F3',\n    'Jump 10 Frames Left': '\u8DF3 10 \u5E27\u5411\u5DE6',\n    'Jump 10 Frames Right': '\u8DF3 10 \u5E27\u5411\u53F3',\n    'Trim In Point': '\u88C1\u526A\u5165\u70B9',\n    'Trim Out Point': '\u88C1\u526A\u51FA\u70B9',\n    'Edit': '\u7F16\u8F91',\n    'File': '\u6587\u4EF6',\n    'Arrange': '\u6392\u5217',\n    'Navigation': '\u5BFC\u89C8',\n    'Media': '\u5A92\u4F53',\n    'Translate': '\u7FFB\u8BD1',\n\n    // \u2500\u2500 Misc \u2500\u2500\n    'MP4': 'MP4',\n    'Video': '\u89C6\u9891',\n    'Image': '\u56FE\u7247',\n    'F 0': 'F 0',\n    '0:00.00': '0:00.00',\n    '30 fps': '30 fps',\n    'fps': 'fps',\n    '0:00': '0:00',\n    'f \u2014': 'f \u2014',\n    '\u2014': '\u2014',\n    'Type here...': '\u5728\u6B64\u8F93\u5165...',\n    'Krafted Package': 'Krafted \u5C01\u88C5',\n    'JSON File': 'JSON \u6587\u4EF6',\n    'Checklist': '\u5F85\u529E\u6E05\u5355',\n    'Mind Map': '\u601D\u7EF4\u5BFC\u56FE',\n    'Original video file name': '\u539F\u59CB\u89C6\u9891\u6587\u4EF6\u540D',\n    'Comment text size:': '\u7559\u8A00\u6587\u5B57\u5927\u5C0F\uFF1A',\n    'Hide / show snapshot thumbnails on every comment card': '\u9690\u85CF/\u663E\u793A\u7559\u8A00\u5361\u7F29\u56FE',\n    'Snap the popover back to the video (re-enable follow)': '\u5C06\u5F39\u7A97\u5BF9\u9F50\u89C6\u9891',\n    'Show the draw toolbar and start drawing (or press Ctrl+D / the draw button)': '\u663E\u793A\u7ED8\u56FE\u5DE5\u5177\u5217',\n    'Translate every comment to the other language at once (sequential, ~1s per comment)': '\u4E00\u6B21\u7FFB\u8BD1\u6240\u6709\u7559\u8A00',\n    'Delete ALL comments for this video (cannot be undone \u2014 confirmation asked)': '\u5220\u9664\u6B64\u89C6\u9891\u6240\u6709\u7559\u8A00',\n    'Export frame comments + snapshots + over comment to HTML (uses original file name)': '\u5BFC\u51FA\u5E27\u7559\u8A00+\u622A\u56FE\u4E3A HTML',\n    'Send every snap+text comment to the canvas as a 2-column storyboard...': '\u53D1\u9001\u6240\u6709\u622A\u56FE+\u7559\u8A00\u5230\u753B\u5E03',\n    'Export the video with per-frame drawings baked in (.mp4)': '\u5BFC\u51FA\u542B\u5E27\u7ED8\u56FE\u7684\u89C6\u9891 (.mp4)',\n    'Trim start': '\u88C1\u526A\u8D77\u70B9',\n    'Trim end': '\u88C1\u526A\u7EC8\u70B9',\n    'Reset trim': '\u91CD\u8BBE\u88C1\u526A',\n    'Drag to move': '\u62D6\u52A8\u79FB\u52A8',\n    'Frame rate. Click to cycle 24->25->30->50->60->auto. Right-click to reset to auto-detect.': '\u5E27\u7387\u3002\u70B9\u51FB\u5FAA\u73AF 24\u219225\u219230\u219250\u219260\u2192\u81EA\u52A8\u3002\u53F3\u952E\u91CD\u8BBE\u4E3A\u81EA\u52A8\u4FA6\u6D4B\u3002',\n    'Drag to set trim start': '\u62D6\u52A8\u8BBE\u5B9A\u88C1\u526A\u8D77\u70B9',\n    'Drag to set trim end': '\u62D6\u52A8\u8BBE\u5B9A\u88C1\u526A\u7EC8\u70B9',\n    'Snap all annotated frames \u2014 batch-capture every frame that has draw/text strokes as a frame comment': '\u64B7\u53D6\u6240\u6709\u6CE8\u89E3\u5E27',\n    'Save images to a local folder (Chrome / Edge on Win + Mac)': '\u4FDD\u5B58\u56FE\u7247\u5230\u672C\u673A\u6587\u4EF6\u5939 (Chrome/Edge Win+Mac)',\n    'Folder picker unavailable \u2014 will download each image instead': '\u4E0D\u652F\u63F4\u6587\u4EF6\u5939\u9009\u62E9\u5668 \u2014 \u6539\u4E3A\u9010\u5F20\u4E0B\u8F7D',\n    'Exporting video...': '\u5BFC\u51FA\u89C6\u9891\u4E2D...',\n  };\n\n  // \u2500\u2500 State \u2500\u2500\n  var currentLang = 'en'; // 'en' | 'zh'\n  var REVERSE_MAP = null; // built lazily when switching to zh\n\n  function buildReverseMap() {\n    if (REVERSE_MAP) return;\n    REVERSE_MAP = {};\n    Object.keys(MAP).forEach(function(en) {\n      REVERSE_MAP[MAP[en]] = en;\n    });\n  }\n\n  // \u2500\u2500 Walk DOM and translate text nodes + attributes \u2500\u2500\n  function walkAndTranslate(root, toZh) {\n    var map = toZh ? MAP : (buildReverseMap(), REVERSE_MAP);\n    if (!map) return;\n\n    // Skip user content areas \u2014 never translate these\n    var skipTags = { 'SCRIPT':1, 'STYLE':1, 'TEXTAREA':1, 'INPUT':1, 'SELECT':1, 'CANVAS':1, 'VIDEO':1, 'AUDIO':1, 'IFRAME':1, 'CODE':1, 'PRE':1 };\n    // Skip user-editable content\n    var skipClasses = ['user-text', 'comment-body', 'mindmap-node', 'todo-text', 'media-filename-badge'];\n\n    function shouldSkip(el) {\n      if (!el || !el.tagName) return true;\n      if (skipTags[el.tagName]) return true;\n      if (el.isContentEditable || (el.getAttribute && el.getAttribute('contenteditable') === 'true')) return true;\n      // Skip items on the canvas (user content)\n      if (el.closest && (el.closest('.item') || el.closest('.mindmap-node') || el.closest('.todo-item'))) return true;\n      // Skip comment bodies\n      if (el.closest && el.closest('.comment-body')) return true;\n      return false;\n    }\n\n    function walk(node) {\n      if (!node) return;\n\n      // Text nodes\n      if (node.nodeType === 3) { // TEXT_NODE\n        var text = node.textContent;\n        if (!text || !text.trim()) return;\n        var trimmed = text.trim();\n        if (map[trimmed] !== undefined) {\n          node.textContent = text.replace(trimmed, map[trimmed]);\n        }\n        return;\n      }\n\n      // Element nodes\n      if (node.nodeType !== 1) return;\n      if (shouldSkip(node)) return;\n\n      // Translate title attribute\n      if (node.title && map[node.title] !== undefined) {\n        node.title = map[node.title];\n      }\n\n      // Translate placeholder attribute\n      if (node.placeholder && map[node.placeholder] !== undefined) {\n        node.placeholder = map[node.placeholder];\n      }\n\n      // Translate aria-label\n      if (node.getAttribute && node.getAttribute('aria-label')) {\n        var al = node.getAttribute('aria-label');\n        if (map[al] !== undefined) node.setAttribute('aria-label', map[al]);\n      }\n\n      // Walk children\n      var children = node.childNodes;\n      if (children) {\n        for (var i = 0; i < children.length; i++) {\n          walk(children[i]);\n        }\n      }\n    }\n\n    walk(root);\n  }\n\n  // \u2500\u2500 Translate specific dynamic elements \u2500\u2500\n  function translateDynamicElements(toZh) {\n    // Status bar\n    var statusEl = document.getElementById('status');\n    if (statusEl && toZh) {\n      var txt = statusEl.textContent || '';\n      statusEl.textContent = txt\n        .replace(/Zoom:/g, '\u7F29\u653E\uFF1A')\n        .replace(/Items:/g, '\u9879\u76EE\uFF1A')\n        .replace(/Undo:/g, '\u64A4\u9500\uFF1A');\n    }\n\n    // Paper toggle button\n    var paperBtn = document.getElementById('btn-paper-toggle');\n    if (paperBtn) {\n      var pt = paperBtn.textContent || '';\n      if (toZh) {\n        paperBtn.textContent = pt.replace('Show Paper', '\u663E\u793A\u7EB8\u5F20').replace('Hide Paper', '\u9690\u85CF\u7EB8\u5F20');\n      } else {\n        paperBtn.textContent = pt.replace('\u663E\u793A\u7EB8\u5F20', 'Show Paper').replace('\u9690\u85CF\u7EB8\u5F20', 'Hide Paper');\n      }\n    }\n\n    // Auto-fit button\n    var autoFitBtn = document.getElementById('btn-autofit-toggle');\n    if (autoFitBtn) {\n      var at = autoFitBtn.textContent || '';\n      if (toZh) {\n        autoFitBtn.textContent = at.replace('Auto-fit: ON', '\u81EA\u52A8\u9002\u5E94\uFF1A\u5F00').replace('Auto-fit: OFF', '\u81EA\u52A8\u9002\u5E94\uFF1A\u5173');\n      } else {\n        autoFitBtn.textContent = at.replace('\u81EA\u52A8\u9002\u5E94\uFF1A\u5F00', 'Auto-fit: ON').replace('\u81EA\u52A8\u9002\u5E94\uFF1A\u5173', 'Auto-fit: OFF');\n      }\n    }\n  }\n\n  // \u2500\u2500 Main toggle function \u2500\u2500\n  function toggleLang() {\n    var toZh = (currentLang === 'en');\n    currentLang = toZh ? 'zh' : 'en';\n\n    // Walk entire body (but skip canvas content)\n    var body = document.body;\n    if (body) walkAndTranslate(body, toZh);\n\n    // Handle dynamic elements\n    translateDynamicElements(toZh);\n\n    // v7.0.26: text-item placeholders live on the canvas, which\n    // walkAndTranslate deliberately skips \u2014 update them directly.\n    document.querySelectorAll('.text-item').forEach(function(ti) {\n      ti.setAttribute('data-placeholder', toZh ? '\u8F93\u5165\u6587\u5B57\u2026' : 'Type here...');\n    });\n\n    // v7.0.29: board-pen pack/exit hint is injected by JS, so the tree walk\n    // above cannot translate it \u2014 refresh it explicitly.\n    if (typeof refreshDrawPackHint === 'function') refreshDrawPackHint();\n    if (typeof syncBoardTextUI === 'function') syncBoardTextUI();\n\n    // Update the lang button icon\n    updateLangButton();\n\n    // Persist preference\n    try {\n      localStorage.setItem('krafted_lang', currentLang);\n      if (window.KraftedStorage) window.KraftedStorage.setItem('krafted_lang', currentLang).catch(function(){});\n    } catch(e) {}\n\n    // Show toast\n    if (typeof window.toast === 'function') {\n      window.toast(toZh ? '\uF310 \u754C\u9762\u5DF2\u5207\u6362\u4E3A\u4E2D\u6587' : '\uF310 UI switched to English');\n    }\n\n    return currentLang;\n  }\n\n  function setLang(lang) {\n    if (lang === currentLang) return;\n    toggleLang();\n  }\n\n  function getLang() {\n    return currentLang;\n  }\n\n  // \u2500\u2500 Lang button in toolbar \u2500\u2500\n  function updateLangButton() {\n    var btn = document.getElementById('btn-lang');\n    if (!btn) return;\n    btn.textContent = currentLang === 'zh' ? '\u4E2D' : 'EN';\n    btn.title = currentLang === 'zh' ? 'Switch UI to English' : '\u5207\u6362\u754C\u9762\u4E3A\u4E2D\u6587';\n  }\n\n  function createLangButton() {\n    var existing = document.getElementById('btn-lang');\n    if (existing) return existing;\n\n    var toolbar = document.getElementById('toolbar');\n    if (!toolbar) return null;\n\n    // Add a separator before the lang button\n    var sep = document.createElement('span');\n    sep.className = 'tb-sep';\n    sep.style.cssText = 'width:1px;height:20px;background:var(--border);margin:0 2px;flex-shrink:0;align-self:center;';\n    toolbar.appendChild(sep);\n\n    var btn = document.createElement('button');\n    btn.id = 'btn-lang';\n    btn.className = 'tb-primary';\n    btn.style.cssText = 'font-weight:700;font-size:11px;min-width:32px;padding:0 6px;';\n    btn.textContent = currentLang === 'zh' ? '\u4E2D' : 'EN';\n    btn.title = currentLang === 'zh' ? 'Switch UI to English' : '\u5207\u6362\u754C\u9762\u4E3A\u4E2D\u6587';\n    btn.addEventListener('click', toggleLang);\n    toolbar.appendChild(btn);\n    return btn;\n  }\n\n  // \u2500\u2500 Init \u2500\u2500\n  function init() {\n    // Restore saved preference\n    try {\n      var saved = (window.KraftedStorage && window.KraftedStorage.getItemSync('krafted_lang')) || localStorage.getItem('krafted_lang');\n      if (saved === 'zh') {\n        currentLang = 'en'; // toggleLang expects currentLang to be opposite\n        // Delay to let DOM render first\n        setTimeout(function() {\n          toggleLang();\n        }, 500);\n      }\n    } catch(e) {}\n\n    // Create button after a short delay (let toolbar render)\n    setTimeout(function() {\n      createLangButton();\n    }, 300);\n  }\n\n  // \u2500\u2500 Observe new DOM elements and translate them \u2500\u2500\n  var observer = null;\n  function startObserver() {\n    if (observer) return;\n    observer = new MutationObserver(function(mutations) {\n      if (currentLang !== 'zh') return;\n      mutations.forEach(function(mutation) {\n        mutation.addedNodes.forEach(function(node) {\n          if (node.nodeType === 1) {\n            walkAndTranslate(node, true);\n            translateDynamicElements(true);\n          }\n        });\n      });\n    });\n    observer.observe(document.body, { childList: true, subtree: true });\n  }\n\n  // Start observer once DOM is ready\n  setTimeout(startObserver, 1000);\n\n  // \u2500\u2500 Public API \u2500\u2500\n  return {\n    init: init,\n    toggle: toggleLang,\n    setLang: setLang,\n    getLang: getLang,\n    t: function(key) { return currentLang === 'zh' && MAP[key] ? MAP[key] : key; },\n    MAP: MAP\n  };\n})();\n\n// Auto-init\nif (document.readyState === 'loading') {\n  document.addEventListener('DOMContentLoaded', function() { I18N.init(); });\n} else {\n  I18N.init();\n}\n\n\n// ==== shortcut-editor.js ====\n\n// ============================================================\n//  SHORTCUT EDITOR \u2014 customizable keyboard shortcuts\n//  v5.4 R79 \u2014 user can remap any shortcut from the Help panel.\n//  All shortcuts read from ShortcutRegistry; user overrides\n//  are persisted to localStorage.\n// ============================================================\n\n// \u2500\u2500 Default shortcut registry \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Each entry: { id, label, category, defaultKeys, macKeys?, action }\n// - defaultKeys: array of { key, ctrl, shift, alt, meta } objects\n// - macKeys: optional Mac-specific override (Cmd instead of Ctrl)\n// - action: function name to call\n// When Platform.mac is true AND macKeys is provided, macKeys wins.\n// Otherwise defaultKeys is used, with ctrl\u2192cmd on Mac automatically.\n\nconst DEFAULT_SHORTCUTS = [\n  // === TOOLS ===\n  { id: 'tool-select',     category: 'Tools', label: 'Select & Move',            keys: [{ key: 'v' }] },\n  { id: 'tool-text',       category: 'Tools', label: 'Board Text',               keys: [{ key: 't' }] },\n  { id: 'tool-draw',       category: 'Tools', label: 'Board Pen',                keys: [{ key: 'd', ctrl: true }], macKeys: [{ key: 'd', meta: true }] },\n  { id: 'tool-export',     category: 'Tools', label: 'Export Area',              keys: [{ key: 'e' }] },\n  { id: 'tool-capture',    category: 'Tools', label: 'Capture Area',             keys: [{ key: 'c' }] },\n  { id: 'tool-screen-cap', category: 'Tools', label: 'Screen Capture',           keys: [{ key: 'c', shift: true }] },\n  { id: 'tool-cut',        category: 'Tools', label: 'Free Shape Cut',           keys: [{ key: 'x' }] },\n  { id: 'tool-lasso',      category: 'Tools', label: 'Lasso Cut',                keys: [{ key: 'l' }] },\n  { id: 'tool-mindmap',    category: 'Tools', label: 'Mind Map',                 keys: [{ key: 'm' }] },\n  { id: 'tool-relation',   category: 'Tools', label: 'Relation Line',            keys: [{ key: 'r' }] },\n  // v7.0.49: Reframe. Bare r is Relation Line, so this rides on Shift+R.\n  // Registered rather than hand-rolled so it shows in the palette and can be\n  // rebound \u2014 a feature you cannot find is a feature you do not have.\n  { id: 'edit-reframe',    category: 'Edit',  label: 'Reframe Image',              keys: [{ key: 'r', shift: true }] },\n  { id: 'tool-link',       category: 'Tools', label: 'Add Link Card',            keys: [{ key: 'l', ctrl: true }], macKeys: [{ key: 'l', meta: true }] },\n  { id: 'tool-grid',       category: 'Tools', label: 'Toggle Grid',              keys: [{ key: 'g' }] },\n  { id: 'tool-fullscreen', category: 'Tools', label: 'Fullscreen',               keys: [{ key: 'f', shift: true }] },\n  { id: 'tool-frame-sel',  category: 'Tools', label: 'Frame Selection',          keys: [{ key: 'f' }] },\n\n  // === EDIT ===\n  { id: 'edit-undo',       category: 'Edit', label: 'Undo',                      keys: [{ key: 'z', ctrl: true }], macKeys: [{ key: 'z', meta: true }] },\n  { id: 'edit-redo',       category: 'Edit', label: 'Redo',                      keys: [{ key: 'y', ctrl: true }], macKeys: [{ key: 'y', meta: true }] },\n  { id: 'edit-redo-alt',   category: 'Edit', label: 'Redo (Shift+Undo)',         keys: [{ key: 'z', ctrl: true, shift: true }], macKeys: [{ key: 'z', meta: true, shift: true }] },\n  { id: 'edit-copy',       category: 'Edit', label: 'Copy',                      keys: [{ key: 'c', ctrl: true }], macKeys: [{ key: 'c', meta: true }] },\n  { id: 'edit-paste',      category: 'Edit', label: 'Paste',                     keys: [{ key: 'v', ctrl: true }], macKeys: [{ key: 'v', meta: true }] },\n  { id: 'edit-duplicate',  category: 'Edit', label: 'Duplicate',                 keys: [{ key: 'd', ctrl: true, shift: true }], macKeys: [{ key: 'd', meta: true, shift: true }] },\n  { id: 'edit-delete',     category: 'Edit', label: 'Delete Selected',           keys: [{ key: 'Delete' }, { key: 'Backspace' }] },\n  { id: 'edit-select-all', category: 'Edit', label: 'Select All',                keys: [{ key: 'a', ctrl: true }], macKeys: [{ key: 'a', meta: true }] },\n\n  // === FILE ===\n  { id: 'file-save',       category: 'File', label: 'Save Board',                keys: [{ key: 's', ctrl: true }], macKeys: [{ key: 's', meta: true }] },\n  { id: 'file-save-as',    category: 'File', label: 'Save As\u2026',                  keys: [{ key: 's', ctrl: true, shift: true }], macKeys: [{ key: 's', meta: true, shift: true }] },\n  { id: 'file-open',       category: 'File', label: 'Open Board',                keys: [{ key: 'o', ctrl: true }], macKeys: [{ key: 'o', meta: true }] },\n\n  // === GROUP ===\n  { id: 'group-group',     category: 'Group', label: 'Group Selected',           keys: [{ key: 'g', ctrl: true }], macKeys: [{ key: 'g', meta: true }] },\n  { id: 'group-ungroup',   category: 'Group', label: 'Ungroup',                  keys: [{ key: 'g', ctrl: true, shift: true }], macKeys: [{ key: 'g', meta: true, shift: true }] },\n\n  // === ARRANGE ===\n  { id: 'arrange-tidy',    category: 'Arrange', label: 'Tidy Selection',         keys: [{ key: 'u', ctrl: true, shift: true }], macKeys: [{ key: 'u', meta: true, shift: true }] },\n  { id: 'arrange-tetris-up',    category: 'Arrange', label: 'Tetris Align Up',    keys: [{ key: 'ArrowUp', ctrl: true }], macKeys: [{ key: 'ArrowUp', meta: true }] },\n  { id: 'arrange-tetris-down',  category: 'Arrange', label: 'Tetris Align Down',  keys: [{ key: 'ArrowDown', ctrl: true }], macKeys: [{ key: 'ArrowDown', meta: true }] },\n  { id: 'arrange-tetris-left',  category: 'Arrange', label: 'Tetris Align Left',  keys: [{ key: 'ArrowLeft', ctrl: true }], macKeys: [{ key: 'ArrowLeft', meta: true }] },\n  { id: 'arrange-tetris-right', category: 'Arrange', label: 'Tetris Align Right', keys: [{ key: 'ArrowRight', ctrl: true }], macKeys: [{ key: 'ArrowRight', meta: true }] },\n  { id: 'arrange-dist-h',  category: 'Arrange', label: 'Distribute Horizontal',  keys: [{ key: 'ArrowUp', ctrl: true, alt: true, shift: true }] },\n  { id: 'arrange-dist-v',  category: 'Arrange', label: 'Distribute Vertical',    keys: [{ key: 'ArrowDown', ctrl: true, alt: true, shift: true }] },\n  { id: 'arrange-norm-size',  category: 'Arrange', label: 'Normalize Size',      keys: [{ key: 'ArrowUp', ctrl: true, alt: true }] },\n  { id: 'arrange-norm-scale', category: 'Arrange', label: 'Normalize Scale',     keys: [{ key: 'ArrowDown', ctrl: true, alt: true }] },\n  { id: 'arrange-norm-h',  category: 'Arrange', label: 'Normalize Height',       keys: [{ key: 'ArrowLeft', ctrl: true, alt: true }] },\n  { id: 'arrange-norm-w',  category: 'Arrange', label: 'Normalize Width',        keys: [{ key: 'ArrowRight', ctrl: true, alt: true }] },\n  { id: 'arrange-stack',   category: 'Arrange', label: 'Stack Items',            keys: [{ key: 's', ctrl: true, alt: true }] },\n\n  // === NAVIGATION ===\n  { id: 'nav-pan-space',   category: 'Navigation', label: 'Pan Canvas (hold)',   keys: [{ key: ' ' }] },\n  { id: 'nav-help',        category: 'Navigation', label: 'Show Help / Shortcuts', keys: [{ key: 'h' }] },\n  { id: 'nav-esc',         category: 'Navigation', label: 'Cancel / Deselect',   keys: [{ key: 'Escape' }] },\n  { id: 'draw-finish',     category: 'Draw',        label: 'Finish drawing \u2192 item', keys: [{ key: 'Enter' }] },\n\n  // === TRANSLATE ===\n  { id: 'translate-en-zh', category: 'Translate', label: 'Translate EN\u2192\u4E2D\u6587',    keys: [{ key: 't', ctrl: true, shift: true }], macKeys: [{ key: 't', meta: true, shift: true }] },\n\n  // === MEDIA ===\n  { id: 'media-frame-left',  category: 'Media', label: 'Frame Step Left',       keys: [{ key: 'ArrowLeft' }] },\n  { id: 'media-frame-right', category: 'Media', label: 'Frame Step Right',      keys: [{ key: 'ArrowRight' }] },\n  { id: 'media-frame-10-left',  category: 'Media', label: 'Jump 10 Frames Left',  keys: [{ key: 'ArrowLeft', shift: true }] },\n  { id: 'media-frame-10-right', category: 'Media', label: 'Jump 10 Frames Right', keys: [{ key: 'ArrowRight', shift: true }] },\n  { id: 'media-trim-i',    category: 'Media', label: 'Trim In Point',            keys: [{ key: 'i' }] },\n  { id: 'media-trim-o',    category: 'Media', label: 'Trim Out Point',           keys: [{ key: 'o' }] },\n  // v7.0.38: palette-only (keys: []). Trim needs a selected video and opens\n  // a dialog, so binding it to a bare letter would fire while the user is\n  // typing in a board text box. Reachable from the palette and the menu.\n  { id: 'media-contact-sheet', category: 'Media', label: 'Contact Sheet\u2026',       keys: [] },\n  { id: 'media-trim-clear',    category: 'Media', label: 'Clear Trim',           keys: [] },\n  // v7.0.44: Premiere's Marker > Clear In / Clear Out. Palette-only \u2014\n  // see the note above about the registry matching on ev.key.\n  { id: 'media-trim-clear-in',  category: 'Media', label: 'Clear In Point',      keys: [] },\n  { id: 'media-trim-clear-out', category: 'Media', label: 'Clear Out Point',     keys: [] },\n  // v7.0.40: named views. Note on Alt \u2014 this registry matches on ev.key, and\n  // on macOS Option+<letter> emits the OPTION LAYER of the keyboard (Alt+S is\n  // '\u00DF'), so an Alt+letter binding here silently never fires on a Mac. The one\n  // shortcut that IS bound \u2014 Alt+1..0 to jump to a view \u2014 lives in the views\n  // module and matches ev.code instead.\n  //\n  // v7.0.46: P and Shift+P are bound. \"Pick the thing I am looking at, drop it\n  // in Present, name it\" is the entire point of the feature and it had no key\n  // at all, so every shot had to begin on a 236px rail. Bare P is safe: the\n  // global keydown handler returns before the registry is consulted whenever\n  // the caret sits in an input, a textarea or a contenteditable, so typing a\n  // word that contains a 'p' never fires this. P adds a shot, Shift+P plays\n  // the tape \u2014 one letter, both ends of the same job, both rebindable.\n  { id: 'view-save',           category: 'View',  label: 'Add Shot To Present',      keys: [{ key: 'p' }] },\n  { id: 'view-update',         category: 'View',  label: 'Re-aim Current View',      keys: [] },\n  { id: 'view-present',        category: 'View',  label: 'Present Views',            keys: [{ key: 'p', shift: true }] },\n  { id: 'view-toggle-panel',   category: 'View',  label: 'Toggle Views Panel',       keys: [] },\n  { id: 'library-toggle-panel', category: 'View',  label: 'Toggle Library Panel',     keys: [] },\n  { id: 'minimap-toggle-panel', category: 'View',  label: 'Toggle Minimap',           keys: [] },\n  // v7.0.40: A/B compare. Palette-only \u2014 it is modal, so the moment it is open\n  // it owns the keyboard anyway and needs no shortcut of its own.\n  { id: 'view-ab-compare',     category: 'View',  label: 'A/B Compare Two Items',    keys: [] },\n  // === SCREEN SHARE MODE (v6.8.0) ===\n  { id: 'tool-screen-share', category: 'Tools', label: 'Toggle Screen Share Mode', keys: [{ key: 'p', ctrl: true, shift: true }], macKeys: [{ key: 'p', meta: true, shift: true }] },\n];\n\n// \u2500\u2500 Runtime registry \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// On init, defaults are merged with localStorage overrides.\nlet ShortcutRegistry = {};\n\nfunction _loadOverrides() {\n  try {\n    const raw = (window.KraftedStorage && window.KraftedStorage.getItemSync('krafted_shortcuts')) || localStorage.getItem('krafted_shortcuts');\n    if (raw) return JSON.parse(raw);\n  } catch (e) {}\n  return {};\n}\n\nfunction _saveOverrides(overrides) {\n  try {\n    var val = JSON.stringify(overrides);\n    localStorage.setItem('krafted_shortcuts', val);\n    if (window.KraftedStorage) window.KraftedStorage.setItem('krafted_shortcuts', val).catch(function(){});\n  } catch (e) {}\n}\n\n// Build the active shortcut map from defaults + overrides.\n// For each shortcut id, if the user has an override array, use it.\n// Otherwise pick macKeys on Mac, defaultKeys on Win.\nfunction _rebuildRegistry() {\n  const overrides = _loadOverrides();\n  const out = {};\n  DEFAULT_SHORTCUTS.forEach(function(def){\n    const userKeys = overrides[def.id];\n    if (userKeys && Array.isArray(userKeys) && userKeys.length > 0) {\n      out[def.id] = { id: def.id, label: def.label, category: def.category, keys: userKeys, userDefined: true };\n    } else if (Platform.mac && def.macKeys) {\n      out[def.id] = { id: def.id, label: def.label, category: def.category, keys: def.macKeys, userDefined: false };\n    } else {\n      out[def.id] = { id: def.id, label: def.label, category: def.category, keys: def.keys, userDefined: false };\n    }\n  });\n  ShortcutRegistry = out;\n  // Expose globally so the keyboard handler can read it\n  if (typeof window !== 'undefined') window.ShortcutRegistry = ShortcutRegistry;\n  if (typeof window !== 'undefined') window.DEFAULT_SHORTCUTS = DEFAULT_SHORTCUTS;\n}\n\n// \u2500\u2500 Public API \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n// Reset ONE shortcut to default\nfunction resetShortcut(id) {\n  const overrides = _loadOverrides();\n  delete overrides[id];\n  _saveOverrides(overrides);\n  _rebuildRegistry();\n}\n\n// Set a custom key binding for a shortcut\n// keysArr: array of { key, ctrl, shift, alt, meta }\nfunction setShortcut(id, keysArr) {\n  const overrides = _loadOverrides();\n  overrides[id] = keysArr;\n  _saveOverrides(overrides);\n  _rebuildRegistry();\n}\n\n// Reset ALL shortcuts to default\nfunction resetAllShortcuts() {\n  try { localStorage.removeItem('krafted_shortcuts'); } catch (e) {}\n  try { if (window.KraftedStorage) window.KraftedStorage.removeItem('krafted_shortcuts').catch(function(){}); } catch (e) {}\n  _rebuildRegistry();\n}\n\n// Format a key combo for display\nfunction formatKeyCombo(keys) {\n  if (!keys || !keys.length) return '\u2014';\n  return keys.map(function(k){\n    const parts = [];\n    if (k.ctrl) parts.push(Platform.mac ? '\u2303' : 'Ctrl');\n    if (k.meta) parts.push(Platform.mac ? '\u2318' : 'Win');\n    if (k.alt) parts.push(Platform.mac ? '\u2325' : 'Alt');\n    if (k.shift) parts.push(Platform.mac ? '\u21E7' : 'Shift');\n    let keyName = k.key;\n    if (keyName === ' ') keyName = 'Space';\n    if (keyName === 'ArrowUp') keyName = '\u2191';\n    if (keyName === 'ArrowDown') keyName = '\u2193';\n    if (keyName === 'ArrowLeft') keyName = '\u2190';\n    if (keyName === 'ArrowRight') keyName = '\u2192';\n    if (keyName === 'Escape') keyName = 'Esc';\n    if (keyName === 'Delete') keyName = 'Del';\n    if (keyName === 'Backspace') keyName = '\u232B';\n    parts.push(keyName);\n    return parts.join(Platform.mac ? '' : '+');\n  }).join('  ');\n}\n\n// \u2500\u2500 Init \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n_rebuildRegistry();\nconsole.log('[INIT] Shortcut Registry:', Object.keys(ShortcutRegistry).length, 'shortcuts loaded');\n\n// Expose global helpers for the shortcut editor UI\nif (typeof window !== 'undefined') {\n  window._kraftedRebuildShortcuts = _rebuildRegistry;\n  window.resetShortcutSC = resetShortcut;\n  window.resetAllShortcutsSC = resetAllShortcuts;\n}\n\n\n// ==== canvas-view.js ====\n\n\n// ============================================================\n//  CANVAS / VIEW\n// ============================================================\n// v7.5.0 -- OFF-SCREEN IMAGE CULLING.\n//\n// Every image on the board is a live <img>, and Chrome holds a DECODED\n// bitmap per element: w*h*4 bytes, which at the import cap is 16 MB a\n// picture. Chrome decides for itself when to drop those, so a big board\n// was a bet on its eviction policy rather than a budget -- and panning\n// across the board or selecting a dozen images at once is exactly when\n// that bet loses and the tab dies.\n//\n// So take the decision away from it: a card well outside the viewport has\n// its src detached, which releases the decoded bitmap immediately.\n// NOTHING ABOUT THE ITEM CHANGES -- item.src still holds the live blob\n// URL, so export, save, undo and the data model are untouched, and\n// restoring is a string assignment. That is the whole point of culling\n// the attribute rather than revoking the URL: a revoked URL is a one-way\n// door that every consumer would then have to know about.\n//\n// Deliberately NOT content-visibility / contain: those apply layout\n// containment, which breaks the getBoundingClientRect hit testing the\n// canvas pointer handlers depend on.\nconst IMG_CULL_MARGIN = 1.5;      // keep one and a half screens around the view\nconst IMG_CULL_MIN_ITEMS = 40;    // below this there is nothing worth culling\nlet _imgCullHandle = null;\n\nfunction _cullOffscreenImages() {\n  try {\n    const items = (state && state.items) ? state.items : [];\n    if (items.length < IMG_CULL_MIN_ITEMS) { _ensureAllImagesLive(); return; }\n    const vw = window.innerWidth || 0, vh = window.innerHeight || 0;\n    if (!vw || !vh) return;\n    const mx = vw * IMG_CULL_MARGIN, my = vh * IMG_CULL_MARGIN;\n    for (let i = 0; i < items.length; i++) {\n      const it = items[i];\n      if (!it || it.isVideo || it.video) continue;\n      const img = it.img;\n      if (!img || !img.parentNode) continue;\n      const s = it.src;\n      // Only local bytes can be put back for free. A remote src is left\n      // alone: re-assigning it means a second fetch and a flicker on\n      // every pan, for a card that is off screen anyway.\n      if (typeof s !== 'string' || s === '' ||\n          (s.indexOf('blob:') !== 0 && s.indexOf('data:') !== 0)) continue;\n      let r = null;\n      try { r = (it.el || img).getBoundingClientRect(); } catch (e) { continue; }\n      const off = r.bottom < -my || r.top > vh + my || r.right < -mx || r.left > vw + mx;\n      if (off) {\n        if (img.getAttribute('src') !== null) {\n          img.removeAttribute('src');\n          it._imgCulled = true;\n        }\n      } else if (it._imgCulled) {\n        img.src = s;\n        it._imgCulled = false;\n      }\n    }\n  } catch (e) { console.warn('[ImgCull] skipped:', e && e.message); }\n}\n\n// Coalesced: updateCanvas runs on every pan/zoom tick (60-120/sec during\n// a trackpad swipe) and a cull walk is far too much to do there.\nfunction scheduleImageCull() {\n  if (_imgCullHandle) clearTimeout(_imgCullHandle);\n  _imgCullHandle = setTimeout(function () { _imgCullHandle = null; _cullOffscreenImages(); }, 220);\n}\n\n// Call from anything that reads the pixels of many images at once. Cheap\n// and safe: it only re-assigns strings and never revokes anything, so a\n// missed call site costs a decode, never data.\nfunction _ensureAllImagesLive() {\n  try {\n    const items = (state && state.items) ? state.items : [];\n    for (let i = 0; i < items.length; i++) {\n      const it = items[i];\n      if (!it || !it._imgCulled || !it.img) continue;\n      it.img.src = it.src;\n      it._imgCulled = false;\n    }\n  } catch (e) {}\n}\n\nfunction updateCanvas() {\n  requestAnimationFrame(positionBoardTextUI);\n  document.querySelectorAll(\".bt-move\").forEach(el => { el.style.transform = \"scale(\" + (1 / Math.max(.05, state.zoom)) + \")\"; });\n  // Canvas uses a large fixed area with coordinate offset (50000px) so the grid\n  // covers all content including negative world coordinates. Items are inside\n  // #canvas-content which is offset by 50000px, so world (0,0) maps to\n  // canvas-local (50000, 50000) \u2014 always inside the canvas box.\n  const OFF = 50000;\n  canvas.style.transform = `translate(${state.pan.x + OFF - OFF * state.zoom}px, ${state.pan.y + OFF - OFF * state.zoom}px) scale(${state.zoom})`;\n  // v7.5.0: the visible set changed, so the culling decision is stale.\n  scheduleImageCull();\n  if (state.reframing && state.reframing._tb) rfPositionToolbar();\n  // v7.0.53: the map's viewport box is a view of the camera, so every camera\n  // tick is a repaint. Coalesced to one paint per frame inside the callee.\n  try { requestMinimapRefresh(); } catch (e) {}\n  // v7.0.33: assigning canvas.width/height ALWAYS reallocates and wipes the\n  // backing store, even when the value is identical \u2014 ~24 MB per call at\n  // dpr 2 on a 1512x982 screen. updateCanvas() runs on every pan/zoom tick\n  // (60-120/sec during a trackpad swipe), so the old lines were churning\n  // well over 1 GB/s of GPU-side allocation while the user merely dragged\n  // the board. The buffer only ever needs to change on a window resize,\n  // and window resize already routes through updateCanvas() (see the\n  // resize listener), so guarding on the current size is safe.\n  // `| 0` matches what the canvas width/height setters do internally\n  // (unsigned long truncation), so the computed size is bit-identical to\n  // the old code's result.\n  const dpr = window.devicePixelRatio || 1;\n  const _bw = (window.innerWidth * dpr) | 0;\n  const _bh = (window.innerHeight * dpr) | 0;\n  const _sw = window.innerWidth + 'px';\n  const _sh = window.innerHeight + 'px';\n  if (drawLayer.width !== _bw || drawLayer.height !== _bh ||\n      drawLayer.style.width !== _sw || drawLayer.style.height !== _sh) {\n    drawLayer.width = _bw;\n    drawLayer.height = _bh;\n    drawLayer.style.width = _sw;\n    drawLayer.style.height = _sh;\n  }\n  // redrawDrawLayer() clearRect()s the whole buffer and repaints every\n  // stroke unconditionally, so skipping the realloc above is invisible.\n  redrawDrawLayer();\n  updateAllGroupBorders();\n  // Update mind map connectors on pan/zoom\n  (state.mindmaps||[]).forEach(mm => mmUpdateConnectors(mm));\n  // Update relation lines on pan/zoom\n  renderRelations();\n  updateStatus();\n  // Viewport culling: hide/freeze items outside visible area to keep framerate high.\n  // Triggered on every pan/zoom. Cheap: just one rectangle-vs-rect test per item.\n  cullOffscreenItems();\n  // v6.8.26: text items are world-coord now, so the canvas transform\n  // scales them with everything else \u2014 no per-zoom re-render needed.\n  // (The v6.8.25 _syncTextItemsForZoom approach kept text at constant\n  // on-screen size, which was wrong: the user expects text to shrink\n  // when zooming out, exactly like images.)\n  // Round 52: keep the floating \"draw panel\" (.media-anno-toolbar) and the\n  // \"frame comment panel\" (.media-anno-popover.list) glued to the video as\n  // the canvas zooms. Both are appended to <body> at position: fixed and\n  // sized by the video's screen-pixel BCR. updateCanvas() runs on every\n  // pan/zoom tick, so this is the single hook to make them follow the\n  // player. Each function early-returns if the panel is hidden / closed,\n  // and the iteration is O(items) \u2014 fine for typical boards (1-3 vids).\n  repositionAllAnnoToolbars();\n  repositionAllAnnoPopovers();\n}\n\n// ============================================================\n//  VIEWPORT CULLING (perf)\n// ============================================================\n// Computes the visible world-space rectangle, then for each item:\n//   - If completely outside: set el.style.display = 'none' (static images) or\n//     pause video / freeze GIF (videos/GIFs still pay decode cost even when hidden).\n//   - If partially inside: leave alone (preserve partial visibility).\n// Called on every updateCanvas() (pan/zoom). Throttled internally \u2014 only does work\n// when visible bounds change by more than 50px.\nconst _cullLast = { vx: -1e9, vy: -1e9, vw: -1, vh: -1 };\nfunction cullOffscreenItems() {\n  // World-space visible rectangle: 4 corners transformed back to canvas-local.\n  const vw = window.innerWidth, vh = window.innerHeight;\n  // visible world rect = (viewport / zoom) - pan\n  const wx = -state.pan.x / state.zoom;\n  const wy = -state.pan.y / state.zoom;\n  const ww = vw / state.zoom;\n  const wh = vh / state.zoom;\n  // Skip if bounds haven't moved much (cheap fast path)\n  if (Math.abs(_cullLast.vx - wx) < 50 && Math.abs(_cullLast.vy - wy) < 50 &&\n      Math.abs(_cullLast.vw - ww) < 50 && Math.abs(_cullLast.vh - wh) < 50) return;\n  _cullLast.vx = wx; _cullLast.vy = wy; _cullLast.vw = ww; _cullLast.vh = wh;\n\n  // Expand visible rect by 200px so partially-cropped items don't flicker on small pans\n  const pad = 200;\n  const x0 = wx - pad, y0 = wy - pad, x1 = wx + ww + pad, y1 = wy + wh + pad;\n  const allItems = [\n    ...state.items,\n    ...state.texts,\n    ...(state.todos||[]),\n    ...(state.mindmaps||[])\n  ];\n  for (let i = 0; i < allItems.length; i++) {\n    const it = allItems[i];\n    if (!it.el) continue;\n    const ix = it.x, iy = it.y;\n    const iw = it.w || 100, ih = it.h || 100;\n    // AABB test with padding (item must overlap visible area to be visible)\n    if (ix + iw < x0 || ix > x1 || iy + ih < y0 || iy > y1) {\n      // Off-screen\n      if (!it._culled) {\n        it._culled = true;\n        if (it.video) {\n          if (!it.video.paused) {\n            // Pause video but remember it was playing\n            it._wasPlaying = true;\n            it.video.pause();\n          }\n          // v7.0.33: stop the browser buffering ahead for a clip nobody is\n          // looking at. preload='metadata' caps how far the demuxer runs\n          // while the video is parked off screen; 'auto' comes back the\n          // moment it returns (see below), and playMediaEl() forces 'auto'\n          // as well.\n          // NOTE: this deliberately does NOT drop the src. Releasing the\n          // decoder properly needs removeAttribute('src') + load(), which\n          // also zeroes videoWidth/duration \u2014 and export / capture / frame\n          // comments all draw off-screen videos synchronously, so a parked\n          // video would silently export as a black rectangle. Not worth it.\n          if (it.video.paused && it.video.preload === 'auto') {\n            try { it.video.preload = 'metadata'; it._preloadWasAuto = true; } catch (e) {}\n          }\n        } else if (it.img && (it.isGif || isAnimatedGif(it.src)) && !_frozenGifs.has(it.id)) {\n          // Freeze animated GIFs (replace with static first frame) \u2014 this is the biggest perf win\n          try {\n            const c = document.createElement('canvas');\n            c.width = it.img.naturalWidth || it.natW || iw;\n            c.height = it.img.naturalHeight || it.natH || ih;\n            const cctx = c.getContext('2d');\n            cctx.drawImage(it.img, 0, 0);\n            const staticSrc = c.toDataURL('image/png');\n            _frozenGifs.set(it.id, it.img.src);\n            it.img.src = staticSrc;\n          } catch (e) { /* CORS or other \u2014 skip freeze */ }\n        }\n      }\n    } else {\n      // On-screen\n      if (it._culled) {\n        it._culled = false;\n        // v7.0.33: give back the buffering budget the cull took away.\n        if (it.video && it._preloadWasAuto) {\n          try { it.video.preload = 'auto'; } catch (e) {}\n          it._preloadWasAuto = false;\n        }\n        if (it.video && it._wasPlaying) {\n          // v7.0.33: an automatic resume \u2014 registers in the LRU order but\n          // never evicts. _wasPlaying is only ever set by the culling pass\n          // itself, so Pause All / budget evictions no longer \"come back\n          // to life\" here on the next pan.\n          resumeMediaEl(it.video);\n          it._wasPlaying = false;\n        } else if (it.img && _frozenGifs.has(it.id) && !it._userFrozen) {\n          // Restore animated GIF \u2014 only if cull froze it (not user-frozen)\n          const origSrc = _frozenGifs.get(it.id);\n          if (it.img) it.img.src = origSrc;\n          _frozenGifs.delete(it.id);\n        }\n      }\n    }\n  }\n}\n// v7.14.0: collapsible toolbar -- the bar hides, a centered pill restores it; persisted across sessions\nfunction setToolbarCollapsed(collapsed) {\n  var tb = document.getElementById('toolbar');\n  var pill = document.getElementById('toolbar-expand');\n  if (!tb || !pill) return;\n  tb.classList.toggle('collapsed', !!collapsed);\n  pill.classList.toggle('show', !!collapsed);\n  try { localStorage.setItem('krafted_toolbar_collapsed', collapsed ? '1' : '0'); } catch(e) {}\n}\n// v7.14.0: restore collapsed state on load\n(function() {\n  try {\n    if (localStorage.getItem('krafted_toolbar_collapsed') === '1') {\n      var tb = document.getElementById('toolbar');\n      var pill = document.getElementById('toolbar-expand');\n      if (tb) tb.classList.add('collapsed');\n      if (pill) pill.classList.add('show');\n    }\n  } catch(e) {}\n})();\n// v6.1.8s: Implement missing toggleProps function\nfunction toggleProps() {\n  var p = document.getElementById('props');\n  if (!p) return;\n  p.classList.toggle('collapsed');\n  // Persist preference\n  try { localStorage.setItem('krafted_props_collapsed', p.classList.contains('collapsed') ? '1' : '0'); } catch(e) {}\n}\n// v6.1.8s: On load, restore collapsed state\n(function() {\n  try {\n    if (localStorage.getItem('krafted_props_collapsed') === '1') {\n      var p = document.getElementById('props');\n      if (p) p.classList.add('collapsed');\n    }\n  } catch(e) {}\n})();\nfunction updateStatus() {\n  const selCount = state.selected.size;\n  const selText = selCount > 1 ? ` | ${selCount} selected (drag to move all)` : selCount === 1 ? ' | 1 selected' : '';\n  // v6.2.7: real-time memory meter \u2014 sum blob: / data: URL sizes\n  // v6.5.0: also count lazy videos via _kpakEntry / _lazyEntry size\n  var memMB = 0;\n  var blobCount = 0;\n  var allItems = state.items.concat(state.texts, (state.todos || []), (state.mindmaps || []));\n  for (var i = 0; i < allItems.length; i++) {\n    var it = allItems[i];\n    if (it._kpakEntry && it._kpakEntry.size) { memMB += it._kpakEntry.size / (1024 * 1024); blobCount++; continue; }\n    if (it._lazyEntry && it._lazyEntry.size) { memMB += it._lazyEntry.size / (1024 * 1024); blobCount++; continue; }\n    if (!it.src) continue;\n    if (it._fileSize) { memMB += it._fileSize / (1024 * 1024); blobCount++; }\n    else if (it.src.startsWith('data:')) {\n      var b64 = it.src.indexOf(';base64,') >= 0 ? (it.src.split(',')[1] || '').length : 0;\n      memMB += Math.round(b64 * 0.75) / (1024 * 1024);\n      blobCount++;\n    } else if (it.src.startsWith('blob:')) {\n      // blob: without _fileSize \u2014 rough estimate\n      memMB += it.isVideo ? 80 : 5; // ~80MB default for video, 5MB for image\n      blobCount++;\n    }\n  }\n  var memStr = '';\n  if (blobCount > 0) {\n    // v6.5.0: removed 1.5GB warning \u2014 v6 streaming kpak uses Blob.slice()\n    // for on-demand extraction, so total kpak entry sizes don't reflect\n    // actual RAM usage. Showing \"1.5 GB \u26A0\" misleads users into thinking\n    // the browser is about to OOM when in fact only a few MB are loaded.\n    memStr = ' | Mem: ' + (memMB >= 1024 ? (memMB / 1024).toFixed(1) + ' GB' : Math.round(memMB) + ' MB');\n  }\n  var stEl = document.getElementById('status');\n  if (stEl) {\n    stEl.textContent = 'Zoom: ' + Math.round(state.zoom * 100) + '% | Items: ' + (state.items.length + state.texts.length + (state.todos ? state.todos.length : 0) + (state.mindmaps ? state.mindmaps.length : 0)) + selText + ' | Undo: ' + state.undoStack.length + memStr;\n    // v6.5.0: memory pressure color-coding removed (warning icon gone)\n    stEl.style.color = '';\n  }\n}\nfunction zoomBy(factor, cx, cy) {\n  zoomTo(state.zoom * factor, cx, cy);\n}\nfunction zoomTo(z, cx, cy) {\n  if (cx === undefined) { cx = window.innerWidth/2; cy = window.innerHeight/2; }\n  const oldZ = state.zoom;\n  state.zoom = Math.max(0.02, Math.min(10, z));\n  state.pan.x = cx - (cx - state.pan.x) * (state.zoom / oldZ);\n  state.pan.y = cy - (cy - state.pan.y) * (state.zoom / oldZ);\n  updateCanvas();\n}\n\n// Frame / focus the viewport. Maya-style:\n//   - If anything is selected, compute the union bounding box of the\n//     selection (items, text, todo, mindmap) and zoom + pan so the box\n//     fills ~80% of the visible area, centered on the viewport center.\n//   - If nothing is selected, reset to the app-open default (zoom=1,\n//     pan=(0,0)) so world (0,0) is at the top-left of the visible area.\n// Bound to the F key and to the \"\uF3AF Frame\" button in the zoom-step widget.\nfunction frameSelection() {\n  // Don't disturb the viewport while the user is mid-action on the board\n  // (dragging an item, drawing, reframe, crop, free cut, lasso) \u2014 pressing\n  // F should not yank the view out from under their cursor. We only block\n  // when a real interaction is in flight.\n  if (state.dragging || state.reframing || state.cropping || cutState || lassoState) return;\n  const sel = state.selected;\n  if (!sel || sel.size === 0) {\n    // No selection: reset to default (zoom=1, pan=(0,0)) so world (0,0)\n    // sits at the top-left of the visible area, like when the app opens.\n    state.zoom = 1;\n    state.pan.x = 0;\n    state.pan.y = 0;\n    updateCanvas();\n    try { toast('View reset \u00B7 100% \u00B7 (0, 0)  \u2014  F'); } catch (e) {}\n    return;\n  }\n  // Gather bounding boxes of every selected thing in WORLD coordinates.\n  // v7.0.37: the walk itself now lives in worldBBoxOf() so that F (frame\n  // selection) and the mobile Fit button cannot drift apart on what counts\n  // as \"the content\". It used to be inlined here and nowhere else, which is\n  // exactly how zoomToFit() ended up missing entirely.\n  const selArr = Array.from(sel);\n  const bb = worldBBoxOf(selArr);\n  if (!bb) {\n    // Selected IDs don't match anything (e.g. mid-load, stale id). Fall\n    // back to default so F still does something sensible.\n    state.zoom = 1;\n    state.pan.x = 0;\n    state.pan.y = 0;\n    updateCanvas();\n    try { toast('View reset \u00B7 100% \u00B7 (0, 0)  \u2014  F'); } catch (e) {}\n    return;\n  }\n  let minX = bb.minX, minY = bb.minY, maxX = bb.maxX, maxY = bb.maxY;\n  const count = bb.count;\n  // Clamp degenerate selections (single point or zero-area) to a small\n  // 80\u00D760 region so we don't divide by zero in the zoom math.\n  if (maxX - minX < 1) { minX -= 40; maxX += 40; }\n  if (maxY - minY < 1) { minY -= 30; maxY += 30; }\n  const bboxCx = (minX + maxX) / 2;\n  const bboxCy = (minY + maxY) / 2;\n  const bboxW  = maxX - minX;\n  const bboxH  = maxY - minY;\n  // Padding: leave ~12% margin around the bounding box so the selection\n  // doesn't kiss the screen edges. 1.0 = tight, 1.5 = very generous.\n  const PADDING = 1.24;\n  const sw = window.innerWidth;\n  const sh = window.innerHeight;\n  const targetW = bboxW * PADDING;\n  const targetH = bboxH * PADDING;\n  // Use min so the WHOLE bbox fits (don't crop). Also cap at 10x so a\n  // tiny selection (e.g. one small image) doesn't zoom to a screenful of\n  // pixelated nothing.\n  let z = Math.min(sw / Math.max(1, targetW), sh / Math.max(1, targetH));\n  z = Math.max(0.02, Math.min(10, z));\n  state.zoom = z;\n  // Center the bbox on the viewport center.\n  state.pan.x = sw / 2 - bboxCx * state.zoom;\n  state.pan.y = sh / 2 - bboxCy * state.zoom;\n  updateCanvas();\n  try {\n    const tag = count === 1 ? '1 item' : count + ' items';\n    toast('Framed ' + tag + ' \u00B7 ' + Math.round(state.zoom * 100) + '%  \u2014  F');\n  } catch (e) {}\n}\n\n// v7.0.37 \u2014 P1-8. Union bounding box of board objects, in WORLD coordinates.\n// `ids` is an array or Set of ids, or null/undefined for EVERYTHING on the\n// board. Returns null when nothing matched.\n//   items    \u2014 x/y/w/h are already world coords\n//   texts /\n//   todos    \u2014 world-positioned but auto-sized from their DOM, so read the\n//              rendered box and convert back through pan + zoom\n//   mindmaps \u2014 union of node positions (nodes are points)\nfunction worldBBoxOf(ids) {\n  let minX = Infinity, minY = Infinity, maxX = -Infinity, maxY = -Infinity, count = 0;\n  const want = (ids == null) ? null\n    : ((typeof Set !== 'undefined' && ids instanceof Set) ? ids : new Set(Array.from(ids)));\n  const takes = function (id) { return !want || want.has(id); };\n  const addRect = function (x, y, w, h) {\n    if (!isFinite(x) || !isFinite(y) || !isFinite(w) || !isFinite(h)) return;\n    if (x < minX) minX = x;\n    if (y < minY) minY = y;\n    if (x + w > maxX) maxX = x + w;\n    if (y + h > maxY) maxY = y + h;\n    count++;\n  };\n  (state.items || []).forEach(function (it) {\n    if (!takes(it.id)) return;\n    addRect(it.x, it.y, it.w || 0, it.h || 0);\n  });\n  [state.texts, state.todos].forEach(function (list) {\n    (list || []).forEach(function (t) {\n      if (!takes(t.id)) return;\n      if (t.el && typeof t.el.getBoundingClientRect === 'function') {\n        const r = t.el.getBoundingClientRect();\n        if (r.width || r.height) {\n          addRect((r.left - state.pan.x) / state.zoom, (r.top - state.pan.y) / state.zoom,\n                  r.width / state.zoom, r.height / state.zoom);\n          return;\n        }\n      }\n      addRect(t.x, t.y, t.w || 0, t.h || 0);\n    });\n  });\n  (state.mindmaps || []).forEach(function (mm) {\n    if (!takes(mm.id)) return;\n    if (!Array.isArray(mm.nodes) || mm.nodes.length === 0) return;\n    let seen = false;\n    mm.nodes.forEach(function (n) {\n      if (typeof n.x !== 'number' || typeof n.y !== 'number') return;\n      if (n.x < minX) minX = n.x;\n      if (n.y < minY) minY = n.y;\n      if (n.x > maxX) maxX = n.x;\n      if (n.y > maxY) maxY = n.y;\n      seen = true;\n    });\n    if (seen) count++;\n  });\n  if (count === 0 || !isFinite(minX) || !isFinite(maxX)) return null;\n  return { minX: minX, minY: minY, maxX: maxX, maxY: maxY, count: count };\n}\n\n// v7.0.37 \u2014 P1-8. Pan the board the minimum amount needed to bring a world\n// rect fully on screen. Zoom is left ALONE unless allowZoomOut is set: a\n// user who zoomed to 300% to retouch a detail does not want that thrown away\n// because they pasted a screenshot. When the rect is bigger than the\n// viewport at the current zoom it is centred instead of edge-pinned, so the\n// middle of the content (what they were looking at) stays reachable.\nfunction revealWorldRect(minX, minY, maxX, maxY, opts) {\n  const sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  const nothing = { moved: false, dx: 0, dy: 0, zoom: state.zoom };\n  if (!(sw > 0) || !(sh > 0)) return nothing;\n  if (!isFinite(minX) || !isFinite(minY) || !isFinite(maxX) || !isFinite(maxY)) return nothing;\n  // Degenerate rect (a single point, or a zero-area item) \u2014 give it a size\n  // so the edge tests below have something to work with.\n  if (maxX - minX < 1) { const cx = (minX + maxX) / 2; minX = cx - 20; maxX = cx + 20; }\n  if (maxY - minY < 1) { const cy = (minY + maxY) / 2; minY = cy - 15; maxY = cy + 15; }\n  const o = opts || {};\n  // 40px of breathing room, but never eat more than a third of a small\n  // screen (phones) or the margin would push the content back off it.\n  let margin = (o.margin === undefined) ? 40 : o.margin;\n  margin = Math.max(0, Math.min(margin, (Math.min(sw, sh) - 40) / 2));\n  let z = state.zoom;\n  if (o.allowZoomOut) {\n    const fitZ = Math.min((sw - margin * 2) / Math.max(1, maxX - minX),\n                          (sh - margin * 2) / Math.max(1, maxY - minY));\n    if (fitZ < z) { z = Math.max(0.02, fitZ); state.zoom = z; }\n  }\n  // world -> screen is  world * zoom + pan, so a zoom change needs no pan\n  // correction here: we simply recompute where the rect landed.\n  const rw = (maxX - minX) * z, rh = (maxY - minY) * z;\n  const sx = minX * z + state.pan.x, sy = minY * z + state.pan.y;\n  let dx = 0, dy = 0;\n  if (rw + margin * 2 >= sw)      dx = (sw - rw) / 2 - sx;\n  else if (sx < margin)           dx = margin - sx;\n  else if (sx + rw > sw - margin) dx = (sw - margin) - (sx + rw);\n  if (rh + margin * 2 >= sh)      dy = (sh - rh) / 2 - sy;\n  else if (sy < margin)           dy = margin - sy;\n  else if (sy + rh > sh - margin) dy = (sh - margin) - (sy + rh);\n  const moved = Math.abs(dx) > 0.5 || Math.abs(dy) > 0.5;\n  if (moved) { state.pan.x += dx; state.pan.y += dy; }\n  updateCanvas();\n  return { moved: moved, dx: dx, dy: dy, zoom: z };\n}\n\n// Convenience wrapper: reveal one board object by its world x/y/w/h.\nfunction revealItem(item, opts) {\n  if (!item) return null;\n  return revealWorldRect(item.x, item.y, item.x + (item.w || 0), item.y + (item.h || 0), opts);\n}\n\n// v7.0.37: fit EVERYTHING on the board in view. The mobile toolbar's \u22A1\n// button has been calling zoomToFit() since v6 although the function never\n// existed \u2014 tapping it threw a ReferenceError and did nothing at all.\nfunction zoomToFit() {\n  const bb = worldBBoxOf(null);\n  const sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  if (!bb || !(sw > 0) || !(sh > 0)) {\n    state.zoom = 1; state.pan.x = 0; state.pan.y = 0; updateCanvas();\n    return;\n  }\n  const margin = Math.max(0, Math.min(60, (Math.min(sw, sh) - 40) / 2));\n  const bw = Math.max(1, bb.maxX - bb.minX), bh = Math.max(1, bb.maxY - bb.minY);\n  let z = Math.min(Math.max(1, sw - margin * 2) / bw, Math.max(1, sh - margin * 2) / bh);\n  z = Math.max(0.02, Math.min(10, z));\n  state.zoom = z;\n  state.pan.x = sw / 2 - ((bb.minX + bb.maxX) / 2) * z;\n  state.pan.y = sh / 2 - ((bb.minY + bb.maxY) / 2) * z;\n  updateCanvas();\n  try { toast('Fit \u00B7 ' + Math.round(state.zoom * 100) + '% \u00B7 ' + bb.count + ' items'); } catch (e) {}\n}\n\n// ============================================================\n//  ITEM METADATA + LIBRARY   (v7.0.51, P0-2 + P1-1)\n// ============================================================\n// P0-2: every item gains name / note / tags so the board can be searched and\n// the script export (P1-4) has something to print. They are written through\n// ONE function, setItemMeta, so there is exactly one place a metadata field is\n// assigned - the same 'one writer' discipline that killed the reframe field\n// drift. The Properties Reference section and the Library both read these.\nfunction splitTags(s) {\n  if (!s) return [];\n  return String(s).split(',').map(function (t) { return t.trim(); }).filter(function (t) { return t.length; });\n}\n// v7.3.0 \u2014 a dropped folder's name rides along with its files.\n// _handleEntryDrop() has stamped every dropped file with its folder path as\n// `file._kraftedPath` (e.g. \"Refs/Head\") since v5.5.1, and NOTHING ever read\n// it: a 200-image folder landed as 200 anonymous items that the Library could\n// not find. That path is dead weight no longer - but it is read in exactly one\n// place, and the metadata it produces is written in exactly one place.\nfunction folderTagsFromPath(path) {\n  if (!path) return [];\n  return String(path).split('/')\n    .map(function (s) { return s.trim().replace(/,/g, ' ').replace(/\\s+/g, ' '); })\n    .filter(function (s) { return s.length && s !== '.' && s !== '..'; });\n}\n// Merge, never overwrite: an item may already carry tags, and a second import\n// into the same board must not wipe them. Case-insensitive so \"Head\" from one\n// drop and \"head\" from another do not both land on the same item.\nfunction mergeTags(existing, added) {\n  var out = (existing && existing.length) ? existing.slice() : [];\n  (added || []).forEach(function (t) {\n    var seen = false;\n    for (var i = 0; i < out.length; i++) {\n      if (String(out[i]).toLowerCase() === String(t).toLowerCase()) { seen = true; break; }\n    }\n    if (!seen) out.push(t);\n  });\n  return out;\n}\n// One writer for \"what an import stamps onto an item\". Every import path\n// (folder drop, plain file drop, paste; image, video, audio) funnels through\n// here, so the rule exists once instead of once per call site - one behaviour\n// with N hand-written copies is the oldest root cause on this project.\n// The comma -> space substitution in folderTagsFromPath is deliberate: the\n// Tags field is comma-separated, so a folder literally named \"a,b\" would\n// split into two tags the first time the user edited any tag on that item.\nfunction applyImportMeta(item, file) {\n  if (!item || !file) return item;\n  if (!item.filename && file.name) {\n    item.filename = file.name;\n    try { if (item.el && item.el._setFilenameBadge) item.el._setFilenameBadge(file.name); } catch (e) {}\n  }\n  var ftags = folderTagsFromPath(file._kraftedPath);\n  if (ftags.length) {\n    item.tags = mergeTags(item.tags, ftags);\n    try { scheduleAutoSave(); } catch (e) {}\n  }\n  // No second scheduleAutoSave() here: a non-empty key implies a non-empty\n  // ftags, and the branch above has already queued one.\n  var gkey = folderGroupKey(file._kraftedPath);\n  if (gkey) addItemToFolderGroup(item, gkey);\n  return item;\n}\n\n// v7.4.0 \u2014 a dropped folder becomes a NAMED GROUP: one dashed block per\n// folder with the path printed above it. v7.3.0 already wrote the name into\n// tags; this is the half you can SEE. Keyed on the FULL path, so \"Refs/Head\"\n// and \"Refs/Body\" are two blocks rather than one big one.\n// `folderKey` is deliberately NOT serialised: it is a hint for the session\n// that produced the drop. Appending two boards that each carry a \"Head\" group\n// must keep them apart (group ids are renumbered for the same reason), and a\n// re-drop after a reload starts a fresh block instead of silently growing a\n// stale one.\nfunction folderGroupKey(path) {\n  return folderTagsFromPath(path).join('/');\n}\n\nvar _folderBorderTimer = 0;\n// Import fans out one file every 50ms and updateGroupBorder measures every\n// member with getBoundingClientRect. Re-measuring a 300-strong group on every\n// arrival is O(n^2) forced reflows, so coalesce: at most one pass per 120ms.\nfunction scheduleFolderGroupUpdate() {\n  if (_folderBorderTimer) return;\n  _folderBorderTimer = setTimeout(function () {\n    _folderBorderTimer = 0;\n    updateAllGroupBorders();\n  }, 120);\n}\n\nfunction addItemToFolderGroup(item, key) {\n  if (!item || !key) return;\n  var g = null;\n  for (var i = 0; i < state.groups.length; i++) {\n    if (state.groups[i].folderKey === key) { g = state.groups[i]; break; }\n  }\n  if (!g) {\n    var gid = G.nextGroupId++;\n    g = makeGroupEl({ id: gid, color: GROUP_COLORS[(gid - 1) % GROUP_COLORS.length], name: key, memberIds: [] });\n    g.folderKey = key;\n    state.groups.push(g);\n  }\n  g.memberIds.add(item.id);\n  scheduleFolderGroupUpdate();\n}\n// ONE definition of \"does this item match the Library search\", shared by the\n// Library list and the minimap highlight. Two hand-written copies of the same\n// filter is the oldest root cause on this project - they always drift, and one\n// of them always ends up deciding something different from the other.\n\n\n\nfunction toggleLibraryPanel() {\n  var p = document.getElementById('library-panel');\n  if (!p) return;\n  p.classList.toggle('collapsed');\n  renderLibraryPanel();\n  try { localStorage.setItem('krafted_library_collapsed', p.classList.contains('collapsed') ? '1' : '0'); } catch (e) {}\n}\n\n// v7.0.52: two different jobs, deliberately kept apart.\n//\n// requestLibraryRefresh() = 'the CONTENTS changed' (an item was added, deleted,\n// imported, pasted, undone or loaded). It rebuilds the list, and it is\n// debounced to one rebuild per frame because scheduleAutoSave() - the single\n// funnel every board mutation already passes through - can fire dozens of\n// times in a row.\n//\n// libSyncActive() = 'the SELECTION changed'. It never rebuilds anything; it\n// only moves the .active class onto the row for the selected item and scrolls\n// it into view. Runs on every pointermove of a marquee select, so it must stay\n// O(rows) with an early-out when the id has not moved.\nvar LIB_ROW_CAP = 150;\nvar _libActiveId = null;\nvar _libRefreshPending = false;\n\nfunction requestLibraryRefresh() {\n  var p = document.getElementById('library-panel');\n  if (!p || p.classList.contains('collapsed')) return;\n  if (_libRefreshPending) return;\n  _libRefreshPending = true;\n  var run = function () { _libRefreshPending = false; renderLibraryPanel(); };\n  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(run);\n  else setTimeout(run, 60);\n}\n\nfunction libSyncActive() {\n  var p = document.getElementById('library-panel');\n  if (!p || p.classList.contains('collapsed')) return;\n  var rows = p.querySelectorAll('.lib-row[data-id]');\n  if (!rows.length) return;\n  var sel = (typeof getSelectedItems === 'function') ? getSelectedItems() : [];\n  var id = sel.length ? String(sel[0].id) : null;\n  if (id === _libActiveId) return;\n  _libActiveId = id;\n  var found = null;\n  for (var i = 0; i < rows.length; i++) {\n    var on = rows[i].getAttribute('data-id') === id;\n    if (on) rows[i].classList.add('active');\n    else rows[i].classList.remove('active');\n    if (on) found = rows[i];\n  }\n  if (found && found.scrollIntoView) { try { found.scrollIntoView({ block: 'nearest' }); } catch (e) {} }\n}\n\n// Restored on boot, the same way the views and properties panels already are.\n// v7.0.51 wrote this key but never read it back, so the panel forgot whether\n// the user had opened it on every single reload.\n(function initLibraryPanel() {\n  if (typeof document === 'undefined') return;\n  var apply = function () {\n    var p = document.getElementById('library-panel');\n    if (!p) return;\n    var collapsed = true;\n    try { collapsed = localStorage.getItem('krafted_library_collapsed') !== '0'; } catch (e) {}\n    p.classList.toggle('collapsed', collapsed);\n    renderLibraryPanel();\n  };\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);\n  else apply();\n})();\n\nfunction libThumbSrc(it) {\n  if (!it) return null;\n  if (it.isVideo) { if (it.img && it.img.poster) return it.img.poster; return null; }\n  if (it.img && it.img.src) return it.img.src;\n  if (it.src) return it.src;\n  return null;\n}\n\n// v7.22.0: LIBRARY THUMBNAILS MUST NOT DECODE THE ORIGINAL.\n// A lib-row thumb is 34 CSS px (68 device px at 2x). Pointing <img> at the\n// item's full-resolution source kept one decoded bitmap alive per row: a\n// 150-item board held ~618 MB of bitmaps (~7 GB of real footage) and the\n// renderer OOM'd. Worse, renderLibraryPanel() rebuilds every row on each\n// keystroke, so the decode storm repeated while you typed.\n// One pipeline: decode -> downscale to LIB_THUMB_MAX_SIDE -> cache on the\n// item. The full-size <img> is dropped immediately after the draw, so only\n// the 96px JPEG stays resident, and only LIB_THUMB_CONCURRENCY originals\n// are ever in flight.\nvar LIB_THUMB_MAX_SIDE = 96;\nvar LIB_THUMB_CONCURRENCY = 4;\nvar LIB_THUMB_JPEG_Q = 0.72;\nvar _libThumbCache = (typeof WeakMap === 'function') ? new WeakMap() : null;\nvar _libThumbQueue = [];\nvar _libThumbBusy = 0;\n\n// The sizing rule, kept pure so a test can execute it (rule 19): an anchor\n// proves the code exists, running it proves it is right.\nfunction libThumbFit(w, h, cap) {\n  w = Math.max(1, w | 0);\n  h = Math.max(1, h | 0);\n  cap = Math.max(1, cap | 0);\n  var m = Math.max(w, h);\n  if (m <= cap) return { w: w, h: h };\n  var k = cap / m;\n  return { w: Math.max(1, Math.round(w * k)), h: Math.max(1, Math.round(h * k)) };\n}\n\nfunction libThumbGet(it) {\n  if (!_libThumbCache || !it) return undefined;\n  try { return _libThumbCache.get(it); } catch (e) { return undefined; }\n}\n\nfunction libThumbSet(it, v) {\n  if (!_libThumbCache || !it) return;\n  try { _libThumbCache.set(it, v); } catch (e) {}\n}\n\n// The letter / glyph shown when there is no image at all, in one place so\n// the fallback path and the failed-decode path cannot drift apart.\nfunction libThumbGlyph(it, isText) {\n  if (isText) return 'T';\n  var t = it && it.type;\n  if (t === 'video') return '\\u25B6';\n  if (t === 'audio') return '\\u266A';\n  if (t === 'link') return '\\uD83D\\uDD17';\n  return '\\u25A2';\n}\n\nfunction _libThumbFinish(entry, url) {\n  entry.state = 'done';\n  entry.url = url || null;\n  var cbs = entry.cbs;\n  entry.cbs = [];\n  for (var i = 0; i < cbs.length; i++) {\n    try { cbs[i](entry.url); } catch (e) {}\n  }\n}\n\nfunction _libThumbDecode(job, done) {\n  var img = new Image();\n  var settled = false;\n  var finish = function (url) {\n    if (settled) return;\n    settled = true;\n    // v7.22.0: the decoded original is the thing we are trying to get rid\n    // of. Drop the handlers and the reference now, not when the function\n    // happens to return \u2014 otherwise the next decode starts while this\n    // bitmap is still reachable and the real peak is CAP + 1.\n    try { img.onload = null; img.onerror = null; } catch (e) {}\n    _libThumbFinish(job.entry, url);\n    done();\n    img = null;\n  };\n  img.onload = function () {\n    var iw = img.naturalWidth || img.width || 0;\n    var ih = img.naturalHeight || img.height || 0;\n    // No dimensions: nothing to downscale, hand the source straight back\n    // rather than re-encoding something we cannot measure.\n    if (!iw || !ih) { finish(job.src); return; }\n    var fit = libThumbFit(iw, ih, LIB_THUMB_MAX_SIDE);\n    if (fit.w >= iw && fit.h >= ih) { finish(job.src); return; }\n    var cv = document.createElement('canvas');\n    cv.width = fit.w;\n    cv.height = fit.h;\n    var cx = cv.getContext('2d');\n    if (!cx) { finish(job.src); return; }\n    cx.imageSmoothingEnabled = true;\n    if ('imageSmoothingQuality' in cx) cx.imageSmoothingQuality = 'high';\n    try { cx.drawImage(img, 0, 0, fit.w, fit.h); } catch (e) { finish(job.src); return; }\n    var out = '';\n    try { out = cv.toDataURL('image/jpeg', LIB_THUMB_JPEG_Q); } catch (e) { out = ''; }\n    finish(out || job.src);\n  };\n  img.onerror = function () { finish(null); };\n  try { img.src = job.src; } catch (e) { finish(null); }\n}\n\nfunction _libThumbPump() {\n  while (_libThumbBusy < LIB_THUMB_CONCURRENCY && _libThumbQueue.length) {\n    var job = _libThumbQueue.shift();\n    if (!job || job.entry.state === 'done') continue;\n    _libThumbBusy++;\n    _libThumbDecode(job, function () {\n      _libThumbBusy--;\n      // v7.22.0: pump on the next tick. Pumping synchronously from inside\n      // the finished decode's onload keeps that decode's <img> reachable\n      // for the whole of the next one, so the cap is off by one in the\n      // direction that matters (memory held, not throughput).\n      setTimeout(function () { _libThumbPump(); }, 0);\n    });\n  }\n}\n\n// Ask for a row thumbnail. Calls back with a small data URL, or null when\n// there is nothing to show (no source, or the decode failed). Cached per\n// item, so re-rendering the panel \u2014 which happens on every keystroke \u2014\n// never decodes the same original twice.\nfunction libThumbFor(it, cb) {\n  var src = libThumbSrc(it);\n  if (!src) { try { cb(null); } catch (e) {} return null; }\n  var entry = libThumbGet(it);\n  if (entry && entry.src === src) {\n    if (entry.state === 'done') { try { cb(entry.url); } catch (e) {} return entry.url; }\n    entry.cbs.push(cb);\n    return null;\n  }\n  entry = { state: 'pending', src: src, url: null, cbs: [cb] };\n  libThumbSet(it, entry);\n  _libThumbQueue.push({ entry: entry, src: src });\n  _libThumbPump();\n  return null;\n}\n\n// P1-1: a searchable index of the whole board. 300 images are impossible to\n// find by panning, so this is the navigation entry point. Each row flies the\n// camera to the item (revealItem) and selects it. Search covers name, note and\n// tags - the three fields P0-2 just added.\nfunction libraryItems() {\n  return (state.items || []).concat(state.texts || []);\n}\n\nfunction libMatches(it, q) {\n  if (!q) return true;\n  var texts = (typeof state !== 'undefined' && state && state.texts) ? state.texts : [];\n  var isText = it.el ? it.el.classList.contains('text-item') : texts.indexOf(it) >= 0;\n  var body = isText ? (it.el ? it.el.textContent : (it.content || '')) : '';\n  var tags = (typeof boardTagValues === 'function') ? boardTagValues(it.tags) : ((it.tags || []).filter(Boolean));\n  var hay = [it.name, it.note, tags.join(' '), body].join(' ').toLowerCase();\n  return hay.indexOf(String(q).toLowerCase()) >= 0;\n}\n\nfunction renderLibraryPanel() {\n  var p = document.getElementById('library-panel');\n  if (!p || p.classList.contains('collapsed')) return;\n  var listEl = document.getElementById('library-list');\n  if (!listEl) return;\n  var q = ((document.getElementById('library-search').value) || '').toLowerCase().trim();\n  var source = (typeof libraryItems === 'function') ? libraryItems() : (state.items || []).concat(state.texts || []);\n  var items = source.filter(function (it) {\n    if (it.type === 'draw' || it.isDraw) return false;\n    return libMatches(it, q);\n  });\n  // The minimap tints search hits, so a new query is also a new map.\n  try { requestMinimapRefresh(); } catch (e) {}\n  var head = document.getElementById('library-head-text');\n  if (head) head.textContent = items.length ? ('Library ' + items.length) : 'Library';\n  // v7.22.0: the render generation lives on the list, NOT on a global.\n  // A cached thumbnail is delivered SYNCHRONOUSLY, while the row is still\n  // being built and is not in the document yet \u2014 so `isConnected` is\n  // false and the thumbnail was dropped on every render after the first\n  // (found by the live smoke test: reopening the panel showed empty\n  // boxes). The generation, not DOM attachment, says \"this row is\n  // current\". Kept off `window` on purpose (rule 6m: a new global breaks\n  // every old suite that compiles this function in isolation).\n  listEl._libRenderToken = (listEl._libRenderToken | 0) + 1;\n  listEl.innerHTML = '';\n  if (!items.length) { listEl.innerHTML = '<div class=\"views-empty\">No items match.</div>'; return; }\n  var sel0 = (typeof getSelectedItems === 'function') ? getSelectedItems() : [];\n  var activeId = sel0.length ? sel0[0].id : null;\n  _libActiveId = activeId ? String(activeId) : null;\n  // v7.0.52: cap the rows. A 300-item board was building 300 <img> nodes whose\n  // src is a full-resolution data URL, on every keystroke - the list stuttered\n  // and kept the decoded bitmaps alive. 150 rows is more than a screenful, and\n  // past that the search box is the faster tool anyway.\n  var shown = items.length > LIB_ROW_CAP ? items.slice(0, LIB_ROW_CAP) : items;\n  shown.forEach(function (it) {\n    var row = document.createElement('div');\n    row.className = 'lib-row' + (it.id === activeId ? ' active' : '');\n    row.setAttribute('data-id', String(it.id));\n    var thumb = document.createElement('div');\n    thumb.className = 'lib-thumb';\n    var isText = (state.texts || []).indexOf(it) !== -1;\n    var src = libThumbSrc(it);\n    var showGlyph = function () { thumb.textContent = libThumbGlyph(it, isText); };\n    if (src) {\n      // v7.22.0: the <img> starts empty and is filled from the thumbnail\n      // cache. It is never assigned the full-resolution source.\n      var im = document.createElement('img');\n      im.draggable = false;\n      thumb.appendChild(im);\n      var token = listEl._libRenderToken;\n      libThumbFor(it, function (u) {\n        // A cached hit calls back synchronously, before this row reaches\n        // the document: isConnected would be false and the thumbnail\n        // would be dropped on every render but the first.\n        if (token !== listEl._libRenderToken) return;\n        if (u) { im.src = u; return; }\n        if (im.parentNode) im.parentNode.removeChild(im);\n        showGlyph();\n      });\n    } else { showGlyph(); }\n    row.appendChild(thumb);\n    var meta = document.createElement('div');\n    meta.className = 'lib-meta';\n    var nm = document.createElement('div');\n    nm.className = 'lib-name';\n    var textTitle = isText ? String(it.el ? it.el.textContent : (it.content || '')).replace(/\\s+/g, ' ').trim().slice(0, 80) : '';\n    nm.textContent = it.name || (isText ? (textTitle || 'Text') : (it.filename || (it.src ? String(it.src).split('/').pop().split('?')[0] : 'Unnamed')));\n    meta.appendChild(nm);\n    var tg = document.createElement('div');\n    tg.className = 'lib-tags';\n    tg.textContent = (it.tags || []).join('  ');\n    meta.appendChild(tg);\n    row.appendChild(meta);\n    row.addEventListener('click', function () {\n      selectOnly(it.id);\n      revealItem(it);\n    });\n    listEl.appendChild(row);\n  });\n  if (items.length > shown.length) {\n    var more = document.createElement('div');\n    more.className = 'lib-more';\n    more.textContent = '+ ' + (items.length - shown.length) + ' more - refine the search';\n    listEl.appendChild(more);\n  }\n}\n\n// ============================================================\n//  MINIMAP   (v7.0.53)\n// ============================================================\n// A board holding ~300 references cannot be navigated by panning alone - you\n// lose the shape of the thing long before you lose the position. The minimap\n// draws every object as a rectangle at board scale, plus a box for the current\n// viewport that can be GRABBED and dragged to pan. Clicking anywhere else\n// jumps the camera there.\n//\n// WHY A CANVAS, NOT DOM NODES. The Library already priced one element per\n// item: 300 <img> nodes holding full-resolution data URLs made every keystroke\n// stutter. Here it is worse - this repaints on every pan tick, 60-120 times a\n// second during a trackpad swipe. One canvas, one pass, no layout.\n//\n// WHY THE FIT IS A UNION OF CONTENT AND VIEWPORT. Fitting content alone leaves\n// the viewport box outside the map the moment you pan past the edge, so there\n// is nothing left to grab - the control would abandon you exactly when you are\n// lost. Including the viewport guarantees the box is always on-screen and\n// always draggable.\n//\n// WHY THE MAPPING FREEZES DURING A DRAG. Because the fit depends on the\n// viewport, panning can change it. Recomputing mid-gesture would slide the map\n// out from under the cursor, which moves the world point under the cursor,\n// which pans again - a feedback loop. The map is frozen at pointerdown and\n// recomputed once on release.\nvar MINIMAP_W = 220, MINIMAP_H = 145;\nvar _miniMap = null;      // last world -> canvas mapping\nvar _miniView = null;     // last drawn viewport box, in canvas px\nvar _miniDrag = null;     // live gesture: { wx, wy, cx, cy, map, moved }\nvar _miniRaf = false;\nvar _miniBound = false;\n\nfunction toggleMinimapPanel() {\n  var p = document.getElementById('minimap-panel');\n  if (!p) return;\n  p.classList.toggle('collapsed');\n  try { localStorage.setItem('krafted_minimap_collapsed', p.classList.contains('collapsed') ? '1' : '0'); } catch (e) {}\n  if (!p.classList.contains('collapsed')) { miniBindInput(); drawMinimap(); }\n}\n\n// Same shape as the Library's refresh: coalesce to one paint per frame, and do\n// nothing at all while the panel is shut.\nfunction requestMinimapRefresh() {\n  var p = document.getElementById('minimap-panel');\n  if (!p || p.classList.contains('collapsed')) return;\n  if (_miniRaf) return;\n  _miniRaf = true;\n  var run = function () { _miniRaf = false; drawMinimap(); };\n  if (typeof requestAnimationFrame === 'function') requestAnimationFrame(run);\n  else setTimeout(run, 60);\n}\n\n// Every rectangle worth showing: board items, plus text and to-dos so a\n// text-heavy board is not a blank map.\nfunction miniRects() {\n  var out = [];\n  (state.items || []).forEach(function (it) {\n    if (!(it.w > 0) || !(it.h > 0)) return;\n    out.push({ id: it.id, x: it.x, y: it.y, w: it.w, h: it.h });\n  });\n  [state.texts, state.todos].forEach(function (list) {\n    (list || []).forEach(function (t) {\n      if (!(t.w > 0) || !(t.h > 0)) return;\n      out.push({ id: t.id, x: t.x, y: t.y, w: t.w, h: t.h });\n    });\n  });\n  return out;\n}\n\n// The visible world rectangle. screen = pan + zoom * world (see updateCanvas),\n// so world = (screen - pan) / zoom.\nfunction miniViewportRect() {\n  var z = state.zoom || 1;\n  var sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  return {\n    x0: (0 - state.pan.x) / z, y0: (0 - state.pan.y) / z,\n    x1: (sw - state.pan.x) / z, y1: (sh - state.pan.y) / z\n  };\n}\n\nfunction miniComputeMap(W, H) {\n  W = W || MINIMAP_W; H = H || MINIMAP_H;\n  var bb = (typeof worldBBoxOf === 'function') ? worldBBoxOf(null) : null;\n  var v = miniViewportRect();\n  if ((!bb || !bb.count) && !isFinite(v.x0)) return null;\n  var minX, minY, maxX, maxY;\n  if (bb && bb.count) {\n    minX = Math.min(bb.minX, v.x0); minY = Math.min(bb.minY, v.y0);\n    maxX = Math.max(bb.maxX, v.x1); maxY = Math.max(bb.maxY, v.y1);\n  } else {\n    minX = v.x0; minY = v.y0; maxX = v.x1; maxY = v.y1;\n  }\n  var bw = maxX - minX, bh = maxY - minY;\n  var padX = bw > 0 ? bw * 0.06 : 10, padY = bh > 0 ? bh * 0.06 : 10;\n  minX -= padX; maxX += padX; minY -= padY; maxY += padY;\n  bw = Math.max(1, maxX - minX); bh = Math.max(1, maxY - minY);\n  var s = Math.min(W / bw, H / bh);\n  return { minX: minX, minY: minY, s: s, ox: (W - bw * s) / 2, oy: (H - bh * s) / 2 };\n}\n\nfunction miniToWorld(px, py) {\n  var m = (_miniDrag && _miniDrag.map) ? _miniDrag.map : _miniMap;\n  if (!m || !(m.s > 0)) return null;\n  return { x: (px - m.ox) / m.s + m.minX, y: (py - m.oy) / m.s + m.minY };\n}\n\n// Ids matching the Library search, or null when there is no search. The\n// predicate itself lives next to splitTags - one definition, two readers.\nfunction libMatchIds() {\n  var el = document.getElementById('library-search');\n  var q = (el && (el.value || '').toLowerCase().trim()) || '';\n  if (!q) return null;\n  var out = (typeof Set !== 'undefined') ? new Set() : null;\n  var source = (typeof libraryItems === 'function') ? libraryItems() : (state.items || []).concat(state.texts || []);\n  source.forEach(function (it) {\n    if (it.type === 'draw' || it.isDraw) return;\n    if (!libMatches(it, q)) return;\n    if (out) out.add(String(it.id));\n  });\n  return out;\n}\n\nfunction miniPaint(ctx, m, W, H) {\n  ctx.clearRect(0, 0, W, H);\n  ctx.fillStyle = 'rgba(0,0,0,0.35)';\n  ctx.fillRect(0, 0, W, H);\n\n  // Search hits are tinted, everything else dimmed - \"where are the things I\n  // just searched for\" is the question a big board actually asks.\n  var hits = libMatchIds();\n  var sel = (typeof getSelectedItems === 'function') ? getSelectedItems() : [];\n  var selId = sel.length ? String(sel[0].id) : null;\n  var rects = miniRects();\n  for (var i = 0; i < rects.length; i++) {\n    var r = rects[i];\n    var x = m.ox + (r.x - m.minX) * m.s;\n    var y = m.oy + (r.y - m.minY) * m.s;\n    var w = Math.max(1.5, r.w * m.s);\n    var h = Math.max(1.5, r.h * m.s);\n    var id = String(r.id);\n    if (hits && !hits.has(id)) ctx.fillStyle = 'rgba(125,135,150,0.16)';\n    else if (id === selId) ctx.fillStyle = 'rgba(255,255,255,0.95)';\n    else if (hits) ctx.fillStyle = 'rgba(0,229,255,0.9)';\n    else ctx.fillStyle = 'rgba(150,175,200,0.55)';\n    ctx.fillRect(x, y, w, h);\n  }\n\n  // The viewport box is recomputed here rather than carried on the mapping, so\n  // that it still moves while the mapping is frozen mid-drag.\n  var v = miniViewportRect();\n  var vx = m.ox + (v.x0 - m.minX) * m.s, vy = m.oy + (v.y0 - m.minY) * m.s;\n  var vw = (v.x1 - v.x0) * m.s, vh = (v.y1 - v.y0) * m.s;\n  _miniView = { x: vx, y: vy, w: vw, h: vh };\n  ctx.fillStyle = 'rgba(255,255,255,0.07)';\n  ctx.fillRect(vx, vy, vw, vh);\n  ctx.strokeStyle = 'rgba(255,255,255,0.85)';\n  ctx.lineWidth = 1;\n  ctx.strokeRect(vx + 0.5, vy + 0.5, Math.max(2, vw - 1), Math.max(2, vh - 1));\n}\n\nfunction drawMinimap() {\n  var p = document.getElementById('minimap-panel');\n  if (!p || p.classList.contains('collapsed')) return;\n  var cv = document.getElementById('minimap-canvas');\n  if (!cv || !cv.getContext) return;\n  var ctx = cv.getContext('2d');\n  if (!ctx) return;\n  var W = cv.width || MINIMAP_W, H = cv.height || MINIMAP_H;\n  var m = (_miniDrag && _miniDrag.map) ? _miniDrag.map : miniComputeMap(W, H);\n  if (!m) {\n    ctx.clearRect(0, 0, W, H);\n    ctx.fillStyle = 'rgba(0,0,0,0.35)';\n    ctx.fillRect(0, 0, W, H);\n    _miniMap = null;\n    return;\n  }\n  _miniMap = m;\n  miniPaint(ctx, m, W, H);\n}\n\nfunction miniPoint(ev) {\n  var cv = document.getElementById('minimap-canvas');\n  if (!cv || !cv.getBoundingClientRect) return null;\n  var r = cv.getBoundingClientRect();\n  if (!r.width || !r.height) return null;\n  return {\n    x: (ev.clientX - r.left) * (cv.width / r.width),\n    y: (ev.clientY - r.top) * (cv.height / r.height)\n  };\n}\n\nfunction miniCenterOn(wx, wy) {\n  var z = state.zoom || 1;\n  state.pan.x = (window.innerWidth || 0) / 2 - z * wx;\n  state.pan.y = (window.innerHeight || 0) / 2 - z * wy;\n  updateCanvas();\n}\n\nfunction miniOnDown(ev) {\n  var m = _miniMap || miniComputeMap();\n  if (!m) return;\n  _miniMap = m;\n  var p = miniPoint(ev);\n  if (!p) return;\n  var w = miniToWorld(p.x, p.y);\n  if (!w) return;\n  var z = state.zoom || 1;\n  var cx = ((window.innerWidth || 0) / 2 - state.pan.x) / z;\n  var cy = ((window.innerHeight || 0) / 2 - state.pan.y) / z;\n  var v = _miniView;\n  var inside = !!(v && p.x >= v.x && p.x <= v.x + v.w && p.y >= v.y && p.y <= v.y + v.h);\n  // Freeze the mapping for the whole gesture (see the header comment).\n  _miniDrag = { wx: w.x, wy: w.y, cx: cx, cy: cy, map: m, moved: false };\n  // Grabbing inside the box pans; clicking outside it jumps first, then pans.\n  if (!inside) miniCenterOn(w.x, w.y);\n  try { ev.preventDefault(); } catch (e) {}\n  try { ev.stopPropagation(); } catch (e) {}\n  document.addEventListener('pointermove', miniOnMove);\n  document.addEventListener('pointerup', miniOnUp);\n  document.addEventListener('pointercancel', miniOnUp);\n}\n\nfunction miniOnMove(ev) {\n  if (!_miniDrag) return;\n  var p = miniPoint(ev);\n  if (!p) return;\n  var w = miniToWorld(p.x, p.y);\n  if (!w) return;\n  _miniDrag.moved = true;\n  miniCenterOn(_miniDrag.cx + (w.x - _miniDrag.wx), _miniDrag.cy + (w.y - _miniDrag.wy));\n}\n\nfunction miniOnUp() {\n  _miniDrag = null;\n  document.removeEventListener('pointermove', miniOnMove);\n  document.removeEventListener('pointerup', miniOnUp);\n  document.removeEventListener('pointercancel', miniOnUp);\n  // The fit is a union with the viewport, so the gesture will have changed it.\n  requestMinimapRefresh();\n}\n\n// Bound lazily: the canvas is in the markup, but sizing its backing store to\n// the device pixel ratio has to wait for a real element.\nfunction miniBindInput() {\n  if (_miniBound) return;\n  var cv = document.getElementById('minimap-canvas');\n  if (!cv) return;\n  var dpr = window.devicePixelRatio || 1;\n  var bw = Math.round(MINIMAP_W * dpr), bh = Math.round(MINIMAP_H * dpr);\n  if (cv.width !== bw || cv.height !== bh) { cv.width = bw; cv.height = bh; }\n  cv.addEventListener('pointerdown', miniOnDown);\n  _miniBound = true;\n}\n\n(function initMinimapPanel() {\n  if (typeof document === 'undefined') return;\n  var apply = function () {\n    var p = document.getElementById('minimap-panel');\n    if (!p) return;\n    var collapsed = true;\n    try { collapsed = localStorage.getItem('krafted_minimap_collapsed') !== '0'; } catch (e) {}\n    p.classList.toggle('collapsed', collapsed);\n    miniBindInput();\n    drawMinimap();\n  };\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);\n  else apply();\n})();\n\n// ============================================================\n//  NAMED VIEWS + PRESENT   (v7.0.40, batch-5 proposal G)\n// ============================================================\n// A view is a named \"shot\" on the board: the set of items it frames, plus the\n// camera it was saved from as a fallback. Clicking one flies the camera there.\n// Present plays them in order \u2014 that is the pitch deck the user described\n// (\"\u5C07\u597D\u591A\u8996\u983B\u5605\u7247\u6BB5\u52A0\u4E00\u5572\u5716\u7247\u52A0\u6587\u5B57\u53BB\u540C\u5176\u4ED6\u4EBA\u8B1B\u6211\u5605\u5275\u610F\u4FC2\u4E5C\u5622\"), living on the\n// board instead of in a slide app.\n//\n// IDs, NOT COORDINATES. A view remembers WHICH items it frames and re-fits to\n// their CURRENT bounding box every time it is recalled. Storing a frozen\n// rectangle instead would mean every view silently points at empty space the\n// moment anything gets moved \u2014 and on a board that gets tidied and rearranged\n// daily, that is immediately. The saved pan/zoom is kept only to fall back on\n// when every item in a view has been deleted.\n//\n// Nothing here touches rendering: it sets state.pan / state.zoom and calls\n// updateCanvas(), exactly like every other navigation path on the board.\n\nvar VIEW_MAX_ZOOM = 1;        // never upscale \u2014 magnified pixels kill a pitch\nvar VIEW_FIT_MARGIN = 64;     // breathing room, capped on small screens\nvar VIEW_FLIGHT_MS = 620;     // camera move duration\nvar PRESENT_DWELL_MS = 4000;  // auto-play only: how long a shot holds\n// v7.0.48: the tape is MANUAL by default. It used to advance on a fixed\n// 4.6-second clock no matter what the user was doing \u2014 including right\n// after they pressed \"next\" themselves, which simply restarted the same\n// clock. Presenting means talking about a shot for as long as it takes.\n// Auto-play survives as a mode you switch on, for a reel nobody narrates.\nvar PRESENT_AUTO_DEFAULT = false;\n\nfunction _viewsList() { return Array.isArray(state.views) ? state.views : []; }\n\n// v7.0.46 \u2014 the view shape used to be spelled out by hand in six places\n// (three save paths, the undo snapshot, the undo restore and the .kpak\n// load). Adding one field meant finding six lines, and missing one meant a\n// view that silently lost it on reload. One writer and one reader, so the\n// shape can only ever be defined once.\nfunction serializeView(v) {\n  return {\n    id: v.id,\n    name: v.name || '',\n    ids: (v.ids || []).slice(),\n    panX: v.panX, panY: v.panY, zoom: v.zoom,\n    createdAt: v.createdAt || '',\n    // v7.0.46: re-aiming a view stamped updatedAt and every save path then\n    // dropped it, so the field only ever survived until the next reload.\n    updatedAt: v.updatedAt || '',\n    color: v.color || '',\n  };\n}\n\n// remap is the id translator for the load path (a .kpak renumbers every node\n// on import); everywhere else the identity is what you want.\nfunction deserializeView(vd, remap) {\n  const map = (typeof remap === 'function') ? remap : function (x) { return x; };\n  return {\n    id: vd.id,\n    name: vd.name || '',\n    ids: (vd.ids || []).map(map),\n    panX: vd.panX, panY: vd.panY, zoom: vd.zoom,\n    createdAt: vd.createdAt || '',\n    updatedAt: vd.updatedAt || '',\n    color: vd.color || '',\n  };\n}\n\n// Index 0 is \"no colour\" so a chip can always be cleared. The rest are the\n// same eight the relation menu offers, so one board does not end up speaking\n// two different colour languages.\nvar VIEW_COLORS = ['', '#00e5ff', '#ffdd44', '#ff6b6b', '#51cf66', '#cc5de8', '#ff922b', '#74c0fc', '#ffffff'];\n\nfunction viewColor(v) {\n  const c = (v && v.color) ? v.color : '';\n  return (c && VIEW_COLORS.indexOf(c) >= 0) ? c : '';\n}\n\n// hex -> a wash dark enough that the number inside stays readable.\nfunction viewTint(hex) {\n  const m = /^#([0-9a-fA-F]{6})$/.exec(String(hex || ''));\n  if (!m) return 'transparent';\n  const n = parseInt(m[1], 16);\n  return 'rgba(' + ((n >> 16) & 255) + ',' + ((n >> 8) & 255) + ',' + (n & 255) + ',0.20)';\n}\n\nfunction nextViewId() {\n  if (!Number.isFinite(G.nextViewId)) {\n    G.nextViewId = _viewsList().reduce(function (m, v) {\n      return Math.max(m, (v && Number.isFinite(v.id)) ? v.id : 0);\n    }, 0) + 1;\n  }\n  const id = G.nextViewId;\n  G.nextViewId = id + 1;\n  return id;\n}\n\n// The ids a view points at, minus any that no longer exist (deleted item, or a\n// .kpak that dropped a node on load). Empty means \"nothing left to frame\".\nfunction viewLiveIds(v) {\n  if (!v || !Array.isArray(v.ids)) return [];\n  const live = new Set();\n  (state.items || []).forEach(function (it) { live.add(it.id); });\n  [state.texts, state.todos, state.mindmaps].forEach(function (list) {\n    (list || []).forEach(function (t) { live.add(t.id); });\n  });\n  return v.ids.filter(function (id) { return live.has(id); });\n}\n\nfunction viewBBox(v) {\n  const ids = viewLiveIds(v);\n  if (!ids.length) return null;\n  return worldBBoxOf(ids);\n}\n\n// Where the camera should end up to frame this view.\nfunction viewCamera(v) {\n  const sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  const bb = viewBBox(v);\n  if (bb && sw > 0 && sh > 0) {\n    const m = Math.max(0, Math.min(VIEW_FIT_MARGIN, (Math.min(sw, sh) - 40) / 2));\n    const bw = Math.max(1, bb.maxX - bb.minX), bh = Math.max(1, bb.maxY - bb.minY);\n    const z = Math.max(0.02, Math.min(VIEW_MAX_ZOOM,\n      Math.min((sw - m * 2) / bw, (sh - m * 2) / bh)));\n    return { cx: (bb.minX + bb.maxX) / 2, cy: (bb.minY + bb.maxY) / 2, zoom: z };\n  }\n  // Everything the view framed is gone \u2014 fall back to where the camera was.\n  if (v && Number.isFinite(v.panX) && Number.isFinite(v.zoom) && sw > 0 && sh > 0) {\n    const z = Math.max(0.02, Math.min(VIEW_MAX_ZOOM, v.zoom));\n    return { cx: (sw / 2 - v.panX) / z, cy: (sh / 2 - v.panY) / z, zoom: z };\n  }\n  return null;\n}\n\nfunction applyCamera(cx, cy, zoom) {\n  const sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  state.zoom = zoom;\n  state.pan.x = sw / 2 - cx * zoom;\n  state.pan.y = sh / 2 - cy * zoom;\n  updateCanvas();\n}\n\n// Fly the camera to a world point + zoom. Two details matter:\n//   \u2022 Zoom interpolates GEOMETRICALLY (z0 * (z1/z0)^e). Linear zoom reads as a\n//     lurch followed by a crawl, because the perceived rate is relative.\n//   \u2022 The WORLD POINT UNDER SCREEN CENTRE interpolates linearly, rather than\n//     interpolating pan directly. Interpolating pan with a changing zoom makes\n//     the content swing in an arc; interpolating the centre point makes it a\n//     single continuous camera move.\nfunction flyToCamera(cx, cy, zoom, ms, done) {\n  const sw = window.innerWidth || 0, sh = window.innerHeight || 0;\n  if (!(sw > 0) || !(sh > 0)) { if (done) done(); return; }\n  const token = (state._viewFlight = (state._viewFlight || 0) + 1);\n  const z0 = state.zoom;\n  const z1 = Math.max(0.02, Math.min(10, zoom));\n  const c0x = (sw / 2 - state.pan.x) / z0, c0y = (sh / 2 - state.pan.y) / z0;\n  const dur = Math.max(0, (ms === undefined) ? VIEW_FLIGHT_MS : ms);\n  const settled = Math.abs(Math.log(z1 / z0)) < 1e-4 &&\n                  Math.abs(c0x - cx) < 0.5 && Math.abs(c0y - cy) < 0.5;\n  if (dur === 0 || settled) {\n    applyCamera(cx, cy, z1);\n    if (done) done();\n    return;\n  }\n  const t0 = performance.now();\n  const step = function (now) {\n    if (token !== state._viewFlight) return;   // a newer flight took over\n    const p = Math.min(1, (now - t0) / dur);\n    const e = (p < 0.5) ? 4 * p * p * p : 1 - Math.pow(-2 * p + 2, 3) / 2; // easeInOutCubic\n    applyCamera(c0x + (cx - c0x) * e, c0y + (cy - c0y) * e, z0 * Math.pow(z1 / z0, e));\n    if (p < 1) requestAnimationFrame(step);\n    else if (done) done();\n  };\n  requestAnimationFrame(step);\n}\n\nfunction gotoView(index, opts) {\n  const list = _viewsList();\n  const v = list[index];\n  if (!v) return false;\n  const cam = viewCamera(v);\n  if (!cam) {\n    try { toast('View \"' + (v.name || '?') + '\" has nothing left to show'); } catch (e) {}\n    return false;\n  }\n  const o = opts || {};\n  state._activeViewIndex = index;\n  flyToCamera(cam.cx, cam.cy, cam.zoom,\n    o.instant ? 0 : (o.ms === undefined ? VIEW_FLIGHT_MS : o.ms), o.done);\n  renderViewsPanel();\n  return true;\n}\n\n// \u2500\u2500 Editing the view list \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n// Every mutation takes an undo step: views live in .kpak, so losing one is\n// losing work, and Ctrl+Z is how this user reflexively corrects a misclick.\nfunction saveViewFromSelection(name) {\n  const ids = [];\n  state.selected.forEach(function (id) { ids.push(id); });\n  // v7.0.46: refuse outright while the tape is running. Dropping an unnamed\n  // view into the middle of a pitch is worse than the keypress doing nothing \u2014\n  // the name field cannot open (there is no typing mid-pitch), so it would land\n  // as \"View 7\" and the running order would stay wrong for the whole meeting.\n  if (state._present) {\n    try { toast('Stop the presentation before adding a shot'); } catch (e) {}\n    return null;\n  }\n  if (!ids.length) {\n    // Name the key. A nag that does not say which key to press just sends the\n    // user hunting through a 236px rail again, which is the thing being fixed.\n    try { toast('Select what this shot should frame, then press P'); } catch (e) {}\n    return null;\n  }\n  try { pushUndo(); } catch (e) {}\n  if (!Array.isArray(state.views)) state.views = [];\n  const suggested = String(name || suggestViewName(ids) || nextViewNameInSequence() ||\n                           ('View ' + (state.views.length + 1))).slice(0, 60) || 'View';\n  const v = {\n    id: nextViewId(),\n    name: suggested,\n    ids: ids,\n    panX: state.pan.x, panY: state.pan.y, zoom: state.zoom,\n    createdAt: new Date().toISOString(),\n    color: '',\n  };\n  state.views.push(v);\n  state._activeViewIndex = state.views.length - 1;\n  try { scheduleAutoSave(); } catch (e) {}\n  try { toast('Saved \"' + v.name + '\" \u00B7 ' + ids.length + ' item' + (ids.length === 1 ? '' : 's')); } catch (e) {}\n  // v7.0.46: the name field is already open with the suggestion selected, so\n  // naming a shot is one gesture \u2014 type, Enter \u2014 instead of a hunt through a\n  // menu. Skipped when the tape is running: there is no typing mid-pitch.\n  beginViewRename(state.views.length - 1);\n  return v;\n}\n\n// Re-aim a view at whatever is selected now / wherever the camera is now.\n// Without this, \"fix up the framing\" means delete-and-remake.\nfunction updateViewFromCurrent(index) {\n  const v = _viewsList()[index];\n  if (!v) return false;\n  const ids = [];\n  state.selected.forEach(function (id) { ids.push(id); });\n  try { pushUndo(); } catch (e) {}\n  if (ids.length) v.ids = ids;\n  v.panX = state.pan.x; v.panY = state.pan.y; v.zoom = state.zoom;\n  v.updatedAt = new Date().toISOString();\n  try { scheduleAutoSave(); } catch (e) {}\n  renderViewsPanel();\n  try { toast('Updated \"' + (v.name || 'view') + '\"' + (ids.length ? (' \u00B7 ' + ids.length + ' items') : ' \u00B7 camera only')); } catch (e) {}\n  return true;\n}\n\nfunction deleteView(index) {\n  const list = _viewsList();\n  const v = list[index];\n  if (!v) return false;\n  try { pushUndo(); } catch (e) {}\n  if (state._viewEditingId === v.id) state._viewEditingId = 0;\n  if (state._viewSwatchId === v.id) state._viewSwatchId = 0;\n  list.splice(index, 1);\n  if (state._activeViewIndex === index) state._activeViewIndex = -1;\n  else if (state._activeViewIndex > index) state._activeViewIndex--;\n  if (state._present && state._present.index >= list.length) stopPresent();\n  try { scheduleAutoSave(); } catch (e) {}\n  renderViewsPanel();\n  return true;\n}\n\n// A name you have to replace every single time is not a name, it is a tax.\n// If the selection contains words the user actually wrote, that is what the\n// shot is about \u2014 use them. Media filenames are deliberately NOT used: an\n// auto-name of \"IMG_4821.HEIC\" is worse than \"View 4\", because it looks like\n// information and is not.\nfunction suggestViewName(ids) {\n  const want = new Set(ids || []);\n  if (!want.size) return '';\n  let label = '';\n  (state.texts || []).forEach(function (t) {\n    if (label || !want.has(t.id)) return;\n    const raw = (t.el && t.el.textContent) ? String(t.el.textContent) : '';\n    const lines = raw.split(/\\r?\\n/);\n    for (let i = 0; i < lines.length; i++) {\n      if (lines[i].trim()) { label = lines[i].trim(); return; }\n    }\n  });\n  return label ? label.replace(/\\s+/g, ' ').slice(0, 40) : '';\n}\n\n// \"View 4\" is not a name, it is a tax \u2014 and it is the complaint that started\n// this whole change: every view came out numbered, so every view had to be\n// renamed by hand. When the last view already ends in a number, that number is\n// a running order being typed out one keypress at a time, so carry it forward:\n// \"CU 1\" offers \"CU 2\", and the second shot costs what the twentieth costs.\n// Zero padding is preserved \u2014 \"Beat 07\" offers \"Beat 08\" \u2014 because a list that\n// starts padded sorts wrong everywhere else the moment one entry loses it.\n//\n// Only the LAST view is consulted. Walking back to find the nearest numbered\n// name would answer \"CU 3\" after an unrelated \"Finale\", which is surprising\n// rather than helpful.\nfunction nextViewNameInSequence() {\n  const list = _viewsList();\n  if (!list.length) return '';\n  const prev = String((list[list.length - 1] || {}).name || '').trim();\n  const m = /^(.*?)(\\d+)\\s*$/.exec(prev);\n  if (!m) return '';\n  const digits = m[2];\n  const n0 = parseInt(digits, 10);\n  if (!isFinite(n0)) return '';\n  const taken = {};\n  list.forEach(function (v) { taken[String((v && v.name) || '').trim()] = 1; });\n  let name = '';\n  for (let i = 0, n = n0 + 1; i < 1000; i++, n++) {\n    let out = String(n);\n    if (digits.length > 1 && digits.charAt(0) === '0') {\n      while (out.length < digits.length) out = '0' + out;\n    }\n    name = m[1] + out;\n    // Never offer a name the tape already has: Alt+1..0 jumps by position, so\n    // two rows reading the same name is a running order that contradicts itself.\n    if (!taken[name]) break;\n  }\n  return String(name || '').slice(0, 60);\n}\n\n// One editor for all three entry points (double-click, F2, and the moment a\n// view is created). It used to be window.prompt(): a native dialog that\n// cannot be styled, interrupts the flow, and on macOS reads as the app\n// having crashed. Editing is keyed on the view ID, not its index, so a\n// re-render mid-edit cannot silently retarget it at a different view.\nfunction beginViewRename(index) {\n  const v = _viewsList()[index];\n  if (!v) return false;\n  if (state._present) return false;          // never fight the tape\n  const panel = document.getElementById('views-panel');\n  if (panel) panel.classList.remove('collapsed');\n  state._viewSwatchId = 0;\n  state._viewEditingId = v.id;\n  renderViewsPanel();\n  return true;\n}\n\nfunction commitViewRename(id, value, cancelled) {\n  state._viewEditingId = 0;                  // cleared first: blur re-enters\n  const v = _viewsList().filter(function (x) { return x.id === id; })[0];\n  if (v && !cancelled) {\n    const next = String(value == null ? '' : value).trim().slice(0, 60);\n    if (next && next !== v.name) {\n      try { pushUndo(); } catch (e) {}\n      v.name = next;\n      try { scheduleAutoSave(); } catch (e) {}\n    }\n  }\n  renderViewsPanel();\n  return true;\n}\n\n// Kept under its old name because it is the documented \"rename view\" entry\n// point; it now opens the inline editor instead of a native dialog.\nfunction renameViewAt(index) { return beginViewRename(index); }\n\nfunction setViewColor(id, color) {\n  const v = _viewsList().filter(function (x) { return x.id === id; })[0];\n  if (!v) return false;\n  const c = (color && VIEW_COLORS.indexOf(color) >= 0) ? color : '';\n  state._viewSwatchId = 0;\n  if (viewColor(v) === c) { renderViewsPanel(); return false; }\n  try { pushUndo(); } catch (e) {}\n  v.color = c;\n  try { scheduleAutoSave(); } catch (e) {}\n  renderViewsPanel();\n  return true;\n}\n\nfunction moveView(index, dir) {\n  const list = _viewsList();\n  const j = index + dir;\n  if (!list[index] || j < 0 || j >= list.length) return false;\n  try { pushUndo(); } catch (e) {}\n  const tmp = list[index];\n  list[index] = list[j];\n  list[j] = tmp;\n  // Keep the highlight on the row the user is dragging, not on the slot.\n  if (state._activeViewIndex === index) state._activeViewIndex = j;\n  else if (state._activeViewIndex === j) state._activeViewIndex = index;\n  try { scheduleAutoSave(); } catch (e) {}\n  renderViewsPanel();\n  return true;\n}\n\n// \u2500\u2500 Present: walk the views in order \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nvar _presentKeyHandler = null;\nvar _presentUserHandler = null;\n\nfunction startPresent() {\n  // v7.5.0: the tape flies the camera to each shot in turn, so nothing\n  // may be culled while it plays.\n  _ensureAllImagesLive();\n  if (state._present) { stopPresent(); return; }\n  const list = _viewsList();\n  if (!list.length) {\n    try { toast('Save a view first \u2014 select items, then +'); } catch (e) {}\n    return;\n  }\n  // v7.0.48: auto starts OFF. See PRESENT_AUTO_DEFAULT.\n  state._present = { index: -1, timer: null, auto: PRESENT_AUTO_DEFAULT };\n  // v7.0.52: a list of everything on the board has no business being on\n  // screen while the board is being pitched. body.presenting hides it.\n  try { document.body.classList.add('presenting'); } catch (e) {}\n  // Capture phase so a board hotkey cannot swallow the tape controls.\n  _presentKeyHandler = function (ev) {\n    if (!state._present) return;\n    // v7.0.48: never shadow the browser. Cmd/Ctrl+1 switches tab and Cmd+A\n    // selects all, and a pitch tool that eats those is worse than one that\n    // misses a keypress. Alt is left out too \u2014 on macOS the Option layer\n    // turns \"1\" into \"\u00A1\", so ev.key is not even the character shown.\n    if (ev.ctrlKey || ev.metaKey || ev.altKey) return;\n    // v7.0.48: if a text field has the caret, every key belongs to it. The\n    // rename editor can still be open when a tape starts, and without this\n    // the tape eats the typing \u2014 Space advanced the shot instead of typing\n    // a space. Escape included: cancelling the rename is what was meant.\n    const ae = document.activeElement;\n    if (ae && (ae.contentEditable === 'true' || ae.tagName === 'INPUT' ||\n               ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) return;\n    const k = ev.key;\n    if (k === 'Escape') { ev.preventDefault(); ev.stopPropagation(); stopPresent(); return; }\n    // Next. ArrowDown / PageDown / Enter are bound because that is what a\n    // physical presenter remote actually sends \u2014 this is a pitch tool, and a\n    // clicker in the hand is how a pitch is run. Binding only Space and the\n    // right arrow built a feature that needed a keyboard within arm's reach.\n    if (k === ' ' || k === 'ArrowRight' || k === 'ArrowDown' || k === 'PageDown' ||\n        k === 'Enter' || k === 'n' || k === 'N') {\n      ev.preventDefault(); ev.stopPropagation(); presentAdvance(1); return;\n    }\n    if (k === 'ArrowLeft' || k === 'ArrowUp' || k === 'PageUp' || k === 'p' || k === 'P') {\n      ev.preventDefault(); ev.stopPropagation(); presentAdvance(-1); return;\n    }\n    if (k === 'a' || k === 'A') { ev.preventDefault(); ev.stopPropagation(); presentToggleAuto(); return; }\n    if (k === 'Home') { ev.preventDefault(); ev.stopPropagation(); presentGoTo(0); return; }\n    if (k === 'End') { ev.preventDefault(); ev.stopPropagation(); presentGoTo(_viewsList().length - 1); return; }\n    // Bare digits jump to a shot, the way a slideshow remote numbers slides.\n    if (k.length === 1 && k >= '0' && k <= '9') {\n      ev.preventDefault(); ev.stopPropagation();\n      presentGoTo((k === '0' ? 10 : parseInt(k, 10)) - 1);\n      return;\n    }\n  };\n  document.addEventListener('keydown', _presentKeyHandler, true);\n  // Grabbing the board means \"I am taking over\" \u2014 stop flying around under\n  // them. Registered on the next tick so the click that STARTED the tape\n  // (a pointerdown on the Present button) does not immediately end it.\n  setTimeout(function () {\n    if (!state._present) return;\n    _presentUserHandler = function (ev) {\n      // v7.0.48: the HUD's own buttons must not read as the user grabbing the\n      // board, or the first click on \"next\" would end the tape it advances.\n      const hud = document.getElementById('present-hud');\n      if (hud && ev.target && hud.contains(ev.target)) return;\n      const panel = document.getElementById('views-panel');\n      if (panel && ev.target && panel.contains(ev.target)) return;\n      stopPresent();\n    };\n    document.addEventListener('wheel', _presentUserHandler, { passive: true, capture: true });\n    document.addEventListener('pointerdown', _presentUserHandler, true);\n  }, 0);\n  renderViewsPanel();\n  presentAdvance(1);\n  // Say how to drive it. A tape that holds forever with no visible control\n  // reads as a hung app, and the previous build taught everyone that it\n  // advances by itself \u2014 nobody would press anything.\n  try {\n    toast(list.length + (list.length === 1 ? ' shot \u2014 ' : ' shots \u2014 ') +\n          'Space or \u2192 for the next one, Esc to stop');\n  } catch (e) {}\n}\n\nfunction stopPresent() {\n  if (state._present && state._present.timer) clearTimeout(state._present.timer);\n  state._present = null;\n  try { document.body.classList.remove('presenting'); } catch (e) {}\n  if (_presentKeyHandler) { document.removeEventListener('keydown', _presentKeyHandler, true); _presentKeyHandler = null; }\n  if (_presentUserHandler) {\n    document.removeEventListener('wheel', _presentUserHandler, true);\n    document.removeEventListener('pointerdown', _presentUserHandler, true);\n    _presentUserHandler = null;\n  }\n  renderViewsPanel();\n  renderPresentHud();\n  try { toast('Presentation ended'); } catch (e) {}\n}\n\n// The advance timer is scheduled up front as flight + dwell rather than in the\n// flight's completion callback. If the flight is cancelled (the user grabbed\n// the board mid-move) the callback never runs, and a tape that can silently\n// stall halfway through a pitch is worse than one whose timing is 600ms loose.\n// v7.0.48: that timer now exists ONLY while auto-play is on. It used to be\n// scheduled unconditionally, so pressing \"next\" by hand started a 4.6-second\n// clock that then took the shot away mid-sentence.\nfunction presentScheduleNext() {\n  const p = state._present;\n  if (!p || !p.auto) return;\n  if (p.timer) { clearTimeout(p.timer); p.timer = null; }\n  p.timer = setTimeout(function () { presentAdvance(1); }, VIEW_FLIGHT_MS + PRESENT_DWELL_MS);\n}\n\nfunction presentAdvance(dir) {\n  const p = state._present;\n  if (!p) return;\n  const list = _viewsList();\n  if (!list.length) { stopPresent(); return; }\n  if (p.timer) { clearTimeout(p.timer); p.timer = null; }\n  let i;\n  if (p.index < 0) i = (dir > 0) ? 0 : list.length - 1;\n  else i = p.index + dir;\n  if (i >= list.length) {\n    // Auto-play ends the tape; a manual tape holds on the last shot. Ending\n    // a pitch because someone pressed \"next\" once too often throws away the\n    // control the manual tape exists to give, and costs them their place.\n    if (p.auto) {\n      stopPresent();\n      try { toast('End of presentation'); } catch (e) {}\n      return;\n    }\n    i = list.length - 1;\n    if (i === p.index) { renderPresentHud(); return; }\n  }\n  // Stepping backwards off the first shot clamps: \"went back too far\" should\n  // not end the pitch either way.\n  if (i < 0) i = 0;\n  p.index = i;\n  gotoView(i);\n  renderPresentHud();\n  if (p.auto) presentScheduleNext();\n}\n\n// v7.0.48 \u2014 auto-play is opt-in, not the default. Switching it on starts the\n// clock from now; switching it off leaves the tape exactly where it is, so\n// \"I want to talk about this one\" never costs the user their place.\nfunction presentToggleAuto(on) {\n  const p = state._present;\n  if (!p) return;\n  p.auto = (on === undefined) ? !p.auto : !!on;\n  if (p.auto) presentScheduleNext();\n  else if (p.timer) { clearTimeout(p.timer); p.timer = null; }\n  renderPresentHud();\n  try { toast(p.auto ? 'Auto-play on' : 'Auto-play off \u2014 you are driving'); } catch (e) {}\n}\n\n// Jump straight to a shot: Home / End / the number keys.\nfunction presentGoTo(i) {\n  const p = state._present;\n  if (!p) return;\n  const list = _viewsList();\n  if (!list.length) { stopPresent(); return; }\n  if (i < 0) i = 0;\n  if (i > list.length - 1) i = list.length - 1;\n  if (p.timer) { clearTimeout(p.timer); p.timer = null; }\n  p.index = i;\n  gotoView(i);\n  renderPresentHud();\n  if (p.auto) presentScheduleNext();\n}\n\n// v7.0.48 \u2014 the HUD. Presenting from a board 100000px across, the two things\n// you cannot see are \"where am I in the running order\" and \"what comes next\",\n// so a pitch used to be paced from memory. The nodes are built once in the\n// markup and updated here by textContent only: a shot name is user text and\n// it must never be able to become markup.\nfunction renderPresentHud() {\n  const hud = document.getElementById('present-hud');\n  if (!hud) return;\n  const p = state._present;\n  if (!p) { hud.classList.remove('show'); return; }\n  const list = _viewsList();\n  const cur = list[p.index];\n  const nmEl = document.getElementById('present-name');\n  const ctEl = document.getElementById('present-count');\n  const hintEl = document.getElementById('present-hint');\n  const playEl = document.getElementById('present-play');\n  if (nmEl) {\n    // An unnamed shot still needs a label, and \"Shot 4\" beats a blank gap\n    // where the audience expects the name of what they are looking at.\n    nmEl.textContent = (cur && cur.name) || ('Shot ' + (p.index + 1));\n    nmEl.style.color = viewColor(cur || {}) || '';\n  }\n  if (ctEl) ctEl.textContent = (p.index + 1) + ' / ' + list.length;\n  if (playEl) {\n    playEl.textContent = p.auto ? '\u275A\u275A' : '\u25B6';\n    playEl.title = p.auto ? 'Stop auto-play (A) \u2014 take back control'\n                          : 'Auto-play the tape (A)';\n  }\n  if (hintEl) {\n    const nx = list[p.index + 1];\n    hintEl.textContent = p.auto\n      ? ('Auto \u2014 ' + (PRESENT_DWELL_MS / 1000) + 's a shot \u00B7 A to stop')\n      : (nx ? ('Next: ' + ((nx && nx.name) || ('Shot ' + (p.index + 2))) + ' \u00B7 Space to advance')\n            : 'Last shot \u00B7 Esc to stop');\n  }\n  hud.classList.add('show');\n}\n\n// \u2500\u2500 The panel \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\nfunction toggleViewsPanel() {\n  const p = document.getElementById('views-panel');\n  if (!p) return;\n  p.classList.toggle('collapsed');\n  try { localStorage.setItem('krafted_views_collapsed', p.classList.contains('collapsed') ? '1' : '0'); } catch (e) {}\n}\n\nfunction renderViewsPanel() {\n  const el = document.getElementById('views-panel');\n  const listEl = document.getElementById('views-list');\n  if (!el || !listEl) return;\n  const list = _viewsList();\n  el.classList.toggle('presenting', !!state._present);\n  const presentBtn = document.getElementById('views-present-btn');\n  if (presentBtn) presentBtn.textContent = state._present ? '\u25A0 Stop' : '\u25B6 Present';\n  const headText = document.getElementById('views-head-text');\n  if (headText) headText.textContent = list.length ? ('Views ' + list.length) : 'Views';\n  if (!list.length) {\n    listEl.innerHTML = '<div class=\"views-empty\">Select something on the board,<br>then press <b>P</b> to add it to Present.</div>';\n    return;\n  }\n  listEl.innerHTML = '';\n  let toFocus = null, activeRow = null;\n  list.forEach(function (v, i) {\n    const row = document.createElement('div');\n    row.className = 'view-row';\n    if (state._present && state._present.index === i) { row.classList.add('active'); activeRow = row; }\n    else if (state._activeViewIndex === i) row.classList.add('current');\n    const col = viewColor(v);\n\n    // The number is also the colour chip. A 236px rail already carries a\n    // name, a count and four buttons \u2014 there is no room for a separate dot,\n    // and the shortcut hint and the colour want the same eyeball anyway.\n    const num = document.createElement('span');\n    num.className = 'view-num' + (col ? ' tinted' : '');\n    num.textContent = (i < 9) ? String(i + 1) : (i === 9 ? '0' : '\u00B7');\n    num.title = (i < 10 ? ('Alt+' + ((i + 1) % 10) + ' \u00B7 ') : '') + 'Click for a colour';\n    if (col) {\n      num.style.color = col;\n      num.style.borderColor = col;\n      num.style.background = viewTint(col);\n    }\n    num.addEventListener('click', function (ev) {\n      ev.stopPropagation();\n      state._viewSwatchId = (state._viewSwatchId === v.id) ? 0 : v.id;\n      renderViewsPanel();\n    });\n    row.appendChild(num);\n\n    if (state._viewEditingId === v.id) {\n      const input = document.createElement('input');\n      input.type = 'text';\n      input.className = 'view-name-edit';\n      input.value = v.name || '';\n      input.maxLength = 60;\n      input.setAttribute('aria-label', 'View name');\n      const finish = function (save) { commitViewRename(v.id, input.value, !save); };\n      input.addEventListener('keydown', function (ev) {\n        ev.stopPropagation();\n        if (ev.key === 'Enter') { ev.preventDefault(); finish(true); }\n        else if (ev.key === 'Escape') { ev.preventDefault(); finish(false); }\n        // Tab walks the tape's names, so a whole running order can be typed\n        // without ever touching the mouse.\n        else if (ev.key === 'Tab') {\n          ev.preventDefault();\n          const next = i + (ev.shiftKey ? -1 : 1);\n          finish(true);\n          if (next >= 0 && next < list.length) beginViewRename(next);\n        }\n      });\n      input.addEventListener('blur', function () {\n        if (state._viewEditingId !== v.id) return;   // Enter already finished\n        finish(true);\n      });\n      input.addEventListener('mousedown', function (ev) { ev.stopPropagation(); });\n      row.appendChild(input);\n      toFocus = input;\n    } else {\n      const name = document.createElement('span');\n      name.className = 'view-name';\n      name.textContent = v.name || ('View ' + (i + 1));\n      name.title = 'Click to fly here \u00B7 double-click or F2 to rename';\n      name.addEventListener('click', function (ev) {\n        ev.stopPropagation();\n        state._viewSwatchId = 0;\n        gotoView(i);\n      });\n      name.addEventListener('dblclick', function (ev) { ev.stopPropagation(); beginViewRename(i); });\n      row.appendChild(name);\n    }\n\n    const cnt = document.createElement('span');\n    cnt.className = 'view-count';\n    const live = viewLiveIds(v).length;\n    cnt.textContent = String(live);\n    cnt.title = live + ' item' + (live === 1 ? '' : 's') + ' framed';\n    if (!live) cnt.classList.add('stale');\n    row.appendChild(cnt);\n    const mk = function (txt, title, fn, disabled) {\n      const b = document.createElement('button');\n      b.className = 'view-btn';\n      b.textContent = txt;\n      b.title = title;\n      b.disabled = !!disabled;\n      b.addEventListener('click', function (ev) { ev.stopPropagation(); fn(); });\n      return b;\n    };\n    row.appendChild(mk('\u2191', 'Move earlier in the tape', function () { moveView(i, -1); }, i === 0));\n    row.appendChild(mk('\u2193', 'Move later in the tape', function () { moveView(i, 1); }, i === list.length - 1));\n    row.appendChild(mk('\u21BB', 'Re-aim at the current selection / camera', function () { updateViewFromCurrent(i); }));\n    row.appendChild(mk('\u00D7', 'Delete this view', function () { deleteView(i); }));\n    listEl.appendChild(row);\n\n    if (state._viewSwatchId === v.id) {\n      const strip = document.createElement('div');\n      strip.className = 'view-swatches';\n      VIEW_COLORS.forEach(function (c) {\n        const sw = document.createElement('button');\n        sw.className = 'view-swatch' + ((col || '') === c ? ' on' : '') + (c ? '' : ' none');\n        if (c) sw.style.background = c;\n        sw.title = c ? ('Colour ' + c) : 'No colour';\n        sw.addEventListener('click', function (ev) { ev.stopPropagation(); setViewColor(v.id, c); });\n        strip.appendChild(sw);\n      });\n      listEl.appendChild(strip);\n    }\n  });\n\n  // Focus has to wait for the element to be in the document, and the field\n  // opens pre-selected so typing replaces the suggestion outright.\n  if (toFocus) {\n    const inp = toFocus;\n    requestAnimationFrame(function () {\n      try { inp.focus(); inp.select(); inp.scrollIntoView({ block: 'nearest' }); } catch (e) {}\n    });\n  } else if (activeRow) {\n    // A tape of twenty views is taller than the rail; without this the shot\n    // being presented walks out of sight.\n    try { activeRow.scrollIntoView({ block: 'nearest' }); } catch (e) {}\n  }\n}\n\n// Alt+1..9, Alt+0 \u2014 jump straight to a view. These are the keys that make\n// views worth having in a meeting: no panel, no hunting, just \"look at 3\".\n// Matching on ev.code, NOT ev.key. On macOS Option+<digit> emits the OPTION\n// LAYER of the keyboard \u2014 Alt+1 is '\u00A1', Alt+2 is '\u2122', and so on \u2014 so a plain\n// `ev.key >= '0' && ev.key <= '9'` test never fires on a Mac, which is exactly\n// where this shortcut matters most. ev.code reports the physical key\n// ('Digit1') regardless of what the modifier layer produced.\n// F2 \u2014 rename the view you are on. Alt+digit gets you there; F2 is the one\n// that fixes the name when you arrive, without aiming at a row.\ndocument.addEventListener('keydown', function (ev) {\n  if (ev.key !== 'F2' || ev.ctrlKey || ev.metaKey || ev.altKey) return;\n  const tgt = ev.target;\n  if (tgt && (tgt.tagName === 'INPUT' || tgt.tagName === 'TEXTAREA' || tgt.isContentEditable)) return;\n  const vlist = _viewsList();\n  if (!vlist.length) return;\n  ev.preventDefault();\n  let i = state._activeViewIndex;\n  if (!(i >= 0 && i < vlist.length)) {\n    i = (state._present && state._present.index >= 0) ? state._present.index : 0;\n  }\n  beginViewRename(i);\n}, true);\n\ndocument.addEventListener('keydown', function (ev) {\n  if (!ev.altKey || ev.ctrlKey || ev.metaKey || ev.shiftKey) return;\n  const code = ev.code || '';\n  const m = /^(Digit|Numpad)([0-9])$/.exec(code);\n  if (!m) return;\n  const t = ev.target;\n  if (t && (t.tagName === 'INPUT' || t.tagName === 'TEXTAREA' || t.isContentEditable)) return;\n  const idx = (m[2] === '0') ? 9 : (parseInt(m[2], 10) - 1);\n  const list = _viewsList();\n  if (idx >= list.length) return;\n  ev.preventDefault();\n  if (state._present) { stopPresent(); }\n  gotoView(idx);\n}, true);\n\n// Collapsed by default, restored from localStorage once the user has made a\n// choice. The IIFE tolerates either script position (inline after the markup,\n// or deferred), and re-runs harmlessly if it somehow beats the parser.\n(function initViewsPanel() {\n  if (typeof document === 'undefined') return;\n  const apply = function () {\n    const p = document.getElementById('views-panel');\n    if (!p) return;\n    let collapsed = true;\n    try { collapsed = localStorage.getItem('krafted_views_collapsed') !== '0'; } catch (e) {}\n    p.classList.toggle('collapsed', collapsed);\n    renderViewsPanel();\n  };\n  if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', apply);\n  else apply();\n})();\n\n\n// ==== undo-redo.js ====\n\n\n// ============================================================\n//  UNDO / REDO\n// ============================================================\nfunction captureSnapshot() {\n  const snap = {\n    // R72: persist the current selection so undo doesn't visually\n    // deselect everything. The user reported: after Ctrl+Z the\n    // small panel (props) goes empty and the item loses its\n    // highlight, even though the items are still there. We just\n    // round-trip the IDs through Set serialization.\n    selected: [...state.selected],\n    items: state.items.map(i => ({\n      id: i.id, x: i.x, y: i.y, w: i.w, h: i.h, rot: i.rot, opacity: i.opacity,\n      flipH: i.flipH, flipV: i.flipV, locked: i.locked, z: i.z,\n      type: i.type || undefined,\n      strokeId: i.strokeId, drawMode: i.drawMode, drawColor: i.drawColor,\n      drawSize: i.drawSize, drawOpacity: i.drawOpacity, drawArrowHead: i.drawArrowHead,\n      // v7.0.29: packed strokes ride along in the undo snapshot, otherwise\n      // Ctrl+Z / Ctrl+Shift+Z came back with an empty transparent box.\n      drawStrokes: (i.type === 'draw') ? (i.drawStrokes || (i.el && i.el._strokeData) || null) : null,\n      drawPad: (i.type === 'draw') ? i.drawPad : null,\n      drawMinX: (i.type === 'draw') ? i.drawMinX : null,\n      drawMinY: (i.type === 'draw') ? i.drawMinY : null,\n      drawW: (i.type === 'draw') ? i.drawW : null,\n      drawH: (i.type === 'draw') ? i.drawH : null,\n      src: i.src, natW: i.natW, natH: i.natH, isVideo: i.isVideo || false, isGif: i.isGif || false, isAudio: i.isAudio || false, isProxy: i.isProxy || false, originalName: i.originalName || '',\n      audioName: i.audioName || i.filename || '',\n      filename: i.filename || i.audioName || '',\n      // Round 58: persist the user's manual FPS override so undo/redo\n      // and save/reload keep the chip state. Cycle index is UI-only\n      // (not saved) \u2014 it always re-initializes from the saved FPS.\n      fps: (i.video && i.video._kraftedFps) ? i.video._kraftedFps : null,\n      fpsManual: !!(i.video && i.video._kraftedFpsManual),\n      // R72: persist the playhead position and play state so undo\n      // doesn't jump the video to 0 and pause it. The user reported\n      // \"the mov player will close\" after Ctrl+Z \u2014 that's because\n      // the new <video> element was created with no currentTime\n      // (defaults to 0) and no autoplay, so a video the user was\n      // watching at, say, 1:23 would suddenly be at 0:00 and paused.\n      // We round-trip currentTime + !paused; restore applies them\n      // after loadedmetadata.\n      currentTime: (i.video && isFinite(i.video.currentTime)) ? i.video.currentTime : 0,\n      wasPlaying: !!(i.video && !i.video.paused && !i.video.ended),\n      // Original file name (if known) \u2014 used by video frame-comment\n      // export to name the output file and to display in the exported\n      // header. Empty when not available.\n      filename: i.filename || '',\n      cropX: i.cropX, cropY: i.cropY, cropW: i.cropW, cropH: i.cropH, frameOn: i.frameOn || false, frameZ: i.frameZ || 1, frameRot: i.frameRot || 0, frameX: i.frameX || 0, frameY: i.frameY || 0, name: i.name || '', note: i.note || '', tags: i.tags ? i.tags.slice() : [],\n      brightness: i.brightness, contrast: i.contrast, saturate: i.saturate,\n      hueRotate: i.hueRotate, blur: i.blur, sepia: i.sepia, grayscale: i.grayscale,\n      temp: i.temp, vignette: i.vignette, shadow: i.shadow, highlight: i.highlight, grain: i.grain,\n      trimStart: i.trimStart || 0, trimEnd: i.trimEnd || 0, playbackRate: i.playbackRate || 1,\n      isLink: i.isLink || false, linkUrl: i.linkUrl || '', linkTitle: i.linkTitle || '', linkDesc: i.linkDesc || '',\n      // Video annotation data (frame-by-frame comments only \u2014 draw was removed)\n      anno: i.anno && Array.isArray(i.anno.comments) ? {\n        comments: i.anno.comments.map(c => ({\n          id: c.id, frame: c.frame || 0, time: c.time || 0,\n          text: c.text || '',\n          translation: c.translation || '',\n          translationDir: c.translationDir || '',\n          // R73: persist the captured snapshot (base64 data URL) and the\n          // per-frame annotation strokes. Without these the comment list\n          // shows a \"\u2014\" placeholder and the lightbox shows \"No snapshot\"\n          // after undo, because the renderer at line ~6514 and the\n          // lightbox at line ~11211 both read c.snapshot / c.annoStrokes\n          // directly. Snapshots are tens of KB each, which is acceptable\n          // for a 50-entry undo stack on desktop.\n          snapshot: c.snapshot || '',\n          annoStrokes: (c.annoStrokes || []).filter(Boolean).map(s => ({\n            type: s.type, color: s.color, size: s.size,\n            points: (s.points || []).map(p => [p[0], p[1]]),\n            text: s.text || '',\n          })),\n          // Preserve user-edited state too so undo round-trips edits\n          originalText: c.originalText || '',\n        })),\n      } : null,\n      // R85: also snapshot the live strokesByFrame for undo/redo parity\n      // with the kpak save path. Without this, draw/text strokes added\n      // after the last comment are lost on undo/redo.\n      _annoStrokesByFrame: (function(){\n        if (!i.isVideo || !i.el || !i.el._annoDrawState) return null;\n        var sbf = i.el._annoDrawState.strokesByFrame;\n        if (!sbf) return null;\n        var out = {};\n        Object.keys(sbf).forEach(function(f){\n          if (sbf[f] && sbf[f].length) {\n            out[f] = sbf[f].map(function(s){\n              return { type:s.type, color:s.color, size:s.size, points:(s.points||[]).map(function(p){return[p[0],p[1]]}), text:s.text||'' };\n            });\n          }\n        });\n        return Object.keys(out).length ? out : null;\n      })(),\n      masks: (i.masks || []).map(m => ({ id: m.id, name: m.name, enabled: m.enabled, type: m.type, color: m.color, tolerance: m.tolerance, feather: m.feather, brushData: m.brushData, brushSize: m.brushSize, brightness: m.brightness, contrast: m.contrast, saturate: m.saturate, temp: m.temp, shadow: m.shadow, highlight: m.highlight, hueRotate: m.hueRotate, sepia: m.sepia, tintColor: m.tintColor, tintStrength: m.tintStrength })),\n    })),\n    texts: state.texts.map(serializeBoardText),\n    todos: (state.todos||[]).map(t => ({\n      id: t.id, x: t.x, y: t.y, w: t.w, h: t.h, z: t.z,\n      rot: t.rot || 0, opacity: t.opacity !== undefined ? t.opacity : 1, locked: t.locked || false,\n      title: t.title || '', items: (t.items||[]).map(it => ({ text: it.text, done: it.done })),\n    })),\n    mindmaps: (state.mindmaps||[]).map(m => ({\n      id: m.id, x: m.x, y: m.y, w: m.w, h: m.h, z: m.z,\n      rot: m.rot || 0, opacity: m.opacity !== undefined ? m.opacity : 1, locked: m.locked || false,\n      title: m.title || '', nodes: (m.nodes||[]).map(n => ({ id: n.id, text: n.text, x: n.x, y: n.y, w: n.w, h: n.h, color: n.color, textColor: n.textColor, parentId: n.parentId || null, img: n.img || null, imgW: n.imgW || 0, imgH: n.imgH || 0, audio: n.audio || null, audioName: n.audioName || null })),\n      connections: (m.connections||[]).map(c => ({ id: c.id, from: c.from, to: c.to, color: c.color })),\n      nextNodeId: m.nextNodeId || 1, nextConnId: m.nextConnId || 1,\n    })),\n    groups: state.groups.map(serializeGroup),\n    // v7.0.40: named views round-trip through undo. They carry no media, just\n    // names and id lists, so they cost a few hundred bytes per view.\n    views: (state.views || []).map(serializeView),\n    drawStrokes: G.drawStrokes,\n    relations: (state.relations || []).map(function(r) { return { id: r.id, fromId: r.fromId, toId: r.toId, fromAnchor: r.fromAnchor, toAnchor: 