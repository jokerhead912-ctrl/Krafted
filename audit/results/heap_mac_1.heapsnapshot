& Layout': '\u56FE\u5C42\u4E0E\u5E03\u5C40',\n    'Order': '\u987A\u5E8F',\n    'Bring to Front': '\u79FB\u81F3\u6700\u524D',\n    'Top': '\u6700\u524D',\n    'Move Up': '\u4E0A\u79FB',\n    'Up': '\u4E0A',\n    'Move Down': '\u4E0B\u79FB',\n    'Down': '\u4E0B',\n    'Send to Back': '\u79FB\u81F3\u6700\u540E',\n    'Bottom': '\u6700\u540E',\n    'Lock/unlock': '\u9501\u5B9A/\u89E3\u9501',\n    'Lock': '\u9501\u5B9A',\n    'Unlock': '\u89E3\u9501',\n    'Duplicate (Ctrl+Shift+D)': '\u590D\u5236 (Ctrl+Shift+D)',\n    'Align': '\u5BF9\u9F50',\n    'Align Center H': '\u6C34\u5E73\u7F6E\u4E2D',\n    'Center': '\u7F6E\u4E2D',\n    'Right': '\u9760\u53F3',\n    'Left': '\u9760\u5DE6',\n    'Align Top': '\u9760\u4E0A',\n    'Align Center V': '\u5782\u76F4\u7F6E\u4E2D',\n    'Middle': '\u4E2D\u95F4',\n    'Align Bottom': '\u9760\u4E0B',\n    'Smart Layout': '\u667A\u80FD\u5E03\u5C40',\n    'Column Layout': '\u76F4\u5217\u5E03\u5C40',\n    'Column': '\u76F4\u5217',\n    'Row Layout': '\u6A2A\u5217\u5E03\u5C40',\n    'Row': '\u6A2A\u5217',\n    'Grid Layout': '\u7F51\u683C\u5E03\u5C40',\n    '\u25A6 Grid': '\u25A6 \u7F51\u683C',\n    'Distribute & Size': '\u5206\u5E03\u4E0E\u5927\u5C0F',\n    'Distribute Horizontal': '\u6C34\u5E73\u5206\u5E03',\n    '\u2501\u2501 H': '\u2501\u2501 \u6C34\u5E73',\n    'Distribute Vertical': '\u5782\u76F4\u5206\u5E03',\n    '\u2503\u2503 V': '\u2503\u2503 \u5782\u76F4',\n    'Same Size': '\u76F8\u540C\u5927\u5C0F',\n    'CGSize': '\u540C\u5927\u5C0F',\n    'Same Width': '\u76F8\u540C\u5BBD\u5EA6',\n    '= W': '= \u5BBD',\n    'Same Height': '\u76F8\u540C\u9AD8\u5EA6',\n    '= H': '= \u9AD8',\n    'Stack': '\u5806\u53E0',\n    'Border Color': '\u8FB9\u6846\u989C\u8272',\n    'Open Link': '\u5F00\u542F\u8FDE\u7ED3',\n    'Background Color': '\u80CC\u666F\u989C\u8272',\n    'Dark Grey': '\u6DF1\u7070',\n    'Dark Blue': '\u6DF1\u84DD',\n    'Near Black': '\u8FD1\u9ED1',\n    'Charcoal': '\u70AD\u7070',\n    'Light': '\u6D45\u8272',\n    'Warm paper': '\u6696\u7EB8\u8272',\n    'Paper / Artboard': '\u7EB8\u5F20 / \u753B\u677F',\n    'Show Paper': '\u663E\u793A\u7EB8\u5F20',\n    'Hide Paper': '\u9690\u85CF\u7EB8\u5F20',\n    'Auto-fit: ON': '\u81EA\u52A8\u9002\u5E94\uFF1A\u5F00',\n    'Auto-fit: OFF': '\u81EA\u52A8\u9002\u5E94\uFF1A\u5173',\n    'Paper Color': '\u7EB8\u5F20\u989C\u8272',\n    'W': '\u5BBD',\n    'H': '\u9AD8',\n    '4K': '4K',\n\n    // \u2500\u2500 GIF Editor \u2500\u2500\n    'GIF Trim Editor': 'GIF \u88C1\u526A\u7F16\u8F91\u5668',\n    'Preview': '\u9884\u89C8',\n    'Total Frames:': '\u603B\u5E27\u6570\uFF1A',\n    'Duration:': '\u65F6\u957F\uFF1A',\n    'Trim:': '\u88C1\u526A\uFF1A',\n    'Speed:': '\u901F\u5EA6\uFF1A',\n    'Apply Trim': '\u5957\u7528\u88C1\u526A',\n    'Export GIF': '\u5BFC\u51FA GIF',\n    'Frame Strip (click to set In point)': '\u5E27\u6761 (\u70B9\u51FB\u8BBE\u5B9A\u8D77\u59CB\u70B9)',\n\n    // \u2500\u2500 Context menu \u2500\u2500\n    'Duplicate Ctrl+Shift+D': '\u590D\u5236 Ctrl+Shift+D',\n    'Copy Ctrl+C': '\u590D\u5236 Ctrl+C',\n    'Paste Ctrl+V': '\u8D34\u4E0A Ctrl+V',\n    '\u2713 Alt+Left Pan (Mac trackpad)': '\u2713 Alt+\u5DE6\u952E\u5E73\u79FB (Mac \u89E6\u63A7\u677F)',\n    '\u25CB Alt+Left Pan (Mac trackpad)': '\u25CB Alt+\u5DE6\u952E\u5E73\u79FB (Mac \u89E6\u63A7\u677F)',\n    '\u2699 Wheel: Mouse (zoom)': '\u2699 \u6EDA\u8F6E\uFF1A\u9F20\u6807\uFF08\u7F29\u653E\uFF09',\n    '\u2699 Wheel: Trackpad (pan)': '\u2699 \u6EDA\u8F6E\uFF1A\u89E6\u63A7\u677F\uFF08\u5E73\u79FB\uFF09',\n    'Same Size Ctrl+Alt+\u2191': '\u76F8\u540C\u5927\u5C0F Ctrl+Alt+\u2191',\n    'Distribute H': '\u6C34\u5E73\u5206\u5E03',\n    'Distribute V': '\u5782\u76F4\u5206\u5E03',\n    '\uF9F9 Tidy Selected': '\uF9F9 \u6574\u7406\u9009\u53D6',\n    'Trim GIF': '\u88C1\u526A GIF',\n    'Save media files\u2026': '\u50A8\u5B58\u5A92\u4F53\u6863\u2026',\n    '\uF4DD Export notes as HTML\u2026': '\uF4DD \u532F\u51FA\u5716\u6587\u5099\u8A3B HTML\u2026',\n    'Crop Image C': '\u88C1\u526A\