) _armFolderTidy(sorted.length);\n  _handleFileDrop(e, sorted);\n}\n\n// v7.0.37 \u2014 P1-9. Cascade placement for a multi-file drop / paste.\n// Every file used to be offset by a flat 20px, so a drop of 30 images\n// landed as one 97%-overlapping stack: the user could not see or grab any\n// of them, and the only clue was the toast saying \"Imported 30 files\".\n// Now each item steps by a fraction of its OWN size, and wraps to a new row\n// every `cols` so a big drop stays a compact block rather than a 4000px\n// diagonal walk off screen. Returns a function you call with (w, h) of the\n// item you are about to place; it answers where that item should go.\nfunction makeCascade(originX, originY, cols) {\n  let n = 0, step = 0;\n  const COLS = cols || 6;\n  return function (w, h) {\n    const s = Math.max(32, Math.min(200, Math.min(w || 720, h || 720) * 0.22));\n    // Step only ever grows: a big item later in the batch must not end up\n    // hidden behind the small one that happened to be placed before it.\n    if (s > step) step = s;\n    const col = n % COLS, row = (n / COLS) | 0;\n    n++;\n    return { x: originX + col * step, y: originY + row * step };\n  };\n}\n\n// v7.0.37 \u2014 P2. One image-import normaliser. The rule used to be inlined in\n// the web drag-in path only (v7.0.22), so an 8000px PNG pasted from disk\n// landed on the board at full size while the SAME file dragged off a website\n// came in capped. Two paths, two results, one of them able to OOM the tab.\n//   - caps the longest edge, so a pathologically large file cannot blow up\n//     the decoded bitmap or the KPAK payload\n//   - re-encodes fat PNGs as JPEG when a 32px alpha probe says they are\n//     fully opaque (~10x smaller); real transparency survives as PNG\n// `local` files get a much higher ceiling than web drags: a director's own\n// 8K render is reference material they may want to crop into, whereas a web\n// image is only ever looked at.\nconst IMAGE_MAX_EDGE = 1280;\n// v7.5.0: was 4096. This constant is the biggest single lever on what a\n// board costs, because it sets the DECODED size, not the file size: a\n// 4096x4096 <img> is 4096*4096*4 = 67 MB of RGBA once Chrome decodes it,\n// and a 300-image board was asking for ~20 GB of decoded pixels. 2048\n// costs 16 MB per image (4x less), is still crisp at 200% zoom on a 4K\n// display, and is 2.8x the 720px rows the board export writes -- so\n// nothing the app produces loses visible detail. Retune here, once.\nconst IMAGE_MAX_EDGE_LOCAL = 2048;\nconst IMAGE_PNG_REENCODE_BYTES = 600 * 1024;\n\nfunction imageNeedsNormalize(w, h, type, size, local) {\n  if (Math.max(w || 0, h || 0) > (local ? IMAGE_MAX_EDGE_LOCAL : IMAGE_MAX_EDGE)) return true;\n  return type === 'image/png' && size > IMAGE_PNG_REENCODE_BYTES;\n}\n\n// `file` is the original Blob (handed straight back when nothing needs doing);\n// `source` is anything ctx.drawImage accepts (ImageBitmap or HTMLImageElement);\n// `cb(blob, w, h)` always fires \u2014 on any failure it fires with the ORIGINAL\n// bytes, so a normalise attempt can never lose the user's import.\nfunction normalizeImageBlob(file, source, w, h, local, cb) {\n  const bail = function () { cb(file, w, h); };\n  if (!file || !source || !w || !h) return bail();\n  if (!imageNeedsNormalize(w, h, file.type, file.size, local)) return bail();\n  try {\n    const cap = local ? IMAGE_MAX_EDGE_LOCAL : IMAGE_MAX_EDGE;\n    const scale = Math.min(1, cap / Math.max(w, h));\n    const c = document.createElement('canvas');\n    c.width = Math.max(1, Math.round(w * scale));\n    c.height = Math.max(1, Math.round(h * scale));\n    c.getContext('2d').drawImage(source, 0, 0, c.width, c.height);\n    let opaque = true;\n    if (file.type === 'image/png') {\n      // Cheap alpha probe on a 32px sample: fully opaque photos become JPEG\n      // (~10x smaller); real alpha survives as PNG.\n      const sv = document.createElement('canvas');\n      sv.width = 32; sv.height = 32;\n      const sctx = sv.getContext('2d');\n      sctx.drawImage(c, 0, 0, 32, 32);\n      const px = sctx.getImageData(0, 0, 32, 32).data;\n      for (let pi = 3; pi < px.length; pi += 4) {\n        if (px[pi] < 250) { opaque = false; break; }\n      }\n    }\n    c.toBlob(function (b) {\n      if (b) cb(b, c.width, c.height); else bail();\n    }, opaque ? 'image/jpeg' : 'image/png', 0.87);\n  } catch (e) {\n    console.warn('[ImageNormalize] skipped:', e && e.message);\n    bail();\n  }\n}\n\n// v7.7.0 \u2014 folder-drop auto-tidy. A multi-folder drop used to land as one\n// cascade stack with each item stepping by ~22% of its own size, so big\n// images overlapped almost completely. After a folder import we run\n// tidySelection() over the new items so they pack into a non-overlapping\n// block. Images/videos are added asynchronously, so we count completions\n// and only tidy once every expected item has actually been placed. Plain\n// (non-folder) drops and pastes never arm this \u2014 only _finishFolderImport.\nvar _folderTidy = { active: false, ids: [], expected: 0, attempts: 0 };\nfunction _armFolderTidy(n) {\n  if (!_folderTidy.active) { _folderTidy.active = true; _folderTidy.ids = []; _folderTidy.attempts = 0; }\n  _folderTidy.expected += n;\n}\nfunction _maybeTidy(id) {\n  if (!_folderTidy.active) return;\n  if (id != null) _folderTidy.ids.push(id);\n  _folderTidy.attempts++;\n  if (_folderTidy.attempts >= _folderTidy.expected) {\n    _folderTidy.active = false;\n    var _ids = _folderTidy.ids;\n    _folderTidy.ids = []; _folderTidy.expected = 0; _folderTidy.attempts = 0;\n    if (_ids.length >= 2) {\n      state.selected.clear();\n      _ids.forEach(function (i) { state.selected.add(i); });\n      tidySelection();\n    }\n  }\n}\n\n// v7.27.0: proxy <-> original mapping.\n// A clip named \"<base>_proxy.<ext>\" stands in for \"<base>.<ext>\": the board\n// plays the proxy (that is the whole point -- a 1080p H.264 decodes in\n// hardware, a 4K ProRes master does not) and the card remembers which\n// original it stands for.\n// The suffix is NOT configurable. It was offered and turned down: a list of\n// patterns is a setting nobody can remember the contents of, and a file that\n// is not a proxy but matches would silently lose its own card.\nconst PROXY_SUFFIX = '_proxy';\n\n// \"shot01_proxy.mp4\" -> \"shot01\"; anything else -> null.\nfunction proxyBaseName(filename) {\n  const s = String(filename || '');\n  const dot = s.lastIndexOf('.');\n  const base = dot > 0 ? s.slice(0, dot) : s;\n  if (base.length <= PROXY_SUFFIX.length) return null;\n  if (base.slice(-PROXY_SUFFIX.length).toLowerCase() !== PROXY_SUFFIX) return null;\n  // No `|| null` here: the length guard above already rejects a base that is\n  // exactly the suffix, so the slice can never come back empty.\n  return base.slice(0, -PROXY_SUFFIX.length);\n}\n\n// \"shot01.mov\" -> \"shot01\". The extension is what differs between a proxy\n// and its original, so matching has to happen on the name without it.\nfunction mediaBaseName(filename) {\n  const s = String(filename || '');\n  const dot = s.lastIndexOf('.');\n  return dot > 0 ? s.slice(0, dot) : s;\n}\n\n// Decide, for one import batch, which files become cards.\n//   * a proxy always becomes a card;\n//   * an original whose base has a proxy in the SAME batch does not -- that\n//     duplicate is exactly what the mapping exists to prevent;\n//   * everything else is untouched.\n// Pure: no DOM, no state. Returns name -> {isProxy, originalName, originalPath, skip}.\n// `pathsByName` is optional: when a whole folder was dragged in, Chrome\n// knows each file's path, and carrying it through is what lets two takes\n// with the same name both be found later. Without it the behaviour is\n// exactly what it was before.\nfunction planProxyPairs(names, pathsByName) {\n  const plan = Object.create(null);\n  const originalByBase = Object.create(null);\n  const proxies = [];\n  (names || []).forEach(function (n) {\n    if (!(typeof n === 'string') || !n) return;\n    const pb = proxyBaseName(n);\n    if (pb !== null) { proxies.push({ name: n, base: pb }); return; }\n    const b = mediaBaseName(n);\n    if (b && !(b in originalByBase)) originalByBase[b] = n;\n  });\n  const claimed = Object.create(null);\n  proxies.forEach(function (p) {\n    const orig = originalByBase[p.base] || null;\n    plan[p.name] = { isProxy: true, originalName: orig, originalPath: ((orig && pathsByName) ? (pathsByName[orig] || '') : ''), skip: false };\n    if (orig) claimed[orig] = true;\n  });\n  Object.keys(originalByBase).forEach(function (b) {\n    const n = originalByBase[b];\n    if (claimed[n]) plan[n] = { isProxy: false, originalName: null, skip: true };\n  });\n  return plan;\n}\n\nfunction _handleFileDrop(e, files) {\n  console.log('[FileDrop] _handleFileDrop called with', files.length, 'files');\n  // v7.28.0: before anything is filtered away. A proxy's original never\n  // becomes a card, so this is the only moment we still hold its bytes.\n  noteDroppedFiles(files);\n  // v7.0.27: .kpak/.zip drop = OPEN the board package (was silently\n  // swallowed by the media-only filter below). Remaining media files in\n  // the same drop still import normally after the load starts.\n  const _kpakDrop = files.find(f => /\\.(kpak|zip)$/i.test((f && f.name) || ''));\n  if (_kpakDrop) {\n    loadBoardFromFile(_kpakDrop).catch(err => {\n      console.warn('[FileDrop] kpak open failed:', err);\n      toast((_isZhUI() ? '\u8BFB\u53D6\u5931\u8D25\uFF1A' : 'Load failed: ') + (err.message || 'unknown'));\n    });\n    files = files.filter(f => f !== _kpakDrop);\n    if (!files.length) return;\n  }\n  // Separate images, videos, and audio files\n  const imageFiles = [];\n  let videoFiles = [];          // v7.26.1: let \u2014 proxy pairing removes entries\n  const audioFiles = [];\n  // v7.17.0: .md / .txt are board text, not media.\n  const _docTextFiles = files.filter(function (f) { return isDocTextFile(f); });\n  files.forEach((file, idx) => {\n    const isVideo = file.type.startsWith('video/');\n    const isAudio = file.type.startsWith('audio/') || /\\.(mp3|wav|aiff|aif|flac|ogg|m4a)$/i.test(file.name);\n    if (!file.type.startsWith('image/') && !isVideo && !isAudio) return;\n    if (isVideo) videoFiles.push({ file, idx });\n    else if (isAudio) audioFiles.push({ file, idx });\n    else imageFiles.push({ file, idx });\n  });\n  // v7.17.0: a file we cannot use used to vanish with no toast at all \u2014\n  // the same silence as a dead button. Say so instead.\n  const _skipped = files.length - (imageFiles.length + videoFiles.length + audioFiles.length + _docTextFiles.length);\n  if (_skipped > 0) {\n    try { toast(boardTextLabel('Skipped ' + _skipped + ' unsupported file(s) \u2014 images, video, audio, .md or .txt', '\u5DF2\u7565\u8FC7 ' + _skipped + ' \u4E2A\u4E0D\u652F\u63F4\u7684\u6863\u6848 \u2014 \u56FE\u7247 / \u5F71\u7247 / \u97F3\u8BAF / .md / .txt')); } catch (e) {}\n  }\n  const dropX0 = (e.clientX - state.pan.x) / state.zoom;\n  const dropY0 = (e.clientY - state.pan.y) / state.zoom;\n  // v7.0.37 \u2014 P1-9: ONE cascade shared by the image, video and audio chains\n  // so all three fan out from the cursor instead of each starting on top of\n  // the others at dropX0/dropY0.\n  const cascade = makeCascade(dropX0, dropY0);\n  // v7.17.0: text cards fan out to the right of the cursor, one per file.\n  if (_docTextFiles.length) {\n    importDocTextFiles(_docTextFiles, function (i) { return { x: dropX0 + i * (DOC_TEXT_W + 24), y: dropY0 }; });\n  }\n  // Process images SEQUENTIALLY (one at a time) to avoid memory crash.\n  // v6.1.23: Use createImageBitmap() for dimension reading (zero-copy,\n  // no blob URL needed for the temp decode). The canvas <img> gets the\n  // blob URL only after we know the dimensions. createImageBitmap is\n  // async but doesn't create a separate <img> element, so no GC churn\n  // from detached DOM nodes. Bitmap is closed immediately after.\n  if (imageFiles.length > 0) pushUndo();\n  let imgIdx = 0;\n  async function processNextImage() {\n    // v7.5.0: the batch is in, so re-run the cull with the new items.\n    if (imgIdx >= imageFiles.length) { scheduleImageCull(); return; }\n    const { file } = imageFiles[imgIdx];\n    const isLast = (imgIdx === imageFiles.length - 1);\n    imgIdx++;\n    try {\n      // createImageBitmap is async, zero-copy, no DOM needed\n      const bitmap = await createImageBitmap(file);\n      const w = bitmap.width, h = bitmap.height;\n      const isGif = file.type === 'image/gif' || /\\.gif$/i.test(file.name);\n      // v7.0.37 \u2014 P2: same normalise rule as a web drag-in (was: raw, full\n      // size). GIFs are skipped \u2014 re-encoding would kill the animation.\n      const at = cascade(w, h);\n      if (isGif) {\n        bitmap.close();\n        const blobUrl = URL.createObjectURL(file);\n        const _it = applyImportMeta(addImage(blobUrl, w, h, at.x, at.y, false, isLast, file.size, true, file), file);\n        _maybeTidy(_it.id);\n      } else {\n        normalizeImageBlob(file, bitmap, w, h, true, function (outBlob, ow, oh) {\n          bitmap.close();  // release as soon as we are done drawing it\n          const blobUrl = URL.createObjectURL(outBlob);\n          const _it = applyImportMeta(addImage(blobUrl, ow, oh, at.x, at.y, false, isLast, outBlob.size, false, outBlob), file);\n          _maybeTidy(_it.id);\n        });\n      }\n    } catch(e) {\n      console.warn('[FileDrop] Image decode failed:', file.name, e.message);\n      _maybeTidy(null);\n    }\n    // Brief pause to let GC run before next image\n    setTimeout(processNextImage, 50);\n  }\n  // Start the chain. v7.0.37 \u2014 P1-9: this used to call processNextImage()\n  // unconditionally AND then again inside the guard below, so two chains ran\n  // concurrently over the same imgIdx. That defeated the whole point of the\n  // \"one at a time to avoid a memory crash\" sequencing above and made the\n  // isLast flag (hence which item ends up selected) a race.\n  if (imageFiles.length > 0) {\n    processNextImage();\n    if (imageFiles.length > 1) toast('Importing ' + imageFiles.length + ' images\u2026');\n  }\n  // Process videos: create blob URL and add directly \u2014 don't wait for\n  // metadata. Large/high-bitrate files (20+ Mbps) can take seconds to\n  // parse the moov atom; blocking on loadedmetadata makes the UI appear\n  // frozen. Instead, add with estimated/default dimensions and let the\n  // main video element resolve actual dimensions when metadata loads.\n  // v7.27.0: pair before anything becomes a card. Doing it after would mean\n  // creating the original's card and then deleting it, which flashes a card\n  // the user never asked for and leaves an undo step behind.\n  const _pathsByName = Object.create(null);\n  videoFiles.forEach(function (v) {\n    const k = dropKeyOf(v.file);\n    if (v.file && v.file.name && k && k !== v.file.name) _pathsByName[v.file.name] = k;\n  });\n  const _proxyPlan = planProxyPairs(videoFiles.map(function (v) { return v.file.name; }), _pathsByName);\n  const _keepInBatch = function (v) {\n    return !(_proxyPlan[v.file.name] && _proxyPlan[v.file.name].skip);\n  };\n  const _proxySkipped = videoFiles.filter(function (v) { return !_keepInBatch(v); });\n  // Unconditional: filtering is a no-op when nothing paired up, and an\n  // assignment that always runs cannot be quietly switched off by a later\n  // edit to the `if` below (which only guards the message).\n  videoFiles = videoFiles.filter(_keepInBatch);\n  if (_proxySkipped.length > 0) {\n    // Silently dropping a file is never acceptable \u2014 say which ones and why.\n    try {\n      toast(boardTextLabel(\n        'Paired ' + _proxySkipped.length + ' proxy clip(s) with their original \u2014 the board plays the proxy, the original is only remembered',\n        '\u5DF2\u914D\u5BF9 ' + _proxySkipped.length + ' \u4E2A\u4EE3\u7406\u6863 \u2014 \u677F\u4E0A\u64AD\u653E\u4EE3\u7406\u6863\uFF0C\u539F\u6863\u53EA\u4F5C\u8BB0\u5F55'));\n    } catch (e) {}\n  }\n  if (videoFiles.length > 0) pushUndo();\n  let videoQueueIdx = 0;\n  function processNextVideo() {\n    if (videoQueueIdx >= videoFiles.length) return;\n    const { file } = videoFiles[videoQueueIdx];\n    const isLast = (videoQueueIdx === videoFiles.length - 1);\n    const blobUrl = URL.createObjectURL(file);\n    // Use a generous default size; the real dimensions will be picked up\n    // by the main <video> element once metadata loads asynchronously.\n    // 720p default covers most common video sources without looking wrong.\n    const at = cascade(1280, 720);\n    const newItem = addImage(blobUrl, 1280, 720, at.x, at.y, true, isLast, file.size, false, file);\n    applyImportMeta(newItem, file);\n    // v7.27.0: record the pairing on the card that survived.\n    const _pp = _proxyPlan[file.name];\n    if (_pp && _pp.isProxy) {\n      newItem.isProxy = true;\n      newItem.originalName = _pp.originalName || '';\n      // v7.30.0: where it came from. Without this, A/shot01.mov and\n      // B/shot01.mov are the same card as far as the pool is concerned.\n      newItem.originalPath = _pp.originalPath || '';\n      // v7.29.0: how big the original we just paired away was, so a later\n      // \"Link original\" can tell it apart from any other file with the same\n      // name. Absent is fine -- it just means we ask instead of guessing.\n      const _of = _dropFiles.get(newItem.originalPath || newItem.originalName);\n      if (_of && typeof _of.size === 'number') newItem.originalSize = _of.size;\n    }\n    _maybeTidy(newItem.id);\n    videoQueueIdx++;\n    setTimeout(processNextVideo, 50);\n  }\n  processNextVideo();\n  // Process audio files\n  audioFiles.forEach(({ file }) => {\n    const at = cascade(280, 64);   // the audio card's own w/h (addAudioItem)\n    // v6.2.1: use blob URL instead of data URL \u2014 WAV files can be hundreds of MB,\n    // and readAsDataURL allocates a base64 string (~33% bigger) that OOMs the tab\n    // and crashes JSON.stringify during pushUndo/captureSnapshot.\n    const blobUrl = URL.createObjectURL(file);\n    const _a = applyImportMeta(addAudioItem(blobUrl, file.name, at.x, at.y, file.size, file), file);\n    _maybeTidy(_a.id);\n  });\n}\n\nviewport.addEventListener('drop', e => {\n  e.preventDefault();\n  // v6.8.27: block drops while saving to avoid mutating state mid-save.\n  if (state._saving) { toast('Please wait for save to finish'); return; }\n  hideWelcome();\n  // v5.5.1: detect folder drops via DataTransferItem.webkitGetAsEntry()\n  var items = e.dataTransfer.items;\n  if (items && items.length > 0 && items[0].webkitGetAsEntry) {\n    var entries = [];\n    for (var i = 0; i < items.length; i++) {\n      var entry = items[i].webkitGetAsEntry();\n      if (entry) entries.push(entry);\n    }\n    if (entries.length > 0) {\n      _handleEntryDrop(e, entries);\n      return;\n    }\n  }\n  // Fallback: regular file drop (files[] + items/getAsFile merge)\n  const dropped = _collectDroppedFiles(e.dataTransfer);\n  if (dropped.length) _handleFileDrop(e, dropped);\n});\n\n\n// ==== paste-handler.js ====\n\n\n// PASTE FROM CLIPBOARD (handles Explorer files, screenshots, text, URLs, internal items)\ndocument.addEventListener('paste', e => {\n  if (!e.clipboardData) return;\n\n  // v6.8.27: block clipboard imports while saving (images/files), but allow\n  // plain text paste into a focused text-item to finish normally.\n  const ae = document.activeElement;\n  const isOurText = ae && ae.contentEditable === 'true' && ae.classList.contains('text-item');\n  if (state._saving && !isOurText) { toast('Please wait for save to finish'); return; }\n\n  // If user is actively typing inside a text-item (cursor inside, editing mode, HAS SELECTION),\n  // let the browser handle it. v5.5: only return if there's actually a caret/selection INSIDE the\n  // text-item \u2014 otherwise the user wants to paste on the canvas, so blur the text-item and fall\n  // through to our paste handler. Without this, any external text paste (when a stale text-item\n  // still has focus but no selection) is silently swallowed by the text-item's contentEditable.\n  // v6.6.2: If a Krafted text-item is focused and editing, ALWAYS let the\n  // text-item's own paste handler deal with it (strip formatting, insert plain\n  // text). The old logic blurred the text-item when there was no selection,\n  // which caused the global paste handler to try importing clipboard images/HTML\n  // and fail on file:// references from WeChat \u2014 corrupting the text item state.\n  if (isOurText && ae.classList.contains('editing')) {\n    return; // let text-item's own paste listener handle it\n  }\n\n  // If some other contentEditable is focused (but NOT our text-item), blur it first\n  // so our paste handler can take over\n  if (ae && ae.contentEditable === 'true' && !ae.classList.contains('text-item')) return;\n\n  hideWelcome();\n  const items = e.clipboardData.items;\n  const files = e.clipboardData.files;\n\n  try {\n  // Helper: attach image to selected mindmap node\n  function attachToMindmap(blob) {\n    for (const mm of (state.mindmaps || [])) {\n      if (mm.selectedNodeId && mm.el) {\n        const node = mm.nodes.find(n => n.id === mm.selectedNodeId);\n        if (node) return { mm, node };\n      }\n    }\n    return null;\n  }\n\n  // Helper: detect file type from extension when MIME type is empty\n  function fileType(f) {\n    if (f.type) return f.type;\n    const n = (f.name || '').toLowerCase();\n    if (!n) return '';\n    if (/\\.(png|jpg|jpeg|gif|webp|svg|bmp|ico|tiff|tif|avif|heic)$/i.test(n)) return 'image/' + (n.split('.').pop());\n    if (/\\.(mp4|webm|ogv|mov|avi|mkv|wmv|flv)$/i.test(n)) return 'video/' + (n.split('.').pop());\n    if (/\\.(mp3|wav|aiff|aif|flac|ogg|m4a|wma)$/i.test(n)) return 'audio/' + (n.split('.').pop());\n    return '';\n  }\n\n  // \u2500\u2500 0) IN-APP COPY INTERCEPT \u2014 Round 20 \u2500\u2500\n  // If the user just copied something in the app (within 3s), ALWAYS use\n  // state.clipboard. Rounds 17 and 19 tried to mirror the copy to the\n  // SYSTEM clipboard via navigator.clipboard.write, then checked a flag\n  // to decide whether to trust the system clipboard or fall back. But\n  // that flag is unreliable: on Mac file:// in Chrome and Safari the\n  // write is silently blocked (or \"succeeds\" without actually overwriting\n  // the system clipboard), so the paste event keeps delivering whatever\n  // was on the system clipboard before \u2014 i.e., the OLD image. The user\n  // has hit this 3 times.\n  //\n  // The fix: short-circuit the entire paste logic for 3s after an in-app\n  // copy. After 3s the system clipboard is trusted again so external\n  // pastes (screenshots, browser copy-image) still work. This matches\n  // the behavior of triggerPaste() (right-click / toolbar Paste).\n  // v5.5: also check WHAT the user is pasting \u2014 if the incoming paste has\n  // text/plain content, compare it with the internal clipboard text content.\n  // If they differ (or internal clipboard has no text), let the external\n  // text paste fall through to the text handler below. This handles the\n  // case where the user copied a text-item in Krafted, then copied text\n  // from another app (WhatsApp, chat) and pastes \u2014 the old logic would\n  // incorrectly intercept and duplicate the Krafted text-item instead.\n  // v6.8.12: Internal clipboard intercept should support MULTI-paste.\n  // v6.8.11 consumed state.clipboard after the first Cmd/Ctrl+V, so the\n  // second paste fell back to the system clipboard (which might contain\n  // unrelated/stale HTML/text) and users saw \"weird\" pasted content.\n  // Keep internal clipboard alive for a short \"recent copy\" window, and\n  // only throttle ultra-fast key-repeat bursts.\n  if (state.clipboard && state.clipboard.length > 0) {\n    const now = Date.now();\n    const recentCopy = state.clipboardTime && (now - state.clipboardTime) < 3000;\n    if (recentCopy) {\n      if (state._lastInternalPaste && (now - state._lastInternalPaste) < 220) {\n        // Too soon \u2014 likely key-repeat while the key is held down.\n      } else {\n        const hasInternalMedia = state.clipboard.some(c => c.src || c.isVideo || c.isAudio);\n        // Text items in Krafted may not carry type:'text', so detect by content.\n        const hasInternalText = state.clipboard.some(c => (c.content || '').trim().length > 0);\n        if (hasInternalMedia || hasInternalText) {\n          e.preventDefault();\n          pasteClipboard();\n          state._lastInternalPaste = now;\n          return;\n        }\n      }\n    }\n  }\n\n  // \u2500\u2500 0) FILE PASTE from Explorer (files array + items array fallback) \u2500\u2500\n  // Chrome may expose only 1 file in e.clipboardData.files when multiple are copied from Explorer.\n  // Merge both sources: files[] and items[] (kind==='file') to capture all files.\n  const allPastedFiles = [];\n  const seenNames = new Set();\n  // First pass: files array\n  for (let i = 0; i < files.length; i++) {\n    const f = files[i];\n    if (f.name && !seenNames.has(f.name)) { seenNames.add(f.name); allPastedFiles.push(f); }\n    else if (!f.name) allPastedFiles.push(f); // unnamed (screenshot)\n  }\n  // Second pass: items array (kind === 'file') \u2014 may contain additional files Chrome didn't put in files[]\n  for (let i = 0; i < items.length; i++) {\n    const it = items[i];\n    if (it.kind === 'file') {\n      const f = it.getAsFile();\n      if (f) {\n        if (f.name && !seenNames.has(f.name)) { seenNames.add(f.name); allPastedFiles.push(f); }\n        else if (!f.name && files.length === 0) allPastedFiles.push(f); // screenshot via items\n      }\n    }\n  }\n  if (allPastedFiles.length > 0) {\n    const imageFiles = [], videoFiles = [], audioFiles = [];\n    for (const f of allPastedFiles) {\n      const ft = fileType(f);\n      if (ft.startsWith('image/')) imageFiles.push(f);\n      else if (ft.startsWith('video/')) videoFiles.push(f);\n      else if (ft.startsWith('audio/')) audioFiles.push(f);\n    }\n    if (imageFiles.length > 0 || videoFiles.length > 0 || audioFiles.length > 0) {\n      e.preventDefault();\n      const { x, y } = getPasteXY();\n      // v7.0.37 \u2014 P1-9: same cascade as drag-drop (was a flat 20px step).\n      const cascade = makeCascade(x, y);\n      // v6.8.27: Paste images via blob URL + createImageBitmap (same as drag-drop).\n      // readAsDataURL creates a base64 copy (~33% larger) that bloats the undo\n      // snapshot and can push JSON.stringify over the browser's string limit.\n      // One undo snapshot at batch start \u2192 single undo reverts the whole paste.\n      if (imageFiles.length > 0) pushUndo();\n      let imgIdx = 0;\n      (async function processNextImage() {\n        if (imgIdx >= imageFiles.length) return;\n        const f = imageFiles[imgIdx];\n        const isLast = (imgIdx === imageFiles.length - 1);\n        imgIdx++;\n        try {\n          const bitmap = await createImageBitmap(f);\n          const w = bitmap.width, h = bitmap.height;\n          const isGif = f.type === 'image/gif' || /\\.gif$/i.test(f.name);\n          const at = cascade(w, h);\n          // v7.0.37 \u2014 P2: same normalise rule as drag-in (was: raw, full size).\n          if (isGif) {\n            bitmap.close();\n            const blobUrl = URL.createObjectURL(f);\n            applyImportMeta(addImage(blobUrl, w, h, at.x, at.y, false, isLast, f.size, true, f), f);\n          } else {\n            normalizeImageBlob(f, bitmap, w, h, true, function (outBlob, ow, oh) {\n              bitmap.close();\n              const blobUrl = URL.createObjectURL(outBlob);\n              applyImportMeta(addImage(blobUrl, ow, oh, at.x, at.y, false, isLast, outBlob.size, false, outBlob), f);\n            });\n          }\n        } catch (e) {\n          console.warn('[Paste] Image decode failed:', e.message);\n        }\n        setTimeout(processNextImage, 30);\n      })();\n      // Video: read as base64 data URL so it persists like images (not blob URL).\n      if (videoFiles.length > 0) pushUndo();\n      let vIdx = 0;\n      (function processNextVideo() {\n        if (vIdx >= videoFiles.length) return;\n        const f = videoFiles[vIdx];\n        const isLast = (vIdx === videoFiles.length - 1);\n        const blobUrl = URL.createObjectURL(f);\n        const tmpVid = document.createElement('video');\n        tmpVid.preload = 'metadata'; tmpVid.muted = true;\n        tmpVid.src = blobUrl;\n        let done = false;\n        const finish = (w, h) => {\n          if (done) return; done = true;\n          tmpVid.removeAttribute('src'); tmpVid.load();\n          // Capture the original file name so the export can use it\n          const at = cascade(w, h);\n          const newItem = addImage(blobUrl, w, h, at.x, at.y, true, isLast, f.size, false, f);\n          applyImportMeta(newItem, f);\n          vIdx++;\n          setTimeout(processNextVideo, 100);\n        };\n        tmpVid.onloadedmetadata = () => finish(tmpVid.videoWidth || 640, tmpVid.videoHeight || 360);\n        tmpVid.onerror = () => { URL.revokeObjectURL(blobUrl); vIdx++; setTimeout(processNextVideo, 100); };\n        setTimeout(() => { if (!done) finish(640, 360); }, 15000);\n      })();\n      audioFiles.forEach(f => {\n        const at = cascade(280, 64);   // the audio card's own w/h (addAudioItem)\n        // v6.2.1: use blob URL to avoid OOM on large WAVs\n        const blobUrl = URL.createObjectURL(f);\n        applyImportMeta(addAudioItem(blobUrl, f.name, at.x, at.y, f.size, f), f);\n      });\n      toast('Pasted ' + (imageFiles.length + videoFiles.length + audioFiles.length) + ' files');\n      return;\n    }\n  }\n\n  // \u2500\u2500 1) TEXT paste first (non-URL \u2192 text item, URL \u2192 link card) \u2500\u2500\n  // Process text BEFORE images \u2014 PPT/rich-text clipboard often has both text + preview image\n  for (const item of items) {\n    if (item.type === 'text/plain' || item.type === 'text/html' || item.type === 'text/richtext' || item.type === 'text' || item.type === 'text/rtf') {\n      e.preventDefault(); // preventDefault BEFORE getAsString \u2014 stop browser default paste immediately\n      const itemType = item.type; // capture for callback (some browsers recycle the item)\n      item.getAsString(raw => {\n        try {\n            let trimmed = raw.trim();\n            if (!trimmed) return;\n\n            // \u2500\u2500 Cross-origin image URL paste \u2500\u2500\n            // When user copies an image from another website, the clipboard\n            // usually contains text/html (with <img src>) or text/plain (URL).\n            // The image/* MIME type is often missing cross-origin. Detect\n            // image URLs here and fetch + embed them directly.\n            let imgUrl = null;\n            if (itemType === 'text/html') {\n              // Try to extract <img src> from HTML clipboard\n              const imgMatch = raw.match(/<img[^>]+src\\s*=\\s*[\"']([^\"']+)[\"']/i);\n              if (imgMatch) imgUrl = imgMatch[1];\n            }\n            if (!imgUrl && /^https?:\\/\\/[^\\s]+$/i.test(trimmed)) {\n              // Plain-text URL \u2014 check if it looks like an image\n              const lc = trimmed.toLowerCase();\n              if (/\\.(png|jpg|jpeg|gif|webp|svg|bmp|avif|ico)(\\?.*)?$/i.test(lc)) {\n                imgUrl = trimmed;\n              }\n            }\n            console.log('[Paste] imgUrl detected:', imgUrl, 'itemType:', itemType);\n            if (imgUrl) {\n              const { x, y } = getPasteXY();\n              fetchImageFromURL(imgUrl, x, y);\n              return;\n            }\n\n            // If it's HTML or RTF, strip tags/formatting for plain text\n            if (itemType === 'text/html' || itemType === 'text/richtext' || itemType === 'text/rtf') {\n              trimmed = trimmed.replace(/<[^>]*>/g, '').replace(/&nbsp;/g, ' ').replace(/&amp;/g, '&').replace(/&lt;/g, '<').replace(/&gt;/g, '>').replace(/&quot;/g, '\"').replace(/&#39;/g, \"'\").trim();\n            }\n            // Also strip RTF control sequences if present\n            if (itemType === 'text/rtf') {\n              trimmed = trimmed.replace(/\\{\\\\[^{}]*\\}/g, '').replace(/\\\\[a-z]+/gi, '').replace(/[{}]/g, '').trim();\n            }\n            if (!trimmed) return;\n            // v6.1.3: Allow external text paste (from WeChat, browser, etc.).\n            // Only block when: internal clipboard was consumed (one-shot) AND\n            // the user hasn't re-copied from Krafted \u2014 that's the keyboard-repeat\n            // / stale-paste guard. External paste always goes through.\n            if (state._textCopiedFromKrafted && (!state.clipboard || state.clipboard.length === 0)) {\n              // Internal clipboard was consumed \u2014 this is a stale/repeat paste.\n              // Clear flag so next external paste works normally.\n              state._textCopiedFromKrafted = false;\n              console.log('[Paste] Skipping text paste \u2014 internal clipboard consumed');\n              return;\n            }\n            // URL detection\n            if (/^https?:\\/\\/[^\\s]+$/i.test(trimmed) || /^www\\.[^\\s]+\\.[a-z]{2,}/i.test(trimmed) ||\n                /^[a-z0-9-]+\\.[a-z]{2,}[^\\s]*$/i.test(trimmed)) {\n              let url = trimmed;\n              if (!/^https?:\\/\\//i.test(url)) url = 'https://' + url;\n              const { x, y } = getPasteXY();\n              addLinkCard(url, { x, y });\n              toast('Pasted link');\n            } else {\n              // Plain text \u2014 create a text item at mouse position (noFocus so next Ctrl+V still works)\n              const { x, y } = getPasteXY();\n              // Pre-calculate init width by measuring the WIDEST line\n              // (not just the first line \u2014 multi-line text needs the widest line's width)\n              const measureEl = document.createElement('span');\n              measureEl.style.cssText = 'position:absolute;visibility:hidden;white-space:nowrap;font:' +\n                textTool.size + 'px/' + '1.5 ' + textTool.font;\n              document.body.appendChild(measureEl);\n              let widestLineW = 0;\n              for (const line of trimmed.split('\\n')) {\n                measureEl.textContent = line;\n                widestLineW = Math.max(widestLineW, measureEl.offsetWidth);\n              }\n              document.body.removeChild(measureEl);\n              const initW = Math.min(520, Math.max(120, widestLineW + 40));\n              const tx = addText(x, y, trimmed, { noFocus: true, initW: initW });\n              // Auto-size after DOM settles\n              requestAnimationFrame(() => {\n                autoGrowTextItem(tx);\n                refreshSelection();\n              });\n              toast('Pasted text');\n            }\n          } catch (err) {\n            console.error('Text paste error:', err);\n            toast('Failed to paste text');\n          }\n        });\n        return;\n      }\n    }\n\n  // \u2500\u2500 2) Image from clipboard (screenshot, browser copy-image) \u2500\u2500\n  // Round 20: the in-app-copy intercept at the top of this handler\n  // (Section 0) already routes recent in-app copies to state.clipboard.\n  // If we reach here, the user is NOT pasting a recent in-app copy \u2014\n  // either they copied externally (screenshot, browser copy-image) or\n  // the 3s window has expired. So we can trust e.clipboardData and\n  // read the image from the system clipboard normally.\n  const imageItems = [];\n  for (const item of items) {\n    if (item.type.startsWith('image/')) {\n      const blob = item.getAsFile();\n      if (blob) imageItems.push({ blob, type: item.type });\n    }\n  }\n  if (imageItems.length > 0) {\n    e.preventDefault();\n    const target = attachToMindmap(imageItems[0].blob);\n    if (target) {\n      const reader = new FileReader();\n      reader.onload = ev => {\n        const tmpImg = new Image();\n        tmpImg.onload = () => {\n          pushUndo();\n          target.node.img = ev.target.result;\n          target.node.imgW = tmpImg.naturalWidth;\n          target.node.imgH = tmpImg.naturalHeight;\n          const dispH = Math.min(80, tmpImg.naturalHeight * (120 / Math.max(tmpImg.naturalWidth, 1)));\n          target.node.h = Math.max(36, dispH + 24);\n          renderMindMap(target.mm);\n          mmAutoFit(target.mm);\n          scheduleAutoSave();\n          toast('Image attached to idea: ' + (target.node.text || ''));\n        };\n        tmpImg.src = ev.target.result;\n      };\n      reader.readAsDataURL(imageItems[0].blob);\n      return;\n    }\n    // Place on canvas at cursor \u2014 unified with file-paste path.\n    // v6.8.28: screenshot paste used to create a one-shot blob URL and\n    // hope it stayed alive until save. For large boards with many screenshots\n    // in a row, some blob URLs could become invalid before save on Chrome.\n    // We now copy the clipboard blob into a persistent File object and use\n    // the same createImageBitmap + URL.createObjectURL path as file drops.\n    const { x, y } = getPasteXY();\n    if (imageItems.length > 0) pushUndo();\n    let imgIdx = 0;\n    (async function processNextScreenshot() {\n      if (imgIdx >= imageItems.length) return;\n      const { blob } = imageItems[imgIdx];\n      const px = x + imgIdx * 20, py = y + imgIdx * 20;\n      const isLast = (imgIdx === imageItems.length - 1);\n      imgIdx++;\n      try {\n        // v6.8.29: snapshot the clipboard bytes into a fresh in-memory Blob.\n        // A File wrapper alone can still be treated by Chrome as an upload\n        // backing store and later fail with ERR_UPLOAD_FILE_CHANGED. A copied\n        // ArrayBuffer-backed Blob is stable for the entire board lifetime.\n        const bytes = await blob.arrayBuffer();\n        const stableBlob = new Blob([new Uint8Array(bytes)], { type: blob.type || 'image/png' });\n        const bitmap = await createImageBitmap(stableBlob);\n        const w = bitmap.width, h = bitmap.height;\n        bitmap.close();\n        const blobUrl = URL.createObjectURL(stableBlob);\n        addImage(blobUrl, w, h, px, py, false, isLast, stableBlob.size, false, stableBlob);\n      } catch (e) {\n        console.warn('[Paste] Screenshot decode failed:', e.message);\n      }\n      setTimeout(processNextScreenshot, 30);\n    })();\n    toast('Pasted ' + imageItems.length + ' screenshot(s)');\n    return;\n  }\n\n  // \u2500\u2500 2b) Audio from clipboard \u2500\u2500\n  for (const item of items) {\n    if (!item.type.startsWith('audio/')) continue;\n    e.preventDefault();\n    const blob = item.getAsFile();\n    const target = attachToMindmap(blob);\n    if (target) {\n      const reader = new FileReader();\n      reader.onload = ev => {\n        pushUndo();\n        target.node.audio = ev.target.result;\n        target.node.audioName = (blob.name || 'Audio').length > 20 ? (blob.name || 'Audio').substring(0, 17) + '...' : (blob.name || 'Audio');\n        const baseH = target.node.img ? Math.max(36, 24 + 24) : 36;\n        target.node.h = baseH + 28;\n        renderMindMap(target.mm);\n        mmAutoFit(target.mm);\n        scheduleAutoSave();\n        toast('Audio attached to idea: ' + (target.node.text || ''));\n      };\n      reader.readAsDataURL(blob);\n      return;\n    }\n    toast('Select a mind map node first to attach audio');\n    return;\n  }\n\n  // \u2500\u2500 3) Fallback: internal clipboard (only if e.clipboardData is TRULY empty) \u2500\u2500\n  // Round 20: the in-app-copy intercept at the top of this handler\n  // already routed recent in-app copies to state.clipboard. So if we\n  // reach here with a non-empty clipboard event, we should NOT use\n  // state.clipboard \u2014 that was the source of the \"old image gets pasted\"\n  // bug on Mac (Safari often delivers the image via items[] but with\n  // an unrecognised type, and the handler used to fall through to\n  // state.clipboard which was stale from a previous in-app copy). Now\n  // we only consult state.clipboard when the paste event has NO data\n  // at all (e.g., a synthetic paste from the keyboard handler on a\n  // non-secure context).\n  if (state.clipboard && files.length === 0 && items.length === 0) {\n    e.preventDefault();\n    pasteClipboard();\n    return;\n  }\n  } catch (err) {\n    console.error('[PASTE] Handler error:', err);\n    try { toast('Paste failed'); } catch (e2) {}\n  }\n});\n\n\n// ==== keyboard.js ====\n\n// \u2500\u2500 Shortcut Registry dispatcher \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n\n// v5.5.1: check whether the cursor is currently over a video frame\n// (.media-wrap) of any video item. Uses bounding-rect hit-test\n// because the video has pointer-events:none and .media-wrap is\n// transparent, so elementFromPoint penetrates straight through.\nfunction _videoUnderCursor() {\n  if (!state || !state.mouse || !state.items) return false;\n  var mx = state.mouse.x, my = state.mouse.y;\n  for (var i = 0; i < state.items.length; i++) {\n    var it = state.items[i];\n    if (!it || !it.video || !it.el || !it.el._annoDrawState) continue;\n    var mw = it.el.querySelector('.media-wrap');\n    if (!mw) continue;\n    var r = mw.getBoundingClientRect();\n    if (mx >= r.left && mx <= r.right && my >= r.top && my <= r.bottom) {\n      return true;\n    }\n  }\n  return false;\n}\n\n// v7.0.13: shared helper \u2014 if the cursor is hovering a video whose internal\n// Ctrl/Alt+middle-drag zoom/pan is active, reset it to 1x / centered and\n// return true. Returns false when there's nothing to reset, so callers can\n// fall through to their normal behavior. Used by the F shortcut dispatch\n// (frame selection) and the legacy F handler \u2014 F means \"frame/fit\", so\n// when a video is zoomed the most intuitive reading is \"fit it back\".\nfunction _tryResetVideoZoomAtCursor() {\n  if (!state || !state.mouse || !state.items) return false;\n  var mx = state.mouse.x, my = state.mouse.y;\n  for (var i = 0; i < state.items.length; i++) {\n    var it = state.items[i];\n    if (!it || !it.video || !it.el) continue;\n    // v7.0.16: also resettable when only panned (zoom === 1, pan \u2260 0).\n    if (it._videoZoom === undefined) continue;\n    if (it._videoZoom === 1 && !it._videoPanX && !it._videoPanY) continue;\n    var mw = it.el.querySelector('.media-wrap');\n    if (!mw) continue;\n    var r = mw.getBoundingClientRect();\n    if (mx >= r.left && mx <= r.right && my >= r.top && my <= r.bottom) {\n      it._videoZoom = 1;\n      it._videoPanX = 0;\n      it._videoPanY = 0;\n      if (it.video) {\n        it.video.style.transform = '';\n        it.video.style.transformOrigin = '';\n      }\n      var annoCvs = it.el.querySelector('.media-anno-canvas');\n      if (annoCvs) {\n        annoCvs.style.transform = '';\n        annoCvs.style.transformOrigin = '';\n      }\n      if (it.el._renderAnnoCanvas) {\n        it.el._perfLastRenderKey = '';\n        try { it.el._renderAnnoCanvas(); } catch (_e) {}\n      }\n      return true;\n    }\n  }\n  return false;\n}\n\n// v7.0.14: F-to-reset must work in EVERY mode \u2014 including while the video\n// annotation draw mode is active, which is exactly when the user wants it\n// (\"draw stroke \u5605\u65F6\u5019\u60F3\u4F62\u64A4\u9500\"). The normal dispatch chain (shortcut\n// registry + legacy handlers) has too many mode-dependent early returns\n// between the keypress and the reset check, any one of which can swallow\n// the key depending on focus/mode state. Register a CAPTURE-phase listener\n// that runs before ALL of them; when it actually resets a zoom, it stops\n// the event entirely so nothing downstream (registry 'tool-frame-sel' \u2192\n// frameSelection(), legacy handler) also fires. When there's no zoomed\n// video under the cursor it does nothing and the event flows through\n// untouched, so plain F elsewhere is unaffected. Typing guard: if the\n// user is typing in an input/textarea/contenteditable (comment box, anno\n// text editor, etc.) the F must type the letter, not reset a zoom.\ndocument.addEventListener('keydown', function(e) {\n  if (e.key !== 'f' && e.key !== 'F') return;\n  if (e.ctrlKey || e.metaKey || e.altKey || e.shiftKey) return;\n  var ae = document.activeElement;\n  if (ae && (ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' ||\n             ae.isContentEditable || ae.contentEditable === 'true')) return;\n  if (_tryResetVideoZoomAtCursor()) {\n    e.preventDefault();\n    e.stopImmediatePropagation();\n  }\n}, true); // capture phase \u2014 runs before the shortcut registry + legacy handlers\n\n// v5.5.1: check whether any selected item is a video.\nfunction _videoSelected() {\n  if (!state || !state.selected || !state.items) return false;\n  var found = false;\n  state.selected.forEach(function(id) {\n    if (found) return;\n    var it = state.items.find(function(i) { return i.id === id; });\n    if (it && (it.video || it.isVideo)) found = true;\n  });\n  return found;\n}\n\n// R79: lookup the active shortcut registry and dispatch the\n// matching action. Returns true if a shortcut was handled.\n// Called at the top of the keydown handler so user-customised\n// shortcuts always take priority over the legacy hardcoded\n// logic below.\nfunction _dispatchShortcut(e) {\n  var reg = (typeof window !== 'undefined' && window.ShortcutRegistry) ? window.ShortcutRegistry : {};\n  var matchedId = null;\n  var matchedKeys = null;\n  // Walk every shortcut; find the first one whose key combo matches.\n  var ids = Object.keys(reg);\n  for (var i = 0; i < ids.length; i++) {\n    var entry = reg[ids[i]];\n    if (!entry || !entry.keys) continue;\n    for (var j = 0; j < entry.keys.length; j++) {\n      var k = entry.keys[j];\n      // Match modifiers: ctrl OR meta is treated as \"modifier key\"\n      // (Cmd on Mac, Ctrl on Win). If the shortcut expects ctrl and\n      // the user pressed meta (or vice versa), we match \u2014 because\n      // Platform.zoomKey already maps Cmd\u2192metaKey, Ctrl\u2192ctrlKey.\n      var wantCtrl = !!k.ctrl;\n      var wantMeta = !!k.meta;\n      var wantShift = !!k.shift;\n      var wantAlt = !!k.alt;\n      var gotCtrl = !!e.ctrlKey;\n      var gotMeta = !!e.metaKey;\n      var gotShift = !!e.shiftKey;\n      var gotAlt = !!e.altKey;\n      // If the shortcut wants ctrl OR meta, accept either.\n      // If it wants BOTH, require both.\n      var modOk = true;\n      if (wantCtrl && wantMeta) {\n        modOk = gotCtrl && gotMeta;\n      } else if (wantCtrl || wantMeta) {\n        modOk = gotCtrl || gotMeta;\n      } else {\n        modOk = !gotCtrl && !gotMeta;\n      }\n      modOk = modOk && (wantShift === gotShift) && (wantAlt === gotAlt);\n      // Key match (case-insensitive for letters)\n      var keyOk = (k.key === e.key) || (k.key.toUpperCase && k.key.toLowerCase() === e.key.toLowerCase());\n      if (modOk && keyOk) {\n        matchedId = entry.id;\n        matchedKeys = entry.keys;\n        break;\n      }\n    }\n    if (matchedId) break;\n  }\n  if (!matchedId) return false;\n\n  // \u2500\u2500 Dispatch action \u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\u2500\n  // edit-paste MUST NOT preventDefault \u2014 the native paste event needs\n  // to fire so paste-handler.js can read clipboardData.\n  // tool-text / tool-draw: if cursor is over a video frame, bail out\n  // so the plain D/T handler can enter video annotation mode instead\n  // of switching the global canvas tool.\n  if (matchedId === 'tool-text' || matchedId === 'tool-draw') {\n    if (_videoUnderCursor()) return false; // let plain D/T handler take over\n  }\n  // All other shortcuts prevent the default browser behavior.\n  if (matchedId !== 'edit-paste') e.preventDefault();\n  switch (matchedId) {\n    // Tools\n    case 'tool-select':      setTool('select'); return true;\n    case 'tool-text':        setTool('text'); return true;\n    case 'tool-draw':        setTool('draw'); return true;\n    case 'tool-export':      setTool('export'); return true;\n    case 'tool-capture':     setTool('capture'); return true;\n    case 'tool-screen-cap':  captureScreen(); return true;\n    case 'tool-cut':         setTool('cut'); return true;\n    case 'tool-lasso':       setTool('lasso'); return true;\n    case 'tool-mindmap':     addMindMap(); return true;\n    case 'tool-relation':    setTool('relation'); return true;\n    case 'tool-link':        openLinkModal(); return true;\n    case 'tool-grid':        toggleGrid(); return true;\n    case 'tool-fullscreen':  toggleAppFullscreen(); return true;\n    case 'tool-frame-sel':\n      // v7.0.13: F while hovering a ZOOMED video resets its zoom/pan\n      // (\"fit back to 100%\") instead of framing the whole selection.\n      // Only when the hovered video has no active zoom does F fall\n      // through to the normal frame-selection behavior.\n      if (_tryResetVideoZoomAtCursor()) return true;\n      frameSelection(); return true;\n    // Edit\n    // v7.0.36: the Edit menu must behave exactly like Ctrl+Z / Ctrl+Shift+Z \u2014\n    // it has to undo the last action whatever kind it was, including a video\n    // annotation stroke (which lives on its own lightweight stack).\n    case 'edit-undo':        undoLastAction(); return true;\n    case 'edit-redo':        redoLastAction(); return true;\n    case 'edit-redo-alt':    redoLastAction(); return true;\n    case 'edit-copy':        copySelected(); return true;\n    case 'edit-paste':       return true; // handled by native paste event\n    case 'edit-duplicate':   duplicateSelected(); return true;\n    case 'edit-delete':      deleteSelected(); return true;\n    case 'edit-select-all':  state.selected.clear(); var all = []; [].push.apply(all, state.items); [].push.apply(all, state.texts); [].push.apply(all, state.todos||[]); [].push.apply(all, state.mindmaps||[]); all.forEach(function(i){ state.selected.add(i.id); }); refreshSelection(); return true;\n    // Screen Share Mode (v6.8.0)\n    case 'tool-screen-share':  toggleScreenShareMode(); return true;\n    // File\n    case 'file-save':        if (typeof saveBoardV6 === 'function') saveBoardV6(); return true;\n    case 'file-save-as':     if (typeof setTool === 'function') setTool('capture'); return true; // Shift+Ctrl+S = screen cap\n    case 'file-open':        if (typeof loadBoard === 'function') loadBoard(); return true;\n    // Group\n    case 'group-group':      groupSelected(); return true;\n    case 'group-ungroup':    ungroupSelected(); return true;\n    // Arrange\n    case 'arrange-tidy':     tidySelection(); return true;\n    case 'arrange-tetris-up':    tetrisAlign('up'); return true;\n    case 'arrange-tetris-down':  tetrisAlign('down'); return true;\n    case 'arrange-tetris-left':  tetrisAlign('left'); return true;\n    case 'arrange-tetris-right': tetrisAlign('right'); return true;\n    case 'arrange-dist-h':   distributeItems('h'); return true;\n    case 'arrange-dist-v':   distributeItems('v'); return true;\n    case 'arrange-norm-size':  normalizeSize('size'); return true;\n    case 'arrange-norm-scale': normalizeSize('scale'); return true;\n    case 'arrange-norm-h':   normalizeSize('height'); return true;\n    case 'arrange-norm-w':   normalizeSize('width'); return true;\n    case 'arrange-stack':    stackItems(); return true;\n    // Navigation\n    case 'nav-pan-space':\n      // v5.5.1: if a video is selected, let the legacy spacebar handler\n      // (below) handle play/pause. Only pan if no video is selected.\n      if (_videoSelected()) return false;\n      state.spaceDown = true; viewport.style.cursor = 'grab'; return true;\n    case 'nav-help':         if (typeof showHelp === 'function') showHelp(); return true;\n    case 'nav-esc':\n      // v6.0: draw mode \u2014 Esc packs all strokes into one item then exits\n      if (state.tool === 'draw') { convertAllStrokesToItem(); setTool('select'); return true; }\n      clearSelection(); hideCtx(); if (typeof hideHelp === 'function') hideHelp(); captureResultPanel.classList.remove('show'); _exitRelationTool();\n      if (state.tool !== 'select') setTool('select'); return true;\n    case 'draw-finish':      if (state.tool === 'draw') { convertAllStrokesToItem(); setTool('select'); return true; } return false;\n    // Translate\n    case 'translate-en-zh':  translateSelectedText('en', 'zh'); return true;\n    // Media\n    case 'media-frame-left':       /* handled by existing logic */ return false;\n    case 'media-frame-right':      /* handled by existing logic */ return false;\n    case 'media-frame-10-left':    /* handled by existing logic */ return false;\n    case 'media-frame-10-right':   /* handled by existing logic */ return false;\n    // v7.0.41: these used to return false, i.e. the palette closed and\n    // NOTHING happened. Route them at the playhead, which is what their\n    // labels promise \u2014 a palette press has no cursor to read.\n    case 'media-trim-i':           setTrimFromPlayhead('in');  return true;\n    case 'media-trim-o':           setTrimFromPlayhead('out'); return true;\n    case 'media-trim-clear':       clearTrimSelected(); return true;\n    case 'media-trim-clear-in':    clearTrimMark('in');  return true;\n    case 'media-trim-clear-out':   clearTrimMark('out'); return true;\n    case 'media-contact-sheet':    openContactSheetDialog(); return true;\n    // v7.0.40: named views\n    case 'view-save':              saveViewFromSelection(); return true;\n    case 'view-update':            updateViewFromCurrent(state._activeViewIndex); return true;\n    case 'view-present':           startPresent(); return true;\n    case 'view-toggle-panel':      toggleViewsPanel(); return true;\n    case 'library-toggle-panel':   toggleLibraryPanel(); return true;\n    case 'minimap-toggle-panel':   toggleMinimapPanel(); return true;\n    case 'view-ab-compare':        openABCompare(); return true;\n    case 'edit-reframe':           enterReframe(getSelectedImages()); return true;\n    default: return false;\n  }\n}\n\n// ============================================================\n//  KEYBOARD\n// ============================================================\n// v6.5.0: Capture-phase Ctrl+S / Cmd+S \u2192 saveBoardV6().\n// Without capture, browser default \"Save Page As\" (or \"Save Image\" in\n// some browsers) intercepts the key combo before Krafted sees it.\ndocument.addEventListener('keydown', e => {\n  if ((e.ctrlKey || e.metaKey) && !e.altKey && (e.key === 's' || e.key === 'S')) {\n    // Don't steal from text inputs\n    const tag = (e.target && e.target.tagName) || '';\n    if (tag === 'INPUT' || tag === 'TEXTAREA' || (e.target && e.target.isContentEditable)) return;\n    e.preventDefault();\n    e.stopPropagation();\n    // v7.0.27: Ctrl/Cmd+Shift+S = Save As (force a new file picker);\n    // plain Ctrl/Cmd+S quick-saves back to the last picked file.\n    if (typeof saveBoardV6 === 'function') saveBoardV6(e.shiftKey ? { forceNew: true } : undefined);\n    return;\n  }\n}, true); // capture phase \u2014 fires before browser default\ndocument.addEventListener('keydown', e => {\n  // v6.1.1: Capture-phase Ctrl+C from text selection. If user has selected\n  // text inside a contentEditable (Krafted text-item) and copies it, save\n  // the selected text to state.clipboard so the next Ctrl+V pastes it\n  // correctly. Without this, browser native copy writes to system clipboard\n  // (unreliable on GitHub Pages) and our internal clipboard stays stale.\n  if ((e.ctrlKey || e.metaKey) && !e.shiftKey && !e.altKey && (e.key === 'c' || e.key === 'C')) {\n    const sel = window.getSelection();\n    const selectedText = sel ? sel.toString().trim() : '';\n    if (selectedText && e.target && e.target.contentEditable === 'true') {\n      // Find the source text item by matching the DOM element.\n      // Walk up from the selection anchor to find the .text-item container,\n      // then look it up in state.texts by its `el` reference.\n      let node = sel.anchorNode;\n      let textEl = null;\n      while (node && node !== document.body) {\n        if (node.classList && node.classList.contains('text-item')) {\n          textEl = node;\n          break;\n        }\n        node = node.parentNode;\n      }\n      var textItem = null;\n      if (textEl) {\n        for (var ti = 0; ti < state.texts.length; ti++) {\n          if (state.texts[ti].el === textEl) { textItem = state.texts[ti]; break; }\n        }\n      }\n      if (textItem) {\n        // v6.1.1: Save selected text to internal clipboard\n        state.clipboard = [{ ...textItem, el: null, img: null, tags: (textItem.tags || []).slice(), content: selectedText }];\n        state._textCopiedFromKrafted = true;\n        state._lastInternalPaste = 0; // reset guard so this copy can be pasted immediately\n        // Native copy remains allowed so text can also be pasted outside Krafted.\n        e.stopPropagation();\n        try { toast('Copied text'); } catch (ex) {}\n        return;\n      }\n    }\n  }\n\n  \n  // Don't intercept when typing in text\n  // Round 15: added TEXTAREA \u2014 the draw text tool spawns a <textarea>\n  // overlay, and single-letter hotkeys (v, t, d, e, c, x, l, m, s, etc.)\n  // were being intercepted while the user typed, switching tools\n  // underneath their fingers.\n  // v6.5.0: check activeElement (where the cursor actually is), not e.target.\n  // e.target on a text-item div has contentEditable=true even when the user\n  // hasn't clicked into it \u2014 that incorrectly blocked F (frame selection) and\n  // other hotkeys while the text box was just selected, not being edited.\n  var ae = document.activeElement;\n  if (ae && (ae.contentEditable === 'true' || ae.tagName === 'INPUT' || ae.tagName === 'TEXTAREA' || ae.tagName === 'SELECT')) {\n    // Allow translate shortcut even while editing text\n    if ((e.ctrlKey || e.metaKey) && e.shiftKey && (e.key === 'T' || e.key === 't')) {\n      e.preventDefault();\n      translateSelectedText('en', 'zh');\n      return;\n    }\n    if (e.key === 'Escape' && !boardTextIsComposing(e, ae)) e.target.blur();\n    return;\n  }\n\n  // R79: try the shortcut registry first. If the user has remapped\n  // a shortcut, the registry dispatches it and the legacy hardcoded\n  // logic below is skipped for that key combo.\n  if (_dispatchShortcut(e)) return;\n\n  if (e.key === ' ' && !state.spaceDown) {\n    state.spaceDown = true;\n    // Spacebar plays/pauses the selected video (if any). If no video is\n    // selected, fall through to the pan behavior below.\n    if (!cutState && !lassoState && !state.reframing && !state.cropping) {\n      var vidItem = null;\n      state.selected.forEach(function(id) {\n        var it = state.items.find(function(i) { return i.id === id; });\n        if (it && it.isVideo && it.video) { vidItem = it; }\n      });\n      if (vidItem && vidItem.video) {\n        e.preventDefault();\n        if (vidItem.video.paused) {\n          playMediaEl(vidItem.video);   // v7.0.33: concurrency budget\n        } else {\n          vidItem.video.pause();\n        }\n        return;\n      }\n    }\n    // No video selected \u2014 switch to pan mode (grab cursor)\n    viewport.style.cursor = 'grab';\n    e.preventDefault();\n    return;\n  }\n  // Free cut shortcuts\n  if (cutState) {\n    if (e.key === 'Escape') { cancelCut(); setTool('select'); return; }\n    // v7.0.