File(it.getAsFile && it.getAsFile()); } catch (err) {}\n    }\n  }\n  return out;\n}\n\n// v7.0.22: disk-backed store for dragged-in web images. Storing each\n// dragged image as a data URL keeps the whole thing in the renderer JS\n// heap (plus a copy inside every undo snapshot's JSON string), and after\n// a handful of drags Chrome's OOM killer was killing the heavy SOURCE\n// tab (Pinterest). Round-tripping each image through IndexedDB returns a\n// Blob backed by the browser's blob store (disk for anything non-trivial)\n// instead of our heap, so long drag sessions cost almost no RAM.\n\n// v7.2.1: strict serialization for cross-site image drags. Each drop used\n// to decode independently, so dragging several images quickly held every\n// full-resolution bitmap at once -- a 4000x3000 source is ~48 MB of RGBA\n// before the 1280 cap ever runs, and a handful of drags killed the tab.\n// One decode at a time, with a yield between them so the IndexedDB write\n// and GC can settle. Declared at module scope on purpose: a queue created\n// inside the drop handler would be a fresh empty one on every drop, which\n// is exactly the same as having no queue at all.\nvar _webDragQueue = { busy: false, pending: [] };\nfunction _drainWebDragQueue() {\n  if (_webDragQueue.busy) return;\n  var job = _webDragQueue.pending.shift();\n  if (!job) return;\n  _webDragQueue.busy = true;\n  Promise.resolve()\n    .then(job)\n    .catch(function (e) { console.warn('[FileDrop] queued import failed:', e && e.message); })\n    .then(function () {\n      _webDragQueue.busy = false;\n      setTimeout(_drainWebDragQueue, 50);\n    });\n}\nfunction _enqueueWebDrag(job) {\n  _webDragQueue.pending.push(job);\n  _drainWebDragQueue();\n}\n\nvar _dragImgStore = {\n  _dbPromise: null,\n  _open: function() {\n    if (this._dbPromise) return this._dbPromise;\n    this._dbPromise = new Promise(function(resolve, reject) {\n      const req = indexedDB.open('krafted-drag-images', 1);\n      req.onupgradene